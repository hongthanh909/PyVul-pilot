:\n            self.message = (as_unicode(self.delete_integrity_error_message), \"warning\")\n            log.warning(LOGMSG_WAR_DBI_DEL_INTEGRITY.format(str(e)))\n            self.session.rollback()\n            if raise_exception:\n                raise e\n            return False\n        except Exception as e:\n            self.message = (as_unicode(self.database_error_message), \"danger\")\n            log.exception(\"Database error\")\n            self.session.rollback()\n            if raise_exception:\n                raise e\n            return False\n"}, {"function_name": "edit", "code_before": "    def edit(self, item: Model, raise_exception: bool = False) -> bool:\n        try:\n            self.session.merge(item)\n            self.session.commit()\n            self.message = (as_unicode(self.edit_row_message), \"success\")\n            return True\n        except IntegrityError as e:\n            self.message = (as_unicode(self.edit_integrity_error_message), \"warning\")\n            log.warning(LOGMSG_WAR_DBI_EDIT_INTEGRITY.format(str(e)))\n            self.session.rollback()\n            if raise_exception:\n                raise e\n            return False\n        except Exception as e:\n            self.message = (\n                as_unicode(self.general_error_message + \" \" + str(sys.exc_info()[0])),\n                \"danger\",\n            )\n            log.exception(LOGMSG_ERR_DBI_EDIT_GENERIC.format(str(e)))\n            self.session.rollback()\n            if raise_exception:\n                raise e\n            return False\n", "code_after": "    def edit(self, item: Model, raise_exception: bool = False) -> bool:\n        try:\n            self.session.merge(item)\n            self.session.commit()\n            self.message = (as_unicode(self.edit_row_message), \"success\")\n            return True\n        except IntegrityError as e:\n            self.message = (as_unicode(self.edit_integrity_error_message), \"warning\")\n            log.warning(LOGMSG_WAR_DBI_EDIT_INTEGRITY.format(str(e)))\n            self.session.rollback()\n            if raise_exception:\n                raise e\n            return False\n        except Exception as e:\n            self.message = (as_unicode(self.database_error_message), \"danger\")\n            log.exception(\"Database error\")\n            self.session.rollback()\n            if raise_exception:\n                raise e\n            return False\n"}], "gpt_answer": "The vulnerability described in the advisory is related to a malicious actor with Admin privileges being able to trigger a database error by adding a special character on the add, edit User forms. This error can include the entire user row including the hashed password.\n\nLooking at the changes in the \"add\" function, the main change is in the handling of the generic Exception. The error message has been changed from a general error message to a specific database error message. Also, the log message has been changed from a detailed message including the exception details to a generic \"Database error\" message.\n\nThis change is directly related to the vulnerability described, as it prevents the detailed database error from being logged and potentially exposed to a malicious actor. Therefore, the function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
