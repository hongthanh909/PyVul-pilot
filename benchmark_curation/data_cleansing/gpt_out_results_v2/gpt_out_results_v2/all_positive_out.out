ile(path,\n                         cache_timeout=datetime.timedelta(\n                             days=365).total_seconds(),\n                         add_etags=True,\n                         conditional=True)\n    return response\n"}], "gpt_answer": "The function `_get_obj_abosolute_path` is removed in the commit, and it seems to be replaced by `_get_obj_absolute_path` (note the spelling correction). The commit message indicates that the commit is intended to fix path traversal issues. \n\nThe vulnerability description mentions that the Flask `send_file` function is used unsafely, allowing absolute path traversal. The function `get_object_src_http` uses `send_file` and it is changed in the commit to use `_get_obj_absolute_path` instead of `_get_obj_abosolute_path`.\n\nGiven this, it seems that `_get_obj_abosolute_path` was part of the vulnerability, as it was used to construct the path that was then passed to `send_file`. The function was removed and replaced with a presumably safer function, `_get_obj_absolute_path`, to mitigate the vulnerability.\n\nSo, the function `_get_obj_abosolute_path` is relevant to the vulnerability that the commit is trying to fix.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_object_src_http", "code_before": "def get_object_src_http(dataset, rel_path):\n    path = _get_obj_abosolute_path(dataset, rel_path)\n    response = send_file(path,\n                         cache_timeout=datetime.timedelta(\n                             days=365).total_seconds(),\n                         add_etags=True,\n                         conditional=True)\n    return response\n", "code_after": "def get_object_src_http(dataset, rel_path):\n    path = _get_obj_absolute_path(dataset, rel_path)\n    response = send_file(path,\n                         cache_timeout=datetime.timedelta(\n                             days=365).total_seconds(),\n                         add_etags=True,\n                         conditional=True)\n    return response\n", "commit_message": "Fix path traversal issues in all dataretriever backends", "commit": "https://github.com/cmusatyalab/opendiamond/commit/398049c187ee644beabab44d6fece82251c1ea56", "description": "The cmusatyalab/opendiamond repository through 10.1.1 on GitHub allows absolute path traversal because the Flask send_file function is used unsafely. A patch is available on the `master` branch of the repository.", "file_change_id": 85493540041570, "report_link": "https://github.com/advisories/GHSA-x2pc-fqrw-hc7f", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "_get_object_element", "code_before": "def _get_object_element(dataset, seq_no, rel_path, download_link):\n    \"\"\"If rel_path and download_link are not None, we are called from scope.\n    Otherwise we are called from ID and need to run SQL query to fetch these attrs.\"\"\"\n\n    if rel_path is None:\n        query = \"SELECT rel_path, download_link FROM \" + \\\n        dataset + \\\n        \" WHERE sequence_no = %s\"\n\n        cnx = mysql.connector.connect(user=DB_USER,\n                                    password=DB_PASSWORD,\n                                    host=DB_HOST,\n                                    database=DB_DBNAME,\n                                    port=DB_PORT)\n        cursor = cnx.cursor()\n        cursor.execute(query, (seq_no,))\n\n        row = cursor.fetchone()\n\n        if not row:\n            return None\n\n        rel_path, download_link = row[0], row[1]\n\n    if LOCAL_OBJ_URI:\n        src_uri = 'file://' + os.path.join(DATAROOT, dataset, rel_path)\n    else:\n        src_uri = url_for('.get_object_src_http', dataset=dataset, rel_path=rel_path)\n\n    return '<object id={} src={} hyperfind.external-link={} />' \\\n        .format(\n        quoteattr(url_for('.get_object_id', dataset=dataset, seq_no=seq_no)),\n        quoteattr(src_uri),\n        quoteattr(download_link))\n", "code_after": "def _get_object_element(dataset, seq_no, rel_path, download_link):\n    \"\"\"If rel_path and download_link are not None, we are called from scope.\n    Otherwise we are called from ID and need to run SQL query to fetch these attrs.\"\"\"\n\n    if rel_path is None:\n        query = \"SELECT rel_path, download_link FROM \" + \\\n        dataset + \\\n        \" WHERE sequence_no = %s\"\n\n        cnx = mysql.connector.connect(user=DB_USER,\n                                    password=DB_PASSWORD,\n                                    host=DB_HOST,\n                                    database=DB_DBNAME,\n                                    port=DB_PORT)\n        cursor = cnx.cursor()\n        cursor.execute(query, (seq_no,))\n\n        row = cursor.fetchone()\n\n        if not row:\n            return None\n\n        rel_path, download_link = row[0], row[1]\n\n    if LOCAL_OBJ_URI:\n        src_uri = 'file://' + _get_obj_absolute_path(dataset, rel_path)\n    else:\n        src_uri = url_for('.get_object_src_http', dataset=dataset, rel_path=rel_path)\n\n    return '<object id={} src={} hyperfind.external-link={} />' \\\n        .format(\n        quoteattr(url_for('.get_object_id', dataset=dataset, seq_no=seq_no)),\n        quoteattr(src_uri),\n        quoteattr(download_link))\n"}, {"function_name": "_get_obj_abosolute_path", "code_before": "def _get_obj_abosolute_path(dataset, rel_path):\n    return os.path.join(DATAROOT, dataset, rel_path)\n", "code_after": ""}], "gpt_answer": "The vulnerability described is related to absolute path traversal due to unsafe use of the Flask send_file function. The function `get_object_src_http` is changed in the commit, but the change is a spelling correction in a function call from `_get_obj_abosolute_path` to `_get_obj_absolute_path`.\n\nThe function `_get_obj_abosolute_path` is removed in the commit and its usage in other functions like `_get_object_element` is replaced with `_get_obj_absolute_path`. This suggests that the `_get_obj_abosolute_path` function was the one that had the vulnerability, and the `get_object_src_http` function was using it.\n\nSo, the `get_object_src_http` function was indirectly vulnerable because it was using a vulnerable function. After the change, it is no longer vulnerable. Therefore, the answer is 1, the function is vulnerable.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "build_attrs", "code_before": "    def build_attrs(self, *args, **kwargs):\n        attrs = super().build_attrs(*args, **kwargs)\n\n        accept = attrs.get(\"accept\")\n        response = self.client.generate_presigned_post(\n            self.bucket_name,\n            str(pathlib.PurePosixPath(self.upload_folder, \"${filename}\")),\n            Conditions=self.get_conditions(accept),\n            ExpiresIn=self.expires,\n        )\n\n        defaults = {\n            \"data-fields-%s\" % key: value for key, value in response[\"fields\"].items()\n        }\n        defaults[\"data-url\"] = response[\"url\"]\n        defaults.update(attrs)\n\n        try:\n            defaults[\"class\"] += \" s3file\"\n        except KeyError:\n            defaults[\"class\"] = \"s3file\"\n        return defaults\n", "code_after": "    def build_attrs(self, *args, **kwargs):\n        attrs = super().build_attrs(*args, **kwargs)\n\n        accept = attrs.get(\"accept\")\n        response = self.client.generate_presigned_post(\n            self.bucket_name,\n            str(pathlib.PurePosixPath(self.upload_folder, \"${filename}\")),\n            Conditions=self.get_conditions(accept),\n            ExpiresIn=self.expires,\n        )\n\n        defaults = {\n            \"data-fields-%s\" % key: value for key, value in response[\"fields\"].items()\n        }\n        defaults[\"data-url\"] = response[\"url\"]\n        signer = signing.Signer(\n            salt=f\"{S3FileInputMixin.__module__}.{S3FileInputMixin.__name__}\"\n        )\n        print(self.upload_folder)\n        defaults[\"data-s3f-signature\"] = signer.signature(self.upload_folder)\n        defaults.update(attrs)\n\n        try:\n            defaults[\"class\"] += \" s3file\"\n        except KeyError:\n            defaults[\"class\"] = \"s3file\"\n        return defaults\n", "commit_message": "Fix CVE-XXXX-XXXX -- Fix Path Traversal security vulnerability", "commit": "https://github.com/codingjoe/django-s3file/commit/68ccd2c621a40eb66fdd6af2be9d5fcc9c373318", "description": "### Impact\n\nIt was possible to traverse the entire AWS S3 bucket and in most cases to access or delete files.\nThe issue was discovered by the maintainer. There were no reports of the vulnerability\nbeing known to or exploited by a third party, before the release of the patch.\n\nIf the `AWS_LOCATION` setting was set, traversal was limited to that location only.\nIf all your files handling views (like form views) require authentication or special permission, the thread is limited to privileged users.\n\n### Patches\n\nThe vulnerability has been fixed in version 5.5.1 and above.\n\n### Workarounds\n\nThere is no feasible workaround. We must urge all users to immediately updated to a patched version.\n\n### Detailed attack vector description\n\nAn attacker may use a request with malicious form data to traverse the entire AWS S3 bucket and perform destructive operations.\n\nAn attack could look as follows:\n```bash\ncurl -X POST -F \"s3file=file\" -F \"file=/priviliged/location/secrets.txt\" https://www.example.com/any/path/will/work/\n```\n\nThis will result in a request with files set and opened:\n\n```python\n>>> request.FILES.getlist(\"file\")\n[File(\"/priviliged/location/secrets.txt\")]\n```\n\nSince this behavior is injected via a middleware, any view can be called this way and will carry any files defined by the attacker.\n\nVia the `s3file` form field, any input name can be specified, including multiple inputs. For each input, multiple files can be freely\npicked of the S3 bucket.\n\n#### Scenarios and their practicality\n\nThere are four scenarios that would be considered practical in most setups:\n\n1. Illegal file injection,\n2. file deletion,\n3. file retrieval & tree traversal.\n4. code injection & remote code execution.\n\n##### File deletion\n\nAn attacker knows the location of a privileged file, like a static asset. Next, the file is injected into a form view. The upload to function will move the file to a new location. This is effectively deleting the file, since the previous references to it are invalid, and will cause S3 to return a 404. Furthermore, the new location is unknown to the site operator.\n\n##### File retrieval & tree traversal\n\nAn attacker knows the URL of a secret file and injects it into a form view. The view will move the file to a public location, making it accessible to the attacker. Since most form views will not be rate limited, this could also be used to guess files and traverse the file tree.\n\n##### Illegal file injection\n\nAn attacker uses any form to upload a file to the temporary upload location. Next, the attacker injects that file into a request, does not validate the contents or is not equipped to handle the mime type. The latter could be used as a potential DOS vector.\n\nIn practice, this is not a practical risk in most hardened setup. Files should always be sanitized before processing, since files can be included in a request even without this security issues.\n\n### For more information\nIf you have any questions or comments about this advisory:\n* Open an issue on [GitHub](https://github.com/codingjoe/django-s3file/issues)\n* Email us at [johannes@maron.family](mailto:johannes@maron.family)\n", "file_change_id": 175378558196896, "report_link": "https://github.com/advisories/GHSA-4w8f-hjm9-xwgf", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"build_attrs\" was changed to address a path traversal security vulnerability. The vulnerability allowed an attacker to traverse the entire AWS S3 bucket and potentially access or delete files.\n\nIn the \"code_after\" section, a new signer object is created and used to generate a signature for the upload folder. This signature is then added to the defaults dictionary under the key \"data-s3f-signature\". This change appears to be a security measure to ensure the integrity of the upload folder path, which could help prevent path traversal attacks.\n\nGiven this, it seems that the function \"build_attrs\" was indeed vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_files_from_storage", "code_before": "    def get_files_from_storage(paths):\n        \"\"\"Return S3 file where the name does not include the path.\"\"\"\n        for path in paths:\n            path = pathlib.PurePosixPath(path)\n            try:\n                location = storage.aws_location\n            except AttributeError:\n                location = storage.location\n            try:\n                f = storage.open(str(path.relative_to(location)))\n                f.name = path.name\n                yield f\n            except (OSError, ValueError):\n                logger.exception(\"File not found: %s\", path)\n", "code_after": "    def get_files_from_storage(paths, signature):\n        \"\"\"Return S3 file where the name does not include the path.\"\"\"\n        try:\n            location = storage.aws_location\n        except AttributeError:\n            location = storage.location\n        signer = signing.Signer(\n            salt=f\"{S3FileInputMixin.__module__}.{S3FileInputMixin.__name__}\"\n        )\n        for path in paths:\n            path = pathlib.PurePosixPath(path)\n            print(path)\n            print(signer.signature(path.parent), signature)\n            if not constant_time_compare(signer.signature(path.parent), signature):\n                raise PermissionDenied(\"Illegal signature!\")\n            try:\n                relative_path = str(path.relative_to(location))\n            except ValueError as e:\n                raise SuspiciousFileOperation(\n                    f\"Path is not inside the designated upload location: {path}\"\n                ) from e\n\n            try:\n                f = storage.open(relative_path)\n                f.name = path.name\n                yield f\n            except (OSError, ValueError):\n                logger.exception(\"File not found: %s\", path)\n", "commit_message": "Fix CVE-XXXX-XXXX -- Fix Path Traversal security vulnerability", "commit": "https://github.com/codingjoe/django-s3file/commit/68ccd2c621a40eb66fdd6af2be9d5fcc9c373318", "description": "### Impact\n\nIt was possible to traverse the entire AWS S3 bucket and in most cases to access or delete files.\nThe issue was discovered by the maintainer. There were no reports of the vulnerability\nbeing known to or exploited by a third party, before the release of the patch.\n\nIf the `AWS_LOCATION` setting was set, traversal was limited to that location only.\nIf all your files handling views (like form views) require authentication or special permission, the thread is limited to privileged users.\n\n### Patches\n\nThe vulnerability has been fixed in version 5.5.1 and above.\n\n### Workarounds\n\nThere is no feasible workaround. We must urge all users to immediately updated to a patched version.\n\n### Detailed attack vector description\n\nAn attacker may use a request with malicious form data to traverse the entire AWS S3 bucket and perform destructive operations.\n\nAn attack could look as follows:\n```bash\ncurl -X POST -F \"s3file=file\" -F \"file=/priviliged/location/secrets.txt\" https://www.example.com/any/path/will/work/\n```\n\nThis will result in a request with files set and opened:\n\n```python\n>>> request.FILES.getlist(\"file\")\n[File(\"/priviliged/location/secrets.txt\")]\n```\n\nSince this behavior is injected via a middleware, any view can be called this way and will carry any files defined by the attacker.\n\nVia the `s3file` form field, any input name can be specified, including multiple inputs. For each input, multiple files can be freely\npicked of the S3 bucket.\n\n#### Scenarios and their practicality\n\nThere are four scenarios that would be considered practical in most setups:\n\n1. Illegal file injection,\n2. file deletion,\n3. file retrieval & tree traversal.\n4. code injection & remote code execution.\n\n##### File deletion\n\nAn attacker knows the location of a privileged file, like a static asset. Next, the file is injected into a form view. The upload to function will move the file to a new location. This is effectively deleting the file, since the previous references to it are invalid, and will cause S3 to return a 404. Furthermore, the new location is unknown to the site operator.\n\n##### File retrieval & tree traversal\n\nAn attacker knows the URL of a secret file and injects it into a form view. The view will move the file to a public location, making it accessible to the attacker. Since most form views will not be rate limited, this could also be used to guess files and traverse the file tree.\n\n##### Illegal file injection\n\nAn attacker uses any form to upload a file to the temporary upload location. Next, the attacker injects that file into a request, does not validate the contents or is not equipped to handle the mime type. The latter could be used as a potential DOS vector.\n\nIn practice, this is not a practical risk in most hardened setup. Files should always be sanitized before processing, since files can be included in a request even without this security issues.\n\n### For more information\nIf you have any questions or comments about this advisory:\n* Open an issue on [GitHub](https://github.com/codingjoe/django-s3file/issues)\n* Email us at [johannes@maron.family](mailto:johannes@maron.family)\n", "file_change_id": 85881485547864, "report_link": "https://github.com/advisories/GHSA-4w8f-hjm9-xwgf", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "__call__", "code_before": "    def __call__(self, request):\n        file_fields = request.POST.getlist(\"s3file\")\n        for field_name in file_fields:\n            paths = request.POST.getlist(field_name)\n            request.FILES.setlist(field_name, list(self.get_files_from_storage(paths)))\n\n        if local_dev and request.path == \"/__s3_mock__/\":\n            return views.S3MockView.as_view()(request)\n\n        return self.get_response(request)\n", "code_after": "    def __call__(self, request):\n        file_fields = request.POST.getlist(\"s3file\")\n        for field_name in file_fields:\n\n            paths = request.POST.getlist(field_name)\n            if paths:\n                try:\n                    signature = request.POST[f\"{field_name}-s3f-signature\"]\n                except KeyError:\n                    raise PermissionDenied(\"No signature provided.\")\n                try:\n                    request.FILES.setlist(\n                        field_name, list(self.get_files_from_storage(paths, signature))\n                    )\n                except SuspiciousFileOperation as e:\n                    raise PermissionDenied(\"Illegal file name!\") from e\n\n        if local_dev and request.path == \"/__s3_mock__/\":\n            return views.S3MockView.as_view()(request)\n\n        return self.get_response(request)\n"}], "gpt_answer": "The provided information indicates that the function \"get_files_from_storage\" has been modified to address a security vulnerability. The vulnerability allowed an attacker to traverse the entire AWS S3 bucket and perform destructive operations. \n\nIn the \"code_after\" section, a new parameter \"signature\" has been added to the function. This signature is used to verify the authenticity of the path from which files are being retrieved. If the signature does not match, a \"PermissionDenied\" exception is raised, preventing unauthorized access. \n\nThis change directly addresses the described vulnerability by adding an additional layer of security to prevent unauthorized file access and modification. Therefore, the function \"get_files_from_storage\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "__call__", "code_before": "    def __call__(self, request):\n        file_fields = request.POST.getlist(\"s3file\")\n        for field_name in file_fields:\n            paths = request.POST.getlist(field_name)\n            request.FILES.setlist(field_name, list(self.get_files_from_storage(paths)))\n\n        if local_dev and request.path == \"/__s3_mock__/\":\n            return views.S3MockView.as_view()(request)\n\n        return self.get_response(request)\n", "code_after": "    def __call__(self, request):\n        file_fields = request.POST.getlist(\"s3file\")\n        for field_name in file_fields:\n\n            paths = request.POST.getlist(field_name)\n            if paths:\n                try:\n                    signature = request.POST[f\"{field_name}-s3f-signature\"]\n                except KeyError:\n                    raise PermissionDenied(\"No signature provided.\")\n                try:\n                    request.FILES.setlist(\n                        field_name, list(self.get_files_from_storage(paths, signature))\n                    )\n                except SuspiciousFileOperation as e:\n                    raise PermissionDenied(\"Illegal file name!\") from e\n\n        if local_dev and request.path == \"/__s3_mock__/\":\n            return views.S3MockView.as_view()(request)\n\n        return self.get_response(request)\n", "commit_message": "Fix CVE-XXXX-XXXX -- Fix Path Traversal security vulnerability", "commit": "https://github.com/codingjoe/django-s3file/commit/68ccd2c621a40eb66fdd6af2be9d5fcc9c373318", "description": "### Impact\n\nIt was possible to traverse the entire AWS S3 bucket and in most cases to access or delete files.\nThe issue was discovered by the maintainer. There were no reports of the vulnerability\nbeing known to or exploited by a third party, before the release of the patch.\n\nIf the `AWS_LOCATION` setting was set, traversal was limited to that location only.\nIf all your files handling views (like form views) require authentication or special permission, the thread is limited to privileged users.\n\n### Patches\n\nThe vulnerability has been fixed in version 5.5.1 and above.\n\n### Workarounds\n\nThere is no feasible workaround. We must urge all users to immediately updated to a patched version.\n\n### Detailed attack vector description\n\nAn attacker may use a request with malicious form data to traverse the entire AWS S3 bucket and perform destructive operations.\n\nAn attack could look as follows:\n```bash\ncurl -X POST -F \"s3file=file\" -F \"file=/priviliged/location/secrets.txt\" https://www.example.com/any/path/will/work/\n```\n\nThis will result in a request with files set and opened:\n\n```python\n>>> request.FILES.getlist(\"file\")\n[File(\"/priviliged/location/secrets.txt\")]\n```\n\nSince this behavior is injected via a middleware, any view can be called this way and will carry any files defined by the attacker.\n\nVia the `s3file` form field, any input name can be specified, including multiple inputs. For each input, multiple files can be freely\npicked of the S3 bucket.\n\n#### Scenarios and their practicality\n\nThere are four scenarios that would be considered practical in most setups:\n\n1. Illegal file injection,\n2. file deletion,\n3. file retrieval & tree traversal.\n4. code injection & remote code execution.\n\n##### File deletion\n\nAn attacker knows the location of a privileged file, like a static asset. Next, the file is injected into a form view. The upload to function will move the file to a new location. This is effectively deleting the file, since the previous references to it are invalid, and will cause S3 to return a 404. Furthermore, the new location is unknown to the site operator.\n\n##### File retrieval & tree traversal\n\nAn attacker knows the URL of a secret file and injects it into a form view. The view will move the file to a public location, making it accessible to the attacker. Since most form views will not be rate limited, this could also be used to guess files and traverse the file tree.\n\n##### Illegal file injection\n\nAn attacker uses any form to upload a file to the temporary upload location. Next, the attacker injects that file into a request, does not validate the contents or is not equipped to handle the mime type. The latter could be used as a potential DOS vector.\n\nIn practice, this is not a practical risk in most hardened setup. Files should always be sanitized before processing, since files can be included in a request even without this security issues.\n\n### For more information\nIf you have any questions or comments about this advisory:\n* Open an issue on [GitHub](https://github.com/codingjoe/django-s3file/issues)\n* Email us at [johannes@maron.family](mailto:johannes@maron.family)\n", "file_change_id": 85881485547864, "report_link": "https://github.com/advisories/GHSA-4w8f-hjm9-xwgf", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "get_files_from_storage", "code_before": "    def get_files_from_storage(paths):\n        \"\"\"Return S3 file where the name does not include the path.\"\"\"\n        for path in paths:\n            path = pathlib.PurePosixPath(path)\n            try:\n                location = storage.aws_location\n            except AttributeError:\n                location = storage.location\n            try:\n                f = storage.open(str(path.relative_to(location)))\n                f.name = path.name\n                yield f\n            except (OSError, ValueError):\n                logger.exception(\"File not found: %s\", path)\n", "code_after": "    def get_files_from_storage(paths, signature):\n        \"\"\"Return S3 file where the name does not include the path.\"\"\"\n        try:\n            location = storage.aws_location\n        except AttributeError:\n            location = storage.location\n        signer = signing.Signer(\n            salt=f\"{S3FileInputMixin.__module__}.{S3FileInputMixin.__name__}\"\n        )\n        for path in paths:\n            path = pathlib.PurePosixPath(path)\n            print(path)\n            print(signer.signature(path.parent), signature)\n            if not constant_time_compare(signer.signature(path.parent), signature):\n                raise PermissionDenied(\"Illegal signature!\")\n            try:\n                relative_path = str(path.relative_to(location))\n            except ValueError as e:\n                raise SuspiciousFileOperation(\n                    f\"Path is not inside the designated upload location: {path}\"\n                ) from e\n\n            try:\n                f = storage.open(relative_path)\n                f.name = path.name\n                yield f\n            except (OSError, ValueError):\n                logger.exception(\"File not found: %s\", path)\n"}], "gpt_answer": "The provided information indicates that the vulnerability allowed an attacker to traverse the entire AWS S3 bucket and perform destructive operations. The vulnerability was fixed by adding a signature check to the paths provided in the POST request. If the signature does not match or is not provided, a PermissionDenied exception is raised.\n\nThe \"__call__\" function was changed to include this signature check. Before the change, the function would get files from storage based on the paths provided in the POST request without any checks. After the change, the function checks for a signature associated with each path and passes it to the \"get_files_from_storage\" function, which has also been changed to include a signature check.\n\nTherefore, the \"__call__\" function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "uploadFiles", "code_before": "  function uploadFiles (form, fileInput, name) {\n    var url = fileInput.getAttribute('data-url')\n    fileInput.loaded = 0\n    fileInput.total = 0\n    var promises = Array.from(fileInput.files).map(function (file) {\n      form.total += file.size\n      fileInput.total += file.size\n      var s3Form = new window.FormData()\n      Array.from(fileInput.attributes).forEach(function (attr) {\n        var name = attr.name\n\n        if (name.startsWith('data-fields')) {\n          name = name.replace('data-fields-', '')\n          s3Form.append(name, attr.value)\n        }\n      })\n      s3Form.append('success_action_status', '201')\n      s3Form.append('Content-Type', file.type)\n      s3Form.append('file', file)\n      return request('POST', url, s3Form, fileInput, file, form)\n    })\n    Promise.all(promises).then(function (results) {\n      results.forEach(function (result) {\n        var hiddenFileInput = document.createElement('input')\n        hiddenFileInput.type = 'hidden'\n        hiddenFileInput.name = name\n        hiddenFileInput.value = parseURL(result)\n        form.appendChild(hiddenFileInput)\n      })\n      fileInput.name = ''\n      window.uploading -= 1\n    }, function (err) {\n      console.log(err)\n      fileInput.setCustomValidity(err)\n      fileInput.reportValidity()\n    })\n  }\n", "code_after": "  function uploadFiles (form, fileInput, name) {\n    var url = fileInput.getAttribute('data-url')\n    fileInput.loaded = 0\n    fileInput.total = 0\n    var promises = Array.from(fileInput.files).map(function (file) {\n      form.total += file.size\n      fileInput.total += file.size\n      var s3Form = new window.FormData()\n      Array.from(fileInput.attributes).forEach(function (attr) {\n        var name = attr.name\n\n        if (name.startsWith('data-fields')) {\n          name = name.replace('data-fields-', '')\n          s3Form.append(name, attr.value)\n        }\n      })\n      s3Form.append('success_action_status', '201')\n      s3Form.append('Content-Type', file.type)\n      s3Form.append('file', file)\n      return request('POST', url, s3Form, fileInput, file, form)\n    })\n    Promise.all(promises).then(function (results) {\n      results.forEach(function (result) {\n        var hiddenFileInput = document.createElement('input')\n        hiddenFileInput.type = 'hidden'\n        hiddenFileInput.name = name\n        hiddenFileInput.value = parseURL(result)\n        form.appendChild(hiddenFileInput)\n        var hiddenSignatureInput = document.createElement('input')\n        hiddenSignatureInput.type = 'hidden'\n        hiddenSignatureInput.name = name + '-s3f-signature'\n        console.log(fileInput.dataset.s3fSignature)\n        hiddenSignatureInput.value = fileInput.dataset.s3fSignature\n        form.appendChild(hiddenSignatureInput)\n      })\n      fileInput.name = ''\n      window.uploading -= 1\n    }, function (err) {\n      console.log(err)\n      fileInput.setCustomValidity(err)\n      fileInput.reportValidity()\n    })\n  }\n", "commit_message": "Fix CVE-XXXX-XXXX -- Fix Path Traversal security vulnerability", "commit": "https://github.com/codingjoe/django-s3file/commit/68ccd2c621a40eb66fdd6af2be9d5fcc9c373318", "description": "### Impact\n\nIt was possible to traverse the entire AWS S3 bucket and in most cases to access or delete files.\nThe issue was discovered by the maintainer. There were no reports of the vulnerability\nbeing known to or exploited by a third party, before the release of the patch.\n\nIf the `AWS_LOCATION` setting was set, traversal was limited to that location only.\nIf all your files handling views (like form views) require authentication or special permission, the thread is limited to privileged users.\n\n### Patches\n\nThe vulnerability has been fixed in version 5.5.1 and above.\n\n### Workarounds\n\nThere is no feasible workaround. We must urge all users to immediately updated to a patched version.\n\n### Detailed attack vector description\n\nAn attacker may use a request with malicious form data to traverse the entire AWS S3 bucket and perform destructive operations.\n\nAn attack could look as follows:\n```bash\ncurl -X POST -F \"s3file=file\" -F \"file=/priviliged/location/secrets.txt\" https://www.example.com/any/path/will/work/\n```\n\nThis will result in a request with files set and opened:\n\n```python\n>>> request.FILES.getlist(\"file\")\n[File(\"/priviliged/location/secrets.txt\")]\n```\n\nSince this behavior is injected via a middleware, any view can be called this way and will carry any files defined by the attacker.\n\nVia the `s3file` form field, any input name can be specified, including multiple inputs. For each input, multiple files can be freely\npicked of the S3 bucket.\n\n#### Scenarios and their practicality\n\nThere are four scenarios that would be considered practical in most setups:\n\n1. Illegal file injection,\n2. file deletion,\n3. file retrieval & tree traversal.\n4. code injection & remote code execution.\n\n##### File deletion\n\nAn attacker knows the location of a privileged file, like a static asset. Next, the file is injected into a form view. The upload to function will move the file to a new location. This is effectively deleting the file, since the previous references to it are invalid, and will cause S3 to return a 404. Furthermore, the new location is unknown to the site operator.\n\n##### File retrieval & tree traversal\n\nAn attacker knows the URL of a secret file and injects it into a form view. The view will move the file to a public location, making it accessible to the attacker. Since most form views will not be rate limited, this could also be used to guess files and traverse the file tree.\n\n##### Illegal file injection\n\nAn attacker uses any form to upload a file to the temporary upload location. Next, the attacker injects that file into a request, does not validate the contents or is not equipped to handle the mime type. The latter could be used as a potential DOS vector.\n\nIn practice, this is not a practical risk in most hardened setup. Files should always be sanitized before processing, since files can be included in a request even without this security issues.\n\n### For more information\nIf you have any questions or comments about this advisory:\n* Open an issue on [GitHub](https://github.com/codingjoe/django-s3file/issues)\n* Email us at [johannes@maron.family](mailto:johannes@maron.family)\n", "file_change_id": 154305567180155, "report_link": "https://github.com/advisories/GHSA-4w8f-hjm9-xwgf", "programming_language": "JavaScript", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `uploadFiles` has been modified to address a security vulnerability related to path traversal in the AWS S3 bucket. The vulnerability allowed an attacker to traverse the entire AWS S3 bucket and potentially access or delete files.\n\nThe change in the `uploadFiles` function includes the addition of a hidden input field named `name + '-s3f-signature'` which is appended to the form. This input field is assigned a value from `fileInput.dataset.s3fSignature`. This change seems to be a part of the fix for the vulnerability, as it introduces a signature mechanism that could be used to verify the authenticity of the files and prevent unauthorized access or modifications.\n\nTherefore, it can be concluded that the `uploadFiles` function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "add", "code_before": "    def add(self, req=None):\n        \"\"\"\n        File upload functionality\n        \"\"\"\n        if not self.validate_request('upload'):\n            return self.ERROR_NOT_ALLOWED\n\n        the_dir = self.dir if self.dir is not None else ''\n        err_msg = ''\n        code = 1\n        try:\n            path = req.form.get('currentpath')\n\n            file_obj = req.files['newfile']\n            file_name = file_obj.filename\n            orig_path = \"{0}{1}\".format(the_dir, path)\n            new_name = \"{0}{1}\".format(orig_path, file_name)\n\n            try:\n                # Check if the new file is inside the users directory\n                if config.SERVER_MODE:\n                    pathlib.Path(new_name).relative_to(the_dir)\n            except ValueError:\n                return self.ERROR_NOT_ALLOWED\n\n            with open(new_name, 'wb') as f:\n                while True:\n                    # 4MB chunk (4 * 1024 * 1024 Bytes)\n                    data = file_obj.read(4194304)\n                    if not data:\n                        break\n                    f.write(data)\n        except Exception as e:\n            code = 0\n            err_msg = str(e.strerror) if hasattr(e, 'strerror') else str(e)\n\n        try:\n            Filemanager.check_access_permission(the_dir, path)\n        except Exception as e:\n            res = {\n                'Error': str(e),\n                'Code': 0\n            }\n            return res\n\n        result = {\n            'Path': path,\n            'Name': new_name,\n            'Error': err_msg,\n            'Code': code\n        }\n        return result\n", "code_after": "    def add(self, req=None):\n        \"\"\"\n        File upload functionality\n        \"\"\"\n        if not self.validate_request('upload'):\n            return self.ERROR_NOT_ALLOWED\n\n        the_dir = self.dir if self.dir is not None else ''\n        err_msg = ''\n        code = 1\n        try:\n            path = req.form.get('currentpath')\n\n            file_obj = req.files['newfile']\n            file_name = file_obj.filename\n            orig_path = \"{0}{1}\".format(the_dir, path)\n            new_name = \"{0}{1}\".format(orig_path, file_name)\n\n            try:\n                # Check if the new file is inside the users directory\n                if config.SERVER_MODE:\n                    pathlib.Path(\n                        os.path.abspath(\n                            os.path.join(the_dir, new_name)\n                        )\n                    ).relative_to(the_dir)\n            except ValueError:\n                return self.ERROR_NOT_ALLOWED\n\n            with open(new_name, 'wb') as f:\n                while True:\n                    # 4MB chunk (4 * 1024 * 1024 Bytes)\n                    data = file_obj.read(4194304)\n                    if not data:\n                        break\n                    f.write(data)\n        except Exception as e:\n            code = 0\n            err_msg = str(e.strerror) if hasattr(e, 'strerror') else str(e)\n\n        try:\n            Filemanager.check_access_permission(the_dir, path)\n        except Exception as e:\n            res = {\n                'Error': str(e),\n                'Code': 0\n            }\n            return res\n\n        result = {\n            'Path': path,\n            'Name': new_name,\n            'Error': err_msg,\n            'Code': code\n        }\n        return result\n", "commit_message": "Ensure that upload paths are children of the storage directory. Fixes #7233", "commit": "https://github.com/pgadmin-org/pgadmin4/commit/dccd4f0bbaafa783d9f0360c7592b128d5cc3928", "description": "When run in server mode, pgAdmin 4 allows users to store files on the server under individual storage directories. Files such as SQL scripts may be uploaded through the user interface. The URI to which upload requests are made fails to validate the upload path to prevent path traversal techniques being used to store files outside of the storage directory. A malicious, but authorised and authenticated user can construct an HTTP request using their existing CSRF token and session cookie to manually upload files to any location that the operating system user account under which pgAdmin is running has permission to write.", "file_change_id": 160084089323997, "report_link": "https://github.com/advisories/GHSA-cr8c-972v-rmp3", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the \"add\" function is being modified to address a security vulnerability. The vulnerability description states that the system previously failed to validate the upload path to prevent path traversal techniques from being used to store files outside of the storage directory. \n\nIn the \"add\" function, the change is specifically in the section that checks if the new file is inside the user's directory. The updated code uses `os.path.abspath` and `os.path.join` to ensure that the new file path is an absolute path and is indeed within the user's directory. This change directly addresses the path traversal vulnerability.\n\nTherefore, the \"add\" function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "file", "code_before": "def file(path):\n    path = secure_filename(path)\n    if app.interface.encrypt and isinstance(app.interface.examples, str) and path.startswith(app.interface.examples):\n        with open(os.path.join(app.cwd, path), \"rb\") as encrypted_file:\n            encrypted_data = encrypted_file.read()\n        file_data = encryptor.decrypt(\n            app.interface.encryption_key, encrypted_data)\n        return send_file(io.BytesIO(file_data), attachment_filename=os.path.basename(path))\n    else:\n        return send_file(os.path.join(app.cwd, path))\n", "code_after": "def file(path):\n    if app.interface.encrypt and isinstance(app.interface.examples, str) and path.startswith(app.interface.examples):\n        with open(safe_join(app.cwd, path), \"rb\") as encrypted_file:\n            encrypted_data = encrypted_file.read()\n        file_data = encryptor.decrypt(\n            app.interface.encryption_key, encrypted_data)\n        return send_file(io.BytesIO(file_data), attachment_filename=os.path.basename(path))\n    else:\n        return send_file(safe_join(app.cwd, path))\n", "commit_message": "secure path hotfix", "commit": "https://github.com/gradio-app/gradio/commit/41bd3645bdb616e1248b2167ca83636a2653f781", "description": "### Impact\nThis is a vulnerability that affects anyone who creates and publicly shares Gradio interfaces using `gradio<2.4.8`. Because of the way that static files were being served, someone who generated a public Gradio link and shared it with others would potentially be exposing the files on the computer that generated the link, while the link was active. An attacker would be able to view the contents of a file on the computer if they knew the exact relative filepath. We do not have any evidence that this was ever exploited, but we treated the issue seriously and immediately took steps to mitigate it (see below)\n\n### Response\n1. We worked with @haby0 to immediately patch the issue and released a new version, `gradio 2.5.0`, within 24 hours of the issue being brought to our attention \n2. We enabled a notification that is printed to anyone using an older version of gradio telling them to upgrade (see screenshot below)\n3. We expanded our test suite to test for this vulnerability ensuring that our patch does not get reverted in future releases of `gradio`\n\n![image](https://user-images.githubusercontent.com/1778297/146251425-f36b519b-6d4a-4dfb-8d89-c1ed005979d3.png)\n\n### Patches\nThe problem has been patched in `gradio>=2.5.0`.\n", "file_change_id": 62290532068922, "report_link": "https://github.com/advisories/GHSA-rhq2-3vr9-6mcr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"file\" was changed to address a security vulnerability. The vulnerability allowed an attacker to view the contents of a file on the computer if they knew the exact relative filepath. \n\nThe change in the function is from using `os.path.join(app.cwd, path)` to `safe_join(app.cwd, path)`. The `safe_join` function is typically used to securely join paths, ensuring that the joined path does not escape the intended root directory. This change is directly related to the described vulnerability, as it prevents directory traversal attacks where an attacker could potentially access sensitive files outside of the intended directory.\n\nTherefore, the function \"file\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "save", "code_before": "    def save(self, name, content, max_length=None):\n        \"\"\"\n        Save new content to the file specified by name. The content should be\n        a proper File object or any Python file-like object, ready to be read\n        from the beginning.\n        \"\"\"\n        # Get the proper name for the file, as it will actually be saved.\n        if name is None:\n            name = content.name\n\n        if not hasattr(content, 'chunks'):\n            content = File(content, name)\n\n        name = self.get_available_name(name, max_length=max_length)\n        return self._save(name, content)\n", "code_after": "    def save(self, name, content, max_length=None):\n        \"\"\"\n        Save new content to the file specified by name. The content should be\n        a proper File object or any Python file-like object, ready to be read\n        from the beginning.\n        \"\"\"\n        # Get the proper name for the file, as it will actually be saved.\n        if name is None:\n            name = content.name\n\n        if not hasattr(content, 'chunks'):\n            content = File(content, name)\n\n        name = self.get_available_name(name, max_length=max_length)\n        name = self._save(name, content)\n        # Ensure that the name returned from the storage system is still valid.\n        validate_file_name(name, allow_relative_path=True)\n        return name\n", "commit_message": "[2.2.x] Fixed CVE-2021-45452 -- Fixed potential path traversal in storage subsystem.\n\nThanks to Dennis Brinkrolf for the report.", "commit": "https://github.com/django/django/commit/4cb35b384ceef52123fc66411a73c36a706825e1", "description": "Storage.save in Django 2.2 before 2.2.26, 3.2 before 3.2.11, and 4.0 before 4.0.1 allows directory traversal if crafted filenames are directly passed to it.", "file_change_id": 210847047502966, "report_link": "https://github.com/advisories/GHSA-jrh2-hc4r-7jwx", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "generate_filename", "code_before": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        if '..' in pathlib.PurePath(dirname).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dirname)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n", "code_after": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        filename = str(filename).replace('\\\\', '/')\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        if '..' in pathlib.PurePath(dirname).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dirname)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n"}, {"function_name": "_save", "code_before": "    def _save(self, name, content):\n        full_path = self.path(name)\n\n        # Create any intermediate directories that do not exist.\n        directory = os.path.dirname(full_path)\n        if not os.path.exists(directory):\n            try:\n                if self.directory_permissions_mode is not None:\n                    # Set the umask because os.makedirs() doesn't apply the \"mode\"\n                    # argument to intermediate-level directories.\n                    old_umask = os.umask(0o777 & ~self.directory_permissions_mode)\n                    try:\n                        os.makedirs(directory, self.directory_permissions_mode)\n                    finally:\n                        os.umask(old_umask)\n                else:\n                    os.makedirs(directory)\n            except FileExistsError:\n                # There's a race between os.path.exists() and os.makedirs().\n                # If os.makedirs() fails with FileExistsError, the directory\n                # was created concurrently.\n                pass\n        if not os.path.isdir(directory):\n            raise IOError(\"%s exists and is not a directory.\" % directory)\n\n        # There's a potential race condition between get_available_name and\n        # saving the file; it's possible that two threads might return the\n        # same name, at which point all sorts of fun happens. So we need to\n        # try to create the file, but if it already exists we have to go back\n        # to get_available_name() and try again.\n\n        while True:\n            try:\n                # This file has a file path that we can move.\n                if hasattr(content, 'temporary_file_path'):\n                    file_move_safe(content.temporary_file_path(), full_path)\n\n                # This is a normal uploadedfile that we can stream.\n                else:\n                    # The current umask value is masked out by os.open!\n                    fd = os.open(full_path, self.OS_OPEN_FLAGS, 0o666)\n                    _file = None\n                    try:\n                        locks.lock(fd, locks.LOCK_EX)\n                        for chunk in content.chunks():\n                            if _file is None:\n                                mode = 'wb' if isinstance(chunk, bytes) else 'wt'\n                                _file = os.fdopen(fd, mode)\n                            _file.write(chunk)\n                    finally:\n                        locks.unlock(fd)\n                        if _file is not None:\n                            _file.close()\n                        else:\n                            os.close(fd)\n            except FileExistsError:\n                # A new name is needed if the file exists.\n                name = self.get_available_name(name)\n                full_path = self.path(name)\n            else:\n                # OK, the file save worked. Break out of the loop.\n                break\n\n        if self.file_permissions_mode is not None:\n            os.chmod(full_path, self.file_permissions_mode)\n\n        # Store filenames with forward slashes, even on Windows.\n        return name.replace('\\\\', '/')\n", "code_after": "    def _save(self, name, content):\n        full_path = self.path(name)\n\n        # Create any intermediate directories that do not exist.\n        directory = os.path.dirname(full_path)\n        if not os.path.exists(directory):\n            try:\n                if self.directory_permissions_mode is not None:\n                    # Set the umask because os.makedirs() doesn't apply the \"mode\"\n                    # argument to intermediate-level directories.\n                    old_umask = os.umask(0o777 & ~self.directory_permissions_mode)\n                    try:\n                        os.makedirs(directory, self.directory_permissions_mode)\n                    finally:\n                        os.umask(old_umask)\n                else:\n                    os.makedirs(directory)\n            except FileExistsError:\n                # There's a race between os.path.exists() and os.makedirs().\n                # If os.makedirs() fails with FileExistsError, the directory\n                # was created concurrently.\n                pass\n        if not os.path.isdir(directory):\n            raise IOError(\"%s exists and is not a directory.\" % directory)\n\n        # There's a potential race condition between get_available_name and\n        # saving the file; it's possible that two threads might return the\n        # same name, at which point all sorts of fun happens. So we need to\n        # try to create the file, but if it already exists we have to go back\n        # to get_available_name() and try again.\n\n        while True:\n            try:\n                # This file has a file path that we can move.\n                if hasattr(content, 'temporary_file_path'):\n                    file_move_safe(content.temporary_file_path(), full_path)\n\n                # This is a normal uploadedfile that we can stream.\n                else:\n                    # The current umask value is masked out by os.open!\n                    fd = os.open(full_path, self.OS_OPEN_FLAGS, 0o666)\n                    _file = None\n                    try:\n                        locks.lock(fd, locks.LOCK_EX)\n                        for chunk in content.chunks():\n                            if _file is None:\n                                mode = 'wb' if isinstance(chunk, bytes) else 'wt'\n                                _file = os.fdopen(fd, mode)\n                            _file.write(chunk)\n                    finally:\n                        locks.unlock(fd)\n                        if _file is not None:\n                            _file.close()\n                        else:\n                            os.close(fd)\n            except FileExistsError:\n                # A new name is needed if the file exists.\n                name = self.get_available_name(name)\n                full_path = self.path(name)\n            else:\n                # OK, the file save worked. Break out of the loop.\n                break\n\n        if self.file_permissions_mode is not None:\n            os.chmod(full_path, self.file_permissions_mode)\n\n        # Ensure the saved path is always relative to the storage root.\n        name = os.path.relpath(full_path, self.location)\n        # Store filenames with forward slashes, even on Windows.\n        return name.replace('\\\\', '/')\n"}, {"function_name": "get_available_name", "code_before": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        dir_name, file_name = os.path.split(name)\n        if '..' in pathlib.PurePath(dir_name).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dir_name)\n        validate_file_name(file_name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, add an underscore and a random 7\n        # character alphanumeric string (before the file extension, if one\n        # exists) to the filename until the generated filename doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n        return name\n", "code_after": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        name = str(name).replace('\\\\', '/')\n        dir_name, file_name = os.path.split(name)\n        if '..' in pathlib.PurePath(dir_name).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dir_name)\n        validate_file_name(file_name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, add an underscore and a random 7\n        # character alphanumeric string (before the file extension, if one\n        # exists) to the filename until the generated filename doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n        return name\n"}], "gpt_answer": "The vulnerability described in the advisory is related to directory traversal if crafted filenames are directly passed to the `Storage.save` function. The change in the `save` function is the addition of a call to `validate_file_name(name, allow_relative_path=True)`, which is likely a function that checks the validity of the filename and prevents directory traversal.\n\nThe change in the `save` function is directly related to the vulnerability, as it adds a validation step to prevent the exploitation of the vulnerability. Therefore, the `save` function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "generate_filename", "code_before": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        if '..' in pathlib.PurePath(dirname).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dirname)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n", "code_after": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        filename = str(filename).replace('\\\\', '/')\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        if '..' in pathlib.PurePath(dirname).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dirname)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n", "commit_message": "[2.2.x] Fixed CVE-2021-45452 -- Fixed potential path traversal in storage subsystem.\n\nThanks to Dennis Brinkrolf for the report.", "commit": "https://github.com/django/django/commit/4cb35b384ceef52123fc66411a73c36a706825e1", "description": "Storage.save in Django 2.2 before 2.2.26, 3.2 before 3.2.11, and 4.0 before 4.0.1 allows directory traversal if crafted filenames are directly passed to it.", "file_change_id": 210847047502966, "report_link": "https://github.com/advisories/GHSA-jrh2-hc4r-7jwx", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "save", "code_before": "    def save(self, name, content, max_length=None):\n        \"\"\"\n        Save new content to the file specified by name. The content should be\n        a proper File object or any Python file-like object, ready to be read\n        from the beginning.\n        \"\"\"\n        # Get the proper name for the file, as it will actually be saved.\n        if name is None:\n            name = content.name\n\n        if not hasattr(content, 'chunks'):\n            content = File(content, name)\n\n        name = self.get_available_name(name, max_length=max_length)\n        return self._save(name, content)\n", "code_after": "    def save(self, name, content, max_length=None):\n        \"\"\"\n        Save new content to the file specified by name. The content should be\n        a proper File object or any Python file-like object, ready to be read\n        from the beginning.\n        \"\"\"\n        # Get the proper name for the file, as it will actually be saved.\n        if name is None:\n            name = content.name\n\n        if not hasattr(content, 'chunks'):\n            content = File(content, name)\n\n        name = self.get_available_name(name, max_length=max_length)\n        name = self._save(name, content)\n        # Ensure that the name returned from the storage system is still valid.\n        validate_file_name(name, allow_relative_path=True)\n        return name\n"}, {"function_name": "_save", "code_before": "    def _save(self, name, content):\n        full_path = self.path(name)\n\n        # Create any intermediate directories that do not exist.\n        directory = os.path.dirname(full_path)\n        if not os.path.exists(directory):\n            try:\n                if self.directory_permissions_mode is not None:\n                    # Set the umask because os.makedirs() doesn't apply the \"mode\"\n                    # argument to intermediate-level directories.\n                    old_umask = os.umask(0o777 & ~self.directory_permissions_mode)\n                    try:\n                        os.makedirs(directory, self.directory_permissions_mode)\n                    finally:\n                        os.umask(old_umask)\n                else:\n                    os.makedirs(directory)\n            except FileExistsError:\n                # There's a race between os.path.exists() and os.makedirs().\n                # If os.makedirs() fails with FileExistsError, the directory\n                # was created concurrently.\n                pass\n        if not os.path.isdir(directory):\n            raise IOError(\"%s exists and is not a directory.\" % directory)\n\n        # There's a potential race condition between get_available_name and\n        # saving the file; it's possible that two threads might return the\n        # same name, at which point all sorts of fun happens. So we need to\n        # try to create the file, but if it already exists we have to go back\n        # to get_available_name() and try again.\n\n        while True:\n            try:\n                # This file has a file path that we can move.\n                if hasattr(content, 'temporary_file_path'):\n                    file_move_safe(content.temporary_file_path(), full_path)\n\n                # This is a normal uploadedfile that we can stream.\n                else:\n                    # The current umask value is masked out by os.open!\n                    fd = os.open(full_path, self.OS_OPEN_FLAGS, 0o666)\n                    _file = None\n                    try:\n                        locks.lock(fd, locks.LOCK_EX)\n                        for chunk in content.chunks():\n                            if _file is None:\n                                mode = 'wb' if isinstance(chunk, bytes) else 'wt'\n                                _file = os.fdopen(fd, mode)\n                            _file.write(chunk)\n                    finally:\n                        locks.unlock(fd)\n                        if _file is not None:\n                            _file.close()\n                        else:\n                            os.close(fd)\n            except FileExistsError:\n                # A new name is needed if the file exists.\n                name = self.get_available_name(name)\n                full_path = self.path(name)\n            else:\n                # OK, the file save worked. Break out of the loop.\n                break\n\n        if self.file_permissions_mode is not None:\n            os.chmod(full_path, self.file_permissions_mode)\n\n        # Store filenames with forward slashes, even on Windows.\n        return name.replace('\\\\', '/')\n", "code_after": "    def _save(self, name, content):\n        full_path = self.path(name)\n\n        # Create any intermediate directories that do not exist.\n        directory = os.path.dirname(full_path)\n        if not os.path.exists(directory):\n            try:\n                if self.directory_permissions_mode is not None:\n                    # Set the umask because os.makedirs() doesn't apply the \"mode\"\n                    # argument to intermediate-level directories.\n                    old_umask = os.umask(0o777 & ~self.directory_permissions_mode)\n                    try:\n                        os.makedirs(directory, self.directory_permissions_mode)\n                    finally:\n                        os.umask(old_umask)\n                else:\n                    os.makedirs(directory)\n            except FileExistsError:\n                # There's a race between os.path.exists() and os.makedirs().\n                # If os.makedirs() fails with FileExistsError, the directory\n                # was created concurrently.\n                pass\n        if not os.path.isdir(directory):\n            raise IOError(\"%s exists and is not a directory.\" % directory)\n\n        # There's a potential race condition between get_available_name and\n        # saving the file; it's possible that two threads might return the\n        # same name, at which point all sorts of fun happens. So we need to\n        # try to create the file, but if it already exists we have to go back\n        # to get_available_name() and try again.\n\n        while True:\n            try:\n                # This file has a file path that we can move.\n                if hasattr(content, 'temporary_file_path'):\n                    file_move_safe(content.temporary_file_path(), full_path)\n\n                # This is a normal uploadedfile that we can stream.\n                else:\n                    # The current umask value is masked out by os.open!\n                    fd = os.open(full_path, self.OS_OPEN_FLAGS, 0o666)\n                    _file = None\n                    try:\n                        locks.lock(fd, locks.LOCK_EX)\n                        for chunk in content.chunks():\n                            if _file is None:\n                                mode = 'wb' if isinstance(chunk, bytes) else 'wt'\n                                _file = os.fdopen(fd, mode)\n                            _file.write(chunk)\n                    finally:\n                        locks.unlock(fd)\n                        if _file is not None:\n                            _file.close()\n                        else:\n                            os.close(fd)\n            except FileExistsError:\n                # A new name is needed if the file exists.\n                name = self.get_available_name(name)\n                full_path = self.path(name)\n            else:\n                # OK, the file save worked. Break out of the loop.\n                break\n\n        if self.file_permissions_mode is not None:\n            os.chmod(full_path, self.file_permissions_mode)\n\n        # Ensure the saved path is always relative to the storage root.\n        name = os.path.relpath(full_path, self.location)\n        # Store filenames with forward slashes, even on Windows.\n        return name.replace('\\\\', '/')\n"}, {"function_name": "get_available_name", "code_before": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        dir_name, file_name = os.path.split(name)\n        if '..' in pathlib.PurePath(dir_name).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dir_name)\n        validate_file_name(file_name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, add an underscore and a random 7\n        # character alphanumeric string (before the file extension, if one\n        # exists) to the filename until the generated filename doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n        return name\n", "code_after": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        name = str(name).replace('\\\\', '/')\n        dir_name, file_name = os.path.split(name)\n        if '..' in pathlib.PurePath(dir_name).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dir_name)\n        validate_file_name(file_name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, add an underscore and a random 7\n        # character alphanumeric string (before the file extension, if one\n        # exists) to the filename until the generated filename doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n        return name\n"}], "gpt_answer": "The function \"generate_filename\" is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability description mentions that \"Storage.save in Django 2.2 before 2.2.26, 3.2 before 3.2.11, and 4.0 before 4.0.1 allows directory traversal if crafted filenames are directly passed to it.\" \n\nThe function \"generate_filename\" is responsible for validating the filename and returning a filename to be passed to the save() method. The change in the function is to replace backslashes with forward slashes in the filename before it is processed further. This change is directly related to the vulnerability as it helps to prevent directory traversal attacks by normalizing the filename.\n\nTherefore, the function \"generate_filename\" is vulnerable and the changes made to it are relevant to the vulnerability that the commit is trying to fix.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "__init__", "code_before": "    def __init__(\n        self,\n        inputFilename,\n        debug=False,\n        token=None,\n        lineNumbers=False,\n        fileRequester=None,\n        testing=False,\n    ):\n        self.valid = False\n        self.lineNumbers = lineNumbers\n        if lineNumbers:\n            # line-numbers are too hacky, so force this to be a dry run\n            constants.dryRun = True\n        if inputFilename is None:\n            inputFilename = findImplicitInputFile()\n        if inputFilename is None:  # still\n            die(\n                \"No input file specified, and no *.bs or *.src.html files found in current directory.\\nPlease specify an input file, or use - to pipe from STDIN.\"\n            )\n            return\n        self.inputSource = InputSource(inputFilename)\n        self.transitiveDependencies = set()\n        self.debug = debug\n        self.token = token\n        self.testing = testing\n        if fileRequester is None:\n            self.dataFile = config.defaultRequester\n        else:\n            self.dataFile = fileRequester\n\n        self.md = None\n        self.mdBaseline = None\n        self.mdDocument = None\n        self.mdCommandLine = None\n        self.mdDefaults = None\n        self.mdOverridingDefaults = None\n        self.lines = []\n        self.document = None\n        self.html = None\n        self.head = None\n        self.body = None\n        self.fillContainers = None\n        self.valid = self.initializeState()\n", "code_after": "    def __init__(\n        self,\n        inputFilename,\n        debug=False,\n        token=None,\n        lineNumbers=False,\n        fileRequester=None,\n        testing=False,\n    ):\n        self.valid = False\n        self.lineNumbers = lineNumbers\n        if lineNumbers:\n            # line-numbers are too hacky, so force this to be a dry run\n            constants.dryRun = True\n        if inputFilename is None:\n            inputFilename = findImplicitInputFile()\n        if inputFilename is None:  # still\n            die(\n                \"No input file specified, and no *.bs or *.src.html files found in current directory.\\nPlease specify an input file, or use - to pipe from STDIN.\"\n            )\n            return\n        self.inputSource = InputSource(inputFilename, chroot=constants.chroot)\n        self.transitiveDependencies = set()\n        self.debug = debug\n        self.token = token\n        self.testing = testing\n        if fileRequester is None:\n            self.dataFile = config.defaultRequester\n        else:\n            self.dataFile = fileRequester\n\n        self.md = None\n        self.mdBaseline = None\n        self.mdDocument = None\n        self.mdCommandLine = None\n        self.mdDefaults = None\n        self.mdOverridingDefaults = None\n        self.lines = []\n        self.document = None\n        self.html = None\n        self.head = None\n        self.body = None\n        self.fillContainers = None\n        self.valid = self.initializeState()\n", "commit_message": "Prevent escaping the source doc's folder, or running arbitrary code, without explicit opt-in at the command-line.", "commit": "https://github.com/tabatkins/bikeshed/commit/b2f668fca204260b1cad28d5078e93471cb6b2dd", "description": "This affects the package bikeshed before 3.0.0. This can occur when an untrusted source file containing Inline Tag Command metadata is processed. When an arbitrary OS command is executed, the command output would be included in the HTML output.", "file_change_id": 194620166583877, "report_link": "https://github.com/advisories/GHSA-87cj-px37-rc3x", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the vulnerability in the package \"bikeshed\" before version 3.0.0 allows for the execution of arbitrary OS commands when processing untrusted source files containing Inline Tag Command metadata. The output of these commands would then be included in the HTML output.\n\nLooking at the changes in the \"__init__\" function, the only difference is the addition of the \"chroot=constants.chroot\" argument in the instantiation of the \"InputSource\" object. This change seems to be a security measure to restrict the process's access to the file system, which is a common way to prevent arbitrary command execution vulnerabilities.\n\nGiven the nature of the vulnerability and the change made, it seems that the \"__init__\" function was indeed vulnerable and has been changed to fix the vulnerability. Therefore, the answer is 1.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "retrieveBoilerplateFile", "code_before": "def retrieveBoilerplateFile(doc, name, group=None, status=None, error=True):\n    # Looks in three or four locations, in order:\n    # the folder the spec source is in, the group's boilerplate folder, the megagroup's boilerplate folder, and the generic boilerplate folder.\n    # In each location, it first looks for the file specialized on status, and then for the generic file.\n    # Filenames must be of the format NAME.include or NAME-STATUS.include\n    if group is None and doc.md.group is not None:\n        group = doc.md.group.lower()\n    if status is None:\n        if doc.md.status is not None:\n            status = doc.md.status\n        elif doc.md.rawStatus is not None:\n            status = doc.md.rawStatus\n    megaGroup, status = splitStatus(status)\n\n    searchLocally = doc.md.localBoilerplate[name]\n\n    def boilerplatePath(*segs):\n        return scriptPath(\"boilerplate\", *segs)\n\n    statusFile = f\"{name}-{status}.include\"\n    genericFile = f\"{name}.include\"\n    sources = []\n    if searchLocally:\n        sources.append(doc.inputSource.relative(statusFile))  # Can be None.\n        sources.append(doc.inputSource.relative(genericFile))\n    else:\n        for f in (statusFile, genericFile):\n            if doc.inputSource.cheaplyExists(f):\n                warn(\n                    (\n                        \"Found {0} next to the specification without a matching\\n\"\n                        + \"Local Boilerplate: {1} yes\\n\"\n                        + \"in the metadata. This include won't be found when building via a URL.\"\n                    ).format(f, name)\n                )\n                # We should remove this after giving specs time to react to the warning:\n                sources.append(doc.inputSource.relative(f))\n    if group:\n        sources.append(InputSource(boilerplatePath(group, statusFile)))\n        sources.append(InputSource(boilerplatePath(group, genericFile)))\n    if megaGroup:\n        sources.append(InputSource(boilerplatePath(megaGroup, statusFile)))\n        sources.append(InputSource(boilerplatePath(megaGroup, genericFile)))\n    sources.append(InputSource(boilerplatePath(statusFile)))\n    sources.append(InputSource(boilerplatePath(genericFile)))\n\n    # Watch all the possible sources, not just the one that got used, because if\n    # an earlier one appears, we want to rebuild.\n    doc.recordDependencies(*sources)\n\n    for source in sources:\n        if source is not None:\n            try:\n                return source.read().content\n            except OSError:\n                # That input doesn't exist.\n                pass\n    else:\n        if error:\n            die(\n                \"Couldn't find an appropriate include file for the {0} inclusion, given group='{1}' and status='{2}'.\",\n                name,\n                group,\n                status,\n            )\n        return \"\"\n", "code_after": "def retrieveBoilerplateFile(doc, name, group=None, status=None, error=True, allowLocal=True):\n    # Looks in three or four locations, in order:\n    # the folder the spec source is in, the group's boilerplate folder, the megagroup's boilerplate folder, and the generic boilerplate folder.\n    # In each location, it first looks for the file specialized on status, and then for the generic file.\n    # Filenames must be of the format NAME.include or NAME-STATUS.include\n    if group is None and doc.md.group is not None:\n        group = doc.md.group.lower()\n    if status is None:\n        if doc.md.status is not None:\n            status = doc.md.status\n        elif doc.md.rawStatus is not None:\n            status = doc.md.rawStatus\n    megaGroup, status = splitStatus(status)\n\n    searchLocally = allowLocal and doc.md.localBoilerplate[name]\n\n    def boilerplatePath(*segs):\n        return scriptPath(\"boilerplate\", *segs)\n\n    statusFile = f\"{name}-{status}.include\"\n    genericFile = f\"{name}.include\"\n    sources = []\n    if searchLocally:\n        sources.append(doc.inputSource.relative(statusFile))  # Can be None.\n        sources.append(doc.inputSource.relative(genericFile))\n    else:\n        for f in (statusFile, genericFile):\n            if doc.inputSource.cheaplyExists(f):\n                warn(\n                    (\n                        \"Found {0} next to the specification without a matching\\n\"\n                        + \"Local Boilerplate: {1} yes\\n\"\n                        + \"in the metadata. This include won't be found when building via a URL.\"\n                    ).format(f, name)\n                )\n                # We should remove this after giving specs time to react to the warning:\n                sources.append(doc.inputSource.relative(f))\n    if group:\n        sources.append(InputSource(boilerplatePath(group, statusFile), chroot=False))\n        sources.append(InputSource(boilerplatePath(group, genericFile), chroot=False))\n    if megaGroup:\n        sources.append(InputSource(boilerplatePath(megaGroup, statusFile), chroot=False))\n        sources.append(InputSource(boilerplatePath(megaGroup, genericFile), chroot=False))\n    sources.append(InputSource(boilerplatePath(statusFile), chroot=False))\n    sources.append(InputSource(boilerplatePath(genericFile), chroot=False))\n\n    # Watch all the possible sources, not just the one that got used, because if\n    # an earlier one appears, we want to rebuild.\n    doc.recordDependencies(*sources)\n\n    for source in sources:\n        if source is not None:\n            try:\n                return source.read().content\n            except OSError:\n                # That input doesn't exist.\n                pass\n    else:\n        if error:\n            die(\n                \"Couldn't find an appropriate include file for the {0} inclusion, given group='{1}' and status='{2}'.\",\n                name,\n                group,\n                status,\n            )\n        return \"\"\n", "commit_message": "Prevent escaping the source doc's folder, or running arbitrary code, without explicit opt-in at the command-line.", "commit": "https://github.com/tabatkins/bikeshed/commit/b2f668fca204260b1cad28d5078e93471cb6b2dd", "description": "This affects the package bikeshed before 3.0.0. This can occur when an untrusted source file containing Inline Tag Command metadata is processed. When an arbitrary OS command is executed, the command output would be included in the HTML output.", "file_change_id": 10442663674066, "report_link": "https://github.com/advisories/GHSA-87cj-px37-rc3x", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The function \"retrieveBoilerplateFile\" is changed in the commit that is intended to fix a vulnerability. The vulnerability description indicates that the issue is related to the execution of arbitrary OS commands when processing untrusted source files containing Inline Tag Command metadata.\n\nIn the \"retrieveBoilerplateFile\" function, the change is related to the addition of a new parameter \"allowLocal\" and the use of this parameter in the \"searchLocally\" variable. This change seems to control whether local boilerplate files are allowed to be searched or not. \n\nAnother change is the addition of \"chroot=False\" in the InputSource function calls. This change seems to restrict the file system access to the current directory and its subdirectories, which could be a measure to prevent the execution of arbitrary OS commands from other directories.\n\nGiven the nature of the vulnerability and the changes made to the function, it seems that the function is vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "load", "code_before": "def load(doc):\n    code = config.retrieveBoilerplateFile(doc, \"bs-extensions\")\n    exec(code, globals())\n", "code_after": "def load(doc):\n    code = config.retrieveBoilerplateFile(doc, \"bs-extensions\", allowLocal=constants.executeCode)\n    exec(code, globals())\n", "commit_message": "Prevent escaping the source doc's folder, or running arbitrary code, without explicit opt-in at the command-line.", "commit": "https://github.com/tabatkins/bikeshed/commit/b2f668fca204260b1cad28d5078e93471cb6b2dd", "description": "This affects the package bikeshed before 3.0.0. This can occur when an untrusted source file containing Inline Tag Command metadata is processed. When an arbitrary OS command is executed, the command output would be included in the HTML output.", "file_change_id": 244593494077975, "report_link": "https://github.com/advisories/GHSA-87cj-px37-rc3x", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the \"load\" function has been modified to include an additional parameter in the \"retrieveBoilerplateFile\" function call. This parameter, \"allowLocal\", is set to the value of \"constants.executeCode\".\n\nThe commit message suggests that the change is intended to prevent escaping the source document's folder or running arbitrary code without explicit opt-in at the command line. This aligns with the vulnerability description, which mentions the execution of arbitrary OS commands when processing untrusted source files containing Inline Tag Command metadata.\n\nGiven this, it appears that the \"load\" function was vulnerable and has been modified to address the described vulnerability. Therefore, the answer is 1.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "processTags", "code_before": "def processTags(doc):\n    for el in findAll(\"[data-span-tag]\", doc):\n        tag = el.get(\"data-span-tag\")\n        if tag not in doc.md.inlineTagCommands:\n            die(\"Unknown inline tag '{0}' found:\\n  {1}\", tag, outerHTML(el), el=el)\n            continue\n        command = doc.md.inlineTagCommands[tag]\n        with Popen(command, stdin=PIPE, stdout=PIPE, stderr=PIPE, shell=True) as p:\n            out, err = p.communicate(innerHTML(el).encode(\"utf-8\"))\n            try:\n                out = out.decode(\"utf-8\")\n            except UnicodeDecodeError as e:\n                die(\n                    \"When trying to process {0}, got invalid unicode in stdout:\\n{1}\",\n                    outerHTML(el),\n                    e,\n                    el=el,\n                )\n            try:\n                err = err.decode(\"utf-8\")\n            except UnicodeDecodeError as e:\n                die(\n                    \"When trying to process {0}, got invalid unicode in stderr:\\n{1}\",\n                    outerHTML(el),\n                    e,\n                    el=el,\n                )\n            if p.returncode:\n                die(\n                    \"When trying to process {0}, got return code {1} and the following stderr:\\n{2}\",\n                    outerHTML(el),\n                    p.returncode,\n                    err,\n                    el=el,\n                )\n                continue\n            replaceContents(el, parseHTML(out))\n", "code_after": "def processTags(doc):\n    for el in findAll(\"[data-span-tag]\", doc):\n        if not constants.executeCode:\n            die(\"Found an inline code tag, but arbitrary code execution isn't allowed. See the --allow-execute flag.\")\n            return\n        tag = el.get(\"data-span-tag\")\n        if tag not in doc.md.inlineTagCommands:\n            die(\"Unknown inline tag '{0}' found:\\n  {1}\", tag, outerHTML(el), el=el)\n            continue\n        command = doc.md.inlineTagCommands[tag]\n        with Popen(command, stdin=PIPE, stdout=PIPE, stderr=PIPE, shell=True) as p:\n            out, err = p.communicate(innerHTML(el).encode(\"utf-8\"))\n            try:\n                out = out.decode(\"utf-8\")\n            except UnicodeDecodeError as e:\n                die(\n                    \"When trying to process {0}, got invalid unicode in stdout:\\n{1}\",\n                    outerHTML(el),\n                    e,\n                    el=el,\n                )\n            try:\n                err = err.decode(\"utf-8\")\n            except UnicodeDecodeError as e:\n                die(\n                    \"When trying to process {0}, got invalid unicode in stderr:\\n{1}\",\n                    outerHTML(el),\n                    e,\n                    el=el,\n                )\n            if p.returncode:\n                die(\n                    \"When trying to process {0}, got return code {1} and the following stderr:\\n{2}\",\n                    outerHTML(el),\n                    p.returncode,\n                    err,\n                    el=el,\n                )\n                continue\n            replaceContents(el, parseHTML(out))\n", "commit_message": "Prevent escaping the source doc's folder, or running arbitrary code, without explicit opt-in at the command-line.", "commit": "https://github.com/tabatkins/bikeshed/commit/b2f668fca204260b1cad28d5078e93471cb6b2dd", "description": "This affects the package bikeshed before 3.0.0. This can occur when an untrusted source file containing Inline Tag Command metadata is processed. When an arbitrary OS command is executed, the command output would be included in the HTML output.", "file_change_id": 84142827059564, "report_link": "https://github.com/advisories/GHSA-87cj-px37-rc3x", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"processTags\" was changed to address a security vulnerability. The vulnerability description states that an issue could occur when an untrusted source file containing Inline Tag Command metadata is processed, leading to the execution of an arbitrary OS command.\n\nIn the \"code_after\" section, a new condition has been added at the beginning of the function to check if the execution of arbitrary code is allowed. If not, the function will terminate with an error message. This change directly addresses the described vulnerability by preventing the execution of arbitrary code unless explicitly allowed.\n\nTherefore, the function \"processTags\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "boboAwareZopeTraverse", "code_before": "def boboAwareZopeTraverse(object, path_items, econtext):\n    \"\"\"Traverses a sequence of names, first trying attributes then items.\n\n    This uses zope.traversing path traversal where possible and interacts\n    correctly with objects providing OFS.interface.ITraversable when\n    necessary (bobo-awareness).\n    \"\"\"\n    request = getattr(econtext, 'request', None)\n    path_items = list(path_items)\n    path_items.reverse()\n\n    while path_items:\n        name = path_items.pop()\n        if OFS.interfaces.ITraversable.providedBy(object):\n            object = object.restrictedTraverse(name)\n        else:\n            object = traversePathElement(object, name, path_items,\n                                         request=request)\n    return object\n", "code_after": "def boboAwareZopeTraverse(object, path_items, econtext):\n    \"\"\"Traverses a sequence of names, first trying attributes then items.\n\n    This uses zope.traversing path traversal where possible and interacts\n    correctly with objects providing OFS.interface.ITraversable when\n    necessary (bobo-awareness).\n    \"\"\"\n    request = getattr(econtext, 'request', None)\n    path_items = list(path_items)\n    path_items.reverse()\n\n    while path_items:\n        name = path_items.pop()\n\n        if name == '_':\n            warnings.warn('Traversing to the name `_` is deprecated '\n                          'and will be removed in Zope 6.',\n                          DeprecationWarning)\n        elif name.startswith('_'):\n            raise NotFound(name)\n\n        if OFS.interfaces.ITraversable.providedBy(object):\n            object = object.restrictedTraverse(name)\n        else:\n            object = traversePathElement(object, name, path_items,\n                                         request=request)\n    return object\n", "commit_message": "Merge pull request from GHSA-5pr9-v234-jw36\n\n* - Prevent traversal to names starting with ``_`` in TAL expressions\n\n* - include the expressions module\n\n* - simplify test\n\n* - lint fix\n\n* - add DeprecationWarnings for traversal to `_`\n\n* Update src/Products/PageTemplates/tests/testChameleonTalesExpressions.py\n\nCo-authored-by: Michael Howitz <mh@gocept.com>\n\n* - add missing import\n\n* - added tests for the ``traverse`` method fix\n\n* - change control flow\n\nCo-authored-by: Michael Howitz <mh@gocept.com>", "commit": "https://github.com/zopefoundation/Zope/commit/1f8456bf1f908ea46012537d52bd7e752a532c91", "description": "Zope is an open-source web application server. In Zope versions prior to 4.6 and 5.2, users can access untrusted modules indirectly through Python modules that are available for direct use. By default, only users with the Manager role can add or edit Zope Page Templates through the web, but sites that allow untrusted users to add/edit Zope Page Templates through the web are at risk from this vulnerability. The problem has been fixed in Zope 5.2 and 4.6. As a workaround, a site administrator can restrict adding/editing Zope Page Templates through the web using the standard Zope user/role permission mechanisms. Untrusted users should not be assigned the Zope Manager role and adding/editing Zope Page Templates through the web should be restricted to trusted users only.", "file_change_id": 208785298790342, "report_link": "https://github.com/advisories/GHSA-962m-m8jw-8wrr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"boboAwareZopeTraverse\" has been modified to prevent traversal to names starting with \"_\". This is done by adding a conditional block that checks if the name starts with \"_\" and raises a NotFound exception if it does.\n\nThe vulnerability description mentions that users can access untrusted modules indirectly through Python modules that are available for direct use. The commit message also indicates that the change is intended to prevent traversal to names starting with \"_\" in TAL expressions.\n\nGiven this information, it seems that the change in the function \"boboAwareZopeTraverse\" is directly related to the vulnerability that the commit is trying to fix. The function was vulnerable and has been changed to mitigate the vulnerability.\n\nTherefore, the answer is 1 (the function is vulnerable).\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "traverse", "code_before": "    def traverse(cls, base, request, path_items):\n        \"\"\"See ``zope.app.pagetemplate.engine``.\"\"\"\n\n        path_items = list(path_items)\n        path_items.reverse()\n\n        while path_items:\n            name = path_items.pop()\n            if ITraversable.providedBy(base):\n                base = getattr(base, cls.traverseMethod)(name)\n            else:\n                base = traversePathElement(base, name, path_items,\n                                           request=request)\n\n        return base\n", "code_after": "    def traverse(cls, base, request, path_items):\n        \"\"\"See ``zope.app.pagetemplate.engine``.\"\"\"\n\n        path_items = list(path_items)\n        path_items.reverse()\n\n        while path_items:\n            name = path_items.pop()\n\n            if name == '_':\n                warnings.warn('Traversing to the name `_` is deprecated '\n                              'and will be removed in Zope 6.',\n                              DeprecationWarning)\n            elif name.startswith('_'):\n                raise NotFound(name)\n\n            if ITraversable.providedBy(base):\n                base = getattr(base, cls.traverse_method)(name)\n            else:\n                base = traversePathElement(base, name, path_items,\n                                           request=request)\n\n        return base\n", "commit_message": "Merge pull request from GHSA-5pr9-v234-jw36\n\n* - Prevent traversal to names starting with ``_`` in TAL expressions\n\n* - include the expressions module\n\n* - simplify test\n\n* - lint fix\n\n* - add DeprecationWarnings for traversal to `_`\n\n* Update src/Products/PageTemplates/tests/testChameleonTalesExpressions.py\n\nCo-authored-by: Michael Howitz <mh@gocept.com>\n\n* - add missing import\n\n* - added tests for the ``traverse`` method fix\n\n* - change control flow\n\nCo-authored-by: Michael Howitz <mh@gocept.com>", "commit": "https://github.com/zopefoundation/Zope/commit/1f8456bf1f908ea46012537d52bd7e752a532c91", "description": "Zope is an open-source web application server. In Zope versions prior to 4.6 and 5.2, users can access untrusted modules indirectly through Python modules that are available for direct use. By default, only users with the Manager role can add or edit Zope Page Templates through the web, but sites that allow untrusted users to add/edit Zope Page Templates through the web are at risk from this vulnerability. The problem has been fixed in Zope 5.2 and 4.6. As a workaround, a site administrator can restrict adding/editing Zope Page Templates through the web using the standard Zope user/role permission mechanisms. Untrusted users should not be assigned the Zope Manager role and adding/editing Zope Page Templates through the web should be restricted to trusted users only.", "file_change_id": 174902315560903, "report_link": "https://github.com/advisories/GHSA-962m-m8jw-8wrr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"traverse\" has been modified to prevent traversal to names starting with \"_\". This change is in response to a vulnerability where users could access untrusted modules indirectly through Python modules that are available for direct use.\n\nIn the \"code_after\" section, we can see that a new condition has been added to check if the name starts with \"_\". If it does, a NotFound exception is raised. This change directly addresses the vulnerability by preventing access to untrusted modules, which are typically denoted by names starting with \"_\".\n\nTherefore, the function \"traverse\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "boboAwareZopeTraverse", "code_before": "def boboAwareZopeTraverse(object, path_items, econtext):\n    \"\"\"Traverses a sequence of names, first trying attributes then items.\n\n    This uses zope.traversing path traversal where possible and interacts\n    correctly with objects providing OFS.interface.ITraversable when\n    necessary (bobo-awareness).\n    \"\"\"\n    request = getattr(econtext, 'request', None)\n    path_items = list(path_items)\n    path_items.reverse()\n\n    while path_items:\n        name = path_items.pop()\n\n        if name == '_':\n            warnings.warn('Traversing to the name `_` is deprecated '\n                          'and will be removed in Zope 6.',\n                          DeprecationWarning)\n        elif name.startswith('_'):\n            raise NotFound(name)\n\n        if OFS.interfaces.ITraversable.providedBy(object):\n            object = object.restrictedTraverse(name)\n        else:\n            object = traversePathElement(object, name, path_items,\n                                         request=request)\n    return object\n", "code_after": "def boboAwareZopeTraverse(object, path_items, econtext):\n    \"\"\"Traverses a sequence of names, first trying attributes then items.\n\n    This uses zope.traversing path traversal where possible and interacts\n    correctly with objects providing OFS.interface.ITraversable when\n    necessary (bobo-awareness).\n    \"\"\"\n    request = getattr(econtext, 'request', None)\n    validate = getSecurityManager().validate\n    path_items = list(path_items)\n    path_items.reverse()\n\n    while path_items:\n        name = path_items.pop()\n\n        if OFS.interfaces.ITraversable.providedBy(object):\n            object = object.restrictedTraverse(name)\n        else:\n            found = traversePathElement(object, name, path_items,\n                                        request=request)\n\n            # Special backwards compatibility exception for the name ``_``,\n            # which was often used for translation message factories.\n            # Allow and continue traversal.\n            if name == '_':\n                warnings.warn('Traversing to the name `_` is deprecated '\n                              'and will be removed in Zope 6.',\n                              DeprecationWarning)\n                object = found\n                continue\n\n            # All other names starting with ``_`` are disallowed.\n            # This emulates what restrictedTraverse does.\n            if name.startswith('_'):\n                raise NotFound(name)\n\n            # traversePathElement doesn't apply any Zope security policy,\n            # so we validate access explicitly here.\n            try:\n                validate(object, object, name, found)\n                object = found\n            except Unauthorized:\n                # Convert Unauthorized to prevent information disclosures\n                raise NotFound(name)\n\n    return object\n", "commit_message": "Merge pull request from GHSA-rpcg-f9q6-2mq6\n\n* - Prevent traversal through authorized Python modules in TAL expressions\n\n* - try a more generic solution that doesn't use special casing\n\n* - add suggestions from Maurits\n\n* - integrate remaining suggestions from Maurits", "commit": "https://github.com/zopefoundation/Zope/commit/1d897910139e2c0b11984fc9b78c1da1365bec21", "description": "Zope is an open-source web application server. This advisory extends the previous advisory at https://github.com/zopefoundation/Zope/security/advisories/GHSA-5pr9-v234-jw36 with additional cases of TAL expression traversal vulnerabilities. Most Python modules are not available for using in TAL expressions that you can add through-the-web, for example in Zope Page Templates. This restriction avoids file system access, for example via the 'os' module. But some of the untrusted modules are available indirectly through Python modules that are available for direct use. By default, you need to have the Manager role to add or edit Zope Page Templates through the web. Only sites that allow untrusted users to add/edit Zope Page Templates through the web are at risk. The problem has been fixed in Zope 5.2.1 and 4.6.1. The workaround is the same as for https://github.com/zopefoundation/Zope/security/advisories/GHSA-5pr9-v234-jw36: A site administrator can restrict adding/editing Zope Page Templates through the web using the standard Zope user/role permission mechanisms. Untrusted users should not be assigned the Zope Manager role and adding/editing Zope Page Templates through the web should be restricted to trusted users only.", "file_change_id": 1535806860405, "report_link": "https://github.com/advisories/GHSA-5vq5-pg3r-9ph3", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"boboAwareZopeTraverse\" has been modified to address a security vulnerability. The vulnerability description suggests that the issue lies in the traversal of TAL expressions, which could potentially allow unauthorized access to Python modules.\n\nIn the \"code_after\" section, we can see that a security validation step has been added to the traversal process. This validation is performed by the `getSecurityManager().validate` function, which checks whether the traversal to a particular object is authorized. If the validation fails, an `Unauthorized` exception is raised, which is then caught and converted into a `NotFound` exception to prevent information disclosure.\n\nGiven this information, it can be concluded that the function \"boboAwareZopeTraverse\" was indeed vulnerable and has been modified to address the reported vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "traverse", "code_before": "    def traverse(cls, base, request, path_items):\n        \"\"\"See ``zope.app.pagetemplate.engine``.\"\"\"\n\n        path_items = list(path_items)\n        path_items.reverse()\n\n        while path_items:\n            name = path_items.pop()\n\n            if name == '_':\n                warnings.warn('Traversing to the name `_` is deprecated '\n                              'and will be removed in Zope 6.',\n                              DeprecationWarning)\n            elif name.startswith('_'):\n                raise NotFound(name)\n\n            if ITraversable.providedBy(base):\n                base = getattr(base, cls.traverse_method)(name)\n            else:\n                base = traversePathElement(base, name, path_items,\n                                           request=request)\n\n        return base\n", "code_after": "    def traverse(cls, base, request, path_items):\n        \"\"\"See ``zope.app.pagetemplate.engine``.\"\"\"\n\n        validate = getSecurityManager().validate\n        path_items = list(path_items)\n        path_items.reverse()\n\n        while path_items:\n            name = path_items.pop()\n\n            if ITraversable.providedBy(base):\n                base = getattr(base, cls.traverse_method)(name)\n            else:\n                found = traversePathElement(base, name, path_items,\n                                            request=request)\n\n                # If traverse_method is something other than\n                # ``restrictedTraverse`` then traversal is assumed to be\n                # unrestricted. This emulates ``unrestrictedTraverse``\n                if cls.traverse_method != 'restrictedTraverse':\n                    base = found\n                    continue\n\n                # Special backwards compatibility exception for the name ``_``,\n                # which was often used for translation message factories.\n                # Allow and continue traversal.\n                if name == '_':\n                    warnings.warn('Traversing to the name `_` is deprecated '\n                                  'and will be removed in Zope 6.',\n                                  DeprecationWarning)\n                    base = found\n                    continue\n\n                # All other names starting with ``_`` are disallowed.\n                # This emulates what restrictedTraverse does.\n                if name.startswith('_'):\n                    raise NotFound(name)\n\n                # traversePathElement doesn't apply any Zope security policy,\n                # so we validate access explicitly here.\n                try:\n                    validate(base, base, name, found)\n                    base = found\n                except Unauthorized:\n                    # Convert Unauthorized to prevent information disclosures\n                    raise NotFound(name)\n\n        return base\n", "commit_message": "Merge pull request from GHSA-rpcg-f9q6-2mq6\n\n* - Prevent traversal through authorized Python modules in TAL expressions\n\n* - try a more generic solution that doesn't use special casing\n\n* - add suggestions from Maurits\n\n* - integrate remaining suggestions from Maurits", "commit": "https://github.com/zopefoundation/Zope/commit/1d897910139e2c0b11984fc9b78c1da1365bec21", "description": "Zope is an open-source web application server. This advisory extends the previous advisory at https://github.com/zopefoundation/Zope/security/advisories/GHSA-5pr9-v234-jw36 with additional cases of TAL expression traversal vulnerabilities. Most Python modules are not available for using in TAL expressions that you can add through-the-web, for example in Zope Page Templates. This restriction avoids file system access, for example via the 'os' module. But some of the untrusted modules are available indirectly through Python modules that are available for direct use. By default, you need to have the Manager role to add or edit Zope Page Templates through the web. Only sites that allow untrusted users to add/edit Zope Page Templates through the web are at risk. The problem has been fixed in Zope 5.2.1 and 4.6.1. The workaround is the same as for https://github.com/zopefoundation/Zope/security/advisories/GHSA-5pr9-v234-jw36: A site administrator can restrict adding/editing Zope Page Templates through the web using the standard Zope user/role permission mechanisms. Untrusted users should not be assigned the Zope Manager role and adding/editing Zope Page Templates through the web should be restricted to trusted users only.", "file_change_id": 278028968957905, "report_link": "https://github.com/advisories/GHSA-5vq5-pg3r-9ph3", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"traverse\" has been modified to address a security vulnerability. The vulnerability description suggests that the issue lies in the traversal of TAL expressions, which could potentially allow unauthorized access to Python modules.\n\nIn the \"code_after\" section, we can see that the function has been modified to include a security validation step using `getSecurityManager().validate`. This validation step checks whether the traversal is authorized or not. If the validation fails, an `Unauthorized` exception is raised, which is then caught and converted into a `NotFound` exception to prevent information disclosure.\n\nGiven this, it can be inferred that the function \"traverse\" was indeed vulnerable and has been modified to address the reported vulnerability. Therefore, the answer is 1.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_context_data", "code_before": "    def get_context_data(self, **kwargs):\n        template = self.kwargs['template']\n        templates = []\n        try:\n            default_engine = Engine.get_default()\n        except ImproperlyConfigured:\n            # Non-trivial TEMPLATES settings aren't supported (#24125).\n            pass\n        else:\n            # This doesn't account for template loaders (#24128).\n            for index, directory in enumerate(default_engine.dirs):\n                template_file = Path(directory) / template\n                if template_file.exists():\n                    with template_file.open() as f:\n                        template_contents = f.read()\n                else:\n                    template_contents = ''\n                templates.append({\n                    'file': template_file,\n                    'exists': template_file.exists(),\n                    'contents': template_contents,\n                    'order': index,\n                })\n        return super().get_context_data(**{\n            **kwargs,\n            'name': template,\n            'templates': templates,\n        })\n", "code_after": "    def get_context_data(self, **kwargs):\n        template = self.kwargs['template']\n        templates = []\n        try:\n            default_engine = Engine.get_default()\n        except ImproperlyConfigured:\n            # Non-trivial TEMPLATES settings aren't supported (#24125).\n            pass\n        else:\n            # This doesn't account for template loaders (#24128).\n            for index, directory in enumerate(default_engine.dirs):\n                template_file = Path(safe_join(directory, template))\n                if template_file.exists():\n                    with template_file.open() as f:\n                        template_contents = f.read()\n                else:\n                    template_contents = ''\n                templates.append({\n                    'file': template_file,\n                    'exists': template_file.exists(),\n                    'contents': template_contents,\n                    'order': index,\n                })\n        return super().get_context_data(**{\n            **kwargs,\n            'name': template,\n            'templates': templates,\n        })\n", "commit_message": "[2.2.x] Fixed CVE-2021-33203 -- Fixed potential path-traversal via admindocs' TemplateDetailView.", "commit": "https://github.com/django/django/commit/053cc9534d174dc89daba36724ed2dcb36755b90", "description": "Django before 2.2.24, 3.x before 3.1.12, and 3.2.x before 3.2.4 has a potential directory traversal via django.contrib.admindocs. Staff members could use the TemplateDetailView view to check the existence of arbitrary files. Additionally, if (and only if) the default admindocs templates have been customized by application developers to also show file contents, then not only the existence but also the file contents would have been exposed. In other words, there is directory traversal outside of the template root directories.", "file_change_id": 172905677209233, "report_link": "https://github.com/advisories/GHSA-68w8-qjq3-2gfm", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `get_context_data` is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability is described as a potential directory traversal issue via `django.contrib.admindocs`. Staff members could use the `TemplateDetailView` view to check the existence of arbitrary files.\n\nIn the `get_context_data` function, the change is from `Path(directory) / template` to `Path(safe_join(directory, template))`. The `safe_join` function is used to prevent directory traversal, it ensures that the joined path stays within the base path. This change is directly addressing the vulnerability described, by preventing the possibility of directory traversal.\n\nTherefore, the function `get_context_data` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_context_data", "code_before": "    def get_context_data(self, **kwargs):\n        template = self.kwargs['template']\n        templates = []\n        try:\n            default_engine = Engine.get_default()\n        except ImproperlyConfigured:\n            # Non-trivial TEMPLATES settings aren't supported (#24125).\n            pass\n        else:\n            # This doesn't account for template loaders (#24128).\n            for index, directory in enumerate(default_engine.dirs):\n                template_file = Path(directory) / template\n                if template_file.exists():\n                    template_contents = template_file.read_text()\n                else:\n                    template_contents = ''\n                templates.append({\n                    'file': template_file,\n                    'exists': template_file.exists(),\n                    'contents': template_contents,\n                    'order': index,\n                })\n        return super().get_context_data(**{\n            **kwargs,\n            'name': template,\n            'templates': templates,\n        })\n", "code_after": "    def get_context_data(self, **kwargs):\n        template = self.kwargs['template']\n        templates = []\n        try:\n            default_engine = Engine.get_default()\n        except ImproperlyConfigured:\n            # Non-trivial TEMPLATES settings aren't supported (#24125).\n            pass\n        else:\n            # This doesn't account for template loaders (#24128).\n            for index, directory in enumerate(default_engine.dirs):\n                template_file = Path(safe_join(directory, template))\n                if template_file.exists():\n                    template_contents = template_file.read_text()\n                else:\n                    template_contents = ''\n                templates.append({\n                    'file': template_file,\n                    'exists': template_file.exists(),\n                    'contents': template_contents,\n                    'order': index,\n                })\n        return super().get_context_data(**{\n            **kwargs,\n            'name': template,\n            'templates': templates,\n        })\n", "commit_message": "[3.1.x] Fixed CVE-2021-33203 -- Fixed potential path-traversal via admindocs' TemplateDetailView.", "commit": "https://github.com/django/django/commit/20c67a0693c4ede2b09af02574823485e82e4c8f", "description": "Django before 2.2.24, 3.x before 3.1.12, and 3.2.x before 3.2.4 has a potential directory traversal via django.contrib.admindocs. Staff members could use the TemplateDetailView view to check the existence of arbitrary files. Additionally, if (and only if) the default admindocs templates have been customized by application developers to also show file contents, then not only the existence but also the file contents would have been exposed. In other words, there is directory traversal outside of the template root directories.", "file_change_id": 127617194074120, "report_link": "https://github.com/advisories/GHSA-68w8-qjq3-2gfm", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `get_context_data` was changed to fix a potential directory traversal vulnerability. The vulnerability allowed staff members to check the existence of arbitrary files, and if the default admindocs templates were customized to show file contents, the contents of the files would also be exposed.\n\nThe change in the function is the way the `template_file` path is constructed. In the 'before' code, the path is constructed by simply appending the template to the directory, which could potentially allow for directory traversal if the template variable is not properly sanitized. In the 'after' code, the `safe_join` function is used to construct the path, which would prevent directory traversal by ensuring that the final path is within the specified directory.\n\nTherefore, the function `get_context_data` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_context_data", "code_before": "    def get_context_data(self, **kwargs):\n        template = self.kwargs['template']\n        templates = []\n        try:\n            default_engine = Engine.get_default()\n        except ImproperlyConfigured:\n            # Non-trivial TEMPLATES settings aren't supported (#24125).\n            pass\n        else:\n            # This doesn't account for template loaders (#24128).\n            for index, directory in enumerate(default_engine.dirs):\n                template_file = Path(directory) / template\n                if template_file.exists():\n                    template_contents = template_file.read_text()\n                else:\n                    template_contents = ''\n                templates.append({\n                    'file': template_file,\n                    'exists': template_file.exists(),\n                    'contents': template_contents,\n                    'order': index,\n                })\n        return super().get_context_data(**{\n            **kwargs,\n            'name': template,\n            'templates': templates,\n        })\n", "code_after": "    def get_context_data(self, **kwargs):\n        template = self.kwargs['template']\n        templates = []\n        try:\n            default_engine = Engine.get_default()\n        except ImproperlyConfigured:\n            # Non-trivial TEMPLATES settings aren't supported (#24125).\n            pass\n        else:\n            # This doesn't account for template loaders (#24128).\n            for index, directory in enumerate(default_engine.dirs):\n                template_file = Path(safe_join(directory, template))\n                if template_file.exists():\n                    template_contents = template_file.read_text()\n                else:\n                    template_contents = ''\n                templates.append({\n                    'file': template_file,\n                    'exists': template_file.exists(),\n                    'contents': template_contents,\n                    'order': index,\n                })\n        return super().get_context_data(**{\n            **kwargs,\n            'name': template,\n            'templates': templates,\n        })\n", "commit_message": "[3.2.x] Fixed CVE-2021-33203 -- Fixed potential path-traversal via admindocs' TemplateDetailView.", "commit": "https://github.com/django/django/commit/dfaba12cda060b8b292ae1d271b44bf810b1c5b9", "description": "Django before 2.2.24, 3.x before 3.1.12, and 3.2.x before 3.2.4 has a potential directory traversal via django.contrib.admindocs. Staff members could use the TemplateDetailView view to check the existence of arbitrary files. Additionally, if (and only if) the default admindocs templates have been customized by application developers to also show file contents, then not only the existence but also the file contents would have been exposed. In other words, there is directory traversal outside of the template root directories.", "file_change_id": 43586749783132, "report_link": "https://github.com/advisories/GHSA-68w8-qjq3-2gfm", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `get_context_data` is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability is described as a potential directory traversal issue via `django.contrib.admindocs`. Staff members could use the `TemplateDetailView` view to check the existence of arbitrary files.\n\nIn the `get_context_data` function, the change is made in the line where `template_file` is defined. In the 'before' code, `template_file` is defined as `Path(directory) / template`, while in the 'after' code, it is defined as `Path(safe_join(directory, template))`. The `safe_join` function is used to prevent directory traversal, which is the exact vulnerability described.\n\nTherefore, the function `get_context_data` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_available_name", "code_before": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        dir_name, file_name = os.path.split(name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, add an underscore and a random 7\n        # character alphanumeric string (before the file extension, if one\n        # exists) to the filename until the generated filename doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n        return name\n", "code_after": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        dir_name, file_name = os.path.split(name)\n        if '..' in pathlib.PurePath(dir_name).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dir_name)\n        validate_file_name(file_name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, add an underscore and a random 7\n        # character alphanumeric string (before the file extension, if one\n        # exists) to the filename until the generated filename doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n        return name\n", "commit_message": "[2.2.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/04ac1624bdc2fa737188401757cf95ced122d26d", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 166232987917802, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "generate_filename", "code_before": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n", "code_after": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        if '..' in pathlib.PurePath(dirname).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dirname)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n"}], "gpt_answer": "The provided information indicates that the vulnerability allowed directory traversal via uploaded files with suitably crafted file names. The changes in the \"get_available_name\" function include the addition of checks for path traversal attempts in the directory name and validation of the file name. These changes directly address the described vulnerability by adding security measures to prevent directory traversal.\n\nTherefore, the function \"get_available_name\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "generate_filename", "code_before": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n", "code_after": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        if '..' in pathlib.PurePath(dirname).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dirname)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n", "commit_message": "[2.2.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/04ac1624bdc2fa737188401757cf95ced122d26d", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 166232987917802, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "get_available_name", "code_before": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        dir_name, file_name = os.path.split(name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, add an underscore and a random 7\n        # character alphanumeric string (before the file extension, if one\n        # exists) to the filename until the generated filename doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n        return name\n", "code_after": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        dir_name, file_name = os.path.split(name)\n        if '..' in pathlib.PurePath(dir_name).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dir_name)\n        validate_file_name(file_name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, add an underscore and a random 7\n        # character alphanumeric string (before the file extension, if one\n        # exists) to the filename until the generated filename doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, \"%s_%s%s\" % (file_root, get_random_string(7), file_ext))\n        return name\n"}], "gpt_answer": "The function \"generate_filename\" is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability, as described, allows directory traversal via uploaded files with suitably crafted file names. \n\nIn the \"code_after\" section, we can see that a check has been added to prevent directory traversal. If '..' is found in the directory name, a SuspiciousFileOperation exception is raised, indicating a detected path traversal attempt. This change directly addresses the described vulnerability by adding a security measure against directory traversal attacks.\n\nTherefore, the function \"generate_filename\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "_set_name", "code_before": "    def _set_name(self, name):\n        # Sanitize the file name so that it can't be dangerous.\n        if name is not None:\n            # Just use the basename of the file -- anything else is dangerous.\n            name = os.path.basename(name)\n\n            # File names longer than 255 characters can cause problems on older OSes.\n            if len(name) > 255:\n                name, ext = os.path.splitext(name)\n                ext = ext[:255]\n                name = name[:255 - len(ext)] + ext\n\n        self._name = name\n", "code_after": "    def _set_name(self, name):\n        # Sanitize the file name so that it can't be dangerous.\n        if name is not None:\n            # Just use the basename of the file -- anything else is dangerous.\n            name = os.path.basename(name)\n\n            # File names longer than 255 characters can cause problems on older OSes.\n            if len(name) > 255:\n                name, ext = os.path.splitext(name)\n                ext = ext[:255]\n                name = name[:255 - len(ext)] + ext\n\n            name = validate_file_name(name)\n\n        self._name = name\n", "commit_message": "[2.2.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/04ac1624bdc2fa737188401757cf95ced122d26d", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 185652839760267, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `_set_name` is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability description mentions that \"MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.\" The function `_set_name` is responsible for setting the name of an uploaded file, and the changes made to this function are directly related to sanitizing the file name to prevent directory traversal.\n\nIn the `code_after` snippet, a new line `name = validate_file_name(name)` has been added. This line is likely responsible for further sanitizing the file name to prevent directory traversal attacks, which is the vulnerability described.\n\nTherefore, the function `_set_name` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "generate_filename", "code_before": "    def generate_filename(self, instance, filename):\n        \"\"\"\n        Apply (if callable) or prepend (if a string) upload_to to the filename,\n        then delegate further processing of the name to the storage backend.\n        Until the storage layer, all file paths are expected to be Unix style\n        (with forward slashes).\n        \"\"\"\n        if callable(self.upload_to):\n            filename = self.upload_to(instance, filename)\n        else:\n            dirname = datetime.datetime.now().strftime(self.upload_to)\n            filename = posixpath.join(dirname, filename)\n        return self.storage.generate_filename(filename)\n", "code_after": "    def generate_filename(self, instance, filename):\n        \"\"\"\n        Apply (if callable) or prepend (if a string) upload_to to the filename,\n        then delegate further processing of the name to the storage backend.\n        Until the storage layer, all file paths are expected to be Unix style\n        (with forward slashes).\n        \"\"\"\n        filename = validate_file_name(filename)\n        if callable(self.upload_to):\n            filename = self.upload_to(instance, filename)\n        else:\n            dirname = datetime.datetime.now().strftime(self.upload_to)\n            filename = posixpath.join(dirname, filename)\n        return self.storage.generate_filename(filename)\n", "commit_message": "[2.2.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/04ac1624bdc2fa737188401757cf95ced122d26d", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 202872689630401, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `generate_filename` was changed to include a call to `validate_file_name(filename)`. This change was made in response to a vulnerability (CVE-2021-31542) that allowed directory traversal via uploaded files with suitably crafted file names.\n\nThe addition of `validate_file_name(filename)` is a direct response to this vulnerability, as it appears to be a measure to sanitize the filename and prevent directory traversal attacks. Therefore, the function `generate_filename` was vulnerable and has been changed to fix the vulnerability.\n\nHere is the answer in the requested format:\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "sanitize_file_name", "code_before": "    def sanitize_file_name(self, file_name):\n        file_name = unescape_entities(file_name)\n        # Cleanup Windows-style path separators.\n        file_name = file_name[file_name.rfind('\\\\') + 1:].strip()\n        return os.path.basename(file_name)\n", "code_after": "    def sanitize_file_name(self, file_name):\n        \"\"\"\n        Sanitize the filename of an upload.\n\n        Remove all possible path separators, even though that might remove more\n        than actually required by the target system. Filenames that could\n        potentially cause problems (current/parent dir) are also discarded.\n\n        It should be noted that this function could still return a \"filepath\"\n        like \"C:some_file.txt\" which is handled later on by the storage layer.\n        So while this function does sanitize filenames to some extent, the\n        resulting filename should still be considered as untrusted user input.\n        \"\"\"\n        file_name = html.unescape(file_name)\n        file_name = file_name.rsplit('/')[-1]\n        file_name = file_name.rsplit('\\\\')[-1]\n\n        if file_name in {'', '.', '..'}:\n            return None\n        return file_name\n", "commit_message": "[2.2.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/04ac1624bdc2fa737188401757cf95ced122d26d", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 113551470055603, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"sanitize_file_name\" has been modified to address a security vulnerability. The vulnerability description states that \"MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.\" \n\nThe changes in the function \"sanitize_file_name\" are directly related to this vulnerability. The function has been updated to sanitize the filename of an upload more thoroughly. It now removes all possible path separators and discards filenames that could potentially cause problems (current/parent dir). \n\nThis change is directly addressing the reported vulnerability, which is about directory traversal via uploaded files with suitably crafted file names. Therefore, it can be concluded that the function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_valid_filename", "code_before": "def get_valid_filename(s):\n    \"\"\"\n    Return the given string converted to a string that can be used for a clean\n    filename. Remove leading and trailing spaces; convert other spaces to\n    underscores; and remove anything that is not an alphanumeric, dash,\n    underscore, or dot.\n    >>> get_valid_filename(\"john's portrait in 2004.jpg\")\n    'johns_portrait_in_2004.jpg'\n    \"\"\"\n    s = str(s).strip().replace(' ', '_')\n    return re.sub(r'(?u)[^-\\w.]', '', s)\n", "code_after": "def get_valid_filename(name):\n    \"\"\"\n    Return the given string converted to a string that can be used for a clean\n    filename. Remove leading and trailing spaces; convert other spaces to\n    underscores; and remove anything that is not an alphanumeric, dash,\n    underscore, or dot.\n    >>> get_valid_filename(\"john's portrait in 2004.jpg\")\n    'johns_portrait_in_2004.jpg'\n    \"\"\"\n    s = str(name).strip().replace(' ', '_')\n    s = re.sub(r'(?u)[^-\\w.]', '', s)\n    if s in {'', '.', '..'}:\n        raise SuspiciousFileOperation(\"Could not derive file name from '%s'\" % name)\n    return s\n", "commit_message": "[2.2.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/04ac1624bdc2fa737188401757cf95ced122d26d", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 63117454460082, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `get_valid_filename` has been modified to address a security vulnerability. The vulnerability description states that \"MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.\" \n\nThe change in the function `get_valid_filename` is to add a check that prevents the function from returning an empty string, '.', or '..'. These are special directory names in many file systems, and allowing them could lead to directory traversal attacks, where an attacker can access files outside of the intended directory. \n\nThe commit message \"Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads\" also supports this interpretation, as it indicates that the commit is intended to improve the sanitation of file names in file uploads, which is exactly what the `get_valid_filename` function is used for.\n\nTherefore, it can be concluded that the function `get_valid_filename` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "generate_filename", "code_before": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n", "code_after": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        if '..' in pathlib.PurePath(dirname).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dirname)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n", "commit_message": "[3.1.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/25d84d64122c15050a0ee739e859f22ddab5ac48", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 19139138145330, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "get_available_name", "code_before": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        dir_name, file_name = os.path.split(name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, generate an alternative filename\n        # until it doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n        return name\n", "code_after": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        dir_name, file_name = os.path.split(name)\n        if '..' in pathlib.PurePath(dir_name).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dir_name)\n        validate_file_name(file_name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, generate an alternative filename\n        # until it doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n        return name\n"}], "gpt_answer": "The vulnerability described in the advisory is related to directory traversal via uploaded files with suitably crafted file names. The function `generate_filename` is changed to add a check for directory traversal attempts. If '..' is found in the directory name, a `SuspiciousFileOperation` exception is raised. This change directly addresses the described vulnerability by preventing directory traversal attempts.\n\nTherefore, the function `generate_filename` is vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_available_name", "code_before": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        dir_name, file_name = os.path.split(name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, generate an alternative filename\n        # until it doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n        return name\n", "code_after": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        dir_name, file_name = os.path.split(name)\n        if '..' in pathlib.PurePath(dir_name).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dir_name)\n        validate_file_name(file_name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, generate an alternative filename\n        # until it doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n        return name\n", "commit_message": "[3.1.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/25d84d64122c15050a0ee739e859f22ddab5ac48", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 19139138145330, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "generate_filename", "code_before": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n", "code_after": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        if '..' in pathlib.PurePath(dirname).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dirname)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n"}], "gpt_answer": "The vulnerability described in the advisory is related to directory traversal via uploaded files with suitably crafted file names. The function `get_available_name` is changed to add checks for directory traversal attempts. Specifically, it checks if '..' is in the directory name, which is a common way to perform directory traversal. If such an attempt is detected, a `SuspiciousFileOperation` exception is raised. \n\nThis change directly addresses the described vulnerability by adding a security measure to prevent directory traversal. Therefore, the function `get_available_name` is relevant to the vulnerability that the commit is trying to fix.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "_set_name", "code_before": "    def _set_name(self, name):\n        # Sanitize the file name so that it can't be dangerous.\n        if name is not None:\n            # Just use the basename of the file -- anything else is dangerous.\n            name = os.path.basename(name)\n\n            # File names longer than 255 characters can cause problems on older OSes.\n            if len(name) > 255:\n                name, ext = os.path.splitext(name)\n                ext = ext[:255]\n                name = name[:255 - len(ext)] + ext\n\n        self._name = name\n", "code_after": "    def _set_name(self, name):\n        # Sanitize the file name so that it can't be dangerous.\n        if name is not None:\n            # Just use the basename of the file -- anything else is dangerous.\n            name = os.path.basename(name)\n\n            # File names longer than 255 characters can cause problems on older OSes.\n            if len(name) > 255:\n                name, ext = os.path.splitext(name)\n                ext = ext[:255]\n                name = name[:255 - len(ext)] + ext\n\n            name = validate_file_name(name)\n\n        self._name = name\n", "commit_message": "[3.1.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/25d84d64122c15050a0ee739e859f22ddab5ac48", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 82833628733011, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `_set_name` is being modified to address a security vulnerability. The vulnerability description states that \"MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.\"\n\nIn the `code_after` section, a new line `name = validate_file_name(name)` has been added. This line appears to be a new security measure to validate the file name and potentially prevent directory traversal attacks.\n\nGiven that the change in the function is directly related to the file name, which is the core of the reported vulnerability, it can be inferred that this function was vulnerable and has been changed to fix the vulnerability.\n\nTherefore, the answer is 1, indicating that the function is vulnerable.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "generate_filename", "code_before": "    def generate_filename(self, instance, filename):\n        \"\"\"\n        Apply (if callable) or prepend (if a string) upload_to to the filename,\n        then delegate further processing of the name to the storage backend.\n        Until the storage layer, all file paths are expected to be Unix style\n        (with forward slashes).\n        \"\"\"\n        if callable(self.upload_to):\n            filename = self.upload_to(instance, filename)\n        else:\n            dirname = datetime.datetime.now().strftime(str(self.upload_to))\n            filename = posixpath.join(dirname, filename)\n        return self.storage.generate_filename(filename)\n", "code_after": "    def generate_filename(self, instance, filename):\n        \"\"\"\n        Apply (if callable) or prepend (if a string) upload_to to the filename,\n        then delegate further processing of the name to the storage backend.\n        Until the storage layer, all file paths are expected to be Unix style\n        (with forward slashes).\n        \"\"\"\n        filename = validate_file_name(filename)\n        if callable(self.upload_to):\n            filename = self.upload_to(instance, filename)\n        else:\n            dirname = datetime.datetime.now().strftime(str(self.upload_to))\n            filename = posixpath.join(dirname, filename)\n        return self.storage.generate_filename(filename)\n", "commit_message": "[3.1.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/25d84d64122c15050a0ee739e859f22ddab5ac48", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 248959616391950, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `generate_filename` is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability description mentions that \"MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.\" \n\nIn the `generate_filename` function, the change is the addition of a line `filename = validate_file_name(filename)`. This line is used to validate the filename of the uploaded file, which directly addresses the issue of directory traversal via uploaded files with suitably crafted file names.\n\nTherefore, the function `generate_filename` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "sanitize_file_name", "code_before": "    def sanitize_file_name(self, file_name):\n        file_name = html.unescape(file_name)\n        # Cleanup Windows-style path separators.\n        file_name = file_name[file_name.rfind('\\\\') + 1:].strip()\n        return os.path.basename(file_name)\n", "code_after": "    def sanitize_file_name(self, file_name):\n        \"\"\"\n        Sanitize the filename of an upload.\n\n        Remove all possible path separators, even though that might remove more\n        than actually required by the target system. Filenames that could\n        potentially cause problems (current/parent dir) are also discarded.\n\n        It should be noted that this function could still return a \"filepath\"\n        like \"C:some_file.txt\" which is handled later on by the storage layer.\n        So while this function does sanitize filenames to some extent, the\n        resulting filename should still be considered as untrusted user input.\n        \"\"\"\n        file_name = html.unescape(file_name)\n        file_name = file_name.rsplit('/')[-1]\n        file_name = file_name.rsplit('\\\\')[-1]\n\n        if file_name in {'', '.', '..'}:\n            return None\n        return file_name\n", "commit_message": "[3.1.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/25d84d64122c15050a0ee739e859f22ddab5ac48", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 165485971485290, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `sanitize_file_name` has been modified to address a security vulnerability. The vulnerability description states that \"MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.\" This suggests that the function was vulnerable to directory traversal attacks due to insufficient sanitization of file names.\n\nIn the updated function, additional sanitization steps have been added. The function now splits the file name by both '/' and '\\\\' and takes the last part, effectively removing any directory paths in the file name. It also checks if the resulting file name is an empty string, '.', or '..', and returns None in these cases. This prevents directory traversal by disallowing file names that could navigate to the current or parent directory.\n\nGiven this information, it can be concluded that the function `sanitize_file_name` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_valid_filename", "code_before": "def get_valid_filename(s):\n    \"\"\"\n    Return the given string converted to a string that can be used for a clean\n    filename. Remove leading and trailing spaces; convert other spaces to\n    underscores; and remove anything that is not an alphanumeric, dash,\n    underscore, or dot.\n    >>> get_valid_filename(\"john's portrait in 2004.jpg\")\n    'johns_portrait_in_2004.jpg'\n    \"\"\"\n    s = str(s).strip().replace(' ', '_')\n    return re.sub(r'(?u)[^-\\w.]', '', s)\n", "code_after": "def get_valid_filename(name):\n    \"\"\"\n    Return the given string converted to a string that can be used for a clean\n    filename. Remove leading and trailing spaces; convert other spaces to\n    underscores; and remove anything that is not an alphanumeric, dash,\n    underscore, or dot.\n    >>> get_valid_filename(\"john's portrait in 2004.jpg\")\n    'johns_portrait_in_2004.jpg'\n    \"\"\"\n    s = str(name).strip().replace(' ', '_')\n    s = re.sub(r'(?u)[^-\\w.]', '', s)\n    if s in {'', '.', '..'}:\n        raise SuspiciousFileOperation(\"Could not derive file name from '%s'\" % name)\n    return s\n", "commit_message": "[3.1.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/25d84d64122c15050a0ee739e859f22ddab5ac48", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 71520501756283, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `get_valid_filename` has been modified to address a security vulnerability. The vulnerability, as described, allowed directory traversal via uploaded files with suitably crafted file names.\n\nIn the updated function, a check has been added to ensure that the sanitized filename is not an empty string, '.', or '..'. If it is, a `SuspiciousFileOperation` exception is raised. This change directly addresses the described vulnerability by preventing directory traversal attacks that could be executed by uploading files with certain names.\n\nTherefore, the function `get_valid_filename` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_available_name", "code_before": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        dir_name, file_name = os.path.split(name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, generate an alternative filename\n        # until it doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n        return name\n", "code_after": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        dir_name, file_name = os.path.split(name)\n        if '..' in pathlib.PurePath(dir_name).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dir_name)\n        validate_file_name(file_name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, generate an alternative filename\n        # until it doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n        return name\n", "commit_message": "[3.2.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/c98f446c188596d4ba6de71d1b77b4a6c5c2a007", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 51965956392713, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "generate_filename", "code_before": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n", "code_after": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        if '..' in pathlib.PurePath(dirname).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dirname)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n"}], "gpt_answer": "The vulnerability described in the advisory is related to directory traversal via uploaded files with suitably crafted file names. The function `get_available_name` is changed to add checks for directory traversal attempts. Specifically, the code checks if '..' is in the directory name, which is a common way to perform directory traversal. If such an attempt is detected, a `SuspiciousFileOperation` exception is raised. This change directly addresses the described vulnerability.\n\nTherefore, the function `get_available_name` is relevant to the vulnerability that the commit is trying to fix, and it was vulnerable before the change.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "generate_filename", "code_before": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n", "code_after": "    def generate_filename(self, filename):\n        \"\"\"\n        Validate the filename by calling get_valid_name() and return a filename\n        to be passed to the save() method.\n        \"\"\"\n        # `filename` may include a path as returned by FileField.upload_to.\n        dirname, filename = os.path.split(filename)\n        if '..' in pathlib.PurePath(dirname).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dirname)\n        return os.path.normpath(os.path.join(dirname, self.get_valid_name(filename)))\n", "commit_message": "[3.2.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/c98f446c188596d4ba6de71d1b77b4a6c5c2a007", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 51965956392713, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "get_available_name", "code_before": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        dir_name, file_name = os.path.split(name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, generate an alternative filename\n        # until it doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n        return name\n", "code_after": "    def get_available_name(self, name, max_length=None):\n        \"\"\"\n        Return a filename that's free on the target storage system and\n        available for new content to be written to.\n        \"\"\"\n        dir_name, file_name = os.path.split(name)\n        if '..' in pathlib.PurePath(dir_name).parts:\n            raise SuspiciousFileOperation(\"Detected path traversal attempt in '%s'\" % dir_name)\n        validate_file_name(file_name)\n        file_root, file_ext = os.path.splitext(file_name)\n        # If the filename already exists, generate an alternative filename\n        # until it doesn't exist.\n        # Truncate original name if required, so the new filename does not\n        # exceed the max_length.\n        while self.exists(name) or (max_length and len(name) > max_length):\n            # file_ext includes the dot.\n            name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n            if max_length is None:\n                continue\n            # Truncate file_root if max_length exceeded.\n            truncation = len(name) - max_length\n            if truncation > 0:\n                file_root = file_root[:-truncation]\n                # Entire file_root was truncated in attempt to find an available filename.\n                if not file_root:\n                    raise SuspiciousFileOperation(\n                        'Storage can not find an available filename for \"%s\". '\n                        'Please make sure that the corresponding file field '\n                        'allows sufficient \"max_length\".' % name\n                    )\n                name = os.path.join(dir_name, self.get_alternative_name(file_root, file_ext))\n        return name\n"}], "gpt_answer": "The function \"generate_filename\" is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability description states that \"MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.\" The change in the \"generate_filename\" function is directly addressing this issue by adding a check for directory traversal attempts in the 'dirname' variable. If '..' is found in the 'dirname', a SuspiciousFileOperation exception is raised, effectively preventing the directory traversal.\n\nTherefore, the function \"generate_filename\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "_set_name", "code_before": "    def _set_name(self, name):\n        # Sanitize the file name so that it can't be dangerous.\n        if name is not None:\n            # Just use the basename of the file -- anything else is dangerous.\n            name = os.path.basename(name)\n\n            # File names longer than 255 characters can cause problems on older OSes.\n            if len(name) > 255:\n                name, ext = os.path.splitext(name)\n                ext = ext[:255]\n                name = name[:255 - len(ext)] + ext\n\n        self._name = name\n", "code_after": "    def _set_name(self, name):\n        # Sanitize the file name so that it can't be dangerous.\n        if name is not None:\n            # Just use the basename of the file -- anything else is dangerous.\n            name = os.path.basename(name)\n\n            # File names longer than 255 characters can cause problems on older OSes.\n            if len(name) > 255:\n                name, ext = os.path.splitext(name)\n                ext = ext[:255]\n                name = name[:255 - len(ext)] + ext\n\n            name = validate_file_name(name)\n\n        self._name = name\n", "commit_message": "[3.2.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/c98f446c188596d4ba6de71d1b77b4a6c5c2a007", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 66995424949397, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `_set_name` is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability description mentions that \"MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.\" The function `_set_name` is responsible for setting the name of a file, and the changes made to this function are directly related to sanitizing the file name to prevent dangerous inputs.\n\nIn the `code_after` snippet, a new line `name = validate_file_name(name)` has been added. This line is not present in the `code_before` snippet. This new line of code is likely a function call to validate the file name, which would help prevent directory traversal attacks by ensuring that the file name does not contain any dangerous characters or sequences.\n\nTherefore, the function `_set_name` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "generate_filename", "code_before": "    def generate_filename(self, instance, filename):\n        \"\"\"\n        Apply (if callable) or prepend (if a string) upload_to to the filename,\n        then delegate further processing of the name to the storage backend.\n        Until the storage layer, all file paths are expected to be Unix style\n        (with forward slashes).\n        \"\"\"\n        if callable(self.upload_to):\n            filename = self.upload_to(instance, filename)\n        else:\n            dirname = datetime.datetime.now().strftime(str(self.upload_to))\n            filename = posixpath.join(dirname, filename)\n        return self.storage.generate_filename(filename)\n", "code_after": "    def generate_filename(self, instance, filename):\n        \"\"\"\n        Apply (if callable) or prepend (if a string) upload_to to the filename,\n        then delegate further processing of the name to the storage backend.\n        Until the storage layer, all file paths are expected to be Unix style\n        (with forward slashes).\n        \"\"\"\n        filename = validate_file_name(filename)\n        if callable(self.upload_to):\n            filename = self.upload_to(instance, filename)\n        else:\n            dirname = datetime.datetime.now().strftime(str(self.upload_to))\n            filename = posixpath.join(dirname, filename)\n        return self.storage.generate_filename(filename)\n", "commit_message": "[3.2.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/c98f446c188596d4ba6de71d1b77b4a6c5c2a007", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 51540478287353, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `generate_filename` is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability description mentions that \"MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.\" \n\nIn the `generate_filename` function, the change is the addition of a line `filename = validate_file_name(filename)`. This line is used to validate the filename of the uploaded file, which directly addresses the vulnerability of directory traversal via uploaded files with crafted file names.\n\nTherefore, the function `generate_filename` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "sanitize_file_name", "code_before": "    def sanitize_file_name(self, file_name):\n        file_name = html.unescape(file_name)\n        # Cleanup Windows-style path separators.\n        file_name = file_name[file_name.rfind('\\\\') + 1:].strip()\n        return os.path.basename(file_name)\n", "code_after": "    def sanitize_file_name(self, file_name):\n        \"\"\"\n        Sanitize the filename of an upload.\n\n        Remove all possible path separators, even though that might remove more\n        than actually required by the target system. Filenames that could\n        potentially cause problems (current/parent dir) are also discarded.\n\n        It should be noted that this function could still return a \"filepath\"\n        like \"C:some_file.txt\" which is handled later on by the storage layer.\n        So while this function does sanitize filenames to some extent, the\n        resulting filename should still be considered as untrusted user input.\n        \"\"\"\n        file_name = html.unescape(file_name)\n        file_name = file_name.rsplit('/')[-1]\n        file_name = file_name.rsplit('\\\\')[-1]\n\n        if file_name in {'', '.', '..'}:\n            return None\n        return file_name\n", "commit_message": "[3.2.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/c98f446c188596d4ba6de71d1b77b4a6c5c2a007", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 50020624510288, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"sanitize_file_name\" has been modified to address a security vulnerability. The vulnerability description states that \"MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.\" \n\nIn the \"code_after\" section, we can see that the function has been updated to sanitize the filename of an upload more thoroughly. It now removes all possible path separators and discards filenames that could potentially cause problems (current/parent dir). \n\nThis change directly addresses the described vulnerability, which involves directory traversal via uploaded files with suitably crafted file names. Therefore, it can be concluded that the function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_valid_filename", "code_before": "def get_valid_filename(s):\n    \"\"\"\n    Return the given string converted to a string that can be used for a clean\n    filename. Remove leading and trailing spaces; convert other spaces to\n    underscores; and remove anything that is not an alphanumeric, dash,\n    underscore, or dot.\n    >>> get_valid_filename(\"john's portrait in 2004.jpg\")\n    'johns_portrait_in_2004.jpg'\n    \"\"\"\n    s = str(s).strip().replace(' ', '_')\n    return re.sub(r'(?u)[^-\\w.]', '', s)\n", "code_after": "def get_valid_filename(name):\n    \"\"\"\n    Return the given string converted to a string that can be used for a clean\n    filename. Remove leading and trailing spaces; convert other spaces to\n    underscores; and remove anything that is not an alphanumeric, dash,\n    underscore, or dot.\n    >>> get_valid_filename(\"john's portrait in 2004.jpg\")\n    'johns_portrait_in_2004.jpg'\n    \"\"\"\n    s = str(name).strip().replace(' ', '_')\n    s = re.sub(r'(?u)[^-\\w.]', '', s)\n    if s in {'', '.', '..'}:\n        raise SuspiciousFileOperation(\"Could not derive file name from '%s'\" % name)\n    return s\n", "commit_message": "[3.2.x] Fixed CVE-2021-31542 -- Tightened path & file name sanitation in file uploads.", "commit": "https://github.com/django/django/commit/c98f446c188596d4ba6de71d1b77b4a6c5c2a007", "description": "In Django 2.2 before 2.2.21, 3.1 before 3.1.9, and 3.2 before 3.2.1, MultiPartParser, UploadedFile, and FieldFile allowed directory traversal via uploaded files with suitably crafted file names.", "file_change_id": 44471921003130, "report_link": "https://github.com/advisories/GHSA-rxjp-mfm9-w4wr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `get_valid_filename` has been modified to address a security vulnerability. The vulnerability, as described, allowed directory traversal via uploaded files with suitably crafted file names.\n\nIn the updated function, a check has been added to raise a `SuspiciousFileOperation` exception if the sanitized filename is empty, a single dot, or two dots. These are common indicators of directory traversal attempts, where an attacker tries to move up in the directory structure.\n\nThe commit message also supports this, stating that the commit is intended to fix a vulnerability by tightening path and file name sanitation in file uploads.\n\nTherefore, it can be concluded that the function `get_valid_filename` was vulnerable and has been changed to address the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "make_after_request_function", "code_before": "def make_after_request_function(resources):\n    def cors_after_request(resp):\n        # If CORS headers are set in a view decorator, pass\n        if resp.headers is not None and resp.headers.get(ACL_ORIGIN):\n            LOG.debug('CORS have been already evaluated, skipping')\n            return resp\n\n        for res_regex, res_options in resources:\n            if try_match(request.path, res_regex):\n                LOG.debug(\"Request to '%s' matches CORS resource '%s'. Using options: %s\",\n                      request.path, get_regexp_pattern(res_regex), res_options)\n                set_cors_headers(resp, res_options)\n                break\n        else:\n            LOG.debug('No CORS rule matches')\n        return resp\n    return cors_after_request\n", "code_after": "def make_after_request_function(resources):\n    def cors_after_request(resp):\n        # If CORS headers are set in a view decorator, pass\n        if resp.headers is not None and resp.headers.get(ACL_ORIGIN):\n            LOG.debug('CORS have been already evaluated, skipping')\n            return resp\n        normalized_path = unquote_plus(request.path)\n        for res_regex, res_options in resources:\n            if try_match(normalized_path, res_regex):\n                LOG.debug(\"Request to '%s' matches CORS resource '%s'. Using options: %s\",\n                      request.path, get_regexp_pattern(res_regex), res_options)\n                set_cors_headers(resp, res_options)\n                break\n        else:\n            LOG.debug('No CORS rule matches')\n        return resp\n    return cors_after_request\n", "commit_message": "Fix request path normalization (#272)\n\n* Normalize path before evaluating resource rules", "commit": "https://github.com/corydolphin/flask-cors/commit/67c4b2cc98ae87cf1fa7df4f97fd81b40c79b895", "description": "An issue was discovered in Flask-CORS (aka CORS Middleware for Flask) before 3.0.9. It allows `../` directory traversal to access private resources because resource matching does not ensure that pathnames are in a canonical format.", "file_change_id": 29224895442801, "report_link": "https://github.com/advisories/GHSA-xc3p-ff3m-f46v", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "make_after_request_function.cors_after_request", "code_before": "    def cors_after_request(resp):\n        # If CORS headers are set in a view decorator, pass\n        if resp.headers is not None and resp.headers.get(ACL_ORIGIN):\n            LOG.debug('CORS have been already evaluated, skipping')\n            return resp\n\n        for res_regex, res_options in resources:\n            if try_match(request.path, res_regex):\n                LOG.debug(\"Request to '%s' matches CORS resource '%s'. Using options: %s\",\n                      request.path, get_regexp_pattern(res_regex), res_options)\n                set_cors_headers(resp, res_options)\n                break\n        else:\n            LOG.debug('No CORS rule matches')\n        return resp\n    return cors_after_request", "code_after": "    def cors_after_request(resp):\n        # If CORS headers are set in a view decorator, pass\n        if resp.headers is not None and resp.headers.get(ACL_ORIGIN):\n            LOG.debug('CORS have been already evaluated, skipping')\n            return resp\n        normalized_path = unquote_plus(request.path)\n        for res_regex, res_options in resources:\n            if try_match(normalized_path, res_regex):\n                LOG.debug(\"Request to '%s' matches CORS resource '%s'. Using options: %s\",\n                      request.path, get_regexp_pattern(res_regex), res_options)\n                set_cors_headers(resp, res_options)\n                break\n        else:\n            LOG.debug('No CORS rule matches')\n        return resp\n    return cors_after_request"}], "gpt_answer": "The vulnerability described in the advisory is related to directory traversal due to resource matching not ensuring that pathnames are in a canonical format. The change in the function \"make_after_request_function\" is directly related to this vulnerability. \n\nIn the \"code_after\" section, a new line of code is added that normalizes the request path using the `unquote_plus(request.path)` function. This normalized path is then used in the `try_match` function to match the request path with the resource regular expression. This change is made to prevent directory traversal attacks by ensuring that the path used for resource matching is in a canonical format.\n\nTherefore, the function \"make_after_request_function\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "make_after_request_function.cors_after_request", "code_before": "    def cors_after_request(resp):\n        # If CORS headers are set in a view decorator, pass\n        if resp.headers is not None and resp.headers.get(ACL_ORIGIN):\n            LOG.debug('CORS have been already evaluated, skipping')\n            return resp\n\n        for res_regex, res_options in resources:\n            if try_match(request.path, res_regex):\n                LOG.debug(\"Request to '%s' matches CORS resource '%s'. Using options: %s\",\n                      request.path, get_regexp_pattern(res_regex), res_options)\n                set_cors_headers(resp, res_options)\n                break\n        else:\n            LOG.debug('No CORS rule matches')\n        return resp\n    return cors_after_request", "code_after": "    def cors_after_request(resp):\n        # If CORS headers are set in a view decorator, pass\n        if resp.headers is not None and resp.headers.get(ACL_ORIGIN):\n            LOG.debug('CORS have been already evaluated, skipping')\n            return resp\n        normalized_path = unquote_plus(request.path)\n        for res_regex, res_options in resources:\n            if try_match(normalized_path, res_regex):\n                LOG.debug(\"Request to '%s' matches CORS resource '%s'. Using options: %s\",\n                      request.path, get_regexp_pattern(res_regex), res_options)\n                set_cors_headers(resp, res_options)\n                break\n        else:\n            LOG.debug('No CORS rule matches')\n        return resp\n    return cors_after_request", "commit_message": "Fix request path normalization (#272)\n\n* Normalize path before evaluating resource rules", "commit": "https://github.com/corydolphin/flask-cors/commit/67c4b2cc98ae87cf1fa7df4f97fd81b40c79b895", "description": "An issue was discovered in Flask-CORS (aka CORS Middleware for Flask) before 3.0.9. It allows `../` directory traversal to access private resources because resource matching does not ensure that pathnames are in a canonical format.", "file_change_id": 29224895442801, "report_link": "https://github.com/advisories/GHSA-xc3p-ff3m-f46v", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "make_after_request_function", "code_before": "def make_after_request_function(resources):\n    def cors_after_request(resp):\n        # If CORS headers are set in a view decorator, pass\n        if resp.headers is not None and resp.headers.get(ACL_ORIGIN):\n            LOG.debug('CORS have been already evaluated, skipping')\n            return resp\n\n        for res_regex, res_options in resources:\n            if try_match(request.path, res_regex):\n                LOG.debug(\"Request to '%s' matches CORS resource '%s'. Using options: %s\",\n                      request.path, get_regexp_pattern(res_regex), res_options)\n                set_cors_headers(resp, res_options)\n                break\n        else:\n            LOG.debug('No CORS rule matches')\n        return resp\n    return cors_after_request\n", "code_after": "def make_after_request_function(resources):\n    def cors_after_request(resp):\n        # If CORS headers are set in a view decorator, pass\n        if resp.headers is not None and resp.headers.get(ACL_ORIGIN):\n            LOG.debug('CORS have been already evaluated, skipping')\n            return resp\n        normalized_path = unquote_plus(request.path)\n        for res_regex, res_options in resources:\n            if try_match(normalized_path, res_regex):\n                LOG.debug(\"Request to '%s' matches CORS resource '%s'. Using options: %s\",\n                      request.path, get_regexp_pattern(res_regex), res_options)\n                set_cors_headers(resp, res_options)\n                break\n        else:\n            LOG.debug('No CORS rule matches')\n        return resp\n    return cors_after_request\n"}], "gpt_answer": "The provided information indicates that the function \"cors_after_request\" is part of the \"make_after_request_function\" and it has been modified to address a vulnerability. The vulnerability description states that the Flask-CORS library allowed directory traversal to access private resources because resource matching did not ensure that pathnames are in a canonical format.\n\nIn the \"cors_after_request\" function, the change is the addition of the line `normalized_path = unquote_plus(request.path)`. This line is used to normalize the request path before it is matched with the resource rules. This change directly addresses the vulnerability by ensuring that the pathnames are in a canonical format before they are processed, thus preventing directory traversal attacks.\n\nTherefore, the function \"cors_after_request\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "_extract_tar_file", "code_before": "def _extract_tar_file(tar, filename, b_dest, b_temp_path, expected_hash=None):\n    n_filename = to_native(filename, errors='surrogate_or_strict')\n    try:\n        member = tar.getmember(n_filename)\n    except KeyError:\n        raise AnsibleError(\"Collection tar at '%s' does not contain the expected file '%s'.\" % (to_native(tar.name),\n                                                                                                n_filename))\n\n    with tempfile.NamedTemporaryFile(dir=b_temp_path, delete=False) as tmpfile_obj:\n        bufsize = 65536\n        sha256_digest = sha256()\n        with _tarfile_extract(tar, member) as tar_obj:\n            data = tar_obj.read(bufsize)\n            while data:\n                tmpfile_obj.write(data)\n                tmpfile_obj.flush()\n                sha256_digest.update(data)\n                data = tar_obj.read(bufsize)\n\n        actual_hash = sha256_digest.hexdigest()\n\n        if expected_hash and actual_hash != expected_hash:\n            raise AnsibleError(\"Checksum mismatch for '%s' inside collection at '%s'\"\n                               % (n_filename, to_native(tar.name)))\n\n        b_dest_filepath = os.path.join(b_dest, to_bytes(filename, errors='surrogate_or_strict'))\n        b_parent_dir = os.path.split(b_dest_filepath)[0]\n        if not os.path.exists(b_parent_dir):\n            # Seems like Galaxy does not validate if all file entries have a corresponding dir ftype entry. This check\n            # makes sure we create the parent directory even if it wasn't set in the metadata.\n            os.makedirs(b_parent_dir, mode=0o0755)\n\n        shutil.move(to_bytes(tmpfile_obj.name, errors='surrogate_or_strict'), b_dest_filepath)\n\n        # Default to rw-r--r-- and only add execute if the tar file has execute.\n        new_mode = 0o644\n        if stat.S_IMODE(member.mode) & stat.S_IXUSR:\n            new_mode |= 0o0111\n\n        os.chmod(b_dest_filepath, new_mode)\n", "code_after": "def _extract_tar_file(tar, filename, b_dest, b_temp_path, expected_hash=None):\n    n_filename = to_native(filename, errors='surrogate_or_strict')\n    try:\n        member = tar.getmember(n_filename)\n    except KeyError:\n        raise AnsibleError(\"Collection tar at '%s' does not contain the expected file '%s'.\" % (to_native(tar.name),\n                                                                                                n_filename))\n\n    with tempfile.NamedTemporaryFile(dir=b_temp_path, delete=False) as tmpfile_obj:\n        bufsize = 65536\n        sha256_digest = sha256()\n        with _tarfile_extract(tar, member) as tar_obj:\n            data = tar_obj.read(bufsize)\n            while data:\n                tmpfile_obj.write(data)\n                tmpfile_obj.flush()\n                sha256_digest.update(data)\n                data = tar_obj.read(bufsize)\n\n        actual_hash = sha256_digest.hexdigest()\n\n        if expected_hash and actual_hash != expected_hash:\n            raise AnsibleError(\"Checksum mismatch for '%s' inside collection at '%s'\"\n                               % (n_filename, to_native(tar.name)))\n\n        b_dest_filepath = os.path.abspath(os.path.join(b_dest, to_bytes(filename, errors='surrogate_or_strict')))\n        b_parent_dir = os.path.dirname(b_dest_filepath)\n        if b_parent_dir != b_dest and not b_parent_dir.startswith(b_dest + to_bytes(os.path.sep)):\n            raise AnsibleError(\"Cannot extract tar entry '%s' as it will be placed outside the collection directory\"\n                               % to_native(filename, errors='surrogate_or_strict'))\n\n        if not os.path.exists(b_parent_dir):\n            # Seems like Galaxy does not validate if all file entries have a corresponding dir ftype entry. This check\n            # makes sure we create the parent directory even if it wasn't set in the metadata.\n            os.makedirs(b_parent_dir, mode=0o0755)\n\n        shutil.move(to_bytes(tmpfile_obj.name, errors='surrogate_or_strict'), b_dest_filepath)\n\n        # Default to rw-r--r-- and only add execute if the tar file has execute.\n        new_mode = 0o644\n        if stat.S_IMODE(member.mode) & stat.S_IXUSR:\n            new_mode |= 0o0111\n\n        os.chmod(b_dest_filepath, new_mode)\n", "commit_message": "ansible-galaxy - Fix tar path traversal issue during install - CVE-2020-10691 - 2.9 (#68601)\n\n* ansible-galaxy - Fix tar path traversal issue during install - CVE-2020-10691 (#68596)\r\n\r\n(cherry picked from commit a20a52701402a12f91396549df04ac55809f68e9)\r\n\r\n* Remove extra tests missing from rebase", "commit": "https://github.com/ansible/ansible/commit/b2551bb6943eec078066aa3a923e0bb3ed85abe8", "description": "An archive traversal flaw was found in all ansible-engine versions 2.9.x prior to 2.9.7, when running `ansible-galaxy collection` install. When extracting a collection .tar.gz file, the directory is created without sanitizing the filename. An attacker could take advantage to overwrite any file within the system.", "file_change_id": 190829886329118, "report_link": "https://github.com/advisories/GHSA-3c67-gc48-983w", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "install", "code_before": "    def install(self, path, b_temp_path):\n        if self.skip:\n            display.display(\"Skipping '%s' as it is already installed\" % to_text(self))\n            return\n\n        # Install if it is not\n        collection_path = os.path.join(path, self.namespace, self.name)\n        b_collection_path = to_bytes(collection_path, errors='surrogate_or_strict')\n        display.display(\"Installing '%s:%s' to '%s'\" % (to_text(self), self.latest_version, collection_path))\n\n        if self.b_path is None:\n            download_url = self._metadata.download_url\n            artifact_hash = self._metadata.artifact_sha256\n            headers = {}\n            self.api._add_auth_token(headers, download_url, required=False)\n\n            self.b_path = _download_file(download_url, b_temp_path, artifact_hash, self.api.validate_certs,\n                                         headers=headers)\n\n        if os.path.exists(b_collection_path):\n            shutil.rmtree(b_collection_path)\n        os.makedirs(b_collection_path)\n\n        with tarfile.open(self.b_path, mode='r') as collection_tar:\n            files_member_obj = collection_tar.getmember('FILES.json')\n            with _tarfile_extract(collection_tar, files_member_obj) as files_obj:\n                files = json.loads(to_text(files_obj.read(), errors='surrogate_or_strict'))\n\n            _extract_tar_file(collection_tar, 'MANIFEST.json', b_collection_path, b_temp_path)\n            _extract_tar_file(collection_tar, 'FILES.json', b_collection_path, b_temp_path)\n\n            for file_info in files['files']:\n                file_name = file_info['name']\n                if file_name == '.':\n                    continue\n\n                if file_info['ftype'] == 'file':\n                    _extract_tar_file(collection_tar, file_name, b_collection_path, b_temp_path,\n                                      expected_hash=file_info['chksum_sha256'])\n                else:\n                    os.makedirs(os.path.join(b_collection_path, to_bytes(file_name, errors='surrogate_or_strict')))\n", "code_after": "    def install(self, path, b_temp_path):\n        if self.skip:\n            display.display(\"Skipping '%s' as it is already installed\" % to_text(self))\n            return\n\n        # Install if it is not\n        collection_path = os.path.join(path, self.namespace, self.name)\n        b_collection_path = to_bytes(collection_path, errors='surrogate_or_strict')\n        display.display(\"Installing '%s:%s' to '%s'\" % (to_text(self), self.latest_version, collection_path))\n\n        if self.b_path is None:\n            download_url = self._metadata.download_url\n            artifact_hash = self._metadata.artifact_sha256\n            headers = {}\n            self.api._add_auth_token(headers, download_url, required=False)\n\n            self.b_path = _download_file(download_url, b_temp_path, artifact_hash, self.api.validate_certs,\n                                         headers=headers)\n\n        if os.path.exists(b_collection_path):\n            shutil.rmtree(b_collection_path)\n        os.makedirs(b_collection_path)\n\n        try:\n            with tarfile.open(self.b_path, mode='r') as collection_tar:\n                files_member_obj = collection_tar.getmember('FILES.json')\n                with _tarfile_extract(collection_tar, files_member_obj) as files_obj:\n                    files = json.loads(to_text(files_obj.read(), errors='surrogate_or_strict'))\n\n                _extract_tar_file(collection_tar, 'MANIFEST.json', b_collection_path, b_temp_path)\n                _extract_tar_file(collection_tar, 'FILES.json', b_collection_path, b_temp_path)\n\n                for file_info in files['files']:\n                    file_name = file_info['name']\n                    if file_name == '.':\n                        continue\n\n                    if file_info['ftype'] == 'file':\n                        _extract_tar_file(collection_tar, file_name, b_collection_path, b_temp_path,\n                                          expected_hash=file_info['chksum_sha256'])\n                    else:\n                        os.makedirs(os.path.join(b_collection_path, to_bytes(file_name, errors='surrogate_or_strict')))\n        except Exception:\n            # Ensure we don't leave the dir behind in case of a failure.\n            shutil.rmtree(b_collection_path)\n\n            b_namespace_path = os.path.dirname(b_collection_path)\n            if not os.listdir(b_namespace_path):\n                os.rmdir(b_namespace_path)\n\n            raise\n"}], "gpt_answer": "The provided information indicates that the function `_extract_tar_file` is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability is described as an archive traversal flaw that allows an attacker to overwrite any file within the system. \n\nIn the `code_after` section, we can see that the function has been modified to include a check that prevents the extraction of a tar entry if it will be placed outside the collection directory. This is done by comparing the absolute path of the destination file (`b_dest_filepath`) with the base destination directory (`b_dest`). If the destination file is not within the base directory, an error is raised. This change directly addresses the described vulnerability by preventing path traversal outside of the intended directory.\n\nTherefore, the function `_extract_tar_file` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "extract", "code_before": "    def extract(self, to_path):\n        members = self._archive.getmembers()\n        leading = self.has_leading_dir(x.name for x in members)\n        for member in members:\n            name = member.name\n            if leading:\n                name = self.split_leading_dir(name)[1]\n            filename = os.path.join(to_path, name)\n            if member.isdir():\n                if filename:\n                    os.makedirs(filename, exist_ok=True)\n            else:\n                try:\n                    extracted = self._archive.extractfile(member)\n                except (KeyError, AttributeError) as exc:\n                    # Some corrupt tar files seem to produce this\n                    # (specifically bad symlinks)\n                    print(\"In the tar file %s the member %s is invalid: %s\" %\n                          (name, member.name, exc))\n                else:\n                    dirname = os.path.dirname(filename)\n                    if dirname:\n                        os.makedirs(dirname, exist_ok=True)\n                    with open(filename, 'wb') as outfile:\n                        shutil.copyfileobj(extracted, outfile)\n                        self._copy_permissions(member.mode, filename)\n                finally:\n                    if extracted:\n                        extracted.close()\n", "code_after": "    def extract(self, to_path):\n        members = self._archive.getmembers()\n        leading = self.has_leading_dir(x.name for x in members)\n        for member in members:\n            name = member.name\n            if leading:\n                name = self.split_leading_dir(name)[1]\n            filename = self.target_filename(to_path, name)\n            if member.isdir():\n                if filename:\n                    os.makedirs(filename, exist_ok=True)\n            else:\n                try:\n                    extracted = self._archive.extractfile(member)\n                except (KeyError, AttributeError) as exc:\n                    # Some corrupt tar files seem to produce this\n                    # (specifically bad symlinks)\n                    print(\"In the tar file %s the member %s is invalid: %s\" %\n                          (name, member.name, exc))\n                else:\n                    dirname = os.path.dirname(filename)\n                    if dirname:\n                        os.makedirs(dirname, exist_ok=True)\n                    with open(filename, 'wb') as outfile:\n                        shutil.copyfileobj(extracted, outfile)\n                        self._copy_permissions(member.mode, filename)\n                finally:\n                    if extracted:\n                        extracted.close()\n", "commit_message": "Fixed CVE-2021-3281 -- Fixed potential directory-traversal via archive.extract().\n\nThanks Florian Apolloner, Shai Berger, and Simon Charette for reviews.\n\nThanks Wang Baohua for the report.", "commit": "https://github.com/django/django/commit/05413afa8c18cdb978fcdf470e09f7a12b234a23", "description": "In Django 2.2 before 2.2.18, 3.0 before 3.0.12, and 3.1 before 3.1.6, the django.utils.archive.extract method (used by \"startapp --template\" and \"startproject --template\") allows directory traversal via an archive with absolute paths or relative paths with dot segments.", "file_change_id": 46121183362671, "report_link": "https://github.com/advisories/GHSA-fvgf-6h6h-3322", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `extract` is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability description mentions that the `django.utils.archive.extract` method allows directory traversal via an archive with absolute paths or relative paths with dot segments. This is the exact function that is being modified in the commit.\n\nThe change in the function is the replacement of the line `filename = os.path.join(to_path, name)` with `filename = self.target_filename(to_path, name)`. This change seems to be aimed at addressing the directory traversal issue by ensuring that the target filename is correctly generated, presumably in a way that prevents directory traversal.\n\nTherefore, the function `extract` appears to be vulnerable and has been changed to address the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "extract", "code_before": "    def extract(self, to_path):\n        members = self._archive.getmembers()\n        leading = self.has_leading_dir(x.name for x in members)\n        for member in members:\n            name = member.name\n            if leading:\n                name = self.split_leading_dir(name)[1]\n            filename = os.path.join(to_path, name)\n            if member.isdir():\n                if filename:\n                    os.makedirs(filename, exist_ok=True)\n            else:\n                try:\n                    extracted = self._archive.extractfile(member)\n                except (KeyError, AttributeError) as exc:\n                    # Some corrupt tar files seem to produce this\n                    # (specifically bad symlinks)\n                    print(\"In the tar file %s the member %s is invalid: %s\" %\n                          (name, member.name, exc))\n                else:\n                    dirname = os.path.dirname(filename)\n                    if dirname:\n                        os.makedirs(dirname, exist_ok=True)\n                    with open(filename, 'wb') as outfile:\n                        shutil.copyfileobj(extracted, outfile)\n                        self._copy_permissions(member.mode, filename)\n                finally:\n                    if extracted:\n                        extracted.close()\n", "code_after": "    def extract(self, to_path):\n        members = self._archive.getmembers()\n        leading = self.has_leading_dir(x.name for x in members)\n        for member in members:\n            name = member.name\n            if leading:\n                name = self.split_leading_dir(name)[1]\n            filename = self.target_filename(to_path, name)\n            if member.isdir():\n                if filename:\n                    os.makedirs(filename, exist_ok=True)\n            else:\n                try:\n                    extracted = self._archive.extractfile(member)\n                except (KeyError, AttributeError) as exc:\n                    # Some corrupt tar files seem to produce this\n                    # (specifically bad symlinks)\n                    print(\"In the tar file %s the member %s is invalid: %s\" %\n                          (name, member.name, exc))\n                else:\n                    dirname = os.path.dirname(filename)\n                    if dirname:\n                        os.makedirs(dirname, exist_ok=True)\n                    with open(filename, 'wb') as outfile:\n                        shutil.copyfileobj(extracted, outfile)\n                        self._copy_permissions(member.mode, filename)\n                finally:\n                    if extracted:\n                        extracted.close()\n", "commit_message": "[3.1.x] Fixed CVE-2021-3281 -- Fixed potential directory-traversal via archive.extract().\n\nThanks Florian Apolloner, Shai Berger, and Simon Charette for reviews.\n\nThanks Wang Baohua for the report.\n\nBackport of 05413afa8c18cdb978fcdf470e09f7a12b234a23 from master.", "commit": "https://github.com/django/django/commit/02e6592835b4559909aa3aaaf67988fef435f624", "description": "In Django 2.2 before 2.2.18, 3.0 before 3.0.12, and 3.1 before 3.1.6, the django.utils.archive.extract method (used by \"startapp --template\" and \"startproject --template\") allows directory traversal via an archive with absolute paths or relative paths with dot segments.", "file_change_id": 264987191967702, "report_link": "https://github.com/advisories/GHSA-fvgf-6h6h-3322", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `extract` is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability description mentions that the `django.utils.archive.extract` method allows directory traversal via an archive with absolute paths or relative paths with dot segments. This is the exact function that is being modified in the commit.\n\nIn the `code_after` section, we can see that the line `filename = os.path.join(to_path, name)` has been replaced with `filename = self.target_filename(to_path, name)`. This change seems to be a direct response to the vulnerability, likely adding additional checks or sanitization to the filename to prevent directory traversal.\n\nTherefore, the function `extract` is vulnerable and has been changed to address the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "extract", "code_before": "    def extract(self, to_path):\n        members = self._archive.getmembers()\n        leading = self.has_leading_dir(x.name for x in members)\n        for member in members:\n            name = member.name\n            if leading:\n                name = self.split_leading_dir(name)[1]\n            filename = os.path.join(to_path, name)\n            if member.isdir():\n                if filename and not os.path.exists(filename):\n                    os.makedirs(filename)\n            else:\n                try:\n                    extracted = self._archive.extractfile(member)\n                except (KeyError, AttributeError) as exc:\n                    # Some corrupt tar files seem to produce this\n                    # (specifically bad symlinks)\n                    print(\"In the tar file %s the member %s is invalid: %s\" %\n                          (name, member.name, exc))\n                else:\n                    dirname = os.path.dirname(filename)\n                    if dirname and not os.path.exists(dirname):\n                        os.makedirs(dirname)\n                    with open(filename, 'wb') as outfile:\n                        shutil.copyfileobj(extracted, outfile)\n                        self._copy_permissions(member.mode, filename)\n                finally:\n                    if extracted:\n                        extracted.close()\n", "code_after": "    def extract(self, to_path):\n        members = self._archive.getmembers()\n        leading = self.has_leading_dir(x.name for x in members)\n        for member in members:\n            name = member.name\n            if leading:\n                name = self.split_leading_dir(name)[1]\n            filename = self.target_filename(to_path, name)\n            if member.isdir():\n                if filename and not os.path.exists(filename):\n                    os.makedirs(filename)\n            else:\n                try:\n                    extracted = self._archive.extractfile(member)\n                except (KeyError, AttributeError) as exc:\n                    # Some corrupt tar files seem to produce this\n                    # (specifically bad symlinks)\n                    print(\"In the tar file %s the member %s is invalid: %s\" %\n                          (name, member.name, exc))\n                else:\n                    dirname = os.path.dirname(filename)\n                    if dirname and not os.path.exists(dirname):\n                        os.makedirs(dirname)\n                    with open(filename, 'wb') as outfile:\n                        shutil.copyfileobj(extracted, outfile)\n                        self._copy_permissions(member.mode, filename)\n                finally:\n                    if extracted:\n                        extracted.close()\n", "commit_message": "[2.2.x] Fixed CVE-2021-3281 -- Fixed potential directory-traversal via archive.extract().\n\nThanks Florian Apolloner, Shai Berger, and Simon Charette for reviews.\n\nThanks Wang Baohua for the report.\n\nBackport of 05413afa8c18cdb978fcdf470e09f7a12b234a23 from master.", "commit": "https://github.com/django/django/commit/21e7622dec1f8612c85c2fc37fe8efbfd3311e37", "description": "In Django 2.2 before 2.2.18, 3.0 before 3.0.12, and 3.1 before 3.1.6, the django.utils.archive.extract method (used by \"startapp --template\" and \"startproject --template\") allows directory traversal via an archive with absolute paths or relative paths with dot segments.", "file_change_id": 221731301926177, "report_link": "https://github.com/advisories/GHSA-fvgf-6h6h-3322", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `extract` is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability description mentions that the `django.utils.archive.extract` method allows directory traversal via an archive with absolute paths or relative paths with dot segments. This is the exact function that has been changed in the commit.\n\nThe change in the function is the way the `filename` is determined. In the `code_before`, `filename` is determined by joining `to_path` and `name`. In the `code_after`, `filename` is determined by a new method `self.target_filename(to_path, name)`. This change is likely to address the directory traversal issue by ensuring that the target filename is correctly and safely determined.\n\nTherefore, the function `extract` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "extract", "code_before": "    def extract(self, to_path):\n        members = self._archive.getmembers()\n        leading = self.has_leading_dir(x.name for x in members)\n        for member in members:\n            name = member.name\n            if leading:\n                name = self.split_leading_dir(name)[1]\n            filename = os.path.join(to_path, name)\n            if member.isdir():\n                if filename:\n                    os.makedirs(filename, exist_ok=True)\n            else:\n                try:\n                    extracted = self._archive.extractfile(member)\n                except (KeyError, AttributeError) as exc:\n                    # Some corrupt tar files seem to produce this\n                    # (specifically bad symlinks)\n                    print(\"In the tar file %s the member %s is invalid: %s\" %\n                          (name, member.name, exc))\n                else:\n                    dirname = os.path.dirname(filename)\n                    if dirname:\n                        os.makedirs(dirname, exist_ok=True)\n                    with open(filename, 'wb') as outfile:\n                        shutil.copyfileobj(extracted, outfile)\n                        self._copy_permissions(member.mode, filename)\n                finally:\n                    if extracted:\n                        extracted.close()\n", "code_after": "    def extract(self, to_path):\n        members = self._archive.getmembers()\n        leading = self.has_leading_dir(x.name for x in members)\n        for member in members:\n            name = member.name\n            if leading:\n                name = self.split_leading_dir(name)[1]\n            filename = self.target_filename(to_path, name)\n            if member.isdir():\n                if filename:\n                    os.makedirs(filename, exist_ok=True)\n            else:\n                try:\n                    extracted = self._archive.extractfile(member)\n                except (KeyError, AttributeError) as exc:\n                    # Some corrupt tar files seem to produce this\n                    # (specifically bad symlinks)\n                    print(\"In the tar file %s the member %s is invalid: %s\" %\n                          (name, member.name, exc))\n                else:\n                    dirname = os.path.dirname(filename)\n                    if dirname:\n                        os.makedirs(dirname, exist_ok=True)\n                    with open(filename, 'wb') as outfile:\n                        shutil.copyfileobj(extracted, outfile)\n                        self._copy_permissions(member.mode, filename)\n                finally:\n                    if extracted:\n                        extracted.close()\n", "commit_message": "[3.0.x] Fixed CVE-2021-3281 -- Fixed potential directory-traversal via archive.extract().\n\nThanks Florian Apolloner, Shai Berger, and Simon Charette for reviews.\n\nThanks Wang Baohua for the report.\n\nBackport of 05413afa8c18cdb978fcdf470e09f7a12b234a23 from master.", "commit": "https://github.com/django/django/commit/52e409ed17287e9aabda847b6afe58be2fa9f86a", "description": "In Django 2.2 before 2.2.18, 3.0 before 3.0.12, and 3.1 before 3.1.6, the django.utils.archive.extract method (used by \"startapp --template\" and \"startproject --template\") allows directory traversal via an archive with absolute paths or relative paths with dot segments.", "file_change_id": 99541052141544, "report_link": "https://github.com/advisories/GHSA-fvgf-6h6h-3322", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `extract` is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability description mentions that the `django.utils.archive.extract` method allows directory traversal via an archive with absolute paths or relative paths with dot segments. This is the exact function that is being modified in the commit.\n\nThe change in the function is the replacement of the line `filename = os.path.join(to_path, name)` with `filename = self.target_filename(to_path, name)`. This change seems to be aimed at ensuring that the filename is correctly and safely generated, likely to prevent the directory traversal issue.\n\nTherefore, the function `extract` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_paths", "code_before": "def get_paths(base_path: pathlib.Path):\n    data_file = pathlib.Path(str(base_path) + \".data\")\n    metadata_file = pathlib.Path(str(base_path) + \".meta\")\n\n    return data_file, metadata_file\n", "code_after": "def get_paths(root: str, sub_path: str) \\\n        -> typing.Tuple[pathlib.Path, pathlib.Path]:\n    base_path = flask.safe_join(root, sub_path)\n    data_file = pathlib.Path(base_path + \".data\")\n    metadata_file = pathlib.Path(base_path + \".meta\")\n\n    return data_file, metadata_file\n", "commit_message": "Simplify path handling, use safe_join\n\nThe current implementation of sanitized_join did not handle\n\"..\" properly. The problem is, that .absolute() does not do\nwhat .resolve() does, but .resolve() does not work on non\nexistant paths.\n\nAnyway, flask has a function exactly for this: safe_join.\n\nSo let's use that one.\n\nWhile at it, simplified the whole path handling a bit.", "commit": "https://github.com/horazont/xmpp-http-upload/commit/82056540191e89f0cd697c81f57714c00962ed75", "description": "### Impact\n\n#### Information Disclosure\n\nWhen the GET method is attacked, attackers can read files which have a `.data` suffix and which are accompanied by a JSON file with the `.meta` suffix. This can lead to Information Disclosure and in some shared-hosting scenarios also to circumvention of authentication or other limitations on the outbound (GET) traffic.\n\nFor example, in a scenario where a single server has multiple instances of the application running (with separate DATA_ROOT settings), an attacker who has knowledge about the directory structure is able to read files from any other instance to which the process has read access.\n\nIf instances have individual authentication (for example, HTTP authentication via a reverse proxy, source IP based filtering) or other restrictions (such as quotas), attackers may circumvent those limits in such a scenario by using the Directory Traversal to retrieve data from the other instances.\n\n#### File Write\n\nIf the associated XMPP server (or anyone knowing the SECRET_KEY) is malicious, they can write files outside the DATA_ROOT. The files which are written are constrained to have the `.meta` and the `.data` suffixes; the `.meta` file will contain the JSON with the Content-Type of the original request and the `.data` file will contain the payload.\n\n### Patches\n\nPR #12 fixes the issue. The PR has been merged into version 0.4.0 and 0.4.0 has been released and pushed to PyPI. Users are advised to upgrade immediately.\n\n### Workarounds\n\n- Apache can apparently be configured to filter such malicious paths when reverse-proxying. \n- There are no other workarounds known.\n\n### References\n\n- [Pull Request #12](https://github.com/horazont/xmpp-http-upload/pull/12)", "file_change_id": 16258011923777, "report_link": "https://github.com/advisories/GHSA-hwv5-w8gm-fq9f", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "get_file", "code_before": "def get_file(path):\n    try:\n        data_file, metadata = get_info(\n            path,\n            pathlib.Path(app.config[\"DATA_ROOT\"])\n        )\n    except (OSError, ValueError):\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    response = flask.make_response(flask.send_file(\n        str(data_file),\n    ))\n    generate_headers(\n        response.headers,\n        metadata[\"headers\"],\n    )\n    return response\n", "code_after": "def get_file(path):\n    try:\n        data_file, metadata = get_info(path)\n    except (OSError, werkzeug.exceptions.NotFound):\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    response = flask.make_response(flask.send_file(\n        str(data_file),\n    ))\n    generate_headers(\n        response.headers,\n        metadata[\"headers\"],\n    )\n    return response\n"}, {"function_name": "get_info", "code_before": "def get_info(path: str, root: pathlib.Path) -> typing.Tuple[\n        pathlib.Path,\n        dict]:\n    dest_path = sanitized_join(", "code_after": "def get_info(path: str) -> typing.Tuple[\n        pathlib.Path,\n        dict]:\n    data_file, metadata_file = get_paths(app.config[\"DATA_ROOT\"], path)"}, {"function_name": "head_file", "code_before": "def head_file(path):\n    try:\n        data_file, metadata = get_info(\n            path,\n            pathlib.Path(app.config[\"DATA_ROOT\"])\n        )\n\n        stat = data_file.stat()\n    except (OSError, ValueError):\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    response = flask.Response()\n    response.headers[\"Content-Length\"] = str(stat.st_size)\n    generate_headers(\n        response.headers,\n        metadata[\"headers\"],\n    )\n    return response\n", "code_after": "def head_file(path):\n    try:\n        data_file, metadata = get_info(path)\n\n        stat = data_file.stat()\n    except (OSError, werkzeug.exceptions.NotFound):\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    response = flask.Response()\n    response.headers[\"Content-Length\"] = str(stat.st_size)\n    generate_headers(\n        response.headers,\n        metadata[\"headers\"],\n    )\n    return response\n"}, {"function_name": "sanitized_join", "code_before": "def sanitized_join(path: str, root: pathlib.Path) -> pathlib.Path:\n    result = (root / path).absolute()\n    if not str(result).startswith(str(root) + \"/\"):\n        raise ValueError(\"resulting path is outside root\")\n    return result\n", "code_after": ""}, {"function_name": "put_file", "code_before": "def put_file(path):\n    try:\n        dest_path = sanitized_join(\n            path,\n            pathlib.Path(app.config[\"DATA_ROOT\"]),\n        )\n    except ValueError:\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    verification_key = flask.request.args.get(\"v\", \"\")\n    length = int(flask.request.headers.get(\"Content-Length\", 0))\n    hmac_input = \"{} {}\".format(path, length).encode(\"utf-8\")\n    key = app.config[\"SECRET_KEY\"]\n    mac = hmac.new(key, hmac_input, hashlib.sha256)\n    digest = mac.hexdigest()\n\n    if not hmac.compare_digest(digest, verification_key):\n        return flask.Response(\n            \"Invalid verification key\",\n            403,\n            mimetype=\"text/plain\",\n        )\n\n    content_type = flask.request.headers.get(\n        \"Content-Type\",\n        \"application/octet-stream\",\n    )\n\n    dest_path.parent.mkdir(parents=True, exist_ok=True, mode=0o770)\n    data_file, metadata_file = get_paths(dest_path)\n\n    try:\n        with write_file(data_file) as fout:\n            stream_file(flask.request.stream, fout, length)\n\n            with metadata_file.open(\"x\") as f:\n                json.dump(\n                    {\n                        \"headers\": {\"Content-Type\": content_type},\n                    },\n                    f,\n                )\n    except EOFError:\n        return flask.Response(\n            \"Bad Request\",\n            400,\n            mimetype=\"text/plain\",\n        )\n    except OSError as exc:\n        if exc.errno == errno.EEXIST:\n            return flask.Response(\n                \"Conflict\",\n                409,\n                mimetype=\"text/plain\",\n            )\n        raise\n\n    return flask.Response(\n        \"Created\",\n        201,\n        mimetype=\"text/plain\",\n    )\n", "code_after": "def put_file(path):\n    try:\n        data_file, metadata_file = get_paths(app.config[\"DATA_ROOT\"], path)\n    except werkzeug.exceptions.NotFound:\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    verification_key = flask.request.args.get(\"v\", \"\")\n    length = int(flask.request.headers.get(\"Content-Length\", 0))\n    hmac_input = \"{} {}\".format(path, length).encode(\"utf-8\")\n    key = app.config[\"SECRET_KEY\"]\n    mac = hmac.new(key, hmac_input, hashlib.sha256)\n    digest = mac.hexdigest()\n\n    if not hmac.compare_digest(digest, verification_key):\n        return flask.Response(\n            \"Invalid verification key\",\n            403,\n            mimetype=\"text/plain\",\n        )\n\n    content_type = flask.request.headers.get(\n        \"Content-Type\",\n        \"application/octet-stream\",\n    )\n\n    data_file.parent.mkdir(parents=True, exist_ok=True, mode=0o770)\n\n    try:\n        with write_file(data_file) as fout:\n            stream_file(flask.request.stream, fout, length)\n\n            with metadata_file.open(\"x\") as f:\n                json.dump(\n                    {\n                        \"headers\": {\"Content-Type\": content_type},\n                    },\n                    f,\n                )\n    except EOFError:\n        return flask.Response(\n            \"Bad Request\",\n            400,\n            mimetype=\"text/plain\",\n        )\n    except OSError as exc:\n        if exc.errno == errno.EEXIST:\n            return flask.Response(\n                \"Conflict\",\n                409,\n                mimetype=\"text/plain\",\n            )\n        raise\n\n    return flask.Response(\n        \"Created\",\n        201,\n        mimetype=\"text/plain\",\n    )\n"}], "gpt_answer": "The function \"get_paths\" is changed to use Flask's \"safe_join\" function for joining paths. This change is relevant to the vulnerability described in the advisory, which involves unauthorized access and modification of the file system beyond the Jupyter root directory. The use of \"safe_join\" helps to prevent directory traversal attacks by ensuring that the resulting path is within the intended root directory.\n\nThe commit message also indicates that the change was made to handle \"..\" properly and to simplify the path handling. This further suggests that the change is directly related to the vulnerability.\n\nTherefore, the function \"get_paths\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "sanitized_join", "code_before": "def sanitized_join(path: str, root: pathlib.Path) -> pathlib.Path:\n    result = (root / path).absolute()\n    if not str(result).startswith(str(root) + \"/\"):\n        raise ValueError(\"resulting path is outside root\")\n    return result\n", "code_after": "", "commit_message": "Simplify path handling, use safe_join\n\nThe current implementation of sanitized_join did not handle\n\"..\" properly. The problem is, that .absolute() does not do\nwhat .resolve() does, but .resolve() does not work on non\nexistant paths.\n\nAnyway, flask has a function exactly for this: safe_join.\n\nSo let's use that one.\n\nWhile at it, simplified the whole path handling a bit.", "commit": "https://github.com/horazont/xmpp-http-upload/commit/82056540191e89f0cd697c81f57714c00962ed75", "description": "### Impact\n\n#### Information Disclosure\n\nWhen the GET method is attacked, attackers can read files which have a `.data` suffix and which are accompanied by a JSON file with the `.meta` suffix. This can lead to Information Disclosure and in some shared-hosting scenarios also to circumvention of authentication or other limitations on the outbound (GET) traffic.\n\nFor example, in a scenario where a single server has multiple instances of the application running (with separate DATA_ROOT settings), an attacker who has knowledge about the directory structure is able to read files from any other instance to which the process has read access.\n\nIf instances have individual authentication (for example, HTTP authentication via a reverse proxy, source IP based filtering) or other restrictions (such as quotas), attackers may circumvent those limits in such a scenario by using the Directory Traversal to retrieve data from the other instances.\n\n#### File Write\n\nIf the associated XMPP server (or anyone knowing the SECRET_KEY) is malicious, they can write files outside the DATA_ROOT. The files which are written are constrained to have the `.meta` and the `.data` suffixes; the `.meta` file will contain the JSON with the Content-Type of the original request and the `.data` file will contain the payload.\n\n### Patches\n\nPR #12 fixes the issue. The PR has been merged into version 0.4.0 and 0.4.0 has been released and pushed to PyPI. Users are advised to upgrade immediately.\n\n### Workarounds\n\n- Apache can apparently be configured to filter such malicious paths when reverse-proxying. \n- There are no other workarounds known.\n\n### References\n\n- [Pull Request #12](https://github.com/horazont/xmpp-http-upload/pull/12)", "file_change_id": 16258011923777, "report_link": "https://github.com/advisories/GHSA-hwv5-w8gm-fq9f", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "get_file", "code_before": "def get_file(path):\n    try:\n        data_file, metadata = get_info(\n            path,\n            pathlib.Path(app.config[\"DATA_ROOT\"])\n        )\n    except (OSError, ValueError):\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    response = flask.make_response(flask.send_file(\n        str(data_file),\n    ))\n    generate_headers(\n        response.headers,\n        metadata[\"headers\"],\n    )\n    return response\n", "code_after": "def get_file(path):\n    try:\n        data_file, metadata = get_info(path)\n    except (OSError, werkzeug.exceptions.NotFound):\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    response = flask.make_response(flask.send_file(\n        str(data_file),\n    ))\n    generate_headers(\n        response.headers,\n        metadata[\"headers\"],\n    )\n    return response\n"}, {"function_name": "get_paths", "code_before": "def get_paths(base_path: pathlib.Path):\n    data_file = pathlib.Path(str(base_path) + \".data\")\n    metadata_file = pathlib.Path(str(base_path) + \".meta\")\n\n    return data_file, metadata_file\n", "code_after": "def get_paths(root: str, sub_path: str) \\\n        -> typing.Tuple[pathlib.Path, pathlib.Path]:\n    base_path = flask.safe_join(root, sub_path)\n    data_file = pathlib.Path(base_path + \".data\")\n    metadata_file = pathlib.Path(base_path + \".meta\")\n\n    return data_file, metadata_file\n"}, {"function_name": "get_info", "code_before": "def get_info(path: str, root: pathlib.Path) -> typing.Tuple[\n        pathlib.Path,\n        dict]:\n    dest_path = sanitized_join(", "code_after": "def get_info(path: str) -> typing.Tuple[\n        pathlib.Path,\n        dict]:\n    data_file, metadata_file = get_paths(app.config[\"DATA_ROOT\"], path)"}, {"function_name": "head_file", "code_before": "def head_file(path):\n    try:\n        data_file, metadata = get_info(\n            path,\n            pathlib.Path(app.config[\"DATA_ROOT\"])\n        )\n\n        stat = data_file.stat()\n    except (OSError, ValueError):\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    response = flask.Response()\n    response.headers[\"Content-Length\"] = str(stat.st_size)\n    generate_headers(\n        response.headers,\n        metadata[\"headers\"],\n    )\n    return response\n", "code_after": "def head_file(path):\n    try:\n        data_file, metadata = get_info(path)\n\n        stat = data_file.stat()\n    except (OSError, werkzeug.exceptions.NotFound):\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    response = flask.Response()\n    response.headers[\"Content-Length\"] = str(stat.st_size)\n    generate_headers(\n        response.headers,\n        metadata[\"headers\"],\n    )\n    return response\n"}, {"function_name": "put_file", "code_before": "def put_file(path):\n    try:\n        dest_path = sanitized_join(\n            path,\n            pathlib.Path(app.config[\"DATA_ROOT\"]),\n        )\n    except ValueError:\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    verification_key = flask.request.args.get(\"v\", \"\")\n    length = int(flask.request.headers.get(\"Content-Length\", 0))\n    hmac_input = \"{} {}\".format(path, length).encode(\"utf-8\")\n    key = app.config[\"SECRET_KEY\"]\n    mac = hmac.new(key, hmac_input, hashlib.sha256)\n    digest = mac.hexdigest()\n\n    if not hmac.compare_digest(digest, verification_key):\n        return flask.Response(\n            \"Invalid verification key\",\n            403,\n            mimetype=\"text/plain\",\n        )\n\n    content_type = flask.request.headers.get(\n        \"Content-Type\",\n        \"application/octet-stream\",\n    )\n\n    dest_path.parent.mkdir(parents=True, exist_ok=True, mode=0o770)\n    data_file, metadata_file = get_paths(dest_path)\n\n    try:\n        with write_file(data_file) as fout:\n            stream_file(flask.request.stream, fout, length)\n\n            with metadata_file.open(\"x\") as f:\n                json.dump(\n                    {\n                        \"headers\": {\"Content-Type\": content_type},\n                    },\n                    f,\n                )\n    except EOFError:\n        return flask.Response(\n            \"Bad Request\",\n            400,\n            mimetype=\"text/plain\",\n        )\n    except OSError as exc:\n        if exc.errno == errno.EEXIST:\n            return flask.Response(\n                \"Conflict\",\n                409,\n                mimetype=\"text/plain\",\n            )\n        raise\n\n    return flask.Response(\n        \"Created\",\n        201,\n        mimetype=\"text/plain\",\n    )\n", "code_after": "def put_file(path):\n    try:\n        data_file, metadata_file = get_paths(app.config[\"DATA_ROOT\"], path)\n    except werkzeug.exceptions.NotFound:\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    verification_key = flask.request.args.get(\"v\", \"\")\n    length = int(flask.request.headers.get(\"Content-Length\", 0))\n    hmac_input = \"{} {}\".format(path, length).encode(\"utf-8\")\n    key = app.config[\"SECRET_KEY\"]\n    mac = hmac.new(key, hmac_input, hashlib.sha256)\n    digest = mac.hexdigest()\n\n    if not hmac.compare_digest(digest, verification_key):\n        return flask.Response(\n            \"Invalid verification key\",\n            403,\n            mimetype=\"text/plain\",\n        )\n\n    content_type = flask.request.headers.get(\n        \"Content-Type\",\n        \"application/octet-stream\",\n    )\n\n    data_file.parent.mkdir(parents=True, exist_ok=True, mode=0o770)\n\n    try:\n        with write_file(data_file) as fout:\n            stream_file(flask.request.stream, fout, length)\n\n            with metadata_file.open(\"x\") as f:\n                json.dump(\n                    {\n                        \"headers\": {\"Content-Type\": content_type},\n                    },\n                    f,\n                )\n    except EOFError:\n        return flask.Response(\n            \"Bad Request\",\n            400,\n            mimetype=\"text/plain\",\n        )\n    except OSError as exc:\n        if exc.errno == errno.EEXIST:\n            return flask.Response(\n                \"Conflict\",\n                409,\n                mimetype=\"text/plain\",\n            )\n        raise\n\n    return flask.Response(\n        \"Created\",\n        201,\n        mimetype=\"text/plain\",\n    )\n"}], "gpt_answer": "The function \"sanitized_join\" is directly related to the vulnerability that the commit is trying to fix. The vulnerability description mentions that there is an issue with unauthorized access and modification of the file system beyond the DATA_ROOT. The \"sanitized_join\" function is responsible for joining paths in the file system, and it is removed in the commit, indicating that it was part of the vulnerability.\n\nThe commit message also mentions that the \"sanitized_join\" function did not handle \"..\" properly, which is a common way to traverse directories in a file system. This further indicates that the function was part of the vulnerability.\n\nTherefore, the function \"sanitized_join\" is vulnerable.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "put_file", "code_before": "def put_file(path):\n    try:\n        dest_path = sanitized_join(\n            path,\n            pathlib.Path(app.config[\"DATA_ROOT\"]),\n        )\n    except ValueError:\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    verification_key = flask.request.args.get(\"v\", \"\")\n    length = int(flask.request.headers.get(\"Content-Length\", 0))\n    hmac_input = \"{} {}\".format(path, length).encode(\"utf-8\")\n    key = app.config[\"SECRET_KEY\"]\n    mac = hmac.new(key, hmac_input, hashlib.sha256)\n    digest = mac.hexdigest()\n\n    if not hmac.compare_digest(digest, verification_key):\n        return flask.Response(\n            \"Invalid verification key\",\n            403,\n            mimetype=\"text/plain\",\n        )\n\n    content_type = flask.request.headers.get(\n        \"Content-Type\",\n        \"application/octet-stream\",\n    )\n\n    dest_path.parent.mkdir(parents=True, exist_ok=True, mode=0o770)\n    data_file, metadata_file = get_paths(dest_path)\n\n    try:\n        with write_file(data_file) as fout:\n            stream_file(flask.request.stream, fout, length)\n\n            with metadata_file.open(\"x\") as f:\n                json.dump(\n                    {\n                        \"headers\": {\"Content-Type\": content_type},\n                    },\n                    f,\n                )\n    except EOFError:\n        return flask.Response(\n            \"Bad Request\",\n            400,\n            mimetype=\"text/plain\",\n        )\n    except OSError as exc:\n        if exc.errno == errno.EEXIST:\n            return flask.Response(\n                \"Conflict\",\n                409,\n                mimetype=\"text/plain\",\n            )\n        raise\n\n    return flask.Response(\n        \"Created\",\n        201,\n        mimetype=\"text/plain\",\n    )\n", "code_after": "def put_file(path):\n    try:\n        data_file, metadata_file = get_paths(app.config[\"DATA_ROOT\"], path)\n    except werkzeug.exceptions.NotFound:\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    verification_key = flask.request.args.get(\"v\", \"\")\n    length = int(flask.request.headers.get(\"Content-Length\", 0))\n    hmac_input = \"{} {}\".format(path, length).encode(\"utf-8\")\n    key = app.config[\"SECRET_KEY\"]\n    mac = hmac.new(key, hmac_input, hashlib.sha256)\n    digest = mac.hexdigest()\n\n    if not hmac.compare_digest(digest, verification_key):\n        return flask.Response(\n            \"Invalid verification key\",\n            403,\n            mimetype=\"text/plain\",\n        )\n\n    content_type = flask.request.headers.get(\n        \"Content-Type\",\n        \"application/octet-stream\",\n    )\n\n    data_file.parent.mkdir(parents=True, exist_ok=True, mode=0o770)\n\n    try:\n        with write_file(data_file) as fout:\n            stream_file(flask.request.stream, fout, length)\n\n            with metadata_file.open(\"x\") as f:\n                json.dump(\n                    {\n                        \"headers\": {\"Content-Type\": content_type},\n                    },\n                    f,\n                )\n    except EOFError:\n        return flask.Response(\n            \"Bad Request\",\n            400,\n            mimetype=\"text/plain\",\n        )\n    except OSError as exc:\n        if exc.errno == errno.EEXIST:\n            return flask.Response(\n                \"Conflict\",\n                409,\n                mimetype=\"text/plain\",\n            )\n        raise\n\n    return flask.Response(\n        \"Created\",\n        201,\n        mimetype=\"text/plain\",\n    )\n", "commit_message": "Simplify path handling, use safe_join\n\nThe current implementation of sanitized_join did not handle\n\"..\" properly. The problem is, that .absolute() does not do\nwhat .resolve() does, but .resolve() does not work on non\nexistant paths.\n\nAnyway, flask has a function exactly for this: safe_join.\n\nSo let's use that one.\n\nWhile at it, simplified the whole path handling a bit.", "commit": "https://github.com/horazont/xmpp-http-upload/commit/82056540191e89f0cd697c81f57714c00962ed75", "description": "### Impact\n\n#### Information Disclosure\n\nWhen the GET method is attacked, attackers can read files which have a `.data` suffix and which are accompanied by a JSON file with the `.meta` suffix. This can lead to Information Disclosure and in some shared-hosting scenarios also to circumvention of authentication or other limitations on the outbound (GET) traffic.\n\nFor example, in a scenario where a single server has multiple instances of the application running (with separate DATA_ROOT settings), an attacker who has knowledge about the directory structure is able to read files from any other instance to which the process has read access.\n\nIf instances have individual authentication (for example, HTTP authentication via a reverse proxy, source IP based filtering) or other restrictions (such as quotas), attackers may circumvent those limits in such a scenario by using the Directory Traversal to retrieve data from the other instances.\n\n#### File Write\n\nIf the associated XMPP server (or anyone knowing the SECRET_KEY) is malicious, they can write files outside the DATA_ROOT. The files which are written are constrained to have the `.meta` and the `.data` suffixes; the `.meta` file will contain the JSON with the Content-Type of the original request and the `.data` file will contain the payload.\n\n### Patches\n\nPR #12 fixes the issue. The PR has been merged into version 0.4.0 and 0.4.0 has been released and pushed to PyPI. Users are advised to upgrade immediately.\n\n### Workarounds\n\n- Apache can apparently be configured to filter such malicious paths when reverse-proxying. \n- There are no other workarounds known.\n\n### References\n\n- [Pull Request #12](https://github.com/horazont/xmpp-http-upload/pull/12)", "file_change_id": 16258011923777, "report_link": "https://github.com/advisories/GHSA-hwv5-w8gm-fq9f", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "get_file", "code_before": "def get_file(path):\n    try:\n        data_file, metadata = get_info(\n            path,\n            pathlib.Path(app.config[\"DATA_ROOT\"])\n        )\n    except (OSError, ValueError):\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    response = flask.make_response(flask.send_file(\n        str(data_file),\n    ))\n    generate_headers(\n        response.headers,\n        metadata[\"headers\"],\n    )\n    return response\n", "code_after": "def get_file(path):\n    try:\n        data_file, metadata = get_info(path)\n    except (OSError, werkzeug.exceptions.NotFound):\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    response = flask.make_response(flask.send_file(\n        str(data_file),\n    ))\n    generate_headers(\n        response.headers,\n        metadata[\"headers\"],\n    )\n    return response\n"}, {"function_name": "get_paths", "code_before": "def get_paths(base_path: pathlib.Path):\n    data_file = pathlib.Path(str(base_path) + \".data\")\n    metadata_file = pathlib.Path(str(base_path) + \".meta\")\n\n    return data_file, metadata_file\n", "code_after": "def get_paths(root: str, sub_path: str) \\\n        -> typing.Tuple[pathlib.Path, pathlib.Path]:\n    base_path = flask.safe_join(root, sub_path)\n    data_file = pathlib.Path(base_path + \".data\")\n    metadata_file = pathlib.Path(base_path + \".meta\")\n\n    return data_file, metadata_file\n"}, {"function_name": "get_info", "code_before": "def get_info(path: str, root: pathlib.Path) -> typing.Tuple[\n        pathlib.Path,\n        dict]:\n    dest_path = sanitized_join(", "code_after": "def get_info(path: str) -> typing.Tuple[\n        pathlib.Path,\n        dict]:\n    data_file, metadata_file = get_paths(app.config[\"DATA_ROOT\"], path)"}, {"function_name": "head_file", "code_before": "def head_file(path):\n    try:\n        data_file, metadata = get_info(\n            path,\n            pathlib.Path(app.config[\"DATA_ROOT\"])\n        )\n\n        stat = data_file.stat()\n    except (OSError, ValueError):\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    response = flask.Response()\n    response.headers[\"Content-Length\"] = str(stat.st_size)\n    generate_headers(\n        response.headers,\n        metadata[\"headers\"],\n    )\n    return response\n", "code_after": "def head_file(path):\n    try:\n        data_file, metadata = get_info(path)\n\n        stat = data_file.stat()\n    except (OSError, werkzeug.exceptions.NotFound):\n        return flask.Response(\n            \"Not Found\",\n            404,\n            mimetype=\"text/plain\",\n        )\n\n    response = flask.Response()\n    response.headers[\"Content-Length\"] = str(stat.st_size)\n    generate_headers(\n        response.headers,\n        metadata[\"headers\"],\n    )\n    return response\n"}, {"function_name": "sanitized_join", "code_before": "def sanitized_join(path: str, root: pathlib.Path) -> pathlib.Path:\n    result = (root / path).absolute()\n    if not str(result).startswith(str(root) + \"/\"):\n        raise ValueError(\"resulting path is outside root\")\n    return result\n", "code_after": ""}], "gpt_answer": "The provided information indicates that the function `put_file` was changed as part of a commit that aimed to fix a security vulnerability. The vulnerability allowed unauthorized access and modification of the file system beyond the Jupyter root directory.\n\nThe changes in the `put_file` function are primarily related to how the paths are handled. The function `get_paths` is now used to get the `data_file` and `metadata_file`, and the `sanitized_join` function is no longer used. The `get_paths` function now uses `flask.safe_join` to join the paths, which is a safer way to handle paths and can prevent directory traversal attacks.\n\nThe commit message also indicates that the changes were made to simplify path handling and to use `safe_join`, which is a safer method for joining paths. This suggests that the changes were made to fix the vulnerability.\n\nTherefore, it can be concluded that the `put_file` function was vulnerable and was changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "_build_api", "code_before": "    def _build_api(self) -> None:\n        # Generate Client\n        client_path = self.package_dir / \"client.py\"\n        client_template = self.env.get_template(\"client.pyi\")\n        client_path.write_text(client_template.render())\n\n        # Generate endpoints\n        api_dir = self.package_dir / \"api\"\n        api_dir.mkdir()\n        api_init = api_dir / \"__init__.py\"\n        api_init.write_text('\"\"\" Contains synchronous methods for accessing the API \"\"\"')\n\n        async_api_dir = self.package_dir / \"async_api\"\n        async_api_dir.mkdir()\n        async_api_init = async_api_dir / \"__init__.py\"\n        async_api_init.write_text('\"\"\" Contains async methods for accessing the API \"\"\"')\n\n        api_errors = self.package_dir / \"errors.py\"\n        errors_template = self.env.get_template(\"errors.pyi\")\n        api_errors.write_text(errors_template.render())\n\n        endpoint_template = self.env.get_template(\"endpoint_module.pyi\")\n        async_endpoint_template = self.env.get_template(\"async_endpoint_module.pyi\")\n        for tag, collection in self.openapi.endpoint_collections_by_tag.items():\n            module_path = api_dir / f\"{tag}.py\"\n            module_path.write_text(endpoint_template.render(collection=collection))\n            async_module_path = async_api_dir / f\"{tag}.py\"\n            async_module_path.write_text(async_endpoint_template.render(collection=collection))\n", "code_after": "    def _build_api(self) -> None:\n        # Generate Client\n        client_path = self.package_dir / \"client.py\"\n        client_template = self.env.get_template(\"client.pyi\")\n        client_path.write_text(client_template.render())\n\n        # Generate endpoints\n        api_dir = self.package_dir / \"api\"\n        api_dir.mkdir()\n        api_init = api_dir / \"__init__.py\"\n        api_init.write_text('\"\"\" Contains synchronous methods for accessing the API \"\"\"')\n\n        async_api_dir = self.package_dir / \"async_api\"\n        async_api_dir.mkdir()\n        async_api_init = async_api_dir / \"__init__.py\"\n        async_api_init.write_text('\"\"\" Contains async methods for accessing the API \"\"\"')\n\n        api_errors = self.package_dir / \"errors.py\"\n        errors_template = self.env.get_template(\"errors.pyi\")\n        api_errors.write_text(errors_template.render())\n\n        endpoint_template = self.env.get_template(\"endpoint_module.pyi\")\n        async_endpoint_template = self.env.get_template(\"async_endpoint_module.pyi\")\n        for tag, collection in self.openapi.endpoint_collections_by_tag.items():\n            tag = utils.snake_case(tag)\n            module_path = api_dir / f\"{tag}.py\"\n            module_path.write_text(endpoint_template.render(collection=collection))\n            async_module_path = async_api_dir / f\"{tag}.py\"\n            async_module_path.write_text(async_endpoint_template.render(collection=collection))\n", "commit_message": "Merge pull request from GHSA-7wgr-7666-7pwj\n\n* All strings used as file/directory names are now sanitized to address the path traversal vulnerabilities\n\n* Switched calls to utils.spinal_case to utils.kebab_case\n\nCo-authored-by: Ethan Mann <emann@triaxtec.com>", "commit": "https://github.com/triaxtec/openapi-python-client/commit/3e7dfae5d0b3685abf1ede1bc6c086a116ac4746", "description": "### Impact\nPath traversal vulnerability. If a user generated a client using a maliciously crafted OpenAPI document, it is possible for generated files to be placed in arbitrary locations on disk.\n\nGiving this a CVSS score of 3.0 (Low) with CVSS:3.0/AV:N/AC:H/PR:L/UI:R/S:C/C:N/I:L/A:N/E:P/RL:U/RC:C\n\n### Patches\nA fix is being worked on for version 0.5.3\n\n### Workarounds\nInspect OpenAPI documents before generating clients for them.\n\n### For more information\nIf you have any questions or comments about this advisory:\n* Open an issue in [openapi-python-client](https://github.com/triaxtec/openapi-python-client/issues)\n* Email us at [danthony@triaxtec.com](mailto:danthony@triaxtec.com)", "file_change_id": 256130440484795, "report_link": "https://github.com/advisories/GHSA-7wgr-7666-7pwj", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "__init__", "code_before": "    def __init__(self, *, openapi: GeneratorData) -> None:\n        self.openapi: GeneratorData = openapi\n        self.env: Environment = Environment(loader=PackageLoader(__package__), trim_blocks=True, lstrip_blocks=True)\n\n        self.project_name: str = self.project_name_override or f\"{openapi.title.replace(' ', '-').lower()}-client\"\n        self.project_dir: Path = Path.cwd() / self.project_name\n\n        self.package_name: str = self.package_name_override or self.project_name.replace(\"-\", \"_\")\n        self.package_dir: Path = self.project_dir / self.package_name\n        self.package_description: str = f\"A client library for accessing {self.openapi.title}\"\n        self.version: str = openapi.version\n\n        self.env.filters.update(self.TEMPLATE_FILTERS)\n", "code_after": "    def __init__(self, *, openapi: GeneratorData) -> None:\n        self.openapi: GeneratorData = openapi\n        self.env: Environment = Environment(loader=PackageLoader(__package__), trim_blocks=True, lstrip_blocks=True)\n\n        self.project_name: str = self.project_name_override or f\"{utils.kebab_case(openapi.title).lower()}-client\"\n        self.project_dir: Path = Path.cwd() / self.project_name\n\n        self.package_name: str = self.package_name_override or self.project_name.replace(\"-\", \"_\")\n        self.package_dir: Path = self.project_dir / self.package_name\n        self.package_description: str = f\"A client library for accessing {self.openapi.title}\"\n        self.version: str = openapi.version\n\n        self.env.filters.update(self.TEMPLATE_FILTERS)\n"}], "gpt_answer": "The provided information indicates that the vulnerability was a path traversal vulnerability, which could allow an attacker to place generated files in arbitrary locations on the disk if a maliciously crafted OpenAPI document was used.\n\nLooking at the changes in the \"_build_api\" function, it can be seen that the only change is the addition of a line that converts the \"tag\" variable to snake_case using the \"utils.snake_case\" function. This change is made before the \"tag\" variable is used to create file paths.\n\nThis change is relevant to the vulnerability because it sanitizes the \"tag\" variable, which is used as a part of the file path. By ensuring that the \"tag\" variable is in snake_case, it reduces the risk of path traversal vulnerabilities because it limits the possible characters that can be used in the \"tag\" variable, and thus in the file path.\n\nTherefore, the function \"_build_api\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "pascal_case", "code_before": "def pascal_case(value: str) -> str:\n    return stringcase.pascalcase(value)\n", "code_after": "def pascal_case(value: str) -> str:\n    return stringcase.pascalcase(_sanitize(value))\n", "commit_message": "Merge pull request from GHSA-7wgr-7666-7pwj\n\n* All strings used as file/directory names are now sanitized to address the path traversal vulnerabilities\n\n* Switched calls to utils.spinal_case to utils.kebab_case\n\nCo-authored-by: Ethan Mann <emann@triaxtec.com>", "commit": "https://github.com/triaxtec/openapi-python-client/commit/3e7dfae5d0b3685abf1ede1bc6c086a116ac4746", "description": "### Impact\nPath traversal vulnerability. If a user generated a client using a maliciously crafted OpenAPI document, it is possible for generated files to be placed in arbitrary locations on disk.\n\nGiving this a CVSS score of 3.0 (Low) with CVSS:3.0/AV:N/AC:H/PR:L/UI:R/S:C/C:N/I:L/A:N/E:P/RL:U/RC:C\n\n### Patches\nA fix is being worked on for version 0.5.3\n\n### Workarounds\nInspect OpenAPI documents before generating clients for them.\n\n### For more information\nIf you have any questions or comments about this advisory:\n* Open an issue in [openapi-python-client](https://github.com/triaxtec/openapi-python-client/issues)\n* Email us at [danthony@triaxtec.com](mailto:danthony@triaxtec.com)", "file_change_id": 150815636188506, "report_link": "https://github.com/advisories/GHSA-7wgr-7666-7pwj", "programming_language": "Groovy", "other_changed_function_in_the_commit": [{"function_name": "spinal_case", "code_before": "def spinal_case(value: str) -> str:\n    return stringcase.spinalcase(value)\n", "code_after": ""}, {"function_name": "snake_case", "code_before": "def snake_case(value: str) -> str:\n    value = re.sub(r\"([A-Z]{2,})([A-Z][a-z]|[ -_]|$)\", lambda m: m.group(1).title() + m.group(2), value.strip())\n    value = re.sub(r\"(^|[ _-])([A-Z])\", lambda m: m.group(1) + m.group(2).lower(), value)\n    return stringcase.snakecase(value)\n", "code_after": "def snake_case(value: str) -> str:\n    return stringcase.snakecase(group_title(_sanitize(value)))\n"}], "gpt_answer": "The vulnerability described in the advisory is a path traversal vulnerability, which could allow an attacker to place files in arbitrary locations on the disk if a client is generated using a maliciously crafted OpenAPI document.\n\nThe function `pascal_case` has been changed to sanitize the input value before converting it to pascal case. This change is directly related to the vulnerability, as it is a measure to prevent path traversal attacks by sanitizing the input that could potentially be used to construct file paths. \n\nThe commit message also supports this, stating that \"All strings used as file/directory names are now sanitized to address the path traversal vulnerabilities\".\n\nTherefore, the function `pascal_case` is relevant to the vulnerability that the commit is trying to fix, and it was vulnerable before the change.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "snake_case", "code_before": "def snake_case(value: str) -> str:\n    value = re.sub(r\"([A-Z]{2,})([A-Z][a-z]|[ -_]|$)\", lambda m: m.group(1).title() + m.group(2), value.strip())\n    value = re.sub(r\"(^|[ _-])([A-Z])\", lambda m: m.group(1) + m.group(2).lower(), value)\n    return stringcase.snakecase(value)\n", "code_after": "def snake_case(value: str) -> str:\n    return stringcase.snakecase(group_title(_sanitize(value)))\n", "commit_message": "Merge pull request from GHSA-7wgr-7666-7pwj\n\n* All strings used as file/directory names are now sanitized to address the path traversal vulnerabilities\n\n* Switched calls to utils.spinal_case to utils.kebab_case\n\nCo-authored-by: Ethan Mann <emann@triaxtec.com>", "commit": "https://github.com/triaxtec/openapi-python-client/commit/3e7dfae5d0b3685abf1ede1bc6c086a116ac4746", "description": "### Impact\nPath traversal vulnerability. If a user generated a client using a maliciously crafted OpenAPI document, it is possible for generated files to be placed in arbitrary locations on disk.\n\nGiving this a CVSS score of 3.0 (Low) with CVSS:3.0/AV:N/AC:H/PR:L/UI:R/S:C/C:N/I:L/A:N/E:P/RL:U/RC:C\n\n### Patches\nA fix is being worked on for version 0.5.3\n\n### Workarounds\nInspect OpenAPI documents before generating clients for them.\n\n### For more information\nIf you have any questions or comments about this advisory:\n* Open an issue in [openapi-python-client](https://github.com/triaxtec/openapi-python-client/issues)\n* Email us at [danthony@triaxtec.com](mailto:danthony@triaxtec.com)", "file_change_id": 150815636188506, "report_link": "https://github.com/advisories/GHSA-7wgr-7666-7pwj", "programming_language": "Groovy", "other_changed_function_in_the_commit": [{"function_name": "pascal_case", "code_before": "def pascal_case(value: str) -> str:\n    return stringcase.pascalcase(value)\n", "code_after": "def pascal_case(value: str) -> str:\n    return stringcase.pascalcase(_sanitize(value))\n"}, {"function_name": "spinal_case", "code_before": "def spinal_case(value: str) -> str:\n    return stringcase.spinalcase(value)\n", "code_after": ""}], "gpt_answer": "The provided information indicates that the function `snake_case` has been modified as part of a commit that addresses a path traversal vulnerability. The vulnerability allowed for files to be placed in arbitrary locations on disk if a client was generated using a maliciously crafted OpenAPI document.\n\nThe change in the `snake_case` function is from using regular expressions to sanitize the input string to using a function called `_sanitize` and `group_title` to sanitize the input string before converting it to snake case.\n\nGiven the context of the vulnerability, it seems that the function `snake_case` is used in the process of generating file/directory names. The change in this function is likely to sanitize the input string to prevent maliciously crafted strings from causing path traversal issues. \n\nTherefore, it can be inferred that the `snake_case` function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "_convert_file_to_url", "code_before": "def _convert_file_to_url(filename):\n    relpath = os.path.relpath(filename, settings.SENDFILE_ROOT)\n\n    url = [settings.SENDFILE_URL]\n\n    while relpath:\n        relpath, head = os.path.split(relpath)\n        url.insert(1, head)\n\n    return quote('/'.join(url))\n", "code_after": "", "commit_message": "Merge pull request from GHSA-6r3c-8xf3-ggrr\n\n* Fix directory traversal bug\n\nFirst try for the fix.\n\nSanitization is done always on the url path. Removed\n_convert_file_to_url()\n\n* Restore use of _convert_file_to_url\n\nThis is now done for all backends, assuming that SENDFILE_URL is set\n\nAlso don't keep converting from Path object to str and back again\n\n* Fix example application so it works again\n\n* Update docs\n\nCo-authored-by: Gianluca Pacchiella <gianluca.pacchiella@ktln2.org>", "commit": "https://github.com/moggers87/django-sendfile2/commit/f870c52398a55b9b5189932dd8caa24efb4bc1e1", "description": "django-sendfile2 currently relies on the backend to correctly limit file paths to `SENDFILE_ROOT`. This is not the case for the `simple` and `development` backends, it is also not necessarily the case for any of the other backends either (it's just an assumption that was made by the original author).\n\nThis will be fixed in 0.6.0 which is to be released the same day as this advisory is made public.\n\nWhen upgrading, you will need to make sure `SENDFILE_ROOT` is set in your settings module if it wasn't already.", "file_change_id": 270387814020682, "report_link": "https://github.com/advisories/GHSA-6r3c-8xf3-ggrr", "programming_language": "unknown", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `_convert_file_to_url` was removed in the commit. The commit message and the vulnerability description suggest that the vulnerability was related to incorrect file path limitations in the `SENDFILE_ROOT`. The function `_convert_file_to_url` was responsible for converting a filename to a URL, which could be related to the file path issue.\n\nHowever, the function was completely removed in the commit, which suggests that it was part of the problem and thus was vulnerable. The commit message also mentions \"Sanitization is done always on the url path. Removed _convert_file_to_url()\", which further supports the idea that this function was part of the vulnerability.\n\nTherefore, the answer is 1, indicating that the function was vulnerable.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "sendfile", "code_before": "def sendfile(request, filename, **kwargs):\n    response = HttpResponse()\n    url = _convert_file_to_url(filename)\n    response['X-Accel-Redirect'] = url.encode('utf-8')\n\n    return response\n", "code_after": "def sendfile(request, filename, **kwargs):\n    response = HttpResponse()\n    response['X-Accel-Redirect'] = _convert_file_to_url(filename)\n\n    return response\n", "commit_message": "Merge pull request from GHSA-6r3c-8xf3-ggrr\n\n* Fix directory traversal bug\n\nFirst try for the fix.\n\nSanitization is done always on the url path. Removed\n_convert_file_to_url()\n\n* Restore use of _convert_file_to_url\n\nThis is now done for all backends, assuming that SENDFILE_URL is set\n\nAlso don't keep converting from Path object to str and back again\n\n* Fix example application so it works again\n\n* Update docs\n\nCo-authored-by: Gianluca Pacchiella <gianluca.pacchiella@ktln2.org>", "commit": "https://github.com/moggers87/django-sendfile2/commit/f870c52398a55b9b5189932dd8caa24efb4bc1e1", "description": "django-sendfile2 currently relies on the backend to correctly limit file paths to `SENDFILE_ROOT`. This is not the case for the `simple` and `development` backends, it is also not necessarily the case for any of the other backends either (it's just an assumption that was made by the original author).\n\nThis will be fixed in 0.6.0 which is to be released the same day as this advisory is made public.\n\nWhen upgrading, you will need to make sure `SENDFILE_ROOT` is set in your settings module if it wasn't already.", "file_change_id": 277983455297642, "report_link": "https://github.com/advisories/GHSA-6r3c-8xf3-ggrr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"sendfile\" has been modified. The change involves the removal of the line `url = _convert_file_to_url(filename)`, which was previously used to encode the URL in 'utf-8'. \n\nThe commit message and the vulnerability description suggest that the issue was related to a directory traversal bug, and the fix involves ensuring that the `SENDFILE_ROOT` is set in the settings module. The `_convert_file_to_url` function was removed from the `sendfile` function, which could be part of the fix to prevent directory traversal by not allowing the conversion of file paths to URLs without proper checks.\n\nGiven this information, it seems that the `sendfile` function was vulnerable and has been changed to address the vulnerability. Therefore, the answer is 1.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "sendfile", "code_before": "def sendfile(request, filename, **kwargs):\n    # Respect the If-Modified-Since header.\n    statobj = os.stat(filename)\n\n    if not was_modified_since(request.META.get('HTTP_IF_MODIFIED_SINCE'),\n                              statobj[stat.ST_MTIME], statobj[stat.ST_SIZE]):\n        return HttpResponseNotModified()\n\n    with File(open(filename, 'rb')) as f:\n        response = HttpResponse(f.chunks())\n\n    response[\"Last-Modified\"] = http_date(statobj[stat.ST_MTIME])\n    return response\n", "code_after": "def sendfile(request, filepath, **kwargs):\n    '''Use the SENDFILE_ROOT value composed with the path arrived as argument\n    to build an absolute path with which resolve and return the file contents.\n\n    If the path points to a file out of the root directory (should cover both\n    situations with '..' and symlinks) then a 404 is raised.\n    '''\n    statobj = filepath.stat()\n\n    # Respect the If-Modified-Since header.\n    if not was_modified_since(request.META.get('HTTP_IF_MODIFIED_SINCE'),\n                              statobj.st_mtime, statobj.st_size):\n        return HttpResponseNotModified()\n\n    with File(filepath.open('rb')) as f:\n        response = HttpResponse(f.chunks())\n\n    response[\"Last-Modified\"] = http_date(statobj.st_mtime)\n    return response\n", "commit_message": "Merge pull request from GHSA-6r3c-8xf3-ggrr\n\n* Fix directory traversal bug\n\nFirst try for the fix.\n\nSanitization is done always on the url path. Removed\n_convert_file_to_url()\n\n* Restore use of _convert_file_to_url\n\nThis is now done for all backends, assuming that SENDFILE_URL is set\n\nAlso don't keep converting from Path object to str and back again\n\n* Fix example application so it works again\n\n* Update docs\n\nCo-authored-by: Gianluca Pacchiella <gianluca.pacchiella@ktln2.org>", "commit": "https://github.com/moggers87/django-sendfile2/commit/f870c52398a55b9b5189932dd8caa24efb4bc1e1", "description": "django-sendfile2 currently relies on the backend to correctly limit file paths to `SENDFILE_ROOT`. This is not the case for the `simple` and `development` backends, it is also not necessarily the case for any of the other backends either (it's just an assumption that was made by the original author).\n\nThis will be fixed in 0.6.0 which is to be released the same day as this advisory is made public.\n\nWhen upgrading, you will need to make sure `SENDFILE_ROOT` is set in your settings module if it wasn't already.", "file_change_id": 201815522635734, "report_link": "https://github.com/advisories/GHSA-6r3c-8xf3-ggrr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"sendfile\" was changed to fix a directory traversal bug. The change in the function is from using a filename to using a filepath. This change is significant because it allows the function to handle file paths more securely and prevent directory traversal attacks.\n\nThe vulnerability description also supports this, stating that \"django-sendfile2 currently relies on the backend to correctly limit file paths to `SENDFILE_ROOT`\", and the fix is to ensure `SENDFILE_ROOT` is set in the settings module.\n\nGiven this information, it can be concluded that the function \"sendfile\" was indeed vulnerable and has been changed to address the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "_unzip_iter", "code_before": "def _unzip_iter(filename, root, verbose=True):\n    if verbose:\n        sys.stdout.write('Unzipping %s' % os.path.split(filename)[1])\n        sys.stdout.flush()\n\n    try:\n        zf = zipfile.ZipFile(filename)\n    except zipfile.error as e:\n        yield ErrorMessage(filename, 'Error with downloaded zip file')\n        return\n    except Exception as e:\n        yield ErrorMessage(filename, e)\n        return\n\n    # Get lists of directories & files\n    namelist = zf.namelist()\n    dirlist = set()\n    for x in namelist:\n        if x.endswith('/'):\n            dirlist.add(x)\n        else:\n            dirlist.add(x.rsplit('/', 1)[0] + '/')\n    filelist = [x for x in namelist if not x.endswith('/')]\n\n    # Create the target directory if it doesn't exist\n    if not os.path.exists(root):\n        os.mkdir(root)\n\n    # Create the directory structure\n    for dirname in sorted(dirlist):\n        pieces = dirname[:-1].split('/')\n        for i in range(len(pieces)):\n            dirpath = os.path.join(root, *pieces[: i + 1])\n            if not os.path.exists(dirpath):\n                os.mkdir(dirpath)\n\n    # Extract files.\n    for i, filename in enumerate(filelist):\n        filepath = os.path.join(root, *filename.split('/'))\n\n        try:\n            with open(filepath, 'wb') as dstfile, zf.open(filename) as srcfile:\n                shutil.copyfileobj(srcfile, dstfile)\n        except Exception as e:\n            yield ErrorMessage(filename, e)\n            return\n\n        if verbose and (i * 10 / len(filelist) > (i - 1) * 10 / len(filelist)):\n            sys.stdout.write('.')\n            sys.stdout.flush()\n    if verbose:\n        print()\n", "code_after": "def _unzip_iter(filename, root, verbose=True):\n    if verbose:\n        sys.stdout.write('Unzipping %s' % os.path.split(filename)[1])\n        sys.stdout.flush()\n\n    try:\n        zf = zipfile.ZipFile(filename)\n    except zipfile.error as e:\n        yield ErrorMessage(filename, 'Error with downloaded zip file')\n        return\n    except Exception as e:\n        yield ErrorMessage(filename, e)\n        return\n\n    zf.extractall(root)\n\n    if verbose:\n        print()\n", "commit_message": "CVE-2019-14751:\nFixed security bug in downloader\n(https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2019-14751)", "commit": "https://github.com/nltk/nltk/commit/f59d7ed8df2e0e957f7f247fe218032abdbe9a10", "description": "NLTK Downloader before 3.4.5 is vulnerable to a directory traversal, allowing attackers to write arbitrary files via a `../` (dot dot slash) in an NLTK package (ZIP archive) that is mishandled during extraction.", "file_change_id": 103278517224329, "report_link": "https://github.com/advisories/GHSA-mr7p-25v2-35wr", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `_unzip_iter` was changed to address a security vulnerability. The vulnerability was a directory traversal issue, which allowed attackers to write arbitrary files via a `../` in an NLTK package (ZIP archive) that was mishandled during extraction.\n\nIn the `code_before`, the function was manually creating directories and extracting files from the zip file. This manual process did not have any checks to prevent directory traversal attacks, making it vulnerable.\n\nIn the `code_after`, the function uses the `extractall` method from the `zipfile` module to extract all files from the zip file. This method includes checks to prevent directory traversal attacks, which would fix the vulnerability.\n\nTherefore, the function `_unzip_iter` was vulnerable and was changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "parse_command_line", "code_before": "def parse_command_line(argv: List[str]) -> argparse.Namespace:  # noqa: C901.\n    defaults: Dict[str, Any] = {\n        \"json_indent\": None,\n        \"ordered\": True,\n        \"stringify\": False,\n        \"yaml_options\": {},\n    }\n\n    me = Path(argv[0]).name\n    argv0_from, argv0_to = argv0_to_format(me)\n    format_from_argv0 = argv0_to != \"\"\n\n    parser = argparse.ArgumentParser(\n        description=\"Convert between CBOR, JSON, MessagePack, TOML, and YAML.\"\n    )\n    parser.add_argument(\"-v\", \"--version\", action=\"version\", version=__version__)\n\n    input_group = parser.add_mutually_exclusive_group()\n    input_group.add_argument(\"input\", nargs=\"?\", default=\"-\", help=\"input file\")\n    input_group.add_argument(\n        \"-i\",\n        \"--input\",\n        dest=\"input_flag\",\n        metavar=\"input\",\n        default=None,\n        help=\"input file\",\n    )\n\n    if not format_from_argv0:\n        parser.add_argument(\n            \"--if\",\n            \"-if\",\n            \"--input-format\",\n            dest=\"input_format\",\n            default=\"\",\n            help=\"input format\",\n            choices=FORMATS,\n        )\n\n    if not format_from_argv0 or argv0_to == \"json\":\n        parser.add_argument(\n            \"--json-indent\",\n            \"--indent-json\",\n            dest=\"json_indent\",\n            metavar=\"n\",\n            type=int,\n            default=defaults[\"json_indent\"],\n            help=\"JSON indentation\",\n        )\n\n    if not format_from_argv0 or argv0_to in {\"json\", \"toml\"}:\n        parser.add_argument(\n            \"-k\",\n            \"--stringify\",\n            dest=\"stringify\",\n            action=\"store_true\",\n            help=(\n                \"Turn into strings boolean, date-time, and null keys for JSON \"\n                \"and TOML and null values for TOML\"\n            ),\n        )\n\n    output_group = parser.add_mutually_exclusive_group()\n    output_group.add_argument(\"output\", nargs=\"?\", default=\"-\", help=\"output file\")\n    output_group.add_argument(\n        \"-o\",\n        \"--output\",\n        dest=\"output_flag\",\n        metavar=\"output\",\n        default=None,\n        help=\"output file\",\n    )\n\n    if not format_from_argv0:\n        parser.add_argument(\n            \"--of\",\n            \"-of\",\n            \"--output-format\",\n            dest=\"output_format\",\n            default=\"\",\n            help=\"output format\",\n            choices=FORMATS,\n        )\n\n    parser.add_argument(\n        \"-p\",\n        \"--preserve-key-order\",\n        help=argparse.SUPPRESS,\n    )\n\n    if not format_from_argv0 or argv0_to in {\"json\", \"toml\", \"yaml\"}:\n        parser.add_argument(\n            \"-s\",\n            \"--sort-keys\",\n            dest=\"ordered\",\n            action=\"store_false\",\n            help=\"sort JSON, TOML, YAML keys instead of preserving key order\",\n        )\n\n    parser.add_argument(\n        \"--unwrap\",\n        dest=\"unwrap\",\n        metavar=\"key\",\n        default=None,\n        help=\"only output the data stored under the given key\",\n    )\n    parser.add_argument(\n        \"--wrap\",\n        dest=\"wrap\",\n        metavar=\"key\",\n        default=None,\n        help=\"wrap the data in a map type with the given key\",\n    )\n\n    if not format_from_argv0 or argv0_to == \"yaml\":\n        parser.add_argument(\n            \"--yaml-indent\",\n            dest=\"yaml_indent\",\n            metavar=\"n\",\n            type=int,\n            default=2,\n            help=\"YAML indentation\",\n        )\n        parser.add_argument(\n            \"--yaml-style\",\n            dest=\"yaml_style\",\n            default=None,\n            help=\"YAML formatting style\",\n            choices=[\"\", \"'\", '\"', \"|\", \">\"],\n        )\n\n        def yaml_width(value: str) -> int:\n            # This is theoretically compatible with LibYAML.\n            return (1 << 32) - 1 if value.lower() == \"inf\" else int(value)\n\n        parser.add_argument(\n            \"--yaml-width\",\n            dest=\"yaml_width\",\n            metavar=\"n\",\n            type=yaml_width,  # Allow \"inf\".\n            default=80,\n            help=\"YAML line width for long strings\",\n        )\n\n    args = parser.parse_args(args=argv[1:])\n\n    # Use the positional input and output arguments.\n    if args.input_flag is not None:\n        args.input = args.input_flag\n\n    if args.output_flag is not None:\n        args.output = args.output_flag\n\n    # Determine the implicit input and output format if possible.\n    if format_from_argv0:\n        args.input_format = argv0_from\n        args.output_format = argv0_to\n    else:\n        if args.input_format == \"\":\n            args.input_format = extension_to_format(args.input)\n            if args.input_format == \"\":\n                parser.error(\"Need an explicit input format\")\n\n        if args.output_format == \"\":\n            args.output_format = extension_to_format(args.output)\n            if args.output_format == \"\":\n                parser.error(\"Need an explicit output format\")\n\n    for key, value in defaults.items():\n        vars(args).setdefault(key, value)\n\n    # Wrap the yaml_* option.\n    if \"yaml_indent\" in vars(args):\n        vars(args)[\"yaml_options\"] = {\n            \"default_style\": args.yaml_style,\n            \"indent\": args.yaml_indent,\n            \"width\": args.yaml_width,\n        }\n        for key in [\"yaml_indent\", \"yaml_style\", \"yaml_width\"]:\n            del vars(args)[key]\n\n    return args\n", "code_after": "def parse_command_line(argv: List[str]) -> argparse.Namespace:  # noqa: C901.\n    defaults: Dict[str, Any] = {\n        \"json_indent\": None,\n        \"ordered\": True,\n        \"stringify\": False,\n        \"yaml_options\": {},\n    }\n\n    me = Path(argv[0]).name\n    argv0_from, argv0_to = argv0_to_format(me)\n    format_from_argv0 = argv0_to != \"\"\n\n    parser = argparse.ArgumentParser(\n        description=\"Convert between CBOR, JSON, MessagePack, TOML, and YAML.\"\n    )\n    parser.add_argument(\"-v\", \"--version\", action=\"version\", version=__version__)\n\n    input_group = parser.add_mutually_exclusive_group()\n    input_group.add_argument(\"input\", nargs=\"?\", default=\"-\", help=\"input file\")\n    input_group.add_argument(\n        \"-i\",\n        \"--input\",\n        dest=\"input_flag\",\n        metavar=\"input\",\n        default=None,\n        help=\"input file\",\n    )\n\n    if not format_from_argv0:\n        parser.add_argument(\n            \"--if\",\n            \"-if\",\n            \"--input-format\",\n            dest=\"input_format\",\n            default=\"\",\n            help=\"input format\",\n            choices=FORMATS,\n        )\n\n    if not format_from_argv0 or argv0_to == \"json\":\n        parser.add_argument(\n            \"--json-indent\",\n            \"--indent-json\",\n            dest=\"json_indent\",\n            metavar=\"n\",\n            type=int,\n            default=defaults[\"json_indent\"],\n            help=\"JSON indentation\",\n        )\n\n    if not format_from_argv0 or argv0_to in {\"json\", \"toml\"}:\n        parser.add_argument(\n            \"-k\",\n            \"--stringify\",\n            dest=\"stringify\",\n            action=\"store_true\",\n            help=(\n                \"Turn into strings boolean, date-time, and null keys for JSON \"\n                \"and TOML and null values for TOML\"\n            ),\n        )\n\n    parser.add_argument(\n        \"--max-nodes\",\n        dest=\"max_nodes\",\n        metavar=\"n\",\n        type=int,\n        default=DEFAULT_MAX_NODES,\n        help=\"maximum number of nodes in input data (default %(default)s)\",\n    )\n\n    output_group = parser.add_mutually_exclusive_group()\n    output_group.add_argument(\"output\", nargs=\"?\", default=\"-\", help=\"output file\")\n    output_group.add_argument(\n        \"-o\",\n        \"--output\",\n        dest=\"output_flag\",\n        metavar=\"output\",\n        default=None,\n        help=\"output file\",\n    )\n\n    if not format_from_argv0:\n        parser.add_argument(\n            \"--of\",\n            \"-of\",\n            \"--output-format\",\n            dest=\"output_format\",\n            default=\"\",\n            help=\"output format\",\n            choices=FORMATS,\n        )\n\n    parser.add_argument(\n        \"-p\",\n        \"--preserve-key-order\",\n        help=argparse.SUPPRESS,\n    )\n\n    if not format_from_argv0 or argv0_to in {\"json\", \"toml\", \"yaml\"}:\n        parser.add_argument(\n            \"-s\",\n            \"--sort-keys\",\n            dest=\"ordered\",\n            action=\"store_false\",\n            help=\"sort JSON, TOML, YAML keys instead of preserving key order\",\n        )\n\n    parser.add_argument(\n        \"--unwrap\",\n        dest=\"unwrap\",\n        metavar=\"key\",\n        default=None,\n        help=\"only output the data stored under the given key\",\n    )\n    parser.add_argument(\n        \"--wrap\",\n        dest=\"wrap\",\n        metavar=\"key\",\n        default=None,\n        help=\"wrap the data in a map type with the given key\",\n    )\n\n    if not format_from_argv0 or argv0_to == \"yaml\":\n        parser.add_argument(\n            \"--yaml-indent\",\n            dest=\"yaml_indent\",\n            metavar=\"n\",\n            type=int,\n            default=2,\n            help=\"YAML indentation\",\n        )\n        parser.add_argument(\n            \"--yaml-style\",\n            dest=\"yaml_style\",\n            default=None,\n            help=\"YAML formatting style\",\n            choices=[\"\", \"'\", '\"', \"|\", \">\"],\n        )\n\n        def yaml_width(value: str) -> int:\n            # This is theoretically compatible with LibYAML.\n            return (1 << 32) - 1 if value.lower() == \"inf\" else int(value)\n\n        parser.add_argument(\n            \"--yaml-width\",\n            dest=\"yaml_width\",\n            metavar=\"n\",\n            type=yaml_width,  # Allow \"inf\".\n            default=80,\n            help=\"YAML line width for long strings\",\n        )\n\n    args = parser.parse_args(args=argv[1:])\n\n    # Use the positional input and output arguments.\n    if args.input_flag is not None:\n        args.input = args.input_flag\n\n    if args.output_flag is not None:\n        args.output = args.output_flag\n\n    # Determine the implicit input and output format if possible.\n    if format_from_argv0:\n        args.input_format = argv0_from\n        args.output_format = argv0_to\n    else:\n        if args.input_format == \"\":\n            args.input_format = extension_to_format(args.input)\n            if args.input_format == \"\":\n                parser.error(\"Need an explicit input format\")\n\n        if args.output_format == \"\":\n            args.output_format = extension_to_format(args.output)\n            if args.output_format == \"\":\n                parser.error(\"Need an explicit output format\")\n\n    for key, value in defaults.items():\n        vars(args).setdefault(key, value)\n\n    # Wrap the yaml_* option.\n    if \"yaml_indent\" in vars(args):\n        vars(args)[\"yaml_options\"] = {\n            \"default_style\": args.yaml_style,\n            \"indent\": args.yaml_indent,\n            \"width\": args.yaml_width,\n        }\n        for key in [\"yaml_indent\", \"yaml_style\", \"yaml_width\"]:\n            del vars(args)[key]\n\n    return args\n", "commit_message": "fix(yaml): limit maximum nodes\n\nPrevent a billion laughs attack carried out with YAML anchors.\n\nThanks to Taichi Kotake of Akatsuki Inc. for finding this vulnerability\nand to JPCERT/CC for reporting it.\n\nJVN#86156389", "commit": "https://github.com/remarshal-project/remarshal/commit/fd6ac799a02f533c3fc243b49cdd6d21aa7ee494", "description": "Remarshal prior to v0.17.1 expands YAML alias nodes unlimitedly, hence Remarshal is vulnerable to Billion Laughs Attack. Processing untrusted YAML files may cause a denial-of-service (DoS) condition.", "file_change_id": 77021401668310, "report_link": "https://github.com/advisories/GHSA-gw7g-qr8w-3448", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "remarshal", "code_before": "def remarshal(\n    input: Path | str,\n    output: Path | str,\n    input_format: str,\n    output_format: str,\n    *,\n    json_indent: Union[int, None] = None,\n    ordered: bool = True,\n    stringify: bool = False,\n    transform: Union[Callable[[Document], Document], None] = None,\n    unwrap: Union[str, None] = None,\n    wrap: Union[str, None] = None,\n    yaml_options: Dict[Any, Any] = {},\n) -> None:\n    input_file = None\n    output_file = None\n\n    try:\n        input_file = sys.stdin.buffer if input == \"-\" else Path(input).open(\"rb\")\n        output_file = sys.stdout.buffer if output == \"-\" else Path(output).open(\"wb\")\n\n        input_data = input_file.read()\n        if not isinstance(input_data, bytes):\n            msg = \"input_data must be bytes\"\n            raise TypeError(msg)\n\n        parsed = decode(input_format, input_data)\n\n        if unwrap is not None:\n            if not isinstance(parsed, Mapping):\n                msg = (\n                    f\"Top-level value of type '{type(parsed).__name__}' \"\n                    \"cannot be unwrapped\"\n                )\n                raise TypeError(msg)\n            parsed = parsed[unwrap]\n        if wrap is not None:\n            temp = {}\n            temp[wrap] = parsed\n            parsed = temp\n\n        if transform:\n            parsed = transform(parsed)\n\n        encoded = encode(\n            output_format,\n            parsed,\n            json_indent=json_indent,\n            ordered=ordered,\n            stringify=stringify,\n            yaml_options=yaml_options,\n        )\n\n        output_file.write(encoded)\n    finally:\n        if input_file is not None:\n            input_file.close()\n        if output != \"-\" and output_file is not None:\n            output_file.close()\n", "code_after": "def remarshal(\n    input: Path | str,\n    output: Path | str,\n    input_format: str,\n    output_format: str,\n    *,\n    json_indent: Union[int, None] = None,\n    max_nodes: int = DEFAULT_MAX_NODES,\n    ordered: bool = True,\n    stringify: bool = False,\n    transform: Union[Callable[[Document], Document], None] = None,\n    unwrap: Union[str, None] = None,\n    wrap: Union[str, None] = None,\n    yaml_options: Dict[Any, Any] = {},\n) -> None:\n    input_file = None\n    output_file = None\n\n    try:\n        input_file = sys.stdin.buffer if input == \"-\" else Path(input).open(\"rb\")\n        output_file = sys.stdout.buffer if output == \"-\" else Path(output).open(\"wb\")\n\n        input_data = input_file.read()\n        if not isinstance(input_data, bytes):\n            msg = \"input_data must be bytes\"\n            raise TypeError(msg)\n\n        parsed = decode(input_format, input_data)\n\n        validate_node_count(parsed, limit=max_nodes)\n\n        if unwrap is not None:\n            if not isinstance(parsed, Mapping):\n                msg = (\n                    f\"Top-level value of type '{type(parsed).__name__}' \"\n                    \"cannot be unwrapped\"\n                )\n                raise TypeError(msg)\n            parsed = parsed[unwrap]\n        if wrap is not None:\n            temp = {}\n            temp[wrap] = parsed\n            parsed = temp\n\n        if transform:\n            parsed = transform(parsed)\n\n        encoded = encode(\n            output_format,\n            parsed,\n            json_indent=json_indent,\n            ordered=ordered,\n            stringify=stringify,\n            yaml_options=yaml_options,\n        )\n\n        output_file.write(encoded)\n    finally:\n        if input_file is not None:\n            input_file.close()\n        if output != \"-\" and output_file is not None:\n            output_file.close()\n"}, {"function_name": "main", "code_before": "def main() -> None:\n    try:\n        run(sys.argv)\n    except KeyboardInterrupt:\n        pass\n    except (OSError, TypeError, ValueError) as e:\n        print(f\"Error: {e}\", file=sys.stderr)  # noqa: T201\n        sys.exit(1)\n", "code_after": "def main() -> None:\n    try:\n        run(sys.argv)\n    except KeyboardInterrupt:\n        pass\n    except (OSError, TooManyNodesError, TypeError, ValueError) as e:\n        print(f\"Error: {e}\", file=sys.stderr)  # noqa: T201\n        sys.exit(1)\n"}, {"function_name": "run", "code_before": "def run(argv: List[str]) -> None:\n    args = parse_command_line(argv)\n    remarshal(\n        args.input,\n        args.output,\n        args.input_format,\n        args.output_format,\n        json_indent=args.json_indent,\n        ordered=args.ordered,\n        stringify=args.stringify,\n        unwrap=args.unwrap,\n        wrap=args.wrap,\n        yaml_options=args.yaml_options,\n    )\n", "code_after": "def run(argv: List[str]) -> None:\n    args = parse_command_line(argv)\n    remarshal(\n        args.input,\n        args.output,\n        args.input_format,\n        args.output_format,\n        json_indent=args.json_indent,\n        max_nodes=args.max_nodes,\n        ordered=args.ordered,\n        stringify=args.stringify,\n        unwrap=args.unwrap,\n        wrap=args.wrap,\n        yaml_options=args.yaml_options,\n    )\n"}], "gpt_answer": "The vulnerability described is a Billion Laughs Attack, which is a type of denial of service attack that can occur when a YAML file with a large number of alias nodes is processed. The vulnerability is due to the unlimited expansion of YAML alias nodes.\n\nLooking at the changes in the `parse_command_line` function, a new argument `--max-nodes` is added to the parser. This argument is used to limit the maximum number of nodes in the input data, which is a direct countermeasure to the described vulnerability.\n\nTherefore, the `parse_command_line` function is relevant to the vulnerability that the commit is trying to fix, and the changes made to the function are directly addressing the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "run", "code_before": "def run(argv: List[str]) -> None:\n    args = parse_command_line(argv)\n    remarshal(\n        args.input,\n        args.output,\n        args.input_format,\n        args.output_format,\n        json_indent=args.json_indent,\n        ordered=args.ordered,\n        stringify=args.stringify,\n        unwrap=args.unwrap,\n        wrap=args.wrap,\n        yaml_options=args.yaml_options,\n    )\n", "code_after": "def run(argv: List[str]) -> None:\n    args = parse_command_line(argv)\n    remarshal(\n        args.input,\n        args.output,\n        args.input_format,\n        args.output_format,\n        json_indent=args.json_indent,\n        max_nodes=args.max_nodes,\n        ordered=args.ordered,\n        stringify=args.stringify,\n        unwrap=args.unwrap,\n        wrap=args.wrap,\n        yaml_options=args.yaml_options,\n    )\n", "commit_message": "fix(yaml): limit maximum nodes\n\nPrevent a billion laughs attack carried out with YAML anchors.\n\nThanks to Taichi Kotake of Akatsuki Inc. for finding this vulnerability\nand to JPCERT/CC for reporting it.\n\nJVN#86156389", "commit": "https://github.com/remarshal-project/remarshal/commit/fd6ac799a02f533c3fc243b49cdd6d21aa7ee494", "description": "Remarshal prior to v0.17.1 expands YAML alias nodes unlimitedly, hence Remarshal is vulnerable to Billion Laughs Attack. Processing untrusted YAML files may cause a denial-of-service (DoS) condition.", "file_change_id": 77021401668310, "report_link": "https://github.com/advisories/GHSA-gw7g-qr8w-3448", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "parse_command_line", "code_before": "def parse_command_line(argv: List[str]) -> argparse.Namespace:  # noqa: C901.\n    defaults: Dict[str, Any] = {\n        \"json_indent\": None,\n        \"ordered\": True,\n        \"stringify\": False,\n        \"yaml_options\": {},\n    }\n\n    me = Path(argv[0]).name\n    argv0_from, argv0_to = argv0_to_