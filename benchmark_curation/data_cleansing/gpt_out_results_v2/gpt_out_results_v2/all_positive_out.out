:\n                # must be zero - unless it's compressed then rsv1 is true\n                raise FailedConnectionError(\n                    1002,\n                    \"RSV1, RSV2, RSV3: MUST be 0 unless an extension is\"\n                    \" negotiated that defines meanings for non-zero values.\")\n        opcode = a & 15\n        if opcode not in (0, 1, 2, 8, 9, 0xA):\n            raise FailedConnectionError(1002, \"Unknown opcode received.\")\n        masked = b & 128 == 128\n        if not masked and not self.client:\n            raise FailedConnectionError(1002, \"A client MUST mask all frames\"\n                                        \" that it sends to the server\")\n        length = b & 127\n        if opcode & 8:\n            if not finished:\n                raise FailedConnectionError(1002, \"Control frames must not\"\n                                            \" be fragmented.\")\n            if length > 125:\n                raise FailedConnectionError(\n                    1002,\n                    \"All control frames MUST have a payload length of 125\"\n                    \" bytes or less\")\n        elif opcode and message:\n            raise FailedConnectionError(\n                1002,\n                \"Received a non-continuation opcode within\"\n                \" fragmented message.\")\n        elif not opcode and not message:\n            raise FailedConnectionError(\n                1002,\n                \"Received continuation opcode with no previous\"\n                \" fragments received.\")\n        if length == 126:\n            length = struct.unpack('!H', recv(2))[0]\n        elif length == 127:\n            length = struct.unpack('!Q', recv(8))[0]\n\n        if length > self.max_frame_length:\n            raise FailedConnectionError(1009, \"Incoming frame of {} bytes is above length limit of {} bytes.\".format(\n                length, self.max_frame_length))\n        if masked:\n            mask = struct.unpack('!BBBB', recv(4))\n        received = 0\n        if not message or opcode & 8:\n            decoder = self.UTF8Decoder() if opcode == 1 else None\n            decompressor = self._get_permessage_deflate_dec(rsv1)\n            message = self.Message(opcode, self.max_frame_length, decoder=decoder, decompressor=decompressor)\n        if not length:\n            message.push(b'', final=finished)\n        else:\n            while received < length:\n                d = self.socket.recv(length - received)\n                if not d:\n                    raise ConnectionClosedError()\n                dlen = len(d)\n                if masked:\n                    d = self._apply_mask(d, mask, length=dlen, offset=received)\n                received = received + dlen\n                try:\n                    message.push(d, final=finished)\n                except (UnicodeDecodeError, ValueError):\n                    raise FailedConnectionError(\n                        1007, \"Text data must be valid utf-8\")\n        return message\n"}, {"function_name": "__init__", "code_before": "    def __init__(self, handler):\n        self.handler = handler\n        self.protocol_version = None\n        self.support_legacy_versions = True\n        self.supported_protocols = []\n        self.origin_checker = None\n", "code_after": "    def __init__(self, handler, max_frame_length=DEFAULT_MAX_FRAME_LENGTH):\n        self.handler = handler\n        self.protocol_version = None\n        self.support_legacy_versions = True\n        self.supported_protocols = []\n        self.origin_checker = None\n        self.max_frame_length = max_frame_length\n"}, {"function_name": "_handle_hybi_request", "code_before": "    def _handle_hybi_request(self, environ):\n        if 'eventlet.input' in environ:\n            sock = environ['eventlet.input'].get_socket()\n        elif 'gunicorn.socket' in environ:\n            sock = environ['gunicorn.socket']\n        else:\n            raise Exception('No eventlet.input or gunicorn.socket present in environ.')\n\n        hybi_version = environ['HTTP_SEC_WEBSOCKET_VERSION']\n        if hybi_version not in ('8', '13', ):\n            raise BadRequest(status='426 Upgrade Required',\n                             headers=[('Sec-WebSocket-Version', '8, 13')])\n        self.protocol_version = int(hybi_version)\n        if 'HTTP_SEC_WEBSOCKET_KEY' not in environ:\n            # That's bad.\n            raise BadRequest()\n        origin = environ.get(\n            'HTTP_ORIGIN',\n            (environ.get('HTTP_SEC_WEBSOCKET_ORIGIN', '')\n             if self.protocol_version <= 8 else ''))\n        if self.origin_checker is not None:\n            if not self.origin_checker(environ.get('HTTP_HOST'), origin):\n                raise BadRequest(status='403 Forbidden')\n        protocols = environ.get('HTTP_SEC_WEBSOCKET_PROTOCOL', None)\n        negotiated_protocol = None\n        if protocols:\n            for p in (i.strip() for i in protocols.split(',')):\n                if p in self.supported_protocols:\n                    negotiated_protocol = p\n                    break\n\n        key = environ['HTTP_SEC_WEBSOCKET_KEY']\n        response = base64.b64encode(sha1(six.b(key) + PROTOCOL_GUID).digest())\n        handshake_reply = [b\"HTTP/1.1 101 Switching Protocols\",\n                           b\"Upgrade: websocket\",\n                           b\"Connection: Upgrade\",\n                           b\"Sec-WebSocket-Accept: \" + response]\n        if negotiated_protocol:\n            handshake_reply.append(b\"Sec-WebSocket-Protocol: \" + six.b(negotiated_protocol))\n\n        parsed_extensions = {}\n        extensions = self._parse_extension_header(environ.get(\"HTTP_SEC_WEBSOCKET_EXTENSIONS\"))\n\n        deflate = self._negotiate_permessage_deflate(extensions)\n        if deflate is not None:\n            parsed_extensions[\"permessage-deflate\"] = deflate\n\n        formatted_ext = self._format_extension_header(parsed_extensions)\n        if formatted_ext is not None:\n            handshake_reply.append(b\"Sec-WebSocket-Extensions: \" + formatted_ext)\n\n        sock.sendall(b'\\r\\n'.join(handshake_reply) + b'\\r\\n\\r\\n')\n        return RFC6455WebSocket(sock, environ, self.protocol_version,\n                                protocol=negotiated_protocol,\n                                extensions=parsed_extensions)\n", "code_after": "    def _handle_hybi_request(self, environ):\n        if 'eventlet.input' in environ:\n            sock = environ['eventlet.input'].get_socket()\n        elif 'gunicorn.socket' in environ:\n            sock = environ['gunicorn.socket']\n        else:\n            raise Exception('No eventlet.input or gunicorn.socket present in environ.')\n\n        hybi_version = environ['HTTP_SEC_WEBSOCKET_VERSION']\n        if hybi_version not in ('8', '13', ):\n            raise BadRequest(status='426 Upgrade Required',\n                             headers=[('Sec-WebSocket-Version', '8, 13')])\n        self.protocol_version = int(hybi_version)\n        if 'HTTP_SEC_WEBSOCKET_KEY' not in environ:\n            # That's bad.\n            raise BadRequest()\n        origin = environ.get(\n            'HTTP_ORIGIN',\n            (environ.get('HTTP_SEC_WEBSOCKET_ORIGIN', '')\n             if self.protocol_version <= 8 else ''))\n        if self.origin_checker is not None:\n            if not self.origin_checker(environ.get('HTTP_HOST'), origin):\n                raise BadRequest(status='403 Forbidden')\n        protocols = environ.get('HTTP_SEC_WEBSOCKET_PROTOCOL', None)\n        negotiated_protocol = None\n        if protocols:\n            for p in (i.strip() for i in protocols.split(',')):\n                if p in self.supported_protocols:\n                    negotiated_protocol = p\n                    break\n\n        key = environ['HTTP_SEC_WEBSOCKET_KEY']\n        response = base64.b64encode(sha1(six.b(key) + PROTOCOL_GUID).digest())\n        handshake_reply = [b\"HTTP/1.1 101 Switching Protocols\",\n                           b\"Upgrade: websocket\",\n                           b\"Connection: Upgrade\",\n                           b\"Sec-WebSocket-Accept: \" + response]\n        if negotiated_protocol:\n            handshake_reply.append(b\"Sec-WebSocket-Protocol: \" + six.b(negotiated_protocol))\n\n        parsed_extensions = {}\n        extensions = self._parse_extension_header(environ.get(\"HTTP_SEC_WEBSOCKET_EXTENSIONS\"))\n\n        deflate = self._negotiate_permessage_deflate(extensions)\n        if deflate is not None:\n            parsed_extensions[\"permessage-deflate\"] = deflate\n\n        formatted_ext = self._format_extension_header(parsed_extensions)\n        if formatted_ext is not None:\n            handshake_reply.append(b\"Sec-WebSocket-Extensions: \" + formatted_ext)\n\n        sock.sendall(b'\\r\\n'.join(handshake_reply) + b'\\r\\n\\r\\n')\n        return RFC6455WebSocket(sock, environ, self.protocol_version,\n                                protocol=negotiated_protocol,\n                                extensions=parsed_extensions,\n                                max_frame_length=self.max_frame_length)\n"}, {"function_name": "_handle_control_frame", "code_before": "    def _handle_control_frame(self, opcode, data):\n        if opcode == 8:  # connection close\n            if not data:\n                status = 1000\n            elif len(data) > 1:\n                status = struct.unpack_from('!H', data)[0]\n                if not status or status not in VALID_CLOSE_STATUS:\n                    raise FailedConnectionError(\n                        1002,\n                        \"Unexpected close status code.\")\n                try:\n                    data = self.UTF8Decoder().decode(data[2:], True)\n                except (UnicodeDecodeError, ValueError):\n                    raise FailedConnectionError(\n                        1002,\n                        \"Close message data should be valid UTF-8.\")\n            else:\n                status = 1002\n            self.close(close_data=(status, ''))\n            raise ConnectionClosedError()\n        elif opcode == 9:  # ping\n            self.send(data, control_code=0xA)\n        elif opcode == 0xA:  # pong\n            pass\n        else:\n            raise FailedConnectionError(\n                1002, \"Unknown control frame received.\")\n", "code_after": "    def _handle_control_frame(self, opcode, data):\n        if opcode == 8:  # connection close\n            self._remote_close_data = data\n            if not data:\n                status = 1000\n            elif len(data) > 1:\n                status = struct.unpack_from('!H', data)[0]\n                if not status or status not in VALID_CLOSE_STATUS:\n                    raise FailedConnectionError(\n                        1002,\n                        \"Unexpected close status code.\")\n                try:\n                    data = self.UTF8Decoder().decode(data[2:], True)\n                except (UnicodeDecodeError, ValueError):\n                    raise FailedConnectionError(\n                        1002,\n                        \"Close message data should be valid UTF-8.\")\n            else:\n                status = 1002\n            self.close(close_data=(status, ''))\n            raise ConnectionClosedError()\n        elif opcode == 9:  # ping\n            self.send(data, control_code=0xA)\n        elif opcode == 0xA:  # pong\n            pass\n        else:\n            raise FailedConnectionError(\n                1002, \"Unknown control frame received.\")\n"}, {"function_name": "__init__", "code_before": "    def __init__(self, sock, environ, version=13, protocol=None, client=False, extensions=None):\n        super(RFC6455WebSocket, self).__init__(sock, environ, version)\n        self.iterator = self._iter_frames()\n        self.client = client\n        self.protocol = protocol\n        self.extensions = extensions or {}\n\n        self._deflate_enc = None\n        self._deflate_dec = None\n", "code_after": ""}, {"function_name": "__init__", "code_before": "        def __init__(self, opcode, decoder=None, decompressor=None):\n            self.decoder = decoder\n            self.data = []\n            self.finished = False\n            self.opcode = opcode\n            self.decompressor = decompressor\n", "code_after": "        def __init__(self, opcode, max_frame_length, decoder=None, decompressor=None):\n            self.decoder = decoder\n            self.data = []\n            self.finished = False\n            self.opcode = opcode\n            self.decompressor = decompressor\n            self.max_frame_length = max_frame_length\n"}], "gpt_answer": "The provided information indicates that the vulnerability was related to a memory exhaustion DOS attack vector. The commit message and the description of the vulnerability suggest that the issue was due to the lack of a limit on the maximum uncompressed frame length.\n\nLooking at the changes in the \"getvalue\" function, it's clear that the function was modified to include a check for the maximum frame length. If the decompressed data exceeds the maximum frame length, an exception is raised. This change directly addresses the described vulnerability by preventing excessive memory usage due to very large websocket frames.\n\nTherefore, the \"getvalue\" function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "m3ApiRawFunction", "code_before": "m3ApiRawFunction(m3_wasi_generic_fd_pread)\n{\n    m3ApiReturnType  (uint32_t)\n    m3ApiGetArg      (__wasi_fd_t          , fd)\n    m3ApiGetArgMem   (__wasi_iovec_t *     , wasi_iovs)\n    m3ApiGetArg      (__wasi_size_t        , iovs_len)\n    m3ApiGetArg      (__wasi_filesize_t    , offset)\n    m3ApiGetArgMem   (__wasi_size_t *      , nread)\n\n    m3ApiCheckMem(wasi_iovs,    iovs_len * sizeof(__wasi_iovec_t));\n    m3ApiCheckMem(nread,        sizeof(__wasi_size_t));\n\n    __wasi_iovec_t iovs[iovs_len];\n    copy_iov_to_host(_mem, iovs, wasi_iovs, iovs_len);\n\n    __wasi_errno_t ret = __wasi_fd_pread(fd, iovs, iovs_len, offset, nread);\n\n    WASI_TRACE(\"fd:%d | nread:%d\", fd, *nread);\n\n    m3ApiReturn(ret);\n}\n", "code_after": "m3ApiRawFunction(m3_wasi_generic_fd_pread)\n{\n    m3ApiReturnType  (uint32_t)\n    m3ApiGetArg      (__wasi_fd_t          , fd)\n    m3ApiGetArgMem   (__wasi_iovec_t *     , wasi_iovs)\n    m3ApiGetArg      (__wasi_size_t        , iovs_len)\n    m3ApiGetArg      (__wasi_filesize_t    , offset)\n    m3ApiGetArgMem   (__wasi_size_t *      , nread)\n\n    m3ApiCheckMem(wasi_iovs,    iovs_len * sizeof(__wasi_iovec_t));\n    m3ApiCheckMem(nread,        sizeof(__wasi_size_t));\n\n    __wasi_iovec_t iovs[iovs_len];\n    const void* mem_check = copy_iov_to_host(runtime, _mem, iovs, wasi_iovs, iovs_len);\n    if (mem_check != m3Err_none) {\n        return mem_check;\n    }\n\n    __wasi_errno_t ret = __wasi_fd_pread(fd, iovs, iovs_len, offset, nread);\n\n    WASI_TRACE(\"fd:%d | nread:%d\", fd, *nread);\n\n    m3ApiReturn(ret);\n}\n", "commit_message": "fix WASI API read/write pread/pwrite buffer overflow (#324)\n\nCo-authored-by: \u8d75\u6d77 <zhaohai@cyberpeace.cn>", "commit": "https://github.com/wasm3/wasm3/commit/8441c82c4a98f554b12971450220b580c3c2b6df", "description": "WASM3 v0.5.0 was discovered to contain a heap overflow via the component /wabt/bin/poc.wasm.", "file_change_id": 266585333463372, "report_link": "https://github.com/advisories/GHSA-77fq-4xf5-hph4", "programming_language": "C", "other_changed_function_in_the_commit": [{"function_name": "copy_iov_to_host", "code_before": "void copy_iov_to_host(void* _mem, __wasi_iovec_t* host_iov, __wasi_iovec_t* wasi_iov, int32_t iovs_len)\n{\n    // Convert wasi memory offsets to host addresses\n    for (int i = 0; i < iovs_len; i++) {\n        host_iov[i].buf = m3ApiOffsetToPtr(wasi_iov[i].buf);\n        host_iov[i].buf_len  = wasi_iov[i].buf_len;\n    }\n}\n", "code_after": "const void* copy_iov_to_host(IM3Runtime runtime, void* _mem, __wasi_iovec_t* host_iov, __wasi_iovec_t* wasi_iov, int32_t iovs_len)\n{\n    // Convert wasi memory offsets to host addresses\n    for (int i = 0; i < iovs_len; i++) {\n        host_iov[i].buf = m3ApiOffsetToPtr(wasi_iov[i].buf);\n        host_iov[i].buf_len  = wasi_iov[i].buf_len;\n        m3ApiCheckMem(host_iov[i].buf,     host_iov[i].buf_len);\n    }\n    m3ApiSuccess();\n}\n"}], "gpt_answer": "The provided information indicates that the function `m3ApiRawFunction(m3_wasi_generic_fd_pread)` has been modified to address a heap overflow vulnerability. The change in the function is related to how it handles the return value of the `copy_iov_to_host` function.\n\nIn the \"before\" code, the `copy_iov_to_host` function is called without checking its return value. In the \"after\" code, the return value of `copy_iov_to_host` is checked, and if it's not `m3Err_none`, the function returns the error.\n\nThe `copy_iov_to_host` function itself has also been modified to include a memory check (`m3ApiCheckMem`) for each buffer in the `iovs` array. This is a direct response to the heap overflow vulnerability, as it ensures that each buffer is within the valid memory range.\n\nTherefore, the `m3ApiRawFunction(m3_wasi_generic_fd_pread)` function is vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "m3ApiRawFunction", "code_before": "m3ApiRawFunction(m3_wasi_generic_fd_write)\n{\n    m3ApiReturnType  (uint32_t)\n    m3ApiGetArg      (__wasi_fd_t          , fd)\n    m3ApiGetArgMem   (__wasi_iovec_t *     , wasi_iovs)\n    m3ApiGetArg      (__wasi_size_t        , iovs_len)\n    m3ApiGetArgMem   (__wasi_size_t *      , nwritten)\n\n    m3ApiCheckMem(wasi_iovs,    iovs_len * sizeof(__wasi_iovec_t));\n    m3ApiCheckMem(nwritten,     sizeof(__wasi_size_t));\n\n    __wasi_iovec_t iovs[iovs_len];\n    copy_iov_to_host(_mem, iovs, wasi_iovs, iovs_len);\n\n    __wasi_errno_t ret = __wasi_fd_write(fd, (__wasi_ciovec_t*)iovs, iovs_len, nwritten);\n\n    WASI_TRACE(\"fd:%d | nwritten:%d\", fd, *nwritten);\n\n    m3ApiReturn(ret);\n}\n", "code_after": "m3ApiRawFunction(m3_wasi_generic_fd_write)\n{\n    m3ApiReturnType  (uint32_t)\n    m3ApiGetArg      (__wasi_fd_t          , fd)\n    m3ApiGetArgMem   (__wasi_iovec_t *     , wasi_iovs)\n    m3ApiGetArg      (__wasi_size_t        , iovs_len)\n    m3ApiGetArgMem   (__wasi_size_t *      , nwritten)\n\n    m3ApiCheckMem(wasi_iovs,    iovs_len * sizeof(__wasi_iovec_t));\n    m3ApiCheckMem(nwritten,     sizeof(__wasi_size_t));\n\n    __wasi_iovec_t iovs[iovs_len];\n    const void* mem_check = copy_iov_to_host(runtime, _mem, iovs, wasi_iovs, iovs_len);\n    if (mem_check != m3Err_none) {\n        return mem_check;\n    }\n\n    __wasi_errno_t ret = __wasi_fd_write(fd, (__wasi_ciovec_t*)iovs, iovs_len, nwritten);\n\n    WASI_TRACE(\"fd:%d | nwritten:%d\", fd, *nwritten);\n\n    m3ApiReturn(ret);\n}\n", "commit_message": "fix WASI API read/write pread/pwrite buffer overflow (#324)\n\nCo-authored-by: \u8d75\u6d77 <zhaohai@cyberpeace.cn>", "commit": "https://github.com/wasm3/wasm3/commit/8441c82c4a98f554b12971450220b580c3c2b6df", "description": "WASM3 v0.5.0 was discovered to contain a heap overflow via the component /wabt/bin/poc.wasm.", "file_change_id": 266585333463372, "report_link": "https://github.com/advisories/GHSA-77fq-4xf5-hph4", "programming_language": "C", "other_changed_function_in_the_commit": [{"function_name": "copy_iov_to_host", "code_before": "void copy_iov_to_host(void* _mem, __wasi_iovec_t* host_iov, __wasi_iovec_t* wasi_iov, int32_t iovs_len)\n{\n    // Convert wasi memory offsets to host addresses\n    for (int i = 0; i < iovs_len; i++) {\n        host_iov[i].buf = m3ApiOffsetToPtr(wasi_iov[i].buf);\n        host_iov[i].buf_len  = wasi_iov[i].buf_len;\n    }\n}\n", "code_after": "const void* copy_iov_to_host(IM3Runtime runtime, void* _mem, __wasi_iovec_t* host_iov, __wasi_iovec_t* wasi_iov, int32_t iovs_len)\n{\n    // Convert wasi memory offsets to host addresses\n    for (int i = 0; i < iovs_len; i++) {\n        host_iov[i].buf = m3ApiOffsetToPtr(wasi_iov[i].buf);\n        host_iov[i].buf_len  = wasi_iov[i].buf_len;\n        m3ApiCheckMem(host_iov[i].buf,     host_iov[i].buf_len);\n    }\n    m3ApiSuccess();\n}\n"}], "gpt_answer": "The provided information indicates that the function `m3ApiRawFunction(m3_wasi_generic_fd_write)` has been modified to address a vulnerability. The vulnerability description mentions a heap overflow issue.\n\nIn the `code_after` snippet, we can see that the function `copy_iov_to_host` is now returning a value which is checked for errors. If an error is detected, the function `m3ApiRawFunction(m3_wasi_generic_fd_write)` returns immediately. This change is likely related to the heap overflow issue, as it adds an additional layer of validation to the data being processed.\n\nMoreover, the function `copy_iov_to_host` has also been modified in the same commit to include a memory check (`m3ApiCheckMem`). This change is directly related to the heap overflow issue, as it adds a validation step to prevent writing beyond the allocated memory.\n\nBased on these observations, it can be concluded that the function `m3ApiRawFunction(m3_wasi_generic_fd_write)` was vulnerable and has been modified to address the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "m3ApiRawFunction", "code_before": "m3ApiRawFunction(m3_wasi_generic_fd_read)\n{\n    m3ApiReturnType  (uint32_t)\n    m3ApiGetArg      (__wasi_fd_t          , fd)\n    m3ApiGetArgMem   (__wasi_iovec_t *     , wasi_iovs)\n    m3ApiGetArg      (__wasi_size_t        , iovs_len)\n    m3ApiGetArgMem   (__wasi_size_t *      , nread)\n\n    m3ApiCheckMem(wasi_iovs,    iovs_len * sizeof(__wasi_iovec_t));\n    m3ApiCheckMem(nread,        sizeof(__wasi_size_t));\n\n    __wasi_iovec_t iovs[iovs_len];\n    copy_iov_to_host(_mem, iovs, wasi_iovs, iovs_len);\n\n    __wasi_errno_t ret = __wasi_fd_read(fd, iovs, iovs_len, nread);\n\n    WASI_TRACE(\"fd:%d | nread:%d\", fd, *nread);\n\n    m3ApiReturn(ret);\n}\n", "code_after": "m3ApiRawFunction(m3_wasi_generic_fd_read)\n{\n    m3ApiReturnType  (uint32_t)\n    m3ApiGetArg      (__wasi_fd_t          , fd)\n    m3ApiGetArgMem   (__wasi_iovec_t *     , wasi_iovs)\n    m3ApiGetArg      (__wasi_size_t        , iovs_len)\n    m3ApiGetArgMem   (__wasi_size_t *      , nread)\n\n    m3ApiCheckMem(wasi_iovs,    iovs_len * sizeof(__wasi_iovec_t));\n    m3ApiCheckMem(nread,        sizeof(__wasi_size_t));\n\n    __wasi_iovec_t iovs[iovs_len];\n    const void* mem_check = copy_iov_to_host(runtime, _mem, iovs, wasi_iovs, iovs_len);\n    if (mem_check != m3Err_none) {\n        return mem_check;\n    }\n\n    __wasi_errno_t ret = __wasi_fd_read(fd, iovs, iovs_len, nread);\n\n    WASI_TRACE(\"fd:%d | nread:%d\", fd, *nread);\n\n    m3ApiReturn(ret);\n}\n", "commit_message": "fix WASI API read/write pread/pwrite buffer overflow (#324)\n\nCo-authored-by: \u8d75\u6d77 <zhaohai@cyberpeace.cn>", "commit": "https://github.com/wasm3/wasm3/commit/8441c82c4a98f554b12971450220b580c3c2b6df", "description": "WASM3 v0.5.0 was discovered to contain a heap overflow via the component /wabt/bin/poc.wasm.", "file_change_id": 266585333463372, "report_link": "https://github.com/advisories/GHSA-77fq-4xf5-hph4", "programming_language": "C", "other_changed_function_in_the_commit": [{"function_name": "copy_iov_to_host", "code_before": "void copy_iov_to_host(void* _mem, __wasi_iovec_t* host_iov, __wasi_iovec_t* wasi_iov, int32_t iovs_len)\n{\n    // Convert wasi memory offsets to host addresses\n    for (int i = 0; i < iovs_len; i++) {\n        host_iov[i].buf = m3ApiOffsetToPtr(wasi_iov[i].buf);\n        host_iov[i].buf_len  = wasi_iov[i].buf_len;\n    }\n}\n", "code_after": "const void* copy_iov_to_host(IM3Runtime runtime, void* _mem, __wasi_iovec_t* host_iov, __wasi_iovec_t* wasi_iov, int32_t iovs_len)\n{\n    // Convert wasi memory offsets to host addresses\n    for (int i = 0; i < iovs_len; i++) {\n        host_iov[i].buf = m3ApiOffsetToPtr(wasi_iov[i].buf);\n        host_iov[i].buf_len  = wasi_iov[i].buf_len;\n        m3ApiCheckMem(host_iov[i].buf,     host_iov[i].buf_len);\n    }\n    m3ApiSuccess();\n}\n"}], "gpt_answer": "The provided information indicates that the function `m3ApiRawFunction(m3_wasi_generic_fd_read)` has been modified to address a heap overflow vulnerability. The change in the function is related to how it handles the return value of the `copy_iov_to_host` function.\n\nIn the \"before\" code, the `copy_iov_to_host` function is called without checking its return value. In the \"after\" code, the return value of `copy_iov_to_host` is checked, and if it's not `m3Err_none`, the function returns the error.\n\nThe `copy_iov_to_host` function itself has also been modified to include a memory check (`m3ApiCheckMem`) for each buffer in the `iovs` array. This is a direct response to the reported heap overflow vulnerability, as it adds a protection measure against ill-formed or malicious inputs that could potentially lead to a buffer overflow.\n\nTherefore, the `m3ApiRawFunction(m3_wasi_generic_fd_read)` function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "m3ApiRawFunction", "code_before": "m3ApiRawFunction(m3_wasi_generic_fd_pwrite)\n{\n    m3ApiReturnType  (uint32_t)\n    m3ApiGetArg      (__wasi_fd_t          , fd)\n    m3ApiGetArgMem   (__wasi_iovec_t *     , wasi_iovs)\n    m3ApiGetArg      (__wasi_size_t        , iovs_len)\n    m3ApiGetArg      (__wasi_filesize_t    , offset)\n    m3ApiGetArgMem   (__wasi_size_t *      , nwritten)\n\n    m3ApiCheckMem(wasi_iovs,    iovs_len * sizeof(__wasi_iovec_t));\n    m3ApiCheckMem(nwritten,     sizeof(__wasi_size_t));\n\n    __wasi_iovec_t iovs[iovs_len];\n    copy_iov_to_host(_mem, iovs, wasi_iovs, iovs_len);\n\n    __wasi_errno_t ret = __wasi_fd_pwrite(fd, (__wasi_ciovec_t*)iovs, iovs_len, offset, nwritten);\n\n    WASI_TRACE(\"fd:%d | nwritten:%d\", fd, *nwritten);\n\n    m3ApiReturn(ret);\n}\n", "code_after": "m3ApiRawFunction(m3_wasi_generic_fd_pwrite)\n{\n    m3ApiReturnType  (uint32_t)\n    m3ApiGetArg      (__wasi_fd_t          , fd)\n    m3ApiGetArgMem   (__wasi_iovec_t *     , wasi_iovs)\n    m3ApiGetArg      (__wasi_size_t        , iovs_len)\n    m3ApiGetArg      (__wasi_filesize_t    , offset)\n    m3ApiGetArgMem   (__wasi_size_t *      , nwritten)\n\n    m3ApiCheckMem(wasi_iovs,    iovs_len * sizeof(__wasi_iovec_t));\n    m3ApiCheckMem(nwritten,     sizeof(__wasi_size_t));\n\n    __wasi_iovec_t iovs[iovs_len];\n    const void* mem_check = copy_iov_to_host(runtime, _mem, iovs, wasi_iovs, iovs_len);\n    if (mem_check != m3Err_none) {\n        return mem_check;\n    }\n    \n    __wasi_errno_t ret = __wasi_fd_pwrite(fd, (__wasi_ciovec_t*)iovs, iovs_len, offset, nwritten);\n\n    WASI_TRACE(\"fd:%d | nwritten:%d\", fd, *nwritten);\n\n    m3ApiReturn(ret);\n}\n", "commit_message": "fix WASI API read/write pread/pwrite buffer overflow (#324)\n\nCo-authored-by: \u8d75\u6d77 <zhaohai@cyberpeace.cn>", "commit": "https://github.com/wasm3/wasm3/commit/8441c82c4a98f554b12971450220b580c3c2b6df", "description": "WASM3 v0.5.0 was discovered to contain a heap overflow via the component /wabt/bin/poc.wasm.", "file_change_id": 266585333463372, "report_link": "https://github.com/advisories/GHSA-77fq-4xf5-hph4", "programming_language": "C", "other_changed_function_in_the_commit": [{"function_name": "copy_iov_to_host", "code_before": "void copy_iov_to_host(void* _mem, __wasi_iovec_t* host_iov, __wasi_iovec_t* wasi_iov, int32_t iovs_len)\n{\n    // Convert wasi memory offsets to host addresses\n    for (int i = 0; i < iovs_len; i++) {\n        host_iov[i].buf = m3ApiOffsetToPtr(wasi_iov[i].buf);\n        host_iov[i].buf_len  = wasi_iov[i].buf_len;\n    }\n}\n", "code_after": "const void* copy_iov_to_host(IM3Runtime runtime, void* _mem, __wasi_iovec_t* host_iov, __wasi_iovec_t* wasi_iov, int32_t iovs_len)\n{\n    // Convert wasi memory offsets to host addresses\n    for (int i = 0; i < iovs_len; i++) {\n        host_iov[i].buf = m3ApiOffsetToPtr(wasi_iov[i].buf);\n        host_iov[i].buf_len  = wasi_iov[i].buf_len;\n        m3ApiCheckMem(host_iov[i].buf,     host_iov[i].buf_len);\n    }\n    m3ApiSuccess();\n}\n"}], "gpt_answer": "The provided information indicates that the function `m3ApiRawFunction(m3_wasi_generic_fd_pwrite)` has been modified to address a heap overflow vulnerability. The change in the function is related to how it handles the copying of IO vectors to the host. \n\nIn the \"before\" code, the function `copy_iov_to_host` is called without any error checking. In the \"after\" code, the return value of `copy_iov_to_host` is checked for errors. If an error is detected, the function returns immediately. This change is likely to prevent a potential buffer overflow when copying IO vectors to the host.\n\nThe other function that was changed in the commit, `copy_iov_to_host`, has been modified to include a memory check (`m3ApiCheckMem`) for each IO vector. This is a direct measure to prevent buffer overflows, which is the reported vulnerability.\n\nGiven this information, it can be concluded that the function `m3ApiRawFunction(m3_wasi_generic_fd_pwrite)` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "copy_iov_to_host", "code_before": "void copy_iov_to_host(void* _mem, __wasi_iovec_t* host_iov, __wasi_iovec_t* wasi_iov, int32_t iovs_len)\n{\n    // Convert wasi memory offsets to host addresses\n    for (int i = 0; i < iovs_len; i++) {\n        host_iov[i].buf = m3ApiOffsetToPtr(wasi_iov[i].buf);\n        host_iov[i].buf_len  = wasi_iov[i].buf_len;\n    }\n}\n", "code_after": "const void* copy_iov_to_host(IM3Runtime runtime, void* _mem, __wasi_iovec_t* host_iov, __wasi_iovec_t* wasi_iov, int32_t iovs_len)\n{\n    // Convert wasi memory offsets to host addresses\n    for (int i = 0; i < iovs_len; i++) {\n        host_iov[i].buf = m3ApiOffsetToPtr(wasi_iov[i].buf);\n        host_iov[i].buf_len  = wasi_iov[i].buf_len;\n        m3ApiCheckMem(host_iov[i].buf,     host_iov[i].buf_len);\n    }\n    m3ApiSuccess();\n}\n", "commit_message": "fix WASI API read/write pread/pwrite buffer overflow (#324)\n\nCo-authored-by: \u8d75\u6d77 <zhaohai@cyberpeace.cn>", "commit": "https://github.com/wasm3/wasm3/commit/8441c82c4a98f554b12971450220b580c3c2b6df", "description": "WASM3 v0.5.0 was discovered to contain a heap overflow via the component /wabt/bin/poc.wasm.", "file_change_id": 266585333463372, "report_link": "https://github.com/advisories/GHSA-77fq-4xf5-hph4", "programming_language": "C", "other_changed_function_in_the_commit": [{"function_name": "m3ApiRawFunction", "code_before": "m3ApiRawFunction(m3_wasi_generic_fd_pread)\n{\n    m3ApiReturnType  (uint32_t)\n    m3ApiGetArg      (__wasi_fd_t          , fd)\n    m3ApiGetArgMem   (__wasi_iovec_t *     , wasi_iovs)\n    m3ApiGetArg      (__wasi_size_t        , iovs_len)\n    m3ApiGetArg      (__wasi_filesize_t    , offset)\n    m3ApiGetArgMem   (__wasi_size_t *      , nread)\n\n    m3ApiCheckMem(wasi_iovs,    iovs_len * sizeof(__wasi_iovec_t));\n    m3ApiCheckMem(nread,        sizeof(__wasi_size_t));\n\n    __wasi_iovec_t iovs[iovs_len];\n    copy_iov_to_host(_mem, iovs, wasi_iovs, iovs_len);\n\n    __wasi_e