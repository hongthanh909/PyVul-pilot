up(get_body, 'html.parser')\n    src_attrs = ['src', 'href', 'srcset', 'data-srcset', 'data-src']\n\n    # Parse HTML response and replace relative links w/ absolute\n    for element in results.find_all():\n        for attr in src_attrs:\n            if not element.has_attr(attr) or not element[attr].startswith('/'):\n                continue\n\n            element[attr] = host_url + element[attr]\n\n    # Replace or remove javascript sources\n    for script in results.find_all('script', {'src': True}):\n        if 'nojs' in request.args:\n            script.decompose()\n        else:\n            content_filter.update_element_src(script, 'application/javascript')\n\n    # Replace all possible image attributes\n    img_sources = ['src', 'data-src', 'data-srcset', 'srcset']\n    for img in results.find_all('img'):\n        _ = [\n            content_filter.update_element_src(img, 'image/png', attr=_)\n            for _ in img_sources if img.has_attr(_)\n        ]\n\n    # Replace all stylesheet sources\n    for link in results.find_all('link', {'href': True}):\n        content_filter.update_element_src(link, 'text/css', attr='href')\n\n    # Use anonymous view for all links on page\n    for a in results.find_all('a', {'href': True}):\n        a['href'] = f'{Endpoint.window}?location=' + a['href'] + (\n            '&nojs=1' if 'nojs' in request.args else '')\n\n    # Remove all iframes -- these are commonly used inside of <noscript> tags\n    # to enforce loading Google Analytics\n    for iframe in results.find_all('iframe'):\n        iframe.decompose()\n\n    return render_template(\n        'display.html',\n        response=results,\n        translation=app.config['TRANSLATIONS'][\n            g.user_config.get_localization_lang()\n        ]\n    )\n", "code_after": "def window():\n    target_url = request.args.get('location')\n    if target_url.startswith('gAAAAA'):\n        cipher_suite = Fernet(g.session_key)\n        target_url = cipher_suite.decrypt(target_url.encode()).decode()\n\n    content_filter = Filter(\n        g.session_key,\n        root_url=request.url_root,\n        config=g.user_config)\n    target = urlparse.urlparse(target_url)\n\n    # Ensure requested URL has a valid domain\n    if not validators.domain(target.netloc):\n        return render_template(\n            'error.html',\n            error_message='Invalid location'), 400\n\n    host_url = f'{target.scheme}://{target.netloc}'\n\n    get_body = g.user_request.send(base_url=target_url).text\n\n    results = bsoup(get_body, 'html.parser')\n    src_attrs = ['src', 'href', 'srcset', 'data-srcset', 'data-src']\n\n    # Parse HTML response and replace relative links w/ absolute\n    for element in results.find_all():\n        for attr in src_attrs:\n            if not element.has_attr(attr) or not element[attr].startswith('/'):\n                continue\n\n            element[attr] = host_url + element[attr]\n\n    # Replace or remove javascript sources\n    for script in results.find_all('script', {'src': True}):\n        if 'nojs' in request.args:\n            script.decompose()\n        else:\n            content_filter.update_element_src(script, 'application/javascript')\n\n    # Replace all possible image attributes\n    img_sources = ['src', 'data-src', 'data-srcset', 'srcset']\n    for img in results.find_all('img'):\n        _ = [\n            content_filter.update_element_src(img, 'image/png', attr=_)\n            for _ in img_sources if img.has_attr(_)\n        ]\n\n    # Replace all stylesheet sources\n    for link in results.find_all('link', {'href': True}):\n        content_filter.update_element_src(link, 'text/css', attr='href')\n\n    # Use anonymous view for all links on page\n    for a in results.find_all('a', {'href': True}):\n        a['href'] = f'{Endpoint.window}?location=' + a['href'] + (\n            '&nojs=1' if 'nojs' in request.args else '')\n\n    # Remove all iframes -- these are commonly used inside of <noscript> tags\n    # to enforce loading Google Analytics\n    for iframe in results.find_all('iframe'):\n        iframe.decompose()\n\n    return render_template(\n        'display.html',\n        response=results,\n        translation=app.config['TRANSLATIONS'][\n            g.user_config.get_localization_lang()\n        ]\n    )\n"}, {"function_name": "config", "code_before": "def config():\n    config_disabled = (\n            app.config['CONFIG_DISABLE'] or\n            not valid_user_session(session))\n    if request.method == 'GET':\n        return json.dumps(g.user_config.__dict__)\n    elif request.method == 'PUT' and not config_disabled:\n        if 'name' in request.args:\n            config_pkl = os.path.join(\n                app.config['CONFIG_PATH'],\n                request.args.get('name'))\n            session['config'] = (pickle.load(open(config_pkl, 'rb'))\n                                 if os.path.exists(config_pkl)\n                                 else session['config'])\n            return json.dumps(session['config'])\n        else:\n            return json.dumps({})\n    elif not config_disabled:\n        config_data = request.form.to_dict()\n        if 'url' not in config_data or not config_data['url']:\n            config_data['url'] = g.user_config.url\n\n        # Save config by name to allow a user to easily load later\n        if 'name' in request.args:\n            pickle.dump(\n                config_data,\n                open(os.path.join(\n                    app.config['CONFIG_PATH'],\n                    request.args.get('name')), 'wb'))\n\n        session['config'] = config_data\n        return redirect(config_data['url'])\n    else:\n        return redirect(url_for('.index'), code=403)\n", "code_after": "def config():\n    config_disabled = (\n            app.config['CONFIG_DISABLE'] or\n            not valid_user_session(session))\n\n    name = ''\n    if 'name' in request.args:\n        name = os.path.normpath(request.args.get('name'))\n        if not re.match(r'^[A-Za-z0-9_.+-]+$', name):\n            return make_response('Invalid config name', 400)\n\n    if request.method == 'GET':\n        return json.dumps(g.user_config.__dict__)\n    elif request.method == 'PUT' and not config_disabled:\n        if name:\n            config_pkl = os.path.join(app.config['CONFIG_PATH'], name)\n            session['config'] = (pickle.load(open(config_pkl, 'rb'))\n                                 if os.path.exists(config_pkl)\n                                 else session['config'])\n            return json.dumps(session['config'])\n        else:\n            return json.dumps({})\n    elif not config_disabled:\n        config_data = request.form.to_dict()\n        if 'url' not in config_data or not config_data['url']:\n            config_data['url'] = g.user_config.url\n\n        # Save config by name to allow a user to easily load later\n        if 'name' in request.args:\n            pickle.dump(\n                config_data,\n                open(os.path.join(\n                    app.config['CONFIG_PATH'],\n                    name), 'wb'))\n\n        session['config'] = config_data\n        return redirect(config_data['url'])\n    else:\n        return redirect(url_for('.index'), code=403)\n"}], "gpt_answer": "The vulnerability described is a Server-Side Request Forgery (SSRF) vulnerability, which allows an attacker to craft malicious GET requests to internal and external resources on behalf of the server. \n\nLooking at the changes in the `element` function, it's clear that the function was vulnerable and has been changed to fix the vulnerability. The change includes the addition of a domain validation check for the requested URL. This validation ensures that the requested URL is from a valid domain, which is a typical mitigation strategy for SSRF vulnerabilities. \n\nTherefore, the `element` function was vulnerable and has been changed to fix the vulnerability. \n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "config", "code_before": "def config():\n    config_disabled = (\n            app.config['CONFIG_DISABLE'] or\n            not valid_user_session(session))\n    if request.method == 'GET':\n        return json.dumps(g.user_config.__dict__)\n    elif request.method == 'PUT' and not config_disabled:\n        if 'name' in request.args:\n            config_pkl = os.path.join(\n                app.config['CONFIG_PATH'],\n                request.args.get('name'))\n            session['config'] = (pickle.load(open(config_pkl, 'rb'))\n                                 if os.path.exists(config_pkl)\n                                 else session['config'])\n            return json.dumps(session['config'])\n        else:\n            return json.dumps({})\n    elif not config_disabled:\n        config_data = request.form.to_dict()\n        if 'url' not in config_data or not config_data['url']:\n            config_data['url'] = g.user_config.url\n\n        # Save config by name to allow a user to easily load later\n        if 'name' in request.args:\n            pickle.dump(\n                config_data,\n                open(os.path.join(\n                    app.config['CONFIG_PATH'],\n                    request.args.get('name')), 'wb'))\n\n        session['config'] = config_data\n        return redirect(config_data['url'])\n    else:\n        return redirect(url_for('.index'), code=403)\n", "code_after": "def config():\n    config_disabled = (\n            app.config['CONFIG_DISABLE'] or\n            not valid_user_session(session))\n\n    name = ''\n    if 'name' in request.args:\n        name = os.path.normpath(request.args.get('name'))\n        if not re.match(r'^[A-Za-z0-9_.+-]+$', name):\n            return make_response('Invalid config name', 400)\n\n    if request.method == 'GET':\n        return json.dumps(g.user_config.__dict__)\n    elif request.method == 'PUT' and not config_disabled:\n        if name:\n            config_pkl = os.path.join(app.config['CONFIG_PATH'], name)\n            session['config'] = (pickle.load(open(config_pkl, 'rb'))\n                                 if os.path.exists(config_pkl)\n                                 else session['config'])\n            return json.dumps(session['config'])\n        else:\n            return json.dumps({})\n    elif not config_disabled:\n        config_data = request.form.to_dict()\n        if 'url' not in config_data or not config_data['url']:\n            config_data['url'] = g.user_config.url\n\n        # Save config by name to allow a user to easily load later\n        if 'name' in request.args:\n            pickle.dump(\n                config_data,\n                open(os.path.join(\n                    app.config['CONFIG_PATH'],\n                    name), 'wb'))\n\n        session['config'] = config_data\n        return redirect(config_data['url'])\n    else:\n        return redirect(url_for('.index'), code=403)\n", "commit_message": "Validate urls in `element` and `window` endpoints\n\nDomains were previously not validated before being handled, leading to a\npotential scenario where someone could pass something like\n\"element_url=127.0.0.1:<port>/<resource>\" to access other resources on a\nmachine running Whoogle. This change ensures that the resource used in\nboth endpoints is a valid domain.\n\nThis also includes validation of config names to prevent names from\nincluding path values such as \"../../(etc)\".", "commit": "https://github.com/benbusby/whoogle-search/commit/3a2e0b262e4a076a20416b45e6b6f23fd265aeda", "description": "whoogle-search is a Self-hosted, ad-free, privacy-respecting metasearch engine\nAffected versions of this package are vulnerable to Server-Side Request Forgery (SSRF) via the window endpoint which does not properly sanitize user-supplied input from the location variable before passing it to the send method. An attacker can craft malicious GET requests to internal and external resources on behalf of the server, accessing resources on the internal network that are not publicly accessible.", "file_change_id": 48543589111472, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-WHOOGLESEARCH-6186523", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "window", "code_before": "def window():\n    target_url = request.args.get('location')\n    if target_url.startswith('gAAAAA'):\n        cipher_suite = Fernet(g.session_key)\n        target_url = cipher_suite.decrypt(target_url.encode()).decode()\n\n    content_filter = Filter(\n        g.session_key,\n        root_url=request.url_root,\n        config=g.user_config)\n    target = urlparse.urlparse(target_url)\n    host_url = f'{target.scheme}://{target.netloc}'\n\n    get_body = g.user_request.send(base_url=target_url).text\n\n    results = bsoup(get_body, 'html.parser')\n    src_attrs = ['src', 'href', 'srcset', 'data-srcset', 'data-src']\n\n    # Parse HTML response and replace relative links w/ absolute\n    for element in results.find_all():\n        for attr in src_attrs:\n            if not element.has_attr(attr) or not element[attr].startswith('/'):\n                continue\n\n            element[attr] = host_url + element[attr]\n\n    # Replace or remove javascript sources\n    for script in results.find_all('script', {'src': True}):\n        if 'nojs' in request.args:\n            script.decompose()\n        else:\n            content_filter.update_element_src(script, 'application/javascript')\n\n    # Replace all possible image attributes\n    img_sources = ['src', 'data-src', 'data-srcset', 'srcset']\n    for img in results.find_all('img'):\n        _ = [\n            content_filter.update_element_src(img, 'image/png', attr=_)\n            for _ in img_sources if img.has_attr(_)\n        ]\n\n    # Replace all stylesheet sources\n    for link in results.find_all('link', {'href': True}):\n        content_filter.update_element_src(link, 'text/css', attr='href')\n\n    # Use anonymous view for all links on page\n    for a in results.find_all('a', {'href': True}):\n        a['href'] = f'{Endpoint.window}?location=' + a['href'] + (\n            '&nojs=1' if 'nojs' in request.args else '')\n\n    # Remove all iframes -- these are commonly used inside of <noscript> tags\n    # to enforce loading Google Analytics\n    for iframe in results.find_all('iframe'):\n        iframe.decompose()\n\n    return render_template(\n        'display.html',\n        response=results,\n        translation=app.config['TRANSLATIONS'][\n            g.user_config.get_localization_lang()\n        ]\n    )\n", "code_after": "def window():\n    target_url = request.args.get('location')\n    if target_url.startswith('gAAAAA'):\n        cipher_suite = Fernet(g.session_key)\n        target_url = cipher_suite.decrypt(target_url.encode()).decode()\n\n    content_filter = Filter(\n        g.session_key,\n        root_url=request.url_root,\n        config=g.user_config)\n    target = urlparse.urlparse(target_url)\n\n    # Ensure requested URL has a valid domain\n    if not validators.domain(target.netloc):\n        return render_template(\n            'error.html',\n            error_message='Invalid location'), 400\n\n    host_url = f'{target.scheme}://{target.netloc}'\n\n    get_body = g.user_request.send(base_url=target_url).text\n\n    results = bsoup(get_body, 'html.parser')\n    src_attrs = ['src', 'href', 'srcset', 'data-srcset', 'data-src']\n\n    # Parse HTML response and replace relative links w/ absolute\n    for element in results.find_all():\n        for attr in src_attrs:\n            if not element.has_attr(attr) or not element[attr].startswith('/'):\n                continue\n\n            element[attr] = host_url + element[attr]\n\n    # Replace or remove javascript sources\n    for script in results.find_all('script', {'src': True}):\n        if 'nojs' in request.args:\n            script.decompose()\n        else:\n            content_filter.update_element_src(script, 'application/javascript')\n\n    # Replace all possible image attributes\n    img_sources = ['src', 'data-src', 'data-srcset', 'srcset']\n    for img in results.find_all('img'):\n        _ = [\n            content_filter.update_element_src(img, 'image/png', attr=_)\n            for _ in img_sources if img.has_attr(_)\n        ]\n\n    # Replace all stylesheet sources\n    for link in results.find_all('link', {'href': True}):\n        content_filter.update_element_src(link, 'text/css', attr='href')\n\n    # Use anonymous view for all links on page\n    for a in results.find_all('a', {'href': True}):\n        a['href'] = f'{Endpoint.window}?location=' + a['href'] + (\n            '&nojs=1' if 'nojs' in request.args else '')\n\n    # Remove all iframes -- these are commonly used inside of <noscript> tags\n    # to enforce loading Google Analytics\n    for iframe in results.find_all('iframe'):\n        iframe.decompose()\n\n    return render_template(\n        'display.html',\n        response=results,\n        translation=app.config['TRANSLATIONS'][\n            g.user_config.get_localization_lang()\n        ]\n    )\n"}, {"function_name": "element", "code_before": "def element():\n    element_url = src_url = request.args.get('url')\n    if element_url.startswith('gAAAAA'):\n        try:\n            cipher_suite = Fernet(g.session_key)\n            src_url = cipher_suite.decrypt(element_url.encode()).decode()\n        except (InvalidSignature, InvalidToken) as e:\n            return render_template(\n                'error.html',\n                error_message=str(e)), 401\n\n    src_type = request.args.get('type')\n\n    try:\n        file_data = g.user_request.send(base_url=src_url).content\n        tmp_mem = io.BytesIO()\n        tmp_mem.write(file_data)\n        tmp_mem.seek(0)\n\n        return send_file(tmp_mem, mimetype=src_type)\n    except exceptions.RequestException:\n        pass\n\n    empty_gif = base64.b64decode(\n        'R0lGODlhAQABAIAAAP///////yH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==')\n    return send_file(io.BytesIO(empty_gif), mimetype='image/gif')\n", "code_after": "def element():\n    empty_gif = base64.b64decode(\n        'R0lGODlhAQABAIAAAP///////yH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==')\n    element_url = src_url = request.args.get('url')\n    if element_url.startswith('gAAAAA'):\n        try:\n            cipher_suite = Fernet(g.session_key)\n            src_url = cipher_suite.decrypt(element_url.encode()).decode()\n        except (InvalidSignature, InvalidToken) as e:\n            return render_template(\n                'error.html',\n                error_message=str(e)), 401\n\n    src_type = request.args.get('type')\n\n    # Ensure requested element is from a valid domain\n    domain = urlparse.urlparse(src_url).netloc\n    if not validators.domain(domain):\n        return send_file(io.BytesIO(empty_gif), mimetype='image/gif')\n\n    try:\n        file_data = g.user_request.send(base_url=src_url).content\n        tmp_mem = io.BytesIO()\n        tmp_mem.write(file_data)\n        tmp_mem.seek(0)\n\n        return send_file(tmp_mem, mimetype=src_type)\n    except exceptions.RequestException:\n        pass\n\n    return send_file(io.BytesIO(empty_gif), mimetype='image/gif')\n"}], "gpt_answer": "The provided information indicates that the vulnerability was related to Server-Side Request Forgery (SSRF) via the window endpoint which did not properly sanitize user-supplied input from the location variable before passing it to the send method. This could allow an attacker to craft malicious GET requests to internal and external resources on behalf of the server, accessing resources on the internal network that are not publicly accessible.\n\nThe changes in the \"config\" function are related to the validation of the 'name' parameter in the request arguments. The changes include normalizing the path of the 'name' and checking if it matches a certain regular expression pattern. If the 'name' does not match the pattern, a response with a 400 status code is returned. This change is made to prevent names from including path values such as \"../../(etc)\".\n\nGiven the description of the vulnerability, it seems that the changes in the \"config\" function are relevant to the vulnerability that the commit is trying to fix. The changes are made to prevent path traversal, which could be a part of the SSRF vulnerability. Therefore, the function appears to be vulnerable and has been changed in response to this vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "run", "code_before": "    def run(self, *args, **data):\n        \"\"\"Process a single Onboarding Task instance.\"\"\"\n        self.logger.info(\"START: onboard device\")\n        credentials = self._parse_credentials(data[\"credentials\"])\n        platform = data[\"platform\"]\n        netdev = NetdevKeeper(\n            hostname=data[\"ip_address\"],\n            port=data[\"port\"],\n            timeout=data[\"timeout\"],\n            username=credentials[\"username\"],\n            password=credentials[\"password\"],\n            secret=credentials[\"secret\"],\n            napalm_driver=platform.napalm_driver if platform and platform.napalm_driver else None,\n            optional_args=platform.napalm_args if platform and platform.napalm_args else settings.NAPALM_ARGS,\n        )\n        netdev.get_onboarding_facts()\n        netdev_dict = netdev.get_netdev_dict()\n\n        onboarding_kwargs = {\n            # Kwargs extracted from OnboardingTask:\n            \"netdev_mgmt_ip_address\": data[\"ip_address\"],\n            \"netdev_nb_location_name\": data[\"location\"].name,\n            \"netdev_nb_device_type_name\": data[\"device_type\"],\n            \"netdev_nb_role_name\": data[\"role\"].name if data[\"role\"] else PLUGIN_SETTINGS[\"default_device_role\"],\n            \"netdev_nb_role_color\": PLUGIN_SETTINGS[\"default_device_role_color\"],\n            \"netdev_nb_platform_name\": data[\"platform\"].name if data[\"platform\"] else None,\n            # Kwargs discovered on the Onboarded Device:\n            \"netdev_hostname\": netdev_dict[\"netdev_hostname\"],\n            \"netdev_vendor\": netdev_dict[\"netdev_vendor\"],\n            \"netdev_model\": netdev_dict[\"netdev_model\"],\n            \"netdev_serial_number\": netdev_dict[\"netdev_serial_number\"],\n            \"netdev_mgmt_ifname\": netdev_dict[\"netdev_mgmt_ifname\"],\n            \"netdev_mgmt_pflen\": netdev_dict[\"netdev_mgmt_pflen\"],\n            \"netdev_netmiko_device_type\": netdev_dict[\"netdev_netmiko_device_type\"],\n            \"onboarding_class\": netdev_dict[\"onboarding_class\"],\n            \"driver_addon_result\": netdev_dict[\"driver_addon_result\"],\n        }\n        onboarding_cls = netdev_dict[\"onboarding_class\"]()\n        onboarding_cls.credentials = {\"username\": self.username, \"password\": self.password, \"secret\": self.secret}\n        onboarding_cls.run(onboarding_kwargs=onboarding_kwargs)\n", "code_after": "    def run(self, *args, **data):\n        \"\"\"Process a single Onboarding Task instance.\"\"\"\n        self.logger.info(\"START: onboard device\")\n        self._parse_credentials(data[\"credentials\"])\n        platform = data[\"platform\"]\n        netdev = NetdevKeeper(\n            hostname=data[\"ip_address\"],\n            port=data[\"port\"],\n            timeout=data[\"timeout\"],\n            username=self.username,\n            password=self.password,\n            secret=self.secret,\n            napalm_driver=platform.napalm_driver if platform and platform.napalm_driver else None,\n            optional_args=platform.napalm_args if platform and platform.napalm_args else settings.NAPALM_ARGS,\n        )\n        netdev.get_onboarding_facts()\n        netdev_dict = netdev.get_netdev_dict()\n\n        onboarding_kwargs = {\n            # Kwargs extracted from OnboardingTask:\n            \"netdev_mgmt_ip_address\": data[\"ip_address\"],\n            \"netdev_nb_location_name\": data[\"location\"].name,\n            \"netdev_nb_device_type_name\": data[\"device_type\"],\n            \"netdev_nb_role_name\": data[\"role\"].name if data[\"role\"] else PLUGIN_SETTINGS[\"default_device_role\"],\n            \"netdev_nb_role_color\": PLUGIN_SETTINGS[\"default_device_role_color\"],\n            \"netdev_nb_platform_name\": data[\"platform\"].name if data[\"platform\"] else None,\n            # Kwargs discovered on the Onboarded Device:\n            \"netdev_hostname\": netdev_dict[\"netdev_hostname\"],\n            \"netdev_vendor\": netdev_dict[\"netdev_vendor\"],\n            \"netdev_model\": netdev_dict[\"netdev_model\"],\n            \"netdev_serial_number\": netdev_dict[\"netdev_serial_number\"],\n            \"netdev_mgmt_ifname\": netdev_dict[\"netdev_mgmt_ifname\"],\n            \"netdev_mgmt_pflen\": netdev_dict[\"netdev_mgmt_pflen\"],\n            \"netdev_netmiko_device_type\": netdev_dict[\"netdev_netmiko_device_type\"],\n            \"onboarding_class\": netdev_dict[\"onboarding_class\"],\n            \"driver_addon_result\": netdev_dict[\"driver_addon_result\"],\n        }\n        onboarding_cls = netdev_dict[\"onboarding_class\"]()\n        onboarding_cls.credentials = {\"username\": self.username, \"password\": self.password, \"secret\": self.secret}\n        onboarding_cls.run(onboarding_kwargs=onboarding_kwargs)\n", "commit_message": "resolve issues with credentials", "commit": "https://github.com/nautobot/nautobot-plugin-device-onboarding/commit/b818c57b94f1eeb4e40c9c13d52adcbb1ed33b1b", "description": "nautobot-device-onboarding is an A plugin for Nautobot to easily onboard new devices.\nAffected versions of this package are vulnerable to Information Exposure when the OnboardingTask is created with credentials, these may be exposed in the Job Results view under the Additional Data tab as arguments for the Celery Task execution. An attacker can view these clear text credentials by accessing the Job Results. This is only exploitable if OnboardingTasks are created with credentials specified while on certain versions of the software and does not apply when using NAPALM_USERNAME & NAPALM_PASSWORD from nautobot_config.py file.", "file_change_id": 275077496359210, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-NAUTOBOTDEVICEONBOARDING-6071667", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "_parse_credentials", "code_before": "    def _parse_credentials(self, credentials):\n        \"\"\"Parse and return dictionary of credentials.\"\"\"\n\n        if credentials:\n            self.username = (credentials.secrets.get(secret_type=SecretsGroupSecretTypeChoices.TYPE_USERNAME),)\n            self.password = (credentials.secrets.get(secret_type=SecretsGroupSecretTypeChoices.TYPE_PASSWORD),)\n            self.secret = (None,)\n            secret = credentials.secrets.filter(secret_type=SecretsGroupSecretTypeChoices.TYPE_SECRET)\n            if secret.exists():\n                self.secret = secret.first()\n        else:\n            self.username = (settings.NAPALM_USERNAME,)\n            self.password = (settings.NAPALM_PASSWORD,)\n            self.secret = (settings.NAPALM_ARGS.get(\"secret\", None),)\n", "code_after": "    def _parse_credentials(self, credentials):\n        \"\"\"Parse and return dictionary of credentials.\"\"\"\n        if credentials:\n            self.username = credentials.secrets.get(secret_type=SecretsGroupSecretTypeChoices.TYPE_USERNAME)\n            self.password = credentials.secrets.get(secret_type=SecretsGroupSecretTypeChoices.TYPE_PASSWORD)\n            secret = credentials.secrets.filter(secret_type=SecretsGroupSecretTypeChoices.TYPE_SECRET)\n            if secret.exists():\n                self.secret = secret.first()\n        else:\n            self.username = settings.NAPALM_USERNAME\n            self.password = settings.NAPALM_PASSWORD\n            self.secret = settings.NAPALM_ARGS.get(\"secret\", None)\n"}], "gpt_answer": "The vulnerability described is related to Information Exposure when the OnboardingTask is created with credentials. These credentials may be exposed in the Job Results view under the Additional Data tab as arguments for the Celery Task execution.\n\nLooking at the changes in the \"run\" function, the only change is the removal of the line `credentials = self._parse_credentials(data[\"credentials\"])`. Instead, the credentials are parsed and directly stored in the instance variables `self.username`, `self.password`, and `self.secret` in the `_parse_credentials` function. This change is likely made to prevent the credentials from being exposed as arguments in the Celery Task execution.\n\nGiven this, it can be inferred that the \"run\" function is vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_value", "code_before": "def get_value(section: str, option: str) -> Response:\n    serializer = {\n        \"text/plain\": _config_to_text,\n        \"application/json\": _config_to_json,\n    }\n    return_type = request.accept_mimetypes.best_match(serializer.keys())\n    if conf.get(\"webserver\", \"expose_config\").lower() == \"non-sensitive-only\":\n        expose_config = True\n    else:\n        expose_config = conf.getboolean(\"webserver\", \"expose_config\")\n\n    if return_type not in serializer:\n        return Response(status=HTTPStatus.NOT_ACCEPTABLE)\n    elif expose_config:\n        if not conf.has_option(section, option):\n            raise NotFound(\n                \"Config not found.\", detail=f\"The option [{section}/{option}] is not found in config.\"\n            )\n\n        if (section, option) in conf.sensitive_config_values:\n            value = \"< hidden >\"\n        else:\n            value = conf.get(section, option)\n\n        config = Config(\n            sections=[ConfigSection(name=section, options=[ConfigOption(key=option, value=value)])]\n        )\n        config_text = serializer[return_type](config)\n        return Response(config_text, headers={\"Content-Type\": return_type})\n    else:\n        raise PermissionDenied(\n            detail=(\n                \"Your Airflow administrator chose not to expose the configuration, most likely for security\"\n                \" reasons.\"\n            )\n        )\n", "code_after": "def get_value(section: str, option: str) -> Response:\n    serializer = {\n        \"text/plain\": _config_to_text,\n        \"application/json\": _config_to_json,\n    }\n    return_type = request.accept_mimetypes.best_match(serializer.keys())\n    if conf.get(\"webserver\", \"expose_config\").lower() == \"non-sensitive-only\":\n        expose_config = True\n    else:\n        expose_config = conf.getboolean(\"webserver\", \"expose_config\")\n\n    if return_type not in serializer:\n        return Response(status=HTTPStatus.NOT_ACCEPTABLE)\n    elif expose_config:\n        if not conf.has_option(section, option):\n            raise NotFound(\n                \"Config not found.\", detail=f\"The option [{section}/{option}] is not found in config.\"\n            )\n\n        if (section.lower(), option.lower()) in conf.sensitive_config_values:\n            value = \"< hidden >\"\n        else:\n            value = conf.get(section, option)\n\n        config = Config(\n            sections=[ConfigSection(name=section, options=[ConfigOption(key=option, value=value)])]\n        )\n        config_text = serializer[return_type](config)\n        return Response(config_text, headers={\"Content-Type\": return_type})\n    else:\n        raise PermissionDenied(\n            detail=(\n                \"Your Airflow administrator chose not to expose the configuration, most likely for security\"\n                \" reasons.\"\n            )\n        )\n", "commit_message": "Check if the lower of provided values are sensitives in config endpoint (#34712)\n\n* Check if the lower of provided values are sensitives in config endpoint\r\n\r\n* update unit test\r\n\r\n* ensure that all values in sensitive dict are in lower characters", "commit": "https://github.com/apache/airflow/commit/f044589b685855a8fce8f5376bea2564c5a001f7", "description": "apache-airflow is a platform to programmatically author, schedule, and monitor workflows.\nAffected versions of this package are vulnerable to Information Exposure allowing an authenticated user to retrieve sensitive configuration information when the expose_config option is set to non-sensitive-only.\nNote: The expose_config option is False by default.", "file_change_id": 109176150864472, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-APACHEAIRFLOW-5971013", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `get_value` is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability allows an authenticated user to retrieve sensitive configuration information when the `expose_config` option is set to `non-sensitive-only`.\n\nThe change in the function is specifically related to how it checks if a configuration value is sensitive. In the `code_before`, it checks if the tuple `(section, option)` is in `conf.sensitive_config_values`. In the `code_after`, it changes this check to `(section.lower(), option.lower())`, meaning it now performs a case-insensitive check.\n\nThis change directly addresses the vulnerability by ensuring that case differences in section and option names do not allow sensitive information to be exposed. Therefore, the function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "sensitive_config_values", "code_before": "    def sensitive_config_values(self) -> Set[tuple[str, str]]:  # noqa: UP006\n        if self.configuration_description is None:\n            return (\n                _get_empty_set_for_configuration()\n            )  # we can't use set() here because set is defined below # \u00af\\_(\u30c4)_/\u00af\n        flattened = {\n            (s, k): item\n            for s, s_c in self.configuration_description.items()\n            for k, item in s_c.get(\"options\").items()  # type: ignore[union-attr]\n        }\n        sensitive = {(section, key) for (section, key), v in flattened.items() if v.get(\"sensitive\") is True}\n        depr_option = {self.deprecated_options[x][:-1] for x in sensitive if x in self.deprecated_options}\n        depr_section = {\n            (self.deprecated_sections[s][0], k) for s, k in sensitive if s in self.deprecated_sections\n        }\n        sensitive.update(depr_section, depr_option)\n        return sensitive\n", "code_after": "    def sensitive_config_values(self) -> Set[tuple[str, str]]:  # noqa: UP006\n        if self.configuration_description is None:\n            return (\n                _get_empty_set_for_configuration()\n            )  # we can't use set() here because set is defined below # \u00af\\_(\u30c4)_/\u00af\n        flattened = {\n            (s, k): item\n            for s, s_c in self.configuration_description.items()\n            for k, item in s_c.get(\"options\").items()  # type: ignore[union-attr]\n        }\n        sensitive = {\n            (section.lower(), key.lower())\n            for (section, key), v in flattened.items()\n            if v.get(\"sensitive\") is True\n        }\n        depr_option = {self.deprecated_options[x][:-1] for x in sensitive if x in self.deprecated_options}\n        depr_section = {\n            (self.deprecated_sections[s][0], k) for s, k in sensitive if s in self.deprecated_sections\n        }\n        sensitive.update(depr_section, depr_option)\n        return sensitive\n", "commit_message": "Check if the lower of provided values are sensitives in config endpoint (#34712)\n\n* Check if the lower of provided values are sensitives in config endpoint\r\n\r\n* update unit test\r\n\r\n* ensure that all values in sensitive dict are in lower characters", "commit": "https://github.com/apache/airflow/commit/f044589b685855a8fce8f5376bea2564c5a001f7", "description": "apache-airflow is a platform to programmatically author, schedule, and monitor workflows.\nAffected versions of this package are vulnerable to Information Exposure allowing an authenticated user to retrieve sensitive configuration information when the expose_config option is set to non-sensitive-only.\nNote: The expose_config option is False by default.", "file_change_id": 230473967238111, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-APACHEAIRFLOW-5971013", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The function \"sensitive_config_values\" is being modified in the commit. The change is to convert the section and key to lowercase before checking if they are sensitive. This is in line with the commit message which states \"Check if the lower of provided values are sensitives in config endpoint\".\n\nThe vulnerability description mentions that an authenticated user can retrieve sensitive configuration information when the expose_config option is set to non-sensitive-only. The change in the function seems to be directly addressing this issue by ensuring that the check for sensitive values is case-insensitive, thus making it more robust.\n\nTherefore, it can be concluded that the function was vulnerable and has been changed to address the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_task_instances_batch", "code_before": "def get_task_instances_batch(session: Session = NEW_SESSION) -> APIResponse:\n    \"\"\"Get list of task instances.\"\"\"\n    body = get_json_request_dict()\n    try:\n        data = task_instance_batch_form.load(body)\n    except ValidationError as err:\n        raise BadRequest(detail=str(err.messages))\n    states = _convert_ti_states(data[\"state\"])\n    base_query = select(TI).join(TI.dag_run)\n\n    base_query = _apply_array_filter(base_query, key=TI.dag_id, values=data[\"dag_ids\"])\n    base_query = _apply_array_filter(base_query, key=TI.run_id, values=data[\"dag_run_ids\"])\n    base_query = _apply_array_filter(base_query, key=TI.task_id, values=data[\"task_ids\"])\n    base_query = _apply_range_filter(\n        base_query,\n        key=DR.execution_date,\n        value_range=(data[\"execution_date_gte\"], data[\"execution_date_lte\"]),\n    )\n    base_query = _apply_range_filter(\n        base_query,\n        key=TI.start_date,\n        value_range=(data[\"start_date_gte\"], data[\"start_date_lte\"]),\n    )\n    base_query = _apply_range_filter(\n        base_query, key=TI.end_date, value_range=(data[\"end_date_gte\"], data[\"end_date_lte\"])\n    )\n    base_query = _apply_range_filter(\n        base_query, key=TI.duration, value_range=(data[\"duration_gte\"], data[\"duration_lte\"])\n    )\n    base_query = _apply_array_filter(base_query, key=TI.state, values=states)\n    base_query = _apply_array_filter(base_query, key=TI.pool, values=data[\"pool\"])\n    base_query = _apply_array_filter(base_query, key=TI.queue, values=data[\"queue\"])\n\n    # Count elements before joining extra columns\n    total_entries = get_query_count(base_query, session=session)\n    # Add join\n    base_query = base_query.join(\n        SlaMiss,\n        and_(\n            SlaMiss.dag_id == TI.dag_id,\n            SlaMiss.task_id == TI.task_id,\n            SlaMiss.execution_date == DR.execution_date,\n        ),\n        isouter=True,\n    ).add_columns(SlaMiss)\n    ti_query = base_query.options(joinedload(TI.rendered_task_instance_fields))\n    # using execute because we want the SlaMiss entity. Scalars don't return None for missing entities\n    task_instances = session.execute(ti_query).all()\n\n    return task_instance_collection_schema.dump(\n        TaskInstanceCollection(task_instances=task_instances, total_entries=total_entries)\n    )\n", "code_after": "def get_task_instances_batch(session: Session = NEW_SESSION) -> APIResponse:\n    \"\"\"Get list of task instances.\"\"\"\n    body = get_json_request_dict()\n    try:\n        data = task_instance_batch_form.load(body)\n    except ValidationError as err:\n        raise BadRequest(detail=str(err.messages))\n    dag_ids = data[\"dag_ids\"]\n    if dag_ids:\n        cannot_access_dag_ids = set()\n        for id in dag_ids:\n            if not get_airflow_app().appbuilder.sm.can_read_dag(id, g.user):\n                cannot_access_dag_ids.add(id)\n        if cannot_access_dag_ids:\n            raise PermissionDenied(\n                detail=f\"User not allowed to access these DAGs: {list(cannot_access_dag_ids)}\"\n            )\n    else:\n        dag_ids = get_airflow_app().appbuilder.sm.get_accessible_dag_ids(g.user)\n\n    states = _convert_ti_states(data[\"state\"])\n    base_query = select(TI).join(TI.dag_run)\n\n    base_query = _apply_array_filter(base_query, key=TI.dag_id, values=dag_ids)\n    base_query = _apply_array_filter(base_query, key=TI.run_id, values=data[\"dag_run_ids\"])\n    base_query = _apply_array_filter(base_query, key=TI.task_id, values=data[\"task_ids\"])\n    base_query = _apply_range_filter(\n        base_query,\n        key=DR.execution_date,\n        value_range=(data[\"execution_date_gte\"], data[\"execution_date_lte\"]),\n    )\n    base_query = _apply_range_filter(\n        base_query,\n        key=TI.start_date,\n        value_range=(data[\"start_date_gte\"], data[\"start_date_lte\"]),\n    )\n    base_query = _apply_range_filter(\n        base_query, key=TI.end_date, value_range=(data[\"end_date_gte\"], data[\"end_date_lte\"])\n    )\n    base_query = _apply_range_filter(\n        base_query, key=TI.duration, value_range=(data[\"duration_gte\"], data[\"duration_lte\"])\n    )\n    base_query = _apply_array_filter(base_query, key=TI.state, values=states)\n    base_query = _apply_array_filter(base_query, key=TI.pool, values=data[\"pool\"])\n    base_query = _apply_array_filter(base_query, key=TI.queue, values=data[\"queue\"])\n\n    # Count elements before joining extra columns\n    total_entries = get_query_count(base_query, session=session)\n    # Add join\n    base_query = base_query.join(\n        SlaMiss,\n        and_(\n            SlaMiss.dag_id == TI.dag_id,\n            SlaMiss.task_id == TI.task_id,\n            SlaMiss.execution_date == DR.execution_date,\n        ),\n        isouter=True,\n    ).add_columns(SlaMiss)\n    ti_query = base_query.options(joinedload(TI.rendered_task_instance_fields))\n    # using execute because we want the SlaMiss entity. Scalars don't return None for missing entities\n    task_instances = session.execute(ti_query).all()\n\n    return task_instance_collection_schema.dump(\n        TaskInstanceCollection(task_instances=task_instances, total_entries=total_entries)\n    )\n", "commit_message": "REST API: Fix task instance access issue in the batch endpoint (#34315)\n\nCurrently, there's no restriction on the task instances a user can access in\nthe REST API batch fetch task instances endpoint.\nThis PR fixes it\n\n(cherry picked from commit 3df1af4c45705d67598753a96debf5619bbfee04)", "commit": "https://github.com/apache/airflow/commit/b328c8601a8b16bd442b55b2ce9f242dc7a6b515", "description": "apache-airflow is a platform to programmatically author, schedule, and monitor workflows.\nAffected versions of this package are vulnerable to Information Exposure due to the improper access control mechanism, an authorized user with read access to specific Directed Acyclic Graphs (DAGs) can access information about task instances in other DAGs.\nNote: This is only exploitable if the user has been granted read access to specific DAGs.", "file_change_id": 135436824694631, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-APACHEAIRFLOW-5969353", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"get_task_instances_batch\" was changed to address a vulnerability. The vulnerability allowed an authorized user with read access to specific Directed Acyclic Graphs (DAGs) to access information about task instances in other DAGs.\n\nIn the updated function, a new block of code has been added to check if the user has access to the DAGs specified in the request. If the user does not have access to any of the DAGs, a PermissionDenied exception is raised. If no DAGs are specified in the request, the function retrieves the DAGs that the user has access to.\n\nThis change directly addresses the described vulnerability by adding a check to ensure that the user can only access information about task instances in DAGs they have access to. Therefore, the function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "_deserialize_value", "code_before": "    def _deserialize_value(result: XCom, orm: bool) -> Any:\n        object_hook = None\n        if orm:\n            object_hook = XComDecoder.orm_object_hook\n\n        if result.value is None:\n            return None\n        if conf.getboolean(\"core\", \"enable_xcom_pickling\"):\n            try:\n                return pickle.loads(result.value)\n            except pickle.UnpicklingError:\n                return json.loads(result.value.decode(\"UTF-8\"), cls=XComDecoder, object_hook=object_hook)\n        else:\n            try:\n                return json.loads(result.value.decode(\"UTF-8\"), cls=XComDecoder, object_hook=object_hook)\n            except (json.JSONDecodeError, UnicodeDecodeError):\n                return pickle.loads(result.value)\n", "code_after": "    def _deserialize_value(result: XCom, orm: bool) -> Any:\n        object_hook = None\n        if orm:\n            object_hook = XComDecoder.orm_object_hook\n\n        if result.value is None:\n            return None\n        if conf.getboolean(\"core\", \"enable_xcom_pickling\"):\n            try:\n                return pickle.loads(result.value)\n            except pickle.UnpicklingError:\n                return json.loads(result.value.decode(\"UTF-8\"), cls=XComDecoder, object_hook=object_hook)\n        else:\n            # Since xcom_pickling is disabled, we should only try to deserialize with JSON\n            return json.loads(result.value.decode(\"UTF-8\"), cls=XComDecoder, object_hook=object_hook)\n", "commit_message": "Stop deserializing pickle when enable_xcom_pickling is False (#36255)\n\n* Stop deserializing pickle when enable_xcom_pickling is False\r\n\r\n* Fix unit tests", "commit": "https://github.com/apache/airflow/commit/63e97abec5d56bc62a293c93f5227f364561e51c", "description": "apache-airflow is a platform to programmatically author, schedule, and monitor workflows.\nAffected versions of this package are vulnerable to Deserialization of Untrusted Data due to improper validation of input during the deserialization process of XCom data. An attacker can execute arbitrary code by submitting crafted input that bypasses the protection of the enable_xcom_pickling=False configuration setting, leading to poisoned data after deserialization.", "file_change_id": 212136673404301, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-APACHEAIRFLOW-6187250", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"_deserialize_value\" is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability description mentions that the issue is related to the deserialization of untrusted data due to improper validation of input during the deserialization process of XCom data. \n\nLooking at the changes in the function, it can be seen that the code has been modified to stop deserializing with pickle when the configuration setting \"enable_xcom_pickling\" is set to False. This change directly addresses the vulnerability described, which allows an attacker to execute arbitrary code by submitting crafted input that bypasses the protection of the \"enable_xcom_pickling=False\" configuration setting.\n\nTherefore, the function \"_deserialize_value\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "_list_globals", "code_before": "def _list_globals(data: IO[bytes], multiple_pickles=True) -> Set[Tuple[str, str]]:\n\n    globals = set()\n\n    memo = {}\n    # Scan the data for pickle buffers, stopping when parsing fails or stops making progress\n    last_byte = b\"dummy\"\n    while last_byte != b\"\":\n        # List opcodes\n        try:\n            ops = list(pickletools.genops(data))\n        except Exception as e:\n            raise GenOpsError(str(e))\n        last_byte = data.read(1)\n        data.seek(-1, 1)\n\n        # Extract global imports\n        for n in range(len(ops)):\n            op = ops[n]\n            op_name = op[0].name\n            op_value = op[1]\n\n            if op_name in [\"MEMOIZE\", \"PUT\", \"BINPUT\", \"LONG_BINPUT\"] and n > 0:\n                memo[len(memo)] = ops[n - 1][1]\n\n            if op_name in (\"GLOBAL\", \"INST\"):\n                globals.add(tuple(op_value.split(\" \", 1)))\n            elif op_name == \"STACK_GLOBAL\":\n                values = []\n                for offset in range(1, n):\n                    if ops[n - offset][0].name in [\n                        \"MEMOIZE\",\n                        \"PUT\",\n                        \"BINPUT\",\n                        \"LONG_BINPUT\",\n                    ]:\n                        continue\n                    if ops[n - offset][0].name in [\"GET\", \"BINGET\", \"LONG_BINGET\"]:\n                        values.append(memo[int(ops[n - offset][1])])\n                    elif ops[n - offset][0].name not in [\n                        \"SHORT_BINUNICODE\",\n                        \"UNICODE\",\n                        \"BINUNICODE\",\n                        \"BINUNICODE8\",\n                    ]:\n                        _log.debug(\n                            \"Presence of non-string opcode, categorizing as an unknown dangerous import\"\n                        )\n                        values.append(\"unknown\")\n                    else:\n                        values.append(ops[n - offset][1])\n                    if len(values) == 2:\n                        break\n                if len(values) != 2:\n                    raise ValueError(\n                        f\"Found {len(values)} values for STACK_GLOBAL at position {n} instead of 2.\"\n                    )\n                globals.add((values[1], values[0]))\n\n        if not multiple_pickles:\n            break\n\n    return globals\n", "code_after": "def _list_globals(data: IO[bytes], multiple_pickles=True) -> Set[Tuple[str, str]]:\n\n    globals = set()\n\n    memo = {}\n    # Scan the data for pickle buffers, stopping when parsing fails or stops making progress\n    last_byte = b\"dummy\"\n    while last_byte != b\"\":\n        # List opcodes\n        try:\n            ops = list(pickletools.genops(data))\n        except Exception as e:\n            raise GenOpsError(str(e))\n        last_byte = data.read(1)\n        data.seek(-1, 1)\n\n        # Extract global imports\n        for n in range(len(ops)):\n            op = ops[n]\n            op_name = op[0].name\n            op_value = op[1]\n\n            if op_name in [\"MEMOIZE\", \"PUT\", \"BINPUT\", \"LONG_BINPUT\"] and n > 0:\n                memo[op_value] = ops[n - 1][1]\n\n            if op_name in (\"GLOBAL\", \"INST\"):\n                globals.add(tuple(op_value.split(\" \", 1)))\n            elif op_name == \"STACK_GLOBAL\":\n                values = []\n                for offset in range(1, n):\n                    if ops[n - offset][0].name in [\n                        \"MEMOIZE\",\n                        \"PUT\",\n                        \"BINPUT\",\n                        \"LONG_BINPUT\",\n                    ]:\n                        continue\n                    if ops[n - offset][0].name in [\"GET\", \"BINGET\", \"LONG_BINGET\"]:\n                        values.append(memo[int(ops[n - offset][1])])\n                    elif ops[n - offset][0].name not in [\n                        \"SHORT_BINUNICODE\",\n                        \"UNICODE\",\n                        \"BINUNICODE\",\n                        \"BINUNICODE8\",\n                    ]:\n                        _log.debug(\n                            \"Presence of non-string opcode, categorizing as an unknown dangerous import\"\n                        )\n                        values.append(\"unknown\")\n                    else:\n                        values.append(ops[n - offset][1])\n                    if len(values) == 2:\n                        break\n                if len(values) != 2:\n                    raise ValueError(\n                        f\"Found {len(values)} values for STACK_GLOBAL at position {n} instead of 2.\"\n                    )\n                globals.add((values[1], values[0]))\n\n        if not multiple_pickles:\n            break\n\n    return globals\n", "commit_message": "Patched zero-day memo exploit and bumped version (#23)", "commit": "https://github.com/mmaitre314/picklescan/commit/ad6efbfbe32517f422dc84a004db6b3fa6cb2b04", "description": "picklescan is a Security scanner detecting Python Pickle files performing suspicious actions\nAffected versions of this package are vulnerable to Deserialization of Untrusted Data due to improper argument verification when handling a memo, making it possible to have a different memo and use STACK_GLOBAL to bypass allow-list checking. Exploiting this vulnerability could lead to remote code execution.", "file_change_id": 56584406929224, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-PICKLESCAN-6146056", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"_list_globals\" is part of a security scanner for detecting Python Pickle files performing suspicious actions. The vulnerability described is related to Deserialization of Untrusted Data due to improper argument verification when handling a memo, which could potentially lead to remote code execution.\n\nLooking at the changes in the function, the only difference is in the line where memo values are stored. In the \"code_before\" version, the memo is indexed by the length of the memo itself, while in the \"code_after\" version, the memo is indexed by the op_value. This change seems to be directly related to the vulnerability described, as it changes how the memo is handled, which is the core of the vulnerability.\n\nTherefore, it can be concluded that the function \"_list_globals\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "load", "code_before": "    def load(raw_bytes):\n        \"\"\"\n        given a bytes object, should return a base python data\n        structure that represents the object.\n        \"\"\"\n        try:\n            return yaml.load(raw_bytes, Loader=yaml.Loader)\n        except yaml.scanner.ScannerError as e:\n            raise SerializationException(str(e))\n", "code_after": "    def load(raw_bytes):\n        \"\"\"\n        given a bytes object, should return a base python data\n        structure that represents the object.\n        \"\"\"\n        try:\n            return yaml.load(raw_bytes, Loader=yaml.SafeLoader)\n        except yaml.scanner.ScannerError as e:\n            raise SerializationException(str(e))\n", "commit_message": "fix(yaml_serializer): use yaml.SafeLoader (#58)\n\nyaml.Loader allows for remote execution of arbitrary Python code\r\nduring deserialization, which is a security risk.\r\n\r\nUsing SafeLoader prevents that.\r\n\r\nAlso updating unit tests for new changes since last release\r\n(new major version with test client changes for aiohttp)\r\n\r\nRemoving python2.7 since setup-python github actions no longer\r\nsupports it.\r\n\r\nUpdating black formatting.", "commit": "https://github.com/toumorokoshi/transmute-core/commit/b368618da1909c4e9e58c53a71319effb2a2cc0d", "description": "transmute-core is an a utility library to help provide api route generation form function signature for web frameworks.\nAffected versions of this package are vulnerable to Deserialization of Untrusted Data via the yaml.Loader function. An attacker can execute arbitrary Python code by exploiting unsafe YAML deserialization.", "file_change_id": 39599549376259, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-TRANSMUTECORE-6043133", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"load\" was indeed vulnerable. The vulnerability was due to the use of the \"yaml.Loader\" function, which allows for the execution of arbitrary Python code during deserialization, posing a security risk. \n\nThe change in the function is from using \"yaml.Loader\" to \"yaml.SafeLoader\". The \"SafeLoader\" function only allows for the loading of a safe subset of YAML, preventing the execution of arbitrary Python code during deserialization.\n\nThe commit message also confirms this, stating that \"yaml.Loader allows for remote execution of arbitrary Python code during deserialization, which is a security risk. Using SafeLoader prevents that.\"\n\nTherefore, the function \"load\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "decode", "code_before": "    def decode(\n        self,\n        types: Iterable[TypeStr],\n        data: Decodable,\n    ) -> Tuple[Any, ...]:\n        \"\"\"\n        Decodes the binary value ``data`` as a sequence of values of the ABI types\n        in ``types`` via the head-tail mechanism into a tuple of equivalent python\n        values.\n\n        :param types: A list or tuple of string representations of the ABI types that\n            will be used for decoding e.g. ``('uint256', 'bytes[]', '(int,int)')``\n        :param data: The binary value to be decoded.\n\n        :returns: A tuple of equivalent python values for the ABI values\n            represented in ``data``.\n        \"\"\"\n        validate_list_like_param(types, \"types\")\n        validate_bytes_param(data, \"data\")\n\n        decoders = [self._registry.get_decoder(type_str) for type_str in types]\n\n        decoder = TupleDecoder(decoders=decoders)\n        stream = self.stream_class(data)\n\n        return decoder(stream)\n", "code_after": "    def decode(\n        self,\n        types: Iterable[TypeStr],\n        data: Decodable,\n    ) -> Tuple[Any, ...]:\n        \"\"\"\n        Decodes the binary value ``data`` as a sequence of values of the ABI types\n        in ``types`` via the head-tail mechanism into a tuple of equivalent python\n        values.\n\n        :param types: A list or tuple of string representations of the ABI types that\n            will be used for decoding e.g. ``('uint256', 'bytes[]', '(int,int)')``\n        :param data: The binary value to be decoded.\n\n        :returns: A tuple of equivalent python values for the ABI values\n            represented in ``data``.\n        \"\"\"\n        # validate decode types\n        validate_codec_types(types)\n\n        # validate decode data\n        validate_bytes_param(data, \"data\")\n\n        decoders = [self._registry.get_decoder(type_str) for type_str in types]\n\n        decoder = TupleDecoder(decoders=decoders)\n        stream = self.stream_class(data)\n\n        return decoder(stream)\n", "commit_message": "bugfix: validate against zero-sized tuple types.\n\n- Zero-sized tuple types are not supported by Solidity. We should reflect that in this library.\n- Add tests for this and properly set up reversibility tests to test for minimum_size=1 for tuple encoding / decoding tests.", "commit": "https://github.com/ethereum/eth-abi/commit/7db682955568b01faf0858ac14bc73c624e5dd10", "description": "eth-abi is an eth_abi: Python utilities for working with Ethereum ABI definitions, especially encoding and decoding\nAffected versions of this package are vulnerable to Denial of Service (DoS) when parsing zero-sized-types (ZST). Although allowed by the ABI specification, excessive memory can be allocated when processing malicious ZST tuples.", "file_change_id": 102521879668158, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-ETHABI-6085292", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "encode", "code_before": "    def encode(self, types: Iterable[TypeStr], args: Iterable[Any]) -> bytes:\n        \"\"\"\n        Encodes the python values in ``args`` as a sequence of binary values of\n        the ABI types in ``types`` via the head-tail mechanism.\n\n        :param types: A list or tuple of string representations of the ABI types\n            that will be used for encoding e.g.  ``('uint256', 'bytes[]',\n            '(int,int)')``\n        :param args: A list or tuple of python values to be encoded.\n\n        :returns: The head-tail encoded binary representation of the python\n            values in ``args`` as values of the ABI types in ``types``.\n        \"\"\"\n        validate_list_like_param(types, \"types\")\n        validate_list_like_param(args, \"args\")\n\n        encoders = [self._registry.get_encoder(type_str) for type_str in types]\n\n        encoder = TupleEncoder(encoders=encoders)\n\n        return encoder(args)\n", "code_after": "    def encode(self, types: Iterable[TypeStr], args: Iterable[Any]) -> bytes:\n        \"\"\"\n        Encodes the python values in ``args`` as a sequence of binary values of\n        the ABI types in ``types`` via the head-tail mechanism.\n\n        :param types: A list or tuple of string representations of the ABI types\n            that will be used for encoding e.g.  ``('uint256', 'bytes[]',\n            '(int,int)')``\n        :param args: A list or tuple of python values to be encoded.\n\n        :returns: The head-tail encoded binary representation of the python\n            values in ``args`` as values of the ABI types in ``types``.\n        \"\"\"\n        # validate encode types\n        validate_codec_types(types)\n\n        # validate encode args\n        validate_list_like_param(args, \"args\")\n\n        encoders = [self._registry.get_encoder(type_str) for type_str in types]\n\n        encoder = TupleEncoder(encoders=encoders)\n\n        return encoder(args)\n"}], "gpt_answer": "The provided information indicates that the vulnerability in the `eth-abi` package was related to a Denial of Service (DoS) attack when parsing zero-sized-types (ZST). The vulnerability was due to the fact that excessive memory could be allocated when processing malicious ZST tuples.\n\nThe changes in the `decode` function involve replacing the `validate_list_like_param(types, \"types\")` function with `validate_codec_types(types)`. This change seems to be directly related to the vulnerability, as it appears to add validation to prevent the processing of zero-sized-types (ZST), which were causing the DoS vulnerability.\n\nThe commit message also supports this, mentioning a bugfix to validate against zero-sized tuple types, which are not supported by Solidity.\n\nTherefore, it can be concluded that the `decode` function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "encode", "code_before": "    def encode(self, types: Iterable[TypeStr], args: Iterable[Any]) -> bytes:\n        \"\"\"\n        Encodes the python values in ``args`` as a sequence of binary values of\n        the ABI types in ``types`` via the head-tail mechanism.\n\n        :param types: A list or tuple of string representations of the ABI types\n            that will be used for encoding e.g.  ``('uint256', 'bytes[]',\n            '(int,int)')``\n        :param args: A list or tuple of python values to be encoded.\n\n        :returns: The head-tail encoded binary representation of the python\n            values in ``args`` as values of the ABI types in ``types``.\n        \"\"\"\n        validate_list_like_param(types, \"types\")\n        validate_list_like_param(args, \"args\")\n\n        encoders = [self._registry.get_encoder(type_str) for type_str in types]\n\n        encoder = TupleEncoder(encoders=encoders)\n\n        return encoder(args)\n", "code_after": "    def encode(self, types: Iterable[TypeStr], args: Iterable[Any]) -> bytes:\n        \"\"\"\n        Encodes the python values in ``args`` as a sequence of binary values of\n        the ABI types in ``types`` via the head-tail mechanism.\n\n        :param types: A list or tuple of string representations of the ABI types\n            that will be used for encoding e.g.  ``('uint256', 'bytes[]',\n            '(int,int)')``\n        :param args: A list or tuple of python values to be encoded.\n\n        :returns: The head-tail encoded binary representation of the python\n            values in ``args`` as values of the ABI types in ``types``.\n        \"\"\"\n        # validate encode types\n        validate_codec_types(types)\n\n        # validate encode args\n        validate_list_like_param(args, \"args\")\n\n        encoders = [self._registry.get_encoder(type_str) for type_str in types]\n\n        encoder = TupleEncoder(encoders=encoders)\n\n        return encoder(args)\n", "commit_message": "bugfix: validate against zero-sized tuple types.\n\n- Zero-sized tuple types are not supported by Solidity. We should reflect that in this library.\n- Add tests for this and properly set up reversibility tests to test for minimum_size=1 for tuple encoding / decoding tests.", "commit": "https://github.com/ethereum/eth-abi/commit/7db682955568b01faf0858ac14bc73c624e5dd10", "description": "eth-abi is an eth_abi: Python utilities for working with Ethereum ABI definitions, especially encoding and decoding\nAffected versions of this package are vulnerable to Denial of Service (DoS) when parsing zero-sized-types (ZST). Although allowed by the ABI specification, excessive memory can be allocated when processing malicious ZST tuples.", "file_change_id": 102521879668158, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-ETHABI-6085292", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "decode", "code_before": "    def decode(\n        self,\n        types: Iterable[TypeStr],\n        data: Decodable,\n    ) -> Tuple[Any, ...]:\n        \"\"\"\n        Decodes the binary value ``data`` as a sequence of values of the ABI types\n        in ``types`` via the head-tail mechanism into a tuple of equivalent python\n        values.\n\n        :param types: A list or tuple of string representations of the ABI types that\n            will be used for decoding e.g. ``('uint256', 'bytes[]', '(int,int)')``\n        :param data: The binary value to be decoded.\n\n        :returns: A tuple of equivalent python values for the ABI values\n            represented in ``data``.\n        \"\"\"\n        validate_list_like_param(types, \"types\")\n        validate_bytes_param(data, \"data\")\n\n        decoders = [self._registry.get_decoder(type_str) for type_str in types]\n\n        decoder = TupleDecoder(decoders=decoders)\n        stream = self.stream_class(data)\n\n        return decoder(stream)\n", "code_after": "    def decode(\n        self,\n        types: Iterable[TypeStr],\n        data: Decodable,\n    ) -> Tuple[Any, ...]:\n        \"\"\"\n        Decodes the binary value ``data`` as a sequence of values of the ABI types\n        in ``types`` via the head-tail mechanism into a tuple of equivalent python\n        values.\n\n        :param types: A list or tuple of string representations of the ABI types that\n            will be used for decoding e.g. ``('uint256', 'bytes[]', '(int,int)')``\n        :param data: The binary value to be decoded.\n\n        :returns: A tuple of equivalent python values for the ABI values\n            represented in ``data``.\n        \"\"\"\n        # validate decode types\n        validate_codec_types(types)\n\n        # validate decode data\n        validate_bytes_param(data, \"data\")\n\n        decoders = [self._registry.get_decoder(type_str) for type_str in types]\n\n        decoder = TupleDecoder(decoders=decoders)\n        stream = self.stream_class(data)\n\n        return decoder(stream)\n"}], "gpt_answer": "The provided information indicates that the vulnerability in the `eth-abi` package was related to a Denial of Service (DoS) attack when parsing zero-sized-types (ZST). The vulnerability was due to the fact that excessive memory could be allocated when processing malicious ZST tuples.\n\nLooking at the changes in the `encode` function, it can be seen that a new validation function `validate_codec_types(types)` has been added. This function is likely responsible for checking the types to ensure they are not zero-sized-types, thus preventing the DoS attack.\n\nGiven this, it can be inferred that the `encode` function was indeed vulnerable and has been changed to fix the vulnerability. Therefore, the answer is 1.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "validate_value", "code_before": "    def validate_value(self, value):\n        if not is_list_like(value):\n            self.invalidate_value(\n                value,\n                msg=\"must be list-like object such as array or tuple\",\n            )\n\n        if len(value) != len(self.encoders):\n            self.invalidate_value(\n                value,\n                exc=ValueOutOfBounds,\n                msg=\"value has {} items when {} were expected\".format(\n                    len(value),\n                    len(self.encoders),\n                ),\n            )\n\n        for item, encoder in zip(value, self.encoders):\n            try:\n                encoder.validate_value(item)\n            except AttributeError:\n                encoder(item)\n", "code_after": "    def validate_value(self, value):\n        if not is_list_like(value):\n            self.invalidate_value(\n                value,\n                msg=\"must be list-like object such as array or tuple\",\n            )\n\n        if len(value) == 0:\n            self.invalidate_value(\n                value,\n                msg='Zero-sized tuple types \"()\" are not supported.',\n            )\n\n        if len(value) != len(self.encoders):\n            self.invalidate_value(\n                value,\n                exc=ValueOutOfBounds,\n                msg=\"value has {} items when {} were expected\".format(\n                    len(value),\n                    len(self.encoders),\n                ),\n            )\n\n        for item, encoder in zip(value, self.encoders):\n            try:\n                encoder.validate_value(item)\n            except AttributeError:\n                encoder(item)\n", "commit_message": "bugfix: validate against zero-sized tuple types.\n\n- Zero-sized tuple types are not supported by Solidity. We should reflect that in this library.\n- Add tests for this and properly set up reversibility tests to test for minimum_size=1 for tuple encoding / decoding tests.", "commit": "https://github.com/ethereum/eth-abi/commit/7db682955568b01faf0858ac14bc73c624e5dd10", "description": "eth-abi is an eth_abi: Python utilities for working with Ethereum ABI definitions, especially encoding and decoding\nAffected versions of this package are vulnerable to Denial of Service (DoS) when parsing zero-sized-types (ZST). Although allowed by the ABI specification, excessive memory can be allocated when processing malicious ZST tuples.", "file_change_id": 187994740794637, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-ETHABI-6085292", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `validate_value` has been modified to include a check for zero-sized tuples. The vulnerability description mentions that the package was vulnerable to Denial of Service (DoS) when parsing zero-sized-types (ZST). The commit message also confirms that the change was made to validate against zero-sized tuple types, which are not supported by Solidity.\n\nThe added code checks if the length of the value is zero and if so, invalidates the value with a message stating that zero-sized tuple types are not supported. This change directly addresses the described vulnerability, which is a DoS attack through the parsing of zero-sized-types (ZST).\n\nTherefore, the function `validate_value` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "to_python", "code_before": "    def to_python(self, value):\n        return unicodedata.normalize(\"NFKC\", super().to_python(value))\n", "code_after": "    def to_python(self, value):\n        value = super().to_python(value)\n        if self.max_length is not None and len(value) > self.max_length:\n            # Normalization can increase the string length (e.g.\n            # \"\ufb00\" -> \"ff\", \"\u00bd\" -> \"1\u20442\") but cannot reduce it, so there is no\n            # point in normalizing invalid data. Moreover, Unicode\n            # normalization is very slow on Windows and can be a DoS attack\n            # vector.\n            return value\n        return unicodedata.normalize(\"NFKC\", value)\n", "commit_message": "Fixed CVE-2023-46695 -- Fixed potential DoS in UsernameField on Windows.\n\nThanks MProgrammer (https://hackerone.com/mprogrammer) for the report.", "commit": "https://github.com/django/django/commit/05ba4130ee878c4f520b5d34bb11eaad794623be", "description": "Affected versions of this package are vulnerable to Denial of Service (DoS) via the NFKC normalization function in django.contrib.auth.forms.UsernameField. A potential attack can be executed via certain inputs with a very large number of Unicode characters.\nNote: This vulnerability is only exploitable on Windows systems.", "file_change_id": 144416447422779, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-DJANGO-6041515", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"to_python\" was changed to address a potential Denial of Service (DoS) vulnerability. The vulnerability was due to the NFKC normalization function in django.contrib.auth.forms.UsernameField, which could be exploited with certain inputs containing a very large number of Unicode characters.\n\nIn the \"code_after\" section, a new condition has been added to check if the length of the value is greater than the maximum length. If it is, the function returns the value without normalizing it. This change is directly related to the described vulnerability, as it prevents the normalization of excessively long strings, which could lead to a DoS attack.\n\nTherefore, the function \"to_python\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "handle_message", "code_before": "    def handle_message(self, stream, payload):\n        payload = self.decode_payload(payload)\n        # XXX: Is header really needed?\n        reply = yield self.message_handler(payload)\n        self.stream.send(self.encode_payload(reply))\n", "code_after": "    def handle_message(self, stream, payload):\n        try:\n            payload = self.decode_payload(payload)\n        except salt.exceptions.SaltDeserializationError:\n            self.stream.send(self.encode_payload({\"msg\": \"bad load\"}))\n            return\n        # XXX: Is header really needed?\n        reply = yield self.message_handler(payload)\n        self.stream.send(self.encode_payload(reply))\n", "commit_message": "Do not fail on bad message pack message", "commit": "https://github.com/saltstack/salt/commit/7e30aae5834f1499f4449c5ee53c309b07ef518b", "description": "salt is a new approach to infrastructure management built on a dynamic communication bus. Salt can be used for data-driven orchestration, remote execution for any infrastructure, configuration management for any app stack, and much more.\nAffected versions of this package are vulnerable to Denial of Service (DoS) in the error message decoding mechanism in minion return. If the request server receives a number of requests equal to the number of worker threads, the master will become unresponsive to return requests until it is restarted.", "file_change_id": 30999572858498, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-SALT-5885034", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `handle_message` has been modified to include error handling for deserialization errors. The change involves wrapping the `payload = self.decode_payload(payload)` line in a try-except block to catch `salt.exceptions.SaltDeserializationError` exceptions. If such an exception is caught, the function sends an error message back and returns, effectively terminating the current execution of the function.\n\nThe vulnerability description mentions a Denial of Service (DoS) vulnerability in the error message decoding mechanism in minion return. If the request server receives a number of requests equal to the number of worker threads, the master will become unresponsive to return requests until it is restarted.\n\nGiven the nature of the vulnerability and the changes made to the `handle_message` function, it seems that the function was indeed vulnerable and has been modified to address the described vulnerability. The added error handling prevents the function from failing when a bad message is received, which aligns with the commit message \"Do not fail on bad message pack message\". This change could prevent the server from becoming unresponsive when a large number of bad requests are received, thus addressing the DoS vulnerability.\n\nTherefore, the answer is 1, indicating that the function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_dag_warnings", "code_before": "def get_dag_warnings(\n    *,\n    limit: int,\n    dag_id: str | None = None,\n    warning_type: str | None = None,\n    offset: int | None = None,\n    order_by: str = \"timestamp\",\n    session: Session = NEW_SESSION,\n) -> APIResponse:\n    \"\"\"Get DAG warnings.\n\n    :param dag_id: the dag_id to optionally filter by\n    :param warning_type: the warning type to optionally filter by\n    \"\"\"\n    allowed_filter_attrs = [\"dag_id\", \"warning_type\", \"message\", \"timestamp\"]\n    query = select(DagWarningModel)\n    if dag_id:\n        query = query.where(DagWarningModel.dag_id == dag_id)\n    if warning_type:\n        query = query.where(DagWarningModel.warning_type == warning_type)\n    total_entries = get_query_count(query, session=session)\n    query = apply_sorting(query=query, order_by=order_by, allowed_attrs=allowed_filter_attrs)\n    dag_warnings = session.scalars(query.offset(offset).limit(limit)).all()\n    return dag_warning_collection_schema.dump(\n        DagWarningCollection(dag_warnings=dag_warnings, total_entries=total_entries)\n    )\n", "code_after": "def get_dag_warnings(\n    *,\n    limit: int,\n    dag_id: str | None = None,\n    warning_type: str | None = None,\n    offset: int | None = None,\n    order_by: str = \"timestamp\",\n    session: Session = NEW_SESSION,\n) -> APIResponse:\n    \"\"\"Get DAG warnings.\n\n    :param dag_id: the dag_id to optionally filter by\n    :param warning_type: the warning type to optionally filter by\n    \"\"\"\n    allowed_filter_attrs = [\"dag_id\", \"warning_type\", \"message\", \"timestamp\"]\n    query = select(DagWarningModel)\n    if dag_id:\n        if not get_airflow_app().appbuilder.sm.can_read_dag(dag_id, g.user):\n            raise PermissionDenied(detail=f\"User not allowed to access this DAG: {dag_id}\")\n        query = query.where(DagWarningModel.dag_id == dag_id)\n    else:\n        readable_dags = get_airflow_app().appbuilder.sm.get_accessible_dag_ids(g.user)\n        query = query.where(DagWarningModel.dag_id.in_(readable_dags))\n    if warning_type:\n        query = query.where(DagWarningModel.warning_type == warning_type)\n    total_entries = get_query_count(query, session=session)\n    query = apply_sorting(query=query, order_by=order_by, allowed_attrs=allowed_filter_attrs)\n    dag_warnings = session.scalars(query.offset(offset).limit(limit)).all()\n    return dag_warning_collection_schema.dump(\n        DagWarningCollection(dag_warnings=dag_warnings, total_entries=total_entries)\n    )\n", "commit_message": "Fix dag warning endpoint permissions (#34355)\n\n* Fix dag warning endpoint permissions\r\n\r\n* update the query to have an accurate result for total entries and pagination\r\n\r\n* add unit tests\r\n\r\n* Update test_dag_warning_endpoint.py\r\n\r\nCo-authored-by: Tzu-ping Chung <uranusjr@gmail.com>\r\n\r\n---------\r\n\r\nCo-authored-by: Tzu-ping Chung <uranusjr@gmail.com>", "commit": "https://github.com/apache/airflow/commit/3570bbfbea69e2965f91b9964ce28bc268c68129", "description": "apache-airflow is a platform to programmatically author, schedule, and monitor workflows.\nAffected versions of this package are vulnerable to Improper Access Control allowing authenticated users to list warnings for all DAGs, even if the user had no permission reveal the dag_ids and the stack-traces of import errors for those DAGs with import errors.", "file_change_id": 201154981533462, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-APACHEAIRFLOW-5971012", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `get_dag_warnings` was changed to address a vulnerability related to Improper Access Control. The vulnerability allowed authenticated users to list warnings for all Directed Acyclic Graphs (DAGs), even if they didn't have the necessary permissions.\n\nIn the updated function, additional checks have been added to verify if the user has the necessary permissions to access the DAGs. If the user doesn't have the necessary permissions, a `PermissionDenied` exception is raised. This change directly addresses the described vulnerability by ensuring that only users with the necessary permissions can access the DAG warnings.\n\nTherefore, the function `get_dag_warnings` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "run", "code_before": "def run(cmd):\n    typer.secho(cmd, fg=typer.colors.GREEN)\n    result = os.system(cmd)\n    if result:\n        sys.exit()\n", "code_after": "def run(cmd):\n    typer.secho(cmd, fg=typer.colors.GREEN)\n    args = shlex.split(cmd)\n    p = subprocess.Popen(args)\n    if p.returncode != 0:\n        sys.exit()\n", "commit_message": "refact: more secure.", "commit": "https://github.com/abilian/abilian-devtools/commit/9d71b0d3b6b467589d58aacc932ca3dc7e524ce2", "description": "abilian-devtools is an A curated set of dependencies for quality software development\nAffected versions of this package are vulnerable to Command Injection due to improper user input sanitization.", "file_change_id": 276413044709347, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-ABILIANDEVTOOLS-6133267", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "main", "code_before": "def main():\n    \"\"\"\n    Abilian Dev Tool command-line runner.\n    \"\"\"\n", "code_after": "def main():\n    \"\"\"Abilian Dev Tool command-line runner.\"\"\"\n"}, {"function_name": "check", "code_before": "def check(args: list[str]):\n    \"\"\"Run checker/linters on specified files or directories.\"\"\"\n    args2 = []\n    for arg in args:\n        if not Path(arg).exists():\n            typer.secho(f\"{arg} does not exist\", fg=typer.colors.RED)\n        else:\n            args2.append(arg)\n\n    args_str = ' '.join(args2)\n\n    run(f\"ruff {args_str}\")\n    run(f\"flake8 {args_str}\")\n    run(\"mypy --show-error-codes {args_str}\")\n    run(\"pyright\")\n    run(\"vulture --min-confidence 80 .\")\n    run(\"deptry .\")\n", "code_after": "def check(args: list[str]):\n    \"\"\"Run checker/linters on specified files or directories.\"\"\"\n    args2 = []\n    for arg in args:\n        if not Path(arg).exists():\n            typer.secho(f\"{arg} does not exist\", fg=typer.colors.RED)\n        else:\n            args2.append(arg)\n\n    args_str = \" \".join(args2)\n\n    run(f\"ruff {args_str}\")\n    run(f\"flake8 {args_str}\")\n    run(f\"mypy --show-error-codes {args_str}\")\n    run(\"pyright\")\n    run(\"vulture --min-confidence 80 .\")\n    run(\"deptry .\")\n"}], "gpt_answer": "The provided information indicates that the vulnerability in the package \"abilian-devtools\" is due to Command Injection, which is a result of improper user input sanitization. \n\nLooking at the changes in the \"run\" function, it's clear that the function has been modified to use the \"subprocess.Popen\" method instead of \"os.system\". The \"os.system\" method is known to be vulnerable to shell injection because it executes the command in a subshell. On the other hand, \"subprocess.Popen\" is a more secure way to run system commands as it directly executes the command, making it harder for an attacker to inject malicious commands.\n\nTherefore, the \"run\" function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "check", "code_before": "def check(args: list[str]):\n    \"\"\"Run checker/linters on specified files or directories.\"\"\"\n    args2 = []\n    for arg in args:\n        if not Path(arg).exists():\n            typer.secho(f\"{arg} does not exist\", fg=typer.colors.RED)\n        else:\n            args2.append(arg)\n\n    args_str = ' '.join(args2)\n\n    run(f\"ruff {args_str}\")\n    run(f\"flake8 {args_str}\")\n    run(\"mypy --show-error-codes {args_str}\")\n    run(\"pyright\")\n    run(\"vulture --min-confidence 80 .\")\n    run(\"deptry .\")\n", "code_after": "def check(args: list[str]):\n    \"\"\"Run checker/linters on specified files or directories.\"\"\"\n    args2 = []\n    for arg in args:\n        if not Path(arg).exists():\n            typer.secho(f\"{arg} does not exist\", fg=typer.colors.RED)\n        else:\n            args2.append(arg)\n\n    args_str = \" \".join(args2)\n\n    run(f\"ruff {args_str}\")\n    run(f\"flake8 {args_str}\")\n    run(f\"mypy --show-error-codes {args_str}\")\n    run(\"pyright\")\n    run(\"vulture --min-confidence 80 .\")\n    run(\"deptry .\")\n", "commit_message": "refact: more secure.", "commit": "https://github.com/abilian/abilian-devtools/commit/9d71b0d3b6b467589d58aacc932ca3dc7e524ce2", "description": "abilian-devtools is an A curated set of dependencies for quality software development\nAffected versions of this package are vulnerable to Command Injection due to improper user input sanitization.", "file_change_id": 276413044709347, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-ABILIANDEVTOOLS-6133267", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "run", "code_before": "def run(cmd):\n    typer.secho(cmd, fg=typer.colors.GREEN)\n    result = os.system(cmd)\n    if result:\n        sys.exit()\n", "code_after": "def run(cmd):\n    typer.secho(cmd, fg=typer.colors.GREEN)\n    args = shlex.split(cmd)\n    p = subprocess.Popen(args)\n    if p.returncode != 0:\n        sys.exit()\n"}, {"function_name": "main", "code_before": "def main():\n    \"\"\"\n    Abilian Dev Tool command-line runner.\n    \"\"\"\n", "code_after": "def main():\n    \"\"\"Abilian Dev Tool command-line runner.\"\"\"\n"}], "gpt_answer": "The vulnerability described is a Command Injection due to improper user input sanitization. The function `check` itself does not sanitize user input, but it does pass user input to the `run` function, which is also changed in the commit.\n\nIn the `run` function, the `os.system(cmd)` call, which is vulnerable to command injection, is replaced with `subprocess.Popen(args)`, where `args` is a list of arguments obtained by splitting the command string `cmd` using `shlex.split(cmd)`. This change mitigates the command injection vulnerability by ensuring that the command and its arguments are properly separated and not interpreted as a single string, which could potentially include malicious commands.\n\nTherefore, the `check` function is indirectly vulnerable because it uses the `run` function, which was vulnerable before the fix. The changes in the `check` function itself are not relevant to the vulnerability, but the changes in the `run` function, which is called by `check`, are relevant.\n\nSo, the answer is 1, the function is vulnerable.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "main", "code_before": "    def main(self):\n        while True:\n            request = self.rpc_read()\n            self.log(request)\n            if request is None:\n                self.log('No more requests, stop handler')\n                return\n            cmd = self.conf('cmd')\n            if not cmd:\n                return\n            if request.method == 'notification':\n                icon_data = self.read() if request.params.get('packageIcon', False) else None\n                if request.params.get('event') == 'posted':\n                    text, package = map(request.params.get, ('text', 'package'))\n                    title = request.params.get('title', 'NULL')\n                    name, uin = self.device.name, self.device.uin\n                    if text is None:\n                        text = ''\n                    icon_path = os.path.join(self.conf('icon_dir'), f'{package}.{self.device.uin}.icon.png')\n                    if bool(icon_data):\n                        try:\n                            open(icon_path, 'wb').write(icon_data)\n                        except Exception as e:\n                            self.log(e, logging.WARNING)\n                    icon = icon_path if icon_data else ''\n                    command = cmd.format(uin=uin, name=name, icon=icon, text=text, title=title, package=package)\n                    self.log('Execute: \"{}\"'.format(command))\n                    subprocess.call(command, shell=True)\n", "code_after": "    def main(self):\n        while True:\n            request = self.rpc_read()\n            self.log(request)\n            if request is None:\n                self.log('No more requests, stop handler')\n                return\n            cmd = self.conf('cmd')\n            if not cmd:\n                return\n            if request.method == 'notification':\n                icon_data = self.read() if request.params.get('packageIcon', False) else None\n                if request.params.get('event') == 'posted':\n                    text, package = map(request.params.get, ('text', 'package'))\n                    title = request.params.get('title', 'NULL')\n                    name, uin = self.device.name, self.device.uin\n                    if text is None:\n                        text = ''\n                    icon_path = os.path.join(self.conf('icon_dir'), f'{package}.{self.device.uin}.icon.png')\n                    if bool(icon_data):\n                        try:\n                            open(icon_path, 'wb').write(icon_data)\n                        except Exception as e:\n                            self.log(e, logging.WARNING)\n                    icon = icon_path if icon_data else ''\n                    command = cmd.format(uin=quote(uin), name=quote(name), icon=quote(icon), text=quote(text), title=quote(title), package=quote(package))\n                    self.log('Execute: \"{}\"'.format(command))\n                    subprocess.call(command, shell=True)\n", "commit_message": "Fix command ijection vulnerability\n\nFix passing of unescaped text to the arguments of notification command\nin dcnnt/plugins/notifications.py\n\nThis is a high-risk vulnerability that can lead to RCE and allow arbitrary code\nexecution on the server while the notification showing.\n\nAll text received over the network MUST be escaped before being transmitted to\nthe database or to the shell command arguments.", "commit": "https://github.com/cyanomiko/dcnnt-py/commit/b4021d784a97e25151a5353aa763a741e9a148f5", "description": "dcnnt is an UI-less tool to connect Android phone with desktop\nAffected versions of this package are vulnerable to Command Injection due to passing of unescaped text to the arguments of notification command in dcnnt/plugins/notifications.py.", "file_change_id": 64351356406842, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-DCNNT-6133261", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"main\" was indeed vulnerable to a command injection attack. The vulnerability was due to unescaped text being passed to the arguments of a notification command. This could potentially lead to remote code execution (RCE) on the server while showing the notification.\n\nIn the \"code_after\" section, we can see that the developer has added the \"quote\" function to escape the variables 'uin', 'name', 'icon', 'text', 'title', and 'package' before they are formatted into the 'command' string. This change is directly addressing the vulnerability by ensuring that all text received over the network is escaped before being transmitted to the shell command arguments.\n\nTherefore, the function \"main\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "render_and_merge_yaml", "code_before": "def render_and_merge_yaml(root, template_name, context_name):\n    \"\"\"\n    Renders a Jinja2-templated YAML file based on a YAML context file, merge them, and return\n    result as a dictionary.\n\n    :param root: Root directory of the YAML files\n    :param template_name: Name of the template file\n    :param context_name: Name of the context file\n    :return: Data in yaml file as dictionary\n    \"\"\"\n    import jinja2\n\n    template_path = os.path.join(root, template_name)\n    context_path = os.path.join(root, context_name)\n\n    for path in (template_path, context_path):\n        if not pathlib.Path(path).is_file():\n            raise MissingConfigException(f\"Yaml file '{path}' does not exist.\")\n\n    j2_env = jinja2.Environment(\n        loader=jinja2.FileSystemLoader(root, encoding=ENCODING),\n        undefined=jinja2.StrictUndefined,\n        line_comment_prefix=\"#\",\n    )\n\n    def from_json(input_var):\n        with open(input_var, encoding=\"utf-8\") as f:\n            return json.load(f)\n\n    j2_env.filters[\"from_json\"] = from_json\n    # Compute final source of context file (e.g. my-profile.yml), applying Jinja filters\n    # like from_json as needed to load context information from files, then load into a dict\n    context_source = j2_env.get_template(context_name).render({})\n    context_dict = yaml.load(context_source, Loader=UniqueKeyLoader) or {}\n\n    # Substitute parameters from context dict into template\n    source = j2_env.get_template(template_name).render(context_dict)\n    rendered_template_dict = yaml.load(source, Loader=UniqueKeyLoader)\n    return merge_dicts(rendered_template_dict, context_dict)\n", "code_after": "def render_and_merge_yaml(root, template_name, context_name):\n    \"\"\"\n    Renders a Jinja2-templated YAML file based on a YAML context file, merge them, and return\n    result as a dictionary.\n\n    :param root: Root directory of the YAML files\n    :param template_name: Name of the template file\n    :param context_name: Name of the context file\n    :return: Data in yaml file as dictionary\n    \"\"\"\n    from jinja2 import FileSystemLoader, StrictUndefined\n    from jinja2.sandbox import SandboxedEnvironment\n\n    template_path = os.path.join(root, template_name)\n    context_path = os.path.join(root, context_name)\n\n    for path in (template_path, context_path):\n        if not pathlib.Path(path).is_file():\n            raise MissingConfigException(f\"Yaml file '{path}' does not exist.\")\n\n    j2_env = SandboxedEnvironment(\n        loader=FileSystemLoader(root, encoding=ENCODING),\n        undefined=StrictUndefined,\n        line_comment_prefix=\"#\",\n    )\n\n    def from_json(input_var):\n        with open(input_var, encoding=\"utf-8\") as f:\n            return json.load(f)\n\n    j2_env.filters[\"from_json\"] = from_json\n    # Compute final source of context file (e.g. my-profile.yml), applying Jinja filters\n    # like from_json as needed to load context information from files, then load into a dict\n    context_source = j2_env.get_template(context_name).render({})\n    context_dict = yaml.load(context_source, Loader=UniqueKeyLoader) or {}\n\n    # Substitute parameters from context dict into template\n    source = j2_env.get_template(template_name).render(context_dict)\n    rendered_template_dict = yaml.load(source, Loader=UniqueKeyLoader)\n    return merge_dicts(rendered_template_dict, context_dict)\n", "commit_message": "Add sandboxed jinja2 loader for yaml rendering (#10676)\n\nSigned-off-by: Ben Wilson <benjamin.wilson@databricks.com>", "commit": "https://github.com/mlflow/mlflow/commit/8029113817175cc9b9bed5c1bebe2f9afea2835b", "description": "mlflow is a platform to streamline machine learning development, including tracking experiments, packaging code into reproducible runs, and sharing and deploying models.\nAffected versions of this package are vulnerable to Command Injection because of an invalid fix for CVE-2023-6709. Attackers can gain full command execution on the victim system, with only one user interaction.", "file_change_id": 7903630896595, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-MLFLOW-6130902", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information shows that the function `render_and_merge_yaml` has been modified. The change is from using a `jinja2.Environment` to a `jinja2.sandbox.SandboxedEnvironment`. The sandboxed environment in Jinja2 is a way to execute templates in a safer manner, where it restricts the templates from doing harmful operations. This is a security feature that can prevent attacks such as Command Injection.\n\nThe vulnerability description mentions that the package was vulnerable to Command Injection, which aligns with the change made in the function. Therefore, it can be inferred that the function was vulnerable and has been changed to fix the vulnerability.\n\nSo, the answer is 1 (the function is vulnerable).\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "do_template", "code_before": "    def do_template(self, data, preserve_trailing_newlines=True, escape_backslashes=True, fail_on_undefined=None, overrides=None, disable_lookups=False):\n        if self.jinja2_native and not isinstance(data, string_types):\n            return data\n\n        # For preserving the number of input newlines in the output (used\n        # later in this method)\n        data_newlines = _count_newlines_from_end(data)\n\n        if fail_on_undefined is None:\n            fail_on_undefined = self._fail_on_undefined_errors\n\n        try:\n            # allows template header overrides to change jinja2 options.\n            if overrides is None:\n                myenv = self.environment\n            else:\n                myenv = self.environment.overlay(overrides)\n\n            # Get jinja env overrides from template\n            if hasattr(data, 'startswith') and data.startswith(JINJA2_OVERRIDE):\n                eol = data.find('\\n')\n                line = data[len(JINJA2_OVERRIDE):eol]\n                data = data[eol + 1:]\n                for pair in line.split(','):\n                    (key, val) = pair.split(':')\n                    key = key.strip()\n                    setattr(myenv, key, ast.literal_eval(val.strip()))\n\n            if escape_backslashes:\n                # Allow users to specify backslashes in playbooks as \"\\\\\" instead of as \"\\\\\\\\\".\n                data = _escape_backslashes(data, myenv)\n\n            try:\n                t = myenv.from_string(data)\n            except TemplateSyntaxError as e:\n                raise AnsibleError(\"template error while templating string: %s. String: %s\" % (to_native(e), to_native(data)))\n            except Exception as e:\n                if 'recursion' in to_native(e):\n                    raise AnsibleError(\"recursive loop detected in template string: %s\" % to_native(data))\n                else:\n                    return data\n\n            if disable_lookups:\n                t.globals['query'] = t.globals['q'] = t.globals['lookup'] = self._fail_lookup\n\n            jvars = AnsibleJ2Vars(self, t.globals)\n\n            self.cur_context = new_context = t.new_context(jvars, shared=True)\n            rf = t.root_render_func(new_context)\n\n            try:\n                if self.jinja2_native:\n                    res = ansible_native_concat(rf)\n                else:\n                    res = j2_concat(rf)\n                if getattr(new_context, 'unsafe', False):\n                    res = wrap_var(res)\n            except TypeError as te:\n                if 'AnsibleUndefined' in to_native(te):\n                    errmsg = \"Unable to look up a name or access an attribute in template string (%s).\\n\" % to_native(data)\n                    errmsg += \"Make sure your variable name does not contain invalid characters like '-': %s\" % to_native(te)\n                    raise AnsibleUndefinedVariable(errmsg)\n                else:\n                    display.debug(\"failing because of a type error, template data is: %s\" % to_text(data))\n                    raise AnsibleError(\"Unexpected templating type error occurred on (%s): %s\" % (to_native(data), to_native(te)))\n\n            if self.jinja2_native and not isinstance(res, string_types):\n                return res\n\n            if preserve_trailing_newlines:\n                # The low level calls above do not preserve the newline\n                # characters at the end of the input data, so we use the\n                # calculate the difference in newlines and append them\n                # to the resulting output for parity\n                #\n                # jinja2 added a keep_trailing_newline option in 2.7 when\n                # creating an Environment.  That would let us make this code\n                # better (remove a single newline if\n                # preserve_trailing_newlines is False).  Once we can depend on\n                # that version being present, modify our code to set that when\n                # initializing self.environment and remove a single trailing\n                # newline here if preserve_newlines is False.\n                res_newlines = _count_newlines_from_end(res)\n                if data_newlines > res_newlines:\n                    res += self.environment.newline_sequence * (data_newlines - res_newlines)\n            return res\n        except (UndefinedError, AnsibleUndefinedVariable) as e:\n            if fail_on_undefined:\n                raise AnsibleUndefinedVariable(e)\n            else:\n                display.debug(\"Ignoring undefined failure: %s\" % to_text(e))\n                return data\n", "code_after": "    def do_template(self, data, preserve_trailing_newlines=True, escape_backslashes=True, fail_on_undefined=None, overrides=None, disable_lookups=False):\n        if self.jinja2_native and not isinstance(data, string_types):\n            return data\n\n        # For preserving the number of input newlines in the output (used\n        # later in this method)\n        data_newlines = _count_newlines_from_end(data)\n\n        if fail_on_undefined is None:\n            fail_on_undefined = self._fail_on_undefined_errors\n\n        try:\n            # allows template header overrides to change jinja2 options.\n            if overrides is None:\n                myenv = self.environment\n            else:\n                myenv = self.environment.overlay(overrides)\n\n            # Get jinja env overrides from template\n            if hasattr(data, 'startswith') and data.startswith(JINJA2_OVERRIDE):\n                eol = data.find('\\n')\n                line = data[len(JINJA2_OVERRIDE):eol]\n                data = data[eol + 1:]\n                for pair in line.split(','):\n                    (key, val) = pair.split(':')\n                    key = key.strip()\n                    setattr(myenv, key, ast.literal_eval(val.strip()))\n\n            if escape_backslashes:\n                # Allow users to specify backslashes in playbooks as \"\\\\\" instead of as \"\\\\\\\\\".\n                data = _escape_backslashes(data, myenv)\n\n            try:\n                t = myenv.from_string(data)\n            except TemplateSyntaxError as e:\n                raise AnsibleError(\"template error while templating string: %s. String: %s\" % (to_native(e), to_native(data)))\n            except Exception as e:\n                if 'recursion' in to_native(e):\n                    raise AnsibleError(\"recursive loop detected in template string: %s\" % to_native(data))\n                else:\n                    return data\n\n            if disable_lookups:\n                t.globals['query'] = t.globals['q'] = t.globals['lookup'] = self._fail_lookup\n\n            jvars = AnsibleJ2Vars(self, t.globals)\n\n            self.cur_context = new_context = t.new_context(jvars, shared=True)\n            rf = t.root_render_func(new_context)\n\n            try:\n                if self.jinja2_native:\n                    res = ansible_native_concat(rf)\n                else:\n                    res = j2_concat(rf)\n                unsafe = getattr(new_context, 'unsafe', False)\n                if unsafe:\n                    res = wrap_var(res)\n            except TypeError as te:\n                if 'AnsibleUndefined' in to_native(te):\n                    errmsg = \"Unable to look up a name or access an attribute in template string (%s).\\n\" % to_native(data)\n                    errmsg += \"Make sure your variable name does not contain invalid characters like '-': %s\" % to_native(te)\n                    raise AnsibleUndefinedVariable(errmsg)\n                else:\n                    display.debug(\"failing because of a type error, template data is: %s\" % to_text(data))\n                    raise AnsibleError(\"Unexpected templating type error occurred on (%s): %s\" % (to_native(data), to_native(te)))\n\n            if self.jinja2_native and not isinstance(res, string_types):\n                return res\n\n            if preserve_trailing_newlines:\n                # The low level calls above do not preserve the newline\n                # characters at the end of the input data, so we use the\n                # calculate the difference in newlines and append them\n                # to the resulting output for parity\n                #\n                # jinja2 added a keep_trailing_newline option in 2.7 when\n                # creating an Environment.  That would let us make this code\n                # better (remove a single newline if\n                # preserve_trailing_newlines is False).  Once we can depend on\n                # that version being present, modify our code to set that when\n                # initializing self.environment and remove a single trailing\n                # newline here if preserve_newlines is False.\n                res_newlines = _count_newlines_from_end(res)\n                if data_newlines > res_newlines:\n                    res += self.environment.newline_sequence * (data_newlines - res_newlines)\n                    if unsafe:\n                        res = wrap_var(res)\n            return res\n        except (UndefinedError, AnsibleUndefinedVariable) as e:\n            if fail_on_undefined:\n                raise AnsibleUndefinedVariable(e)\n            else:\n                display.debug(\"Ignoring undefined failure: %s\" % to_text(e))\n                return data\n", "commit_message": "fix unsafe preservation across newlines (#74960) (#74973)\n\n  CVE-2021-3583\r\n  ensure we always have unsafe\r\n\r\nCo-authored-by: Rick Elrod <rick@elrod.me>\r\n(cherry picked from commit 4c8c40fd3d4a58defdc80e7d22aa8d26b731353e)", "commit": "https://github.com/ansible/ansible/commit/03aff644cc1c00e1f7551195c68fbd0d13a39e6e", "description": "ansible-core is an a radically simple IT automation system. It handles configuration management, application deployment, cloud provisioning, ad-hoc task execution, network automation, and multi-node orchestration. Ansible makes complex changes like zero-downtime rolling updates with load balancers easy.\nAffected versions of this package are vulnerable to Command Injection. If a user is trying to put templates in multi-line yaml strings and the facts being handled don't routinely include special template characters, then their controller will be vulnerable to a template injection through the facts used in template.", "file_change_id": 75466037515076, "report_link": "https://security.snyk.io/vuln/SNYK-PYTHON-ANSIBLECORE-6069941", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"do_template\" was changed to fix a vulnerability. The vulnerability description mentions that the issue is related to template injection through the facts used in the template. \n\nLooking at the changes in the \"do_template\" function, it's clear that the changes are related to handling unsafe variables and preserving newlines. The change is specifically in the block of code that handles preserving trailing newlines. In the updated code, an additional check is added to ensure that if the result is marked as unsafe, it is wrapped after the newlines are preserved.\n\nThis change is directly related to the vulnerability described, as it adds an additional layer of security to prevent template injection attacks. Therefore, the function \"do_template\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "do_template", "code_before": "    def do_template(self, data, preserve_trailing_newlines=True, escape_backslashes=True, fail_on_undefined=None, overrides=None, disable_lookups=False):\n        if self.jinja2_native and not isinstance(data, string_types):\n            return data\n\n        # For preserving the number of input newlines in the output (used\n        # later in this method)\n        data_newlines = _count_newlines_from_end(data)\n\n        if fail_on_undefined is None:\n            fail_on_undefined = self._fail_on_undefined_errors\n\n        try:\n            # allows template header overrides to change jinja2 options.\n            if overrides is None:\n                myenv = self.environment\n            else:\n                myenv = self.environment.overlay(overrides)\n\n            # Get jinja env overrides from template\n            if hasattr(data, 'startswith') and data.startswith(JINJA2_OVERRIDE):\n                eol = data.find('\\n')\n                line = data[len(JINJA2_OVERRIDE):eol]\n                data = data[eol + 1:]\n                for pair in line.split(','):\n                    (key, val) = pair.split(':')\n                    key = key.strip()\n                    setattr(myenv, key, ast.literal_eval(val.strip()))\n\n            if escape_backslashes:\n                # Allow users to specify backslashes in playbooks as \"\\\\\" instead of as \"\\\\\\\\\".\n                data = _escape_backslashes(data, myenv)\n\n            try:\n                t = myenv.from_string(data)\n            except TemplateSyntaxError as e:\n                raise AnsibleError(\"template error while templating string: %s. String: %s\" % (to_native(e), to_native(data)))\n            except Exception as e:\n                if 'recursion' in to_native(e):\n                    raise AnsibleError(\"recursive loop detected in template string: %s\" % to_native(data))\n                else:\n                    return data\n\n        