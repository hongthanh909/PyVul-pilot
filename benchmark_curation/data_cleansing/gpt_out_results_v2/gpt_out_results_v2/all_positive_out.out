r(cwd)\n\n    package_data = {\n        'notebook' : ['templates/*'] + static_data,\n        'notebook.tests' : js_tests,\n        'notebook.bundler.tests': ['resources/*', 'resources/*/*', 'resources/*/*/.*'],\n        'notebook.services.api': ['api.yaml'],\n        'notebook.i18n': ['*/LC_MESSAGES/*.*'],\n    }\n    \n    return package_data\n", "commit_message": "Merge pull request from GHSA-hwvq-6gjx-j797\n\n* sanitizer fix\n\n* Pass sanitizer options explicitly", "commit": "https://github.com/jupyter/notebook/commit/79fc76e890a8ec42f73a3d009e44ef84c14ef0d5", "description": "### Impact\n\nUntrusted notebook can execute code on load. This is a remote code execution, but requires user action to open a notebook.\n\n### Patches\n\n5.7.11, 6.4.1\n\n### References\n\n[OWASP Page on Injection Prevention](https://cheatsheetseries.owasp.org/cheatsheets/Injection_Prevention_Cheat_Sheet.html#injection-prevention-rules)\n\n### For more information\n\nIf you have any questions or comments about this advisory, or vulnerabilities to report, please email our security list security@ipython.org.\n\nCredit: Guillaume Jeanne from Google\n\n\n### Example:\n\nA notebook with the following content in a cell and it would display an alert when opened for the first time in Notebook (in an untrusted state):\n\n```\n{ \"cell_type\": \"code\", \"execution_count\": 0, \"metadata\": {}, \"outputs\": [ { \"data\": { \"text/html\": [ \"<select><iframe></select><img src=x: onerror=alert('xss')>\\n\"], \"text/plain\": [] }, \"metadata\": {}, \"output_type\": \"display_data\" } ], \"source\": [ \"\" ] }\n````", "file_change_id": 241683676554571, "report_link": "https://github.com/advisories/GHSA-hwvq-6gjx-j797", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "should_run", "code_before": "    def should_run(self):\n        if self.force:\n            return True\n        if not os.path.exists(self.bower_dir):\n            return True\n        \n        return mtime(self.bower_dir) < mtime(pjoin(repo_root, 'bower.json'))\n", "code_after": "    def should_run(self):\n        if self.force:\n            return True\n        if not os.path.exists(self.bower_dir):\n            return True\n        if not os.path.exists(self.sanitizer_dir):\n            return True\n\n        bower_stale = mtime(self.bower_dir) < mtime(pjoin(repo_root, 'bower.json'))\n        if bower_stale:\n            return True\n\n        return mtime(self.sanitizer_dir) < mtime(pjoin(repo_root, 'webpack.config.js'))\n"}, {"function_name": "run", "code_before": "    def run(self):\n        if not self.should_run():\n            print(\"bower dependencies up to date\")\n            return\n        \n        if self.should_run_npm():\n            print(\"installing build dependencies with npm\")\n            run(['npm', 'install'], cwd=repo_root)\n            os.utime(self.node_modules, None)\n        \n        env = os.environ.copy()\n        env['PATH'] = npm_path\n        \n        try:\n            run(\n                ['bower', 'install', '--allow-root', '--config.interactive=false'],\n                cwd=repo_root,\n                env=env\n            )\n        except OSError as e:\n            print(\"Failed to run bower: %s\" % e, file=sys.stderr)\n            print(\"You can install js dependencies with `npm install`\", file=sys.stderr)\n            raise\n        # self.npm_components()\n        os.utime(self.bower_dir, None)\n        # update package data in case this created new files\n        update_package_data(self.distribution)\n", "code_after": "    def run(self):\n        if not self.should_run():\n            print(\"bower dependencies up to date\")\n            return\n        \n        if self.should_run_npm():\n            print(\"installing build dependencies with npm\")\n            run(['npm', 'install'], cwd=repo_root)\n            os.utime(self.node_modules, None)\n        \n        env = os.environ.copy()\n        env['PATH'] = npm_path\n        \n        try:\n            run(\n                ['bower', 'install', '--allow-root', '--config.interactive=false'],\n                cwd=repo_root,\n                env=env\n            )\n        except OSError as e:\n            print(\"Failed to run bower: %s\" % e, file=sys.stderr)\n            print(\"You can install js dependencies with `npm install`\", file=sys.stderr)\n            raise\n        # self.npm_components()\n        if not os.path.exists(self.sanitizer_dir):\n            run(['npm', 'run', 'build:webpack'], cwd=repo_root, env=env)\n        os.utime(self.bower_dir, None)\n        # update package data in case this created new files\n        update_package_data(self.distribution)\n"}], "gpt_answer": "The function \"find_package_data\" is responsible for finding package data. The change in the function is the addition of a new line in the \"static_data.extend\" section, specifically \"pjoin(components, \\\"sanitizer\\\", \\\"index.js\\\")\". This change is related to the addition of a sanitizer, which is relevant to the vulnerability that the commit is trying to fix.\n\nThe vulnerability is about untrusted notebooks being able to execute code on load, which is a remote code execution vulnerability. The addition of a sanitizer is a common way to mitigate such vulnerabilities, as it can sanitize or clean the untrusted input to prevent malicious code execution.\n\nTherefore, the function \"find_package_data\" is vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
