path)\n    image_project_version = info['project_version']\n    image_id = info['docker_image_id']\n    build_ver = image_project_version.replace(\"+\", \"-\")\n\n    if spec.version != image_project_version:\n        logger.warning(\n            \"Project version is %r, but image was built for %r\",\n            spec.version, image_project_version,\n        )\n\n    return _deploy_image_loaded_to_local_registry(\n        docker_repository=docker_repository,\n        auth_method=auth_method,\n        vault_endpoint=vault_endpoint,\n        vault_secret=vault_secret,\n        image_id=image_id,\n        build_ver=build_ver,\n    )\n", "code_after": "def _deploy_docker_image_from_local_repo(\n    image_info_path: str,\n    docker_repository: str,\n    auth_method: AuthorizationType = AuthorizationType.LOCAL_ACCOUNT,\n    vault_endpoint: str | None = None,\n    vault_endpoint_verify: str | bool | None = None,\n    vault_secret: str | None = None,\n) -> str:\n\n    spec = get_project_spec()\n    info = toml.load(image_info_path)\n    image_project_version = info['project_version']\n    image_id = info['docker_image_id']\n    build_ver = image_project_version.replace(\"+\", \"-\")\n\n    if spec.version != image_project_version:\n        logger.warning(\n            \"Project version is %r, but image was built for %r\",\n            spec.version, image_project_version,\n        )\n\n    return _deploy_image_loaded_to_local_registry(\n        docker_repository=docker_repository,\n        auth_method=auth_method,\n        vault_endpoint=vault_endpoint,\n        vault_endpoint_verify=vault_endpoint_verify,\n        vault_secret=vault_secret,\n        image_id=image_id,\n        build_ver=build_ver,\n    )\n"}, {"function_name": "deploy_docker_image", "code_before": "def deploy_docker_image(\n    image_tar_path: str,\n    docker_repository: str,\n    auth_method: AuthorizationType = AuthorizationType.LOCAL_ACCOUNT,\n    vault_endpoint: T.Optional[str] = None,\n    vault_secret: T.Optional[str] = None,\n) -> str:\n    if image_tar_path.endswith(\".toml\"):\n        deploy_fn = _deploy_docker_image_from_local_repo\n    else:\n        deploy_fn = _deploy_docker_image_from_fs\n    return deploy_fn(\n        image_tar_path,\n        docker_repository,\n        auth_method,\n        vault_endpoint,\n        vault_secret,\n    )\n", "code_after": "def deploy_docker_image(\n    image_tar_path: str,\n    docker_repository: str,\n    auth_method: AuthorizationType = AuthorizationType.LOCAL_ACCOUNT,\n    vault_endpoint: T.Optional[str] = None,\n    vault_endpoint_verify: str | bool | None = None,\n    vault_secret: T.Optional[str] = None,\n) -> str:\n    if image_tar_path.endswith(\".toml\"):\n        deploy_fn = _deploy_docker_image_from_local_repo\n    else:\n        deploy_fn = _deploy_docker_image_from_fs\n    return deploy_fn(\n        image_tar_path,\n        docker_repository,\n        auth_method,\n        vault_endpoint,\n        vault_endpoint_verify,\n        vault_secret,\n    )\n"}, {"function_name": "create_storage_client", "code_before": "def create_storage_client(\n        auth_method: AuthorizationType,\n        project_id: str,\n        vault_endpoint: str,\n        vault_secret: str,\n) -> storage.Client:\n    if auth_method == AuthorizationType.LOCAL_ACCOUNT:", "code_after": "def create_storage_client(\n        auth_method: AuthorizationType,\n        project_id: str,\n        vault_endpoint: str,\n        vault_secret: str,\n        vault_endpoint_verify: str | bool | None = None\n) -> storage.Client:\n    if auth_method == AuthorizationType.LOCAL_ACCOUNT:"}, {"function_name": "authenticate_to_registry", "code_before": "def authenticate_to_registry(\n        auth_method: AuthorizationType,\n        vault_endpoint: T.Optional[str] = None,\n        vault_secret: T.Optional[str] = None,\n):\n    logger.info(\"Authenticating to registry with auth_method=%s\", auth_method)", "code_after": "def authenticate_to_registry(\n        auth_method: AuthorizationType,\n        vault_endpoint: T.Optional[str] = None,\n        vault_secret: T.Optional[str] = None,\n        vault_endpoint_verify: str | bool | None = None,\n):\n    logger.info(\"Authenticating to registry with auth_method=%s\", auth_method)"}], "gpt_answer": "The function \"get_vault_token\" is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability is described as \"Missing SSL Certificate Validation\". In the \"get_vault_token\" function, the code change is specifically related to SSL certificate validation. \n\nIn the \"code_before\" snippet, the \"verify\" parameter of the \"requests.get\" method is set to \"False\", which means that the SSL certificate is not verified. In the \"code_after\" snippet, the \"verify\" parameter is set to \"vault_endpoint_verify\", which means that the SSL certificate will be verified if \"vault_endpoint_verify\" is \"True\". \n\nThis change directly addresses the described vulnerability by enabling SSL certificate verification. Therefore, the function \"get_vault_token\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "set_interface", "code_before": "    def set_interface(self, options):\n        options = {\n            k: v.encode() if hasattr(v, \"encode\") else v for k, v in options.items()\n        }\n\n        interface, proxy, ipv6 = (\n            options[\"interface\"],\n            options[\"proxies\"],\n            options[\"ipv6\"],\n        )\n\n        if interface and interface.lower() != \"none\":\n            self.c.setopt(pycurl.INTERFACE, interface)\n\n        if proxy:\n            if proxy[\"type\"] == \"http\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_HTTP)\n            elif proxy[\"type\"] == \"https\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_HTTPS)\n                self.c.setopt(pycurl.PROXY_SSL_VERIFYPEER, 0)\n            elif proxy[\"type\"] == \"socks4\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_SOCKS4)\n            elif proxy[\"type\"] == \"socks5\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_SOCKS5)\n\n            self.c.setopt(pycurl.PROXY, proxy[\"host\"])\n            self.c.setopt(pycurl.PROXYPORT, int(proxy[\"port\"]))\n\n            if proxy[\"username\"]:\n                user = proxy[\"username\"]\n                pw = proxy[\"password\"]\n                self.c.setopt(pycurl.PROXYUSERPWD, f\"{user}:{pw}\".encode())\n\n        if ipv6:\n            self.c.setopt(pycurl.IPRESOLVE, pycurl.IPRESOLVE_WHATEVER)\n        else:\n            self.c.setopt(pycurl.IPRESOLVE, pycurl.IPRESOLVE_V4)\n\n        if \"auth\" in options:\n            self.c.setopt(pycurl.USERPWD, options[\"auth\"])\n\n        if \"timeout\" in options:\n            self.c.setopt(pycurl.LOW_SPEED_TIME, int(options[\"timeout\"]))\n", "code_after": "    def set_interface(self, options):\n        options = {\n            k: v.encode() if hasattr(v, \"encode\") else v for k, v in options.items()\n        }\n\n        interface, proxy, ipv6 = (\n            options[\"interface\"],\n            options[\"proxies\"],\n            options[\"ipv6\"],\n        )\n\n        if interface and interface.lower() != \"none\":\n            self.c.setopt(pycurl.INTERFACE, interface)\n\n        if proxy:\n            if proxy[\"type\"] == \"http\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_HTTP)\n            elif proxy[\"type\"] == \"https\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_HTTPS)\n                self.c.setopt(pycurl.PROXY_SSL_VERIFYPEER, 0)\n            elif proxy[\"type\"] == \"socks4\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_SOCKS4)\n            elif proxy[\"type\"] == \"socks5\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_SOCKS5)\n\n            self.c.setopt(pycurl.PROXY, proxy[\"host\"])\n            self.c.setopt(pycurl.PROXYPORT, int(proxy[\"port\"]))\n\n            if proxy[\"username\"]:\n                user = proxy[\"username\"]\n                pw = proxy[\"password\"]\n                self.c.setopt(pycurl.PROXYUSERPWD, f\"{user}:{pw}\".encode())\n\n        if ipv6:\n            self.c.setopt(pycurl.IPRESOLVE, pycurl.IPRESOLVE_WHATEVER)\n        else:\n            self.c.setopt(pycurl.IPRESOLVE, pycurl.IPRESOLVE_V4)\n\n        if \"auth\" in options:\n            self.c.setopt(pycurl.USERPWD, options[\"auth\"])\n\n        if \"timeout\" in options:\n            self.c.setopt(pycurl.LOW_SPEED_TIME, int(options[\"timeout\"]))\n\n        if \"ssl_verify\" in options:\n            self.c.setopt(pycurl.SSL_VERIFYPEER, 1 if options[\"ssl_verify\"] else 0)\n", "commit_message": "enable SSL certificate verification by default, add option to disable it", "commit": "https://github.com/pyload/pyload/commit/a9098bdf7406e6faf9df3da6ff2d584e90c13bbb", "description": "Description\nWhen a certificate is invalid or malicious, it might allow an attacker to spoof a trusted entity by interfering in the communication path between the host and client. The software might connect to a malicious host while believing it is a trusted host, or the software might be deceived into accepting spoofed data that appears to originate from a trusted host.\nProof of Concept\nAdd package with a link whose host's SSL certificate is invalid. E.g. https://self-signed.badssl.com/\nGo to the Files tab and see there is the content of the above-mentioned link.\nImpact\nThis vulnerability is capable of allowing an attacker to intercept data sent over HTTPS connections .", "file_change_id": 140653712727655, "report_link": "https://huntr.com/bounties/a370e0c2-a41c-4871-ad91-bc6f31a8e839/", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "init_handle", "code_before": "    def init_handle(self):\n        \"\"\"\n        sets common options to curl handle.\n        \"\"\"\n        self.c.setopt(pycurl.FOLLOWLOCATION, 1)\n        self.c.setopt(pycurl.MAXREDIRS, 10)\n        self.c.setopt(pycurl.CONNECTTIMEOUT, 30)\n        self.c.setopt(pycurl.NOSIGNAL, 1)\n        self.c.setopt(pycurl.NOPROGRESS, 1)\n        if hasattr(pycurl, \"AUTOREFERER\"):\n            self.c.setopt(pycurl.AUTOREFERER, 1)\n        self.c.setopt(pycurl.SSL_VERIFYPEER, 0)\n        self.c.setopt(pycurl.LOW_SPEED_TIME, 60)\n        self.c.setopt(pycurl.LOW_SPEED_LIMIT, 5)\n        if hasattr(pycurl, \"USE_SSL\"):\n            self.c.setopt(pycurl.USE_SSL, pycurl.USESSL_TRY)\n\n        # self.c.setopt(pycurl.VERBOSE, 1)\n        # self.c.setopt(pycurl.HTTP_VERSION, pycurl.CURL_HTTP_VERSION_1_1)\n\n        self.c.setopt(\n            pycurl.USERAGENT,\n            b\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/60.0.3112.113 Safari/537.36\",\n        )\n        if pycurl.version_info()[7]:\n            self.c.setopt(pycurl.ENCODING, b\"gzip, deflate\")\n        self.c.setopt(\n            pycurl.HTTPHEADER,\n            [\n                b\"Accept: */*\",\n                b\"Accept-Language: en-US,en\",\n                b\"Accept-Charset: ISO-8859-1,utf-8;q=0.7,*;q=0.7\",\n                b\"Connection: keep-alive\",\n                b\"Keep-Alive: 300\",\n                b\"Expect:\",\n            ],\n        )\n", "code_after": "    def init_handle(self):\n        \"\"\"\n        sets common options to curl handle.\n        \"\"\"\n        self.c.setopt(pycurl.FOLLOWLOCATION, 1)\n        self.c.setopt(pycurl.MAXREDIRS, 10)\n        self.c.setopt(pycurl.CONNECTTIMEOUT, 30)\n        self.c.setopt(pycurl.NOSIGNAL, 1)\n        self.c.setopt(pycurl.NOPROGRESS, 1)\n        if hasattr(pycurl, \"AUTOREFERER\"):\n            self.c.setopt(pycurl.AUTOREFERER, 1)\n        self.c.setopt(pycurl.SSL_VERIFYPEER, 1)\n        self.c.setopt(pycurl.LOW_SPEED_TIME, 60)\n        self.c.setopt(pycurl.LOW_SPEED_LIMIT, 5)\n        if hasattr(pycurl, \"USE_SSL\"):\n            self.c.setopt(pycurl.USE_SSL, pycurl.USESSL_TRY)\n\n        # self.c.setopt(pycurl.VERBOSE, 1)\n        # self.c.setopt(pycurl.HTTP_VERSION, pycurl.CURL_HTTP_VERSION_1_1)\n\n        self.c.setopt(\n            pycurl.USERAGENT,\n            b\"Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/109.0\",\n        )\n        if pycurl.version_info()[7]:\n            self.c.setopt(pycurl.ENCODING, b\"gzip, deflate\")\n        self.c.setopt(\n            pycurl.HTTPHEADER,\n            [\n                b\"Accept: */*\",\n                b\"Accept-Language: en-US,en\",\n                b\"Accept-Charset: ISO-8859-1,utf-8;q=0.7,*;q=0.7\",\n                b\"Connection: keep-alive\",\n                b\"Keep-Alive: 300\",\n                b\"Expect:\",\n            ],\n        )\n"}], "gpt_answer": "The vulnerability described is related to the software not validating SSL certificates, which could allow an attacker to intercept data sent over HTTPS connections. \n\nLooking at the changes in the `set_interface` function, we can see that a new option `ssl_verify` has been added. This option is used to set the `pycurl.SSL_VERIFYPEER` option, which controls whether the SSL certificates are verified. This directly addresses the vulnerability described.\n\nTherefore, the `set_interface` function is vulnerable and has been changed to fix the vulnerability.\n\nIn addition, the `init_handle` function, which is another changed function in the commit, also has a change related to the `pycurl.SSL_VERIFYPEER` option. This further confirms that the changes are relevant to the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "init_handle", "code_before": "    def init_handle(self):\n        \"\"\"\n        sets common options to curl handle.\n        \"\"\"\n        self.c.setopt(pycurl.FOLLOWLOCATION, 1)\n        self.c.setopt(pycurl.MAXREDIRS, 10)\n        self.c.setopt(pycurl.CONNECTTIMEOUT, 30)\n        self.c.setopt(pycurl.NOSIGNAL, 1)\n        self.c.setopt(pycurl.NOPROGRESS, 1)\n        if hasattr(pycurl, \"AUTOREFERER\"):\n            self.c.setopt(pycurl.AUTOREFERER, 1)\n        self.c.setopt(pycurl.SSL_VERIFYPEER, 0)\n        self.c.setopt(pycurl.LOW_SPEED_TIME, 60)\n        self.c.setopt(pycurl.LOW_SPEED_LIMIT, 5)\n        if hasattr(pycurl, \"USE_SSL\"):\n            self.c.setopt(pycurl.USE_SSL, pycurl.USESSL_TRY)\n\n        # self.c.setopt(pycurl.VERBOSE, 1)\n        # self.c.setopt(pycurl.HTTP_VERSION, pycurl.CURL_HTTP_VERSION_1_1)\n\n        self.c.setopt(\n            pycurl.USERAGENT,\n            b\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/60.0.3112.113 Safari/537.36\",\n        )\n        if pycurl.version_info()[7]:\n            self.c.setopt(pycurl.ENCODING, b\"gzip, deflate\")\n        self.c.setopt(\n            pycurl.HTTPHEADER,\n            [\n                b\"Accept: */*\",\n                b\"Accept-Language: en-US,en\",\n                b\"Accept-Charset: ISO-8859-1,utf-8;q=0.7,*;q=0.7\",\n                b\"Connection: keep-alive\",\n                b\"Keep-Alive: 300\",\n                b\"Expect:\",\n            ],\n        )\n", "code_after": "    def init_handle(self):\n        \"\"\"\n        sets common options to curl handle.\n        \"\"\"\n        self.c.setopt(pycurl.FOLLOWLOCATION, 1)\n        self.c.setopt(pycurl.MAXREDIRS, 10)\n        self.c.setopt(pycurl.CONNECTTIMEOUT, 30)\n        self.c.setopt(pycurl.NOSIGNAL, 1)\n        self.c.setopt(pycurl.NOPROGRESS, 1)\n        if hasattr(pycurl, \"AUTOREFERER\"):\n            self.c.setopt(pycurl.AUTOREFERER, 1)\n        self.c.setopt(pycurl.SSL_VERIFYPEER, 1)\n        self.c.setopt(pycurl.LOW_SPEED_TIME, 60)\n        self.c.setopt(pycurl.LOW_SPEED_LIMIT, 5)\n        if hasattr(pycurl, \"USE_SSL\"):\n            self.c.setopt(pycurl.USE_SSL, pycurl.USESSL_TRY)\n\n        # self.c.setopt(pycurl.VERBOSE, 1)\n        # self.c.setopt(pycurl.HTTP_VERSION, pycurl.CURL_HTTP_VERSION_1_1)\n\n        self.c.setopt(\n            pycurl.USERAGENT,\n            b\"Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/109.0\",\n        )\n        if pycurl.version_info()[7]:\n            self.c.setopt(pycurl.ENCODING, b\"gzip, deflate\")\n        self.c.setopt(\n            pycurl.HTTPHEADER,\n            [\n                b\"Accept: */*\",\n                b\"Accept-Language: en-US,en\",\n                b\"Accept-Charset: ISO-8859-1,utf-8;q=0.7,*;q=0.7\",\n                b\"Connection: keep-alive\",\n                b\"Keep-Alive: 300\",\n                b\"Expect:\",\n            ],\n        )\n", "commit_message": "enable SSL certificate verification by default, add option to disable it", "commit": "https://github.com/pyload/pyload/commit/a9098bdf7406e6faf9df3da6ff2d584e90c13bbb", "description": "Description\nWhen a certificate is invalid or malicious, it might allow an attacker to spoof a trusted entity by interfering in the communication path between the host and client. The software might connect to a malicious host while believing it is a trusted host, or the software might be deceived into accepting spoofed data that appears to originate from a trusted host.\nProof of Concept\nAdd package with a link whose host's SSL certificate is invalid. E.g. https://self-signed.badssl.com/\nGo to the Files tab and see there is the content of the above-mentioned link.\nImpact\nThis vulnerability is capable of allowing an attacker to intercept data sent over HTTPS connections .", "file_change_id": 140653712727655, "report_link": "https://huntr.com/bounties/a370e0c2-a41c-4871-ad91-bc6f31a8e839/", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "set_interface", "code_before": "    def set_interface(self, options):\n        options = {\n            k: v.encode() if hasattr(v, \"encode\") else v for k, v in options.items()\n        }\n\n        interface, proxy, ipv6 = (\n            options[\"interface\"],\n            options[\"proxies\"],\n            options[\"ipv6\"],\n        )\n\n        if interface and interface.lower() != \"none\":\n            self.c.setopt(pycurl.INTERFACE, interface)\n\n        if proxy:\n            if proxy[\"type\"] == \"http\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_HTTP)\n            elif proxy[\"type\"] == \"https\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_HTTPS)\n                self.c.setopt(pycurl.PROXY_SSL_VERIFYPEER, 0)\n            elif proxy[\"type\"] == \"socks4\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_SOCKS4)\n            elif proxy[\"type\"] == \"socks5\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_SOCKS5)\n\n            self.c.setopt(pycurl.PROXY, proxy[\"host\"])\n            self.c.setopt(pycurl.PROXYPORT, int(proxy[\"port\"]))\n\n            if proxy[\"username\"]:\n                user = proxy[\"username\"]\n                pw = proxy[\"password\"]\n                self.c.setopt(pycurl.PROXYUSERPWD, f\"{user}:{pw}\".encode())\n\n        if ipv6:\n            self.c.setopt(pycurl.IPRESOLVE, pycurl.IPRESOLVE_WHATEVER)\n        else:\n            self.c.setopt(pycurl.IPRESOLVE, pycurl.IPRESOLVE_V4)\n\n        if \"auth\" in options:\n            self.c.setopt(pycurl.USERPWD, options[\"auth\"])\n\n        if \"timeout\" in options:\n            self.c.setopt(pycurl.LOW_SPEED_TIME, int(options[\"timeout\"]))\n", "code_after": "    def set_interface(self, options):\n        options = {\n            k: v.encode() if hasattr(v, \"encode\") else v for k, v in options.items()\n        }\n\n        interface, proxy, ipv6 = (\n            options[\"interface\"],\n            options[\"proxies\"],\n            options[\"ipv6\"],\n        )\n\n        if interface and interface.lower() != \"none\":\n            self.c.setopt(pycurl.INTERFACE, interface)\n\n        if proxy:\n            if proxy[\"type\"] == \"http\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_HTTP)\n            elif proxy[\"type\"] == \"https\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_HTTPS)\n                self.c.setopt(pycurl.PROXY_SSL_VERIFYPEER, 0)\n            elif proxy[\"type\"] == \"socks4\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_SOCKS4)\n            elif proxy[\"type\"] == \"socks5\":\n                self.c.setopt(pycurl.PROXYTYPE, pycurl.PROXYTYPE_SOCKS5)\n\n            self.c.setopt(pycurl.PROXY, proxy[\"host\"])\n            self.c.setopt(pycurl.PROXYPORT, int(proxy[\"port\"]))\n\n            if proxy[\"username\"]:\n                user = proxy[\"username\"]\n                pw = proxy[\"password\"]\n                self.c.setopt(pycurl.PROXYUSERPWD, f\"{user}:{pw}\".encode())\n\n        if ipv6:\n            self.c.setopt(pycurl.IPRESOLVE, pycurl.IPRESOLVE_WHATEVER)\n        else:\n            self.c.setopt(pycurl.IPRESOLVE, pycurl.IPRESOLVE_V4)\n\n        if \"auth\" in options:\n            self.c.setopt(pycurl.USERPWD, options[\"auth\"])\n\n        if \"timeout\" in options:\n            self.c.setopt(pycurl.LOW_SPEED_TIME, int(options[\"timeout\"]))\n\n        if \"ssl_verify\" in options:\n            self.c.setopt(pycurl.SSL_VERIFYPEER, 1 if options[\"ssl_verify\"] else 0)\n"}], "gpt_answer": "The provided information indicates that the vulnerability allows an attacker to intercept data sent over HTTPS connections due to the software not validating SSL certificates. The change in the \"init_handle\" function is the setting of the `pycurl.SSL_VERIFYPEER` option from 0 (disabled) to 1 (enabled), which enables the verification of the SSL peer certificate, thus addressing the vulnerability.\n\nThe other function changed in the commit, \"set_interface\", also includes a change related to the `pycurl.SSL_VERIFYPEER` option, adding a condition to set it based on the \"ssl_verify\" option in the provided options.\n\nGiven this, it can be concluded that the \"init_handle\" function was vulnerable and has been changed to fix the vulnerability. Therefore, the answer is 1.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_options", "code_before": "    def get_options(self):\n        \"\"\"\n        returns options needed for pycurl.\n        \"\"\"\n        return {\n            \"interface\": self.iface(),\n            \"proxies\": self.get_proxies(),\n            \"ipv6\": self.pyload.config.get(\"download\", \"ipv6\"),\n        }\n", "code_after": "    def get_options(self):\n        \"\"\"\n        returns options needed for pycurl.\n        \"\"\"\n        return {\n            \"interface\": self.iface(),\n            \"proxies\": self.get_proxies(),\n            \"ipv6\": self.pyload.config.get(\"download\", \"ipv6\"),\n            \"ssl_verify\": self.pyload.config.get(\"general\", \"ssl_verify\"),\n        }\n", "commit_message": "enable SSL certificate verification by default, add option to disable it", "commit": "https://github.com/pyload/pyload/commit/a9098bdf7406e6faf9df3da6ff2d584e90c13bbb", "description": "Description\nWhen a certificate is invalid or malicious, it might allow an attacker to spoof a trusted entity by interfering in the communication path between the host and client. The software might connect to a malicious host while believing it is a trusted host, or the software might be deceived into accepting spoofed data that appears to originate from a trusted host.\nProof of Concept\nAdd package with a link whose host's SSL certificate is invalid. E.g. https://self-signed.badssl.com/\nGo to the Files tab and see there is the content of the above-mentioned link.\nImpact\nThis vulnerability is capable of allowing an attacker to intercept data sent over HTTPS connections .", "file_change_id": 231555490903304, "report_link": "https://huntr.com/bounties/a370e0c2-a41c-4871-ad91-bc6f31a8e839/", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `get_options` has been modified to include an additional option for SSL certificate verification (`\"ssl_verify\"`). This change is directly related to the commit message, which states \"enable SSL certificate verification by default, add option to disable it\".\n\nThe vulnerability description mentions that the software might connect to a malicious host while believing it is a trusted host, or the software might be deceived into accepting spoofed data that appears to originate from a trusted host. This is a typical scenario when SSL certificate verification is not properly implemented or is disabled.\n\nGiven that the change in the function is directly related to enabling SSL certificate verification, it can be inferred that this function was vulnerable and has been changed to fix the vulnerability. Therefore, the answer is 1.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "validate_key", "code_before": "    def validate_key(self, key):\n        \"\"\"\n        Warn about keys that would not be portable to the memcached\n        backend. This encourages (but does not force) writing backend-portable\n        cache code.\n        \"\"\"\n        if len(key) > MEMCACHE_MAX_KEY_LENGTH:\n            warnings.warn(\n                'Cache key will cause errors if used with memcached: %r '\n                '(longer than %s)' % (key, MEMCACHE_MAX_KEY_LENGTH), CacheKeyWarning\n            )\n        for char in key:\n            if ord(char) < 33 or ord(char) == 127:\n                warnings.warn(\n                    'Cache key contains characters that will cause errors if '\n                    'used with memcached: %r' % key, CacheKeyWarning\n                )\n                break\n", "code_after": "    def validate_key(self, key):\n        \"\"\"\n        Warn about keys that would not be portable to the memcached\n        backend. This encourages (but does not force) writing backend-portable\n        cache code.\n        \"\"\"\n        for warning in memcache_key_warnings(key):\n            warnings.warn(warning, CacheKeyWarning)\n", "commit_message": "[2.2.x] Fixed CVE-2020-13254 -- Enforced cache key validation in memcached backends.", "commit": "https://github.com/django/django/commit/07e59caa02831c4569bbebb9eb773bdd9cb4b206", "description": "An issue was discovered in Django version 2.2 before 2.2.13 and 3.0 before 3.0.7. In cases where a memcached backend does not perform key validation, passing malformed cache keys could result in a key collision, and potential data leakage.", "file_change_id": 92428320132982, "report_link": "https://github.com/advisories/GHSA-wpjr-j57x-wxfw", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `validate_key` has been modified to address a security vulnerability. The vulnerability description states that \"In cases where a memcached backend does not perform key validation, passing malformed cache keys could result in a key collision, and potential data leakage.\"\n\nThe change in the `validate_key` function is directly related to this vulnerability. The function's purpose is to validate keys for the memcached backend. In the updated code, the function now uses `memcache_key_warnings(key)` to generate warnings for invalid keys, which is a more robust way of validating keys compared to the previous implementation.\n\nTherefore, the function `validate_key` is vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "incr", "code_before": "    def incr(self, key, delta=1, version=None):\n        key = self.make_key(key, version=version)\n        # memcached doesn't support a negative delta\n        if delta < 0:\n            return self._cache.decr(key, -delta)\n        try:\n            val = self._cache.incr(key, delta)\n\n        # python-memcache responds to incr on nonexistent keys by\n        # raising a ValueError, pylibmc by raising a pylibmc.NotFound\n        # and Cmemcache returns None. In all cases,\n        # we should raise a ValueError though.\n        except self.LibraryValueNotFoundException:\n            val = None\n        if val is None:\n            raise ValueError(\"Key '%s' not found\" % key)\n        return val\n", "code_after": "    def incr(self, key, delta=1, version=None):\n        key = self.make_key(key, version=version)\n        self.validate_key(key)\n        # memcached doesn't support a negative delta\n        if delta < 0:\n            return self._cache.decr(key, -delta)\n        try:\n            val = self._cache.incr(key, delta)\n\n        # python-memcache responds to incr on nonexistent keys by\n        # raising a ValueError, pylibmc by raising a pylibmc.NotFound\n        # and Cmemcache returns None. In all cases,\n        # we should raise a ValueError though.\n        except self.LibraryValueNotFoundException:\n            val = None\n        if val is None:\n            raise ValueError(\"Key '%s' not found\" % key)\n        return val\n", "commit_message": "[2.2.x] Fixed CVE-2020-13254 -- Enforced cache key validation in memcached backends.", "commit": "https://github.com/django/django/commit/07e59caa02831c4569bbebb9eb773bdd9cb4b206", "description": "An issue was discovered in Django version 2.2 before 2.2.13 and 3.0 before 3.0.7. In cases where a memcached backend does not perform key validation, passing malformed cache keys could result in a key collision, and potential data leakage.", "file_change_id": 43091709783067, "report_link": "https://github.com/advisories/GHSA-wpjr-j57x-wxfw", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "get_many", "code_before": "    def get_many(self, keys, version=None):\n        key_map = {self.make_key(key, version=version): key for key in keys}\n        ret = self._cache.get_multi(key_map.keys())\n        return {key_map[k]: v for k, v in ret.items()}\n", "code_after": "    def get_many(self, keys, version=None):\n        key_map = {self.make_key(key, version=version): key for key in keys}\n        for key in key_map:\n            self.validate_key(key)\n        ret = self._cache.get_multi(key_map.keys())\n        return {key_map[k]: v for k, v in ret.items()}\n"}, {"function_name": "get", "code_before": "    def get(self, key, default=None, version=None):\n        key = self.make_key(key, version=version)\n        val = self._cache.get(key)\n        if val is None:\n            return default\n        return val\n", "code_after": "    def get(self, key, default=None, version=None):\n        key = self.make_key(key, version=version)\n        self.validate_key(key)\n        val = self._cache.get(key)\n        if val is None:\n            return default\n        return val\n"}, {"function_name": "set_many", "code_before": "    def set_many(self, data, timeout=DEFAULT_TIMEOUT, version=None):\n        safe_data = {}\n        original_keys = {}\n        for key, value in data.items():\n            safe_key = self.make_key(key, version=version)\n            safe_data[safe_key] = value\n            original_keys[safe_key] = key\n        failed_keys = self._cache.set_multi(safe_data, self.get_backend_timeout(timeout))\n        return [original_keys[k] for k in failed_keys]\n", "code_after": "    def set_many(self, data, timeout=DEFAULT_TIMEOUT, version=None):\n        safe_data = {}\n        original_keys = {}\n        for key, value in data.items():\n            safe_key = self.make_key(key, version=version)\n            self.validate_key(safe_key)\n            safe_data[safe_key] = value\n            original_keys[safe_key] = key\n        failed_keys = self._cache.set_multi(safe_data, self.get_backend_timeout(timeout))\n        return [original_keys[k] for k in failed_keys]\n"}, {"function_name": "set", "code_before": "    def set(self, key, value, timeout=DEFAULT_TIMEOUT, version=None):\n        key = self.make_key(key, version=version)\n        if not self._cache.set(key, value, self.get_backend_timeout(timeout)):\n            # make sure the key doesn't keep its old value in case of failure to set (memcached's 1MB limit)\n            self._cache.delete(key)\n", "code_after": "    def set(self, key, value, timeout=DEFAULT_TIMEOUT, version=None):\n        key = self.make_key(key, version=version)\n        self.validate_key(key)\n        if not self._cache.set(key, value, self.get_backend_timeout(timeout)):\n            # make sure the key doesn't keep its old value in case of failure to set (memcached's 1MB limit)\n            self._cache.delete(key)\n"}, {"function_name": "decr", "code_before": "    def decr(self, key, delta=1, version=None):\n        key = self.make_key(key, version=version)\n        # memcached doesn't support a negative delta\n        if delta < 0:\n            return self._cache.incr(key, -delta)\n        try:\n            val = self._cache.decr(key, delta)\n\n        # python-memcache responds to incr on nonexistent keys by\n        # raising a ValueError, pylibmc by raising a pylibmc.NotFound\n        # and Cmemcache returns None. In all cases,\n        # we should raise a ValueError though.\n        except self.LibraryValueNotFoundException:\n            val = None\n        if val is None:\n            raise ValueError(\"Key '%s' not found\" % key)\n        return val\n", "code_after": "    def decr(self, key, delta=1, version=None):\n        key = self.make_key(key, version=version)\n        self.validate_key(key)\n        # memcached doesn't support a negative delta\n        if delta < 0:\n            return self._cache.incr(key, -delta)\n        try:\n            val = self._cache.decr(key, delta)\n\n        # python-memcache responds to incr on nonexistent keys by\n        # raising a ValueError, pylibmc by raising a pylibmc.NotFound\n        # and Cmemcache returns None. In all cases,\n        # we should raise a ValueError though.\n        except self.LibraryValueNotFoundException:\n            val = None\n        if val is None:\n            raise ValueError(\"Key '%s' not found\" % key)\n        return val\n"}, {"function_name": "delete", "code_before": "    def delete(self, key, version=None):\n        key = self.make_key(key, version=version)\n        self._cache.delete(key)\n", "code_after": "    def delete(self, key, version=None):\n        key = self.make_key(key, version=version)\n        self.validate_key(key)\n        self._cache.delete(key)\n"}, {"function_name": "add", "code_before": "    def add(self, key, value, timeout=DEFAULT_TIMEOUT, version=None):\n        key = self.make_key(key, version=version)\n        return self._cache.add(key, value, self.get_backend_timeout(timeout))\n", "code_after": "    def add(self, key, value, timeout=DEFAULT_TIMEOUT, version=None):\n        key = self.make_key(key, version=version)\n        self.validate_key(key)\n        return self._cache.add(key, value, self.get_backend_timeout(timeout))\n"}], "gpt_answer": "The vulnerability described in the advisory is related to malformed cache keys that could result in a key collision and potential data leakage. The fix for this vulnerability involves adding key validation to prevent malformed keys from being used.\n\nLooking at the changes in the \"incr\" function, we can see that a call to `self.validate_key(key)` has been added. This is a direct response to the vulnerability, as it ensures that the key being used is valid and not malformed.\n\nThe same change has been made in other functions in the same commit, such as \"get\", \"set\", \"add\", \"delete\", \"decr\", and \"set_many\". This indicates that the change in the \"incr\" function is part of a larger effort to ensure key validation across all relevant functions, and not an isolated change.\n\nTherefore, the \"incr\" function is vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_many", "code_before": "    def get_many(self, keys, version=None):\n        key_map = {self.make_key(key, version=version): key for key in keys}\n        ret = self._cache.get_multi(key_map.keys())\n        return {key_map[k]: v for k, v in ret.items()}\n", "code_after": "    def get_many(self, keys, version=None):\n        key_map = {self.make_key(key, version=version): key for key in keys}\n        for key in key_map:\n            self.validate_key(key)\n        ret = self._cache.get_multi(key_map.keys())\n        return {key_map[k]: v for k, v in ret.items()}\n", "commit_message": "[2.2.x] Fixed CVE-2020-13254 -- Enforced cache key validation in memcached backends.", "commit": "https://github.com/django/django/commit/07e59caa02831c4569bbebb9eb773bdd9cb4b206", "description": "An issue was discovered in Django version 2.2 before 2.2.13 and 3.0 before 3.0.7. In cases where a memcached backend does not perform key validation, passing malformed cache keys could result in a key collision, and potential data leakage.", "file_change_id": 43091709783067, "report_link": "https://github.com/advisories/GHSA-wpjr-j57x-wxfw", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "incr", "code_before": "    def incr(self, key, delta=1, version=None):\n        key = self.make_key(key, version=version)\n        # memcached doesn't support a negative delta\n        if delta < 0:\n            return self._cache.decr(key, -delta)\n        try:\n            val = self._cache.incr(key, delta)\n\n        # python-memcache responds to incr on nonexistent keys by\n        # raising a ValueError, pylibmc by raising a pylibmc.NotFound\n        # and Cmemcache returns None. In all cases,\n        # we should raise a ValueError though.\n        except self.LibraryValueNotFoundException:\n            val = None\n        if val is None:\n            raise ValueError(\"Key '%s' not found\" % key)\n        return val\n", "code_after": "    def incr(self, key, delta=1, version=None):\n        key = self.make_key(key, version=version)\n        self.validate_key(key)\n        # memcached doesn't support a negative delta\n        if delta < 0:\n            return self._cache.decr(key, -delta)\n        try:\n            val = self._cache.incr(key, delta)\n\n        # python-memcache responds to incr on nonexistent keys by\n        # raising a ValueError, pylibmc by raising a pylibmc.NotFound\n        # and Cmemcache returns None. In all cases,\n        # we should raise a ValueError though.\n        except self.LibraryValueNotFoundException:\n            val = None\n        if val is None:\n            raise ValueError(\"Key '%s' not found\" % key)\n        return val\n"}, {"function_name": "get", "code_before": "    def get(self, key, default=None, version=None):\n        key = self.make_key(key, version=version)\n        val = self._cache.get(key)\n        if val is None:\n            return default\n        return val\n", "code_after": "    def get(self, key, default=None, version=None):\n        key = self.make_key(key, version=version)\n        self.validate_key(key)\n        val = self._cache.get(key)\n        if val is None:\n            return default\n        return val\n"}, {"function_name": "set_many", "code_before": "    def set_many(self, data, timeout=DEFAULT_TIMEOUT, version=None):\n        safe_data = {}\n        original_keys = {}\n        for key, value in data.items():\n            safe_key = self.make_key(key, version=version)\n            safe_data[safe_key] = value\n            original_keys[safe_key] = key\n        failed_keys = self._cache.set_multi(safe_data, self.get_backend_timeout(timeout))\n        return [original_keys[k] for k in failed_keys]\n", "code_after": "    def set_many(self, data, timeout=DEFAULT_TIMEOUT, version=None):\n        safe_data = {}\n        original_keys = {}\n        for key, value in data.items():\n            safe_key = self.make_key(key, version=version)\n            self.validate_key(safe_key)\n            safe_data[safe_key] = value\n            original_keys[safe_key] = key\n        failed_keys = self._cache.set_multi(safe_data, self.get_backend_timeout(timeout))\n        return [original_keys[k] for k in failed_keys]\n"}, {"function_name": "set", "code_before": "    def set(self, key, value, timeout=DEFAULT_TIMEOUT, version=None):\n        key = self.make_key(key, version=version)\n        if not self._cache.set(key, value, self.get_backend_timeout(timeout)):\n            # make sure the key doesn't keep its old value in case of failure to set (memcached's 1MB limit)\n            self._cache.delete(key)\n", "code_after": "    def set(self, key, value, timeout=DEFAULT_TIMEOUT, version=None):\n        key = self.make_key(key, version=version)\n        self.validate_key(key)\n        if not self._cache.set(key, value, self.get_backend_timeout(timeout)):\n            # make sure the key doesn't keep its old value in case of failure to set (memcached's 1MB limit)\n            self._cache.delete(key)\n"}, {"function_name": "decr", "code_before": "    def decr(self, key, delta=1, version=None):\n        key = self.make_key(key, version=version)\n        # memcached doesn't support a negative delta\n        if delta < 0:\n            return self._cache.incr(key, -delta)\n        try:\n            val = self._cache.decr(key, delta)\n\n        # python-memcache responds to incr on nonexistent keys by\n        # raising a ValueError, pylibmc by raising a pylibmc.NotFound\n        # and Cmemcache returns None. In all cases,\n        # we should raise a ValueError though.\n        except self.LibraryValueNotFoundException:\n            val = None\n        if val is None:\n            raise ValueError(\"Key '%s' not found\" % key)\n        return val\n", "code_after": "    def decr(self, key, delta=1, version=None):\n        key = self.make_key(key, version=version)\n        self.validate_key(key)\n        # memcached doesn't support a negative delta\n        if delta < 0:\n            return self._cache.incr(key, -delta)\n        try:\n            val = self._cache.decr(key, delta)\n\n        # python-memcache responds to incr on nonexistent keys by\n        # raising a ValueError, pylibmc by raising a pylibmc.NotFound\n        # and Cmemcache returns None. In all cases,\n        # we should raise a ValueError though.\n        except self.LibraryValueNotFoundException:\n            val = None\n        if val is None:\n            raise ValueError(\"Key '%s' not found\" % key)\n        return val\n"}, {"function_name": "delete", "code_before": "    def delete(self, key, version=None):\n        key = self.make_key(key, version=version)\n        self._cache.delete(key)\n", "code_after": "    def delete(self, key, version=None):\n        key = self.make_key(key, version=version)\n        self.validate_key(key)\n        self._cache.delete(key)\n"}, {"function_name": "add", "code_before": "    def add(self, key, value, timeout=DEFAULT_TIMEOUT, version=None):\n        key = self.make_key(key, version=version)\n        return self._cache.add(key, value, self.get_backend_timeout(timeout))\n", "code_after": "    def add(self, key, value, timeout=DEFAULT_TIMEOUT, version=None):\n        key = self.make_key(key, version=version)\n        self.validate_key(key)\n        return self._cache.add(key, value, self.get_backend_timeout(timeout))\n"}], "gpt_answer": "The provided information indicates that the vulnerability was due to a lack of key validation in the memcached backends, which could lead to key collisions and potential data leakage. The commit message also confirms that the changes were made to enforce cache key validation in memcached backends.\n\nLooking at the changes in the \"get_many\" function, it's clear that a key validation step has been added. This change is directly related to the described vulnerability, as it introduces a validation step that was previously missing, and which was the cause of the vulnerability.\n\nTherefore, the \"get_many\" function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "paged_dropdown", "code_before": "def paged_dropdown(request):\r\n    conceptid = request.GET.get(\"conceptid\")\r\n    query = request.GET.get(\"query\", None)\r\n    query = None if query == \"\" else query\r\n    page = int(request.GET.get(\"page\", 1))\r\n    limit = 50\r\n    offset = (page - 1) * limit\r\n\r\n    results = Concept().get_child_collections_hierarchically(conceptid, offset=offset, limit=limit, query=query)\r\n    total_count = results[0][3] if len(results) > 0 else 0\r\n    data = [dict(list(zip([\"valueto\", \"depth\", \"collector\"], d))) for d in results]\r\n    data = [\r\n        dict(list(zip([\"id\", \"text\", \"conceptid\", \"language\", \"type\"], d[\"valueto\"].values())), depth=d[\"depth\"], collector=d[\"collector\"])\r\n        for d in data\r\n    ]\r\n\r\n    # This try/except block trys to find an exact match to the concept the user is searching and if found\r\n    # it will insert it into the results as the first item so that users don't have to scroll to find it.\r\n    # See: https://github.com/archesproject/arches/issues/8355\r\n    try:\r\n        if page == 1:\r\n            found = False\r\n            for i, d in enumerate(data):\r\n                if i <= 7 and d[\"text\"].lower() == query.lower():\r\n                    found = True\r\n                    break\r\n            if not found:\r\n                sql = \"\"\"\r\n                    SELECT value, valueid\r\n                    FROM \r\n                    (\r\n                        SELECT *, CASE WHEN LOWER(languageid) = '{languageid}' THEN 10\r\n                        WHEN LOWER(languageid) like '{short_languageid}%' THEN 5\r\n                        ELSE 0\r\n                        END score\r\n                        FROM values\r\n                    ) as vals\r\n                    WHERE LOWER(value)='{query}' AND score > 0\r\n                    AND valuetype in ('prefLabel')\r\n                    ORDER BY score desc limit 1\r\n                \"\"\"\r\n\r\n                languageid = get_language().lower()\r\n                sql = sql.format(query=query.lower(), languageid=languageid, short_languageid=languageid.split(\"-\")[0])\r\n                cursor = connection.cursor()\r\n                cursor.execute(sql)\r\n                rows = cursor.fetchall()\r\n\r\n                if len(rows) == 1:\r\n                    data.insert(0, {\"id\": str(rows[0][1]), \"text\": rows[0][0], \"depth\": 1, \"collector\": False})\r\n    except:\r\n        pass\r\n\r\n    return JSONResponse({\"results\": data, \"more\": offset + limit < total_count})\r\n\r", "code_after": "def paged_dropdown(request):\r\n    conceptid = request.GET.get(\"conceptid\")\r\n    query = request.GET.get(\"query\", \"\")\r\n    page = int(request.GET.get(\"page\", 1))\r\n    limit = 50\r\n    offset = (page - 1) * limit\r\n\r\n    results = Concept().get_child_collections_hierarchically(conceptid, offset=offset, limit=limit, query=query)\r\n    total_count = results[0][3] if len(results) > 0 else 0\r\n    data = [dict(list(zip([\"valueto\", \"depth\", \"collector\"], d))) for d in results]\r\n    data = [\r\n        dict(list(zip([\"id\", \"text\", \"conceptid\", \"language\", \"type\"], d[\"valueto\"].values())), depth=d[\"depth\"], collector=d[\"collector\"])\r\n        for d in data\r\n    ]\r\n\r\n    # This try/except block trys to find an exact match to the concept the user is searching and if found\r\n    # it will insert it into the results as the first item so that users don't have to scroll to find it.\r\n    # See: https://github.com/archesproject/arches/issues/8355\r\n    try:\r\n        if page == 1:\r\n            found = False\r\n            for i, d in enumerate(data):\r\n                if i <= 7 and d[\"text\"].lower() == query.lower():\r\n                    found = True\r\n                    break\r\n            if not found:\r\n                languageid = get_language().lower()\r\n                cursor = connection.cursor()\r\n                cursor.execute(\r\n                    \"\"\"\r\n                        SELECT value, valueid\r\n                        FROM\r\n                        (\r\n                            SELECT *, CASE WHEN LOWER(languageid) = %(languageid)s THEN 10\r\n                            WHEN LOWER(languageid) like %(short_languageid)s THEN 5\r\n                            ELSE 0\r\n                            END score\r\n                            FROM values\r\n                        ) as vals\r\n                        WHERE LOWER(value)=%(query)s AND score > 0\r\n                        AND valuetype in ('prefLabel')\r\n                        ORDER BY score desc limit 1\r\n                    \"\"\",\r\n                    {\"languageid\": languageid, \"short_languageid\": languageid.split(\"-\")[0] + \"%\", \"query\": query.lower()},\r\n                )\r\n                rows = cursor.fetchall()\r\n\r\n                if len(rows) == 1:\r\n                    data.insert(0, {\"id\": str(rows[0][1]), \"text\": rows[0][0], \"depth\": 1, \"collector\": False})\r\n    except:\r\n        pass\r\n\r\n    return JSONResponse({\"results\": data, \"more\": offset + limit < total_count})\r\n\r", "commit_message": "fixes #9019, #9021, #9026 in stable/7.1.1", "commit": "https://github.com/archesproject/arches/commit/7ed53e23a616edf3301d95814d9d64de5e3072a9", "description": "### Impact\nWith a carefully crafted web request, it's possible to execute certain unwanted sql statements against the database.  \nAnyone running the impacted versions (<=6.1.1, 6.2.0, >=7.0.0, <=7.1.1) should upgrade as soon as possible.\n\n### Patches\nThe problem has been patched in the following versions: [6.1.2](https://pypi.org/project/arches/6.1.2/), [6.2.1](https://pypi.org/project/arches/6.2.1/), and [7.2.0](https://pypi.org/project/arches/7.2.0/)\nUsers are strongly urged to upgrade to the most recent relevant patch.\n\n### Workarounds\nThere are no workarounds.\n\n### General References \nhttps://www.w3schools.com/sql/sql_injection.asp\nhttps://en.wikipedia.org/wiki/SQL_injection\n\n### For more information\nPost any questions to the [Arches project forum](https://community.archesproject.org/).\n", "file_change_id": 21324008709630, "report_link": "https://github.com/advisories/GHSA-gmpq-xrxj-xh8m", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"paged_dropdown\" was changed to address a SQL injection vulnerability. The vulnerability allowed for the execution of unwanted SQL statements against the database through a carefully crafted web request.\n\nIn the \"code_before\" section, the SQL query is formatted using string formatting, which can lead to SQL injection if the input is not properly sanitized. In the \"code_after\" section, the SQL query is executed using parameterized queries, which is a common way to prevent SQL injection. The parameters are passed as a dictionary to the execute function, which ensures that they are properly escaped, preventing SQL injection.\n\nTherefore, the function \"paged_dropdown\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "_convert_field_to_tz", "code_before": "    def _convert_field_to_tz(self, sql, params, tzname):\n        if tzname and settings.USE_TZ and self.connection.timezone_name != tzname:\n            return f\"CONVERT_TZ({sql}, %s, %s)\", (\n                *params,\n                self.connection.timezone_name,\n                self._prepare_tzname_delta(tzname),\n            )\n        return sql, params\n", "code_after": "", "commit_message": "Refs CVE-2022-34265 -- Unified DatabaseOperations._convert_*_to_tz() hook names.", "commit": "https://github.com/django/django/commit/5e2f4ddf2940704a26a4ac782b851989668d74db", "description": "An issue was discovered in Django 3.2 before 3.2.14 and 4.0 before 4.0.6. The `Trunc()` and `Extract()` database functions are subject to SQL injection if untrusted data is used as a kind/lookup_name value. Applications that constrain the lookup name and kind choice to a known safe list are unaffected.", "file_change_id": 243816406342049, "report_link": "https://github.com/advisories/GHSA-p64x-8rxx-wf6q", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "datetime_cast_time_sql", "code_before": "    def datetime_cast_time_sql(self, sql, params, tzname):\n        sql, params = self._convert_field_to_tz(sql, params, tzname)\n        return f\"TIME({sql})\", params\n", "code_after": "    def datetime_cast_time_sql(self, sql, params, tzname):\n        sql, params = self._convert_sql_to_tz(sql, params, tzname)\n        return f\"TIME({sql})\", params\n"}, {"function_name": "date_trunc_sql", "code_before": "    def date_trunc_sql(self, lookup_type, sql, params, tzname=None):\n        sql, params = self._convert_field_to_tz(sql, params, tzname)\n        fields = {\n            \"year\": \"%Y-01-01\",\n            \"month\": \"%Y-%m-01\",\n        }\n        if lookup_type in fields:\n            format_str = fields[lookup_type]\n            return f\"CAST(DATE_FORMAT({sql}, %s) AS DATE)\", (*params, format_str)\n        elif lookup_type == \"quarter\":\n            return (\n                f\"MAKEDATE(YEAR({sql}), 1) + \"\n                f\"INTERVAL QUARTER({sql}) QUARTER - INTERVAL 1 QUARTER\",\n                (*params, *params),\n            )\n        elif lookup_type == \"week\":\n            return f\"DATE_SUB({sql}, INTERVAL WEEKDAY({sql}) DAY)\", (*params, *params)\n        else:\n            return f\"DATE({sql})\", params\n", "code_after": "    def date_trunc_sql(self, lookup_type, sql, params, tzname=None):\n        sql, params = self._convert_sql_to_tz(sql, params, tzname)\n        fields = {\n            \"year\": \"%Y-01-01\",\n            \"month\": \"%Y-%m-01\",\n        }\n        if lookup_type in fields:\n            format_str = fields[lookup_type]\n            return f\"CAST(DATE_FORMAT({sql}, %s) AS DATE)\", (*params, format_str)\n        elif lookup_type == \"quarter\":\n            return (\n                f\"MAKEDATE(YEAR({sql}), 1) + \"\n                f\"INTERVAL QUARTER({sql}) QUARTER - INTERVAL 1 QUARTER\",\n                (*params, *params),\n            )\n        elif lookup_type == \"week\":\n            return f\"DATE_SUB({sql}, INTERVAL WEEKDAY({sql}) DAY)\", (*params, *params)\n        else:\n            return f\"DATE({sql})\", params\n"}, {"function_name": "time_trunc_sql", "code_before": "    def time_trunc_sql(self, lookup_type, sql, params, tzname=None):\n        sql, params = self._convert_field_to_tz(sql, params, tzname)\n        fields = {\n            \"hour\": \"%H:00:00\",\n            \"minute\": \"%H:%i:00\",\n            \"second\": \"%H:%i:%s\",\n        }\n        if lookup_type in fields:\n            format_str = fields[lookup_type]\n            return f\"CAST(DATE_FORMAT({sql}, %s) AS TIME)\", (*params, format_str)\n        else:\n            return f\"TIME({sql})\", params\n", "code_after": "    def time_trunc_sql(self, lookup_type, sql, params, tzname=None):\n        sql, params = self._convert_sql_to_tz(sql, params, tzname)\n        fields = {\n            \"hour\": \"%H:00:00\",\n            \"minute\": \"%H:%i:00\",\n            \"second\": \"%H:%i:%s\",\n        }\n        if lookup_type in fields:\n            format_str = fields[lookup_type]\n            return f\"CAST(DATE_FORMAT({sql}, %s) AS TIME)\", (*params, format_str)\n        else:\n            return f\"TIME({sql})\", params\n"}, {"function_name": "datetime_cast_date_sql", "code_before": "    def datetime_cast_date_sql(self, sql, params, tzname):\n        sql, params = self._convert_field_to_tz(sql, params, tzname)\n        return f\"DATE({sql})\", params\n", "code_after": "    def datetime_cast_date_sql(self, sql, params, tzname):\n        sql, params = self._convert_sql_to_tz(sql, params, tzname)\n        return f\"DATE({sql})\", params\n"}, {"function_name": "datetime_extract_sql", "code_before": "    def datetime_extract_sql(self, lookup_type, sql, params, tzname):\n        sql, params = self._convert_field_to_tz(sql, params, tzname)\n        return self.date_extract_sql(lookup_type, sql, params)\n", "code_after": "    def datetime_extract_sql(self, lookup_type, sql, params, tzname):\n        sql, params = self._convert_sql_to_tz(sql, params, tzname)\n        return self.date_extract_sql(lookup_type, sql, params)\n"}, {"function_name": "datetime_trunc_sql", "code_before": "    def datetime_trunc_sql(self, lookup_type, sql, params, tzname):\n        sql, params = self._convert_field_to_tz(sql, params, tzname)\n        fields = [\"year\", \"month\", \"day\", \"hour\", \"minute\", \"second\"]\n        format = (\"%Y-\", \"%m\", \"-%d\", \" %H:\", \"%i\", \":%s\")\n        format_def = (\"0000-\", \"01\", \"-01\", \" 00:\", \"00\", \":00\")\n        if lookup_type == \"quarter\":\n            return (\n                f\"CAST(DATE_FORMAT(MAKEDATE(YEAR({sql}), 1) + \"\n                f\"INTERVAL QUARTER({sql}) QUARTER - \"\n                f\"INTERVAL 1 QUARTER, %s) AS DATETIME)\"\n            ), (*params, *params, \"%Y-%m-01 00:00:00\")\n        if lookup_type == \"week\":\n            return (\n                f\"CAST(DATE_FORMAT(\"\n                f\"DATE_SUB({sql}, INTERVAL WEEKDAY({sql}) DAY), %s) AS DATETIME)\"\n            ), (*params, *params, \"%Y-%m-%d 00:00:00\")\n        try:\n            i = fields.index(lookup_type) + 1\n        except ValueError:\n            pass\n        else:\n            format_str = \"\".join(format[:i] + format_def[i:])\n            return f\"CAST(DATE_FORMAT({sql}, %s) AS DATETIME)\", (*params, format_str)\n        return sql, params\n", "code_after": "    def datetime_trunc_sql(self, lookup_type, sql, params, tzname):\n        sql, params = self._convert_sql_to_tz(sql, params, tzname)\n        fields = [\"year\", \"month\", \"day\", \"hour\", \"minute\", \"second\"]\n        format = (\"%Y-\", \"%m\", \"-%d\", \" %H:\", \"%i\", \":%s\")\n        format_def = (\"0000-\", \"01\", \"-01\", \" 00:\", \"00\", \":00\")\n        if lookup_type == \"quarter\":\n            return (\n                f\"CAST(DATE_FORMAT(MAKEDATE(YEAR({sql}), 1) + \"\n                f\"INTERVAL QUARTER({sql}) QUARTER - \"\n                f\"INTERVAL 1 QUARTER, %s) AS DATETIME)\"\n            ), (*params, *params, \"%Y-%m-01 00:00:00\")\n        if lookup_type == \"week\":\n            return (\n                f\"CAST(DATE_FORMAT(\"\n                f\"DATE_SUB({sql}, INTERVAL WEEKDAY({sql}) DAY), %s) AS DATETIME)\"\n            ), (*params, *params, \"%Y-%m-%d 00:00:00\")\n        try:\n            i = fields.index(lookup_type) + 1\n        except ValueError:\n            pass\n        else:\n            format_str = \"\".join(format[:i] + format_def[i:])\n            return f\"CAST(DATE_FORMAT({sql}, %s) AS DATETIME)\", (*params, format_str)\n        return sql, params\n"}], "gpt_answer": "The function `_convert_field_to_tz` was removed in the commit. The commit message indicates that the function names related to timezone conversion were unified. The vulnerability description mentions that the `Trunc()` and `Extract()` database functions are subject to SQL injection if untrusted data is used as a kind/lookup_name value.\n\nLooking at the other functions changed in the commit, it can be seen that the function `_convert_field_to_tz` was replaced by `_convert_sql_to_tz` in several places. This suggests that the function `_convert_field_to_tz` was indeed vulnerable and was replaced by a safer function as part of the fix.\n\nTherefore, the function `_convert_field_to_tz` is relevant to the vulnerability that the commit is trying to fix.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_prep_value", "code_before": "    def get_prep_value(self, value):\n        if value and ':' in value:\n            try:\n                return clean_ipv6_address(value, self.unpack_ipv4)\n            except exceptions.ValidationError:\n                pass\n        return value\n", "code_after": "    def get_prep_value(self, value):\n        value = super(FilePathField, self).get_prep_value(value)\n        if value is None:\n            return None\n        return six.text_type(value)\n", "commit_message": "[1.6.x] Fixed queries that may return unexpected results on MySQL due to typecasting.\n\nThis is a security fix. Disclosure will follow shortly.\n\nBackport of 75c0d4ea3ae48970f788c482ee0bd6b29a7f1307 from master", "commit": "https://github.com/django/django/commit/5f0829a27e85d89ad8c433f5c6a7a7d17c9e9292", "description": "The (1) FilePathField, (2) GenericIPAddressField, and (3) IPAddressField model field classes in Django before 1.4.11, 1.5.x before 1.5.6, 1.6.x before 1.6.3, and 1.7.x before 1.7 beta 2 do not properly perform type conversion, which allows remote attackers to have unspecified impact and vectors, related to \"MySQL typecasting.\"", "file_change_id": 153084396682249, "report_link": "https://github.com/advisories/GHSA-wqjj-hx84-v449", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `get_prep_value` has been changed in a commit that is intended to fix a security vulnerability. The vulnerability is related to the improper type conversion in Django's `FilePathField`, `GenericIPAddressField`, and `IPAddressField` model field classes, which could allow remote attackers to have unspecified impact and vectors, related to \"MySQL typecasting.\"\n\nIn the `get_prep_value` function, the code has been changed from handling IPv6 address cleaning to handling file path value preparation. The new code ensures that the value is properly typecast to a string, which is consistent with the description of the vulnerability.\n\nGiven that the function is part of the `FilePathField` class (as inferred from the `super(FilePathField, self).get_prep_value(value)` call), it is reasonable to conclude that the function was indeed vulnerable and has been changed to address the reported vulnerability.\n\nTherefore, the answer is 1, indicating that the function is vulnerable.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_prep_value", "code_before": "    def get_prep_value(self, value):\n        if value and ':' in value:\n            try:\n                return clean_ipv6_address(value, self.unpack_ipv4)\n            except exceptions.ValidationError:\n                pass\n        return value\n", "code_after": "    def get_prep_value(self, value):\n        value = super(FilePathField, self).get_prep_value(value)\n        if value is None:\n            return None\n        return six.text_type(value)\n", "commit_message": "[1.5.x] Fixed queries that may return unexpected results on MySQL due to typecasting.\n\nThis is a security fix. Disclosure will follow shortly.\n\nBackport of 75c0d4ea3ae48970f788c482ee0bd6b29a7f1307 from master", "commit": "https://github.com/django/django/commit/985434fb1d6bf2335bf96c6ebf91c3674f1f399f", "description": "The (1) FilePathField, (2) GenericIPAddressField, and (3) IPAddressField model field classes in Django before 1.4.11, 1.5.x before 1.5.6, 1.6.x before 1.6.3, and 1.7.x before 1.7 beta 2 do not properly perform type conversion, which allows remote attackers to have unspecified impact and vectors, related to \"MySQL typecasting.\"", "file_change_id": 257984304995779, "report_link": "https://github.com/advisories/GHSA-wqjj-hx84-v449", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `get_prep_value` was changed in a commit that was intended to fix a security vulnerability. The vulnerability description mentions that the `FilePathField`, `GenericIPAddressField`, and `IPAddressField` model field classes in Django do not properly perform type conversion, which could allow remote attackers to have unspecified impact and vectors, related to \"MySQL typecasting.\"\n\nIn the `get_prep_value` function, the code was changed from handling IPv6 address cleaning to handling file path values. This change seems to be a shift from the `GenericIPAddressField` or `IPAddressField` context to the `FilePathField` context.\n\nGiven that the function was changed as part of a commit that was intended to fix a security vulnerability, and the nature of the change aligns with the description of the vulnerability (improper type conversion), it can be inferred that the function `get_prep_value` was indeed vulnerable and was changed to address the vulnerability.\n\nTherefore, the answer is 1 (the function is vulnerable).\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_prep_value", "code_before": "    def get_prep_value(self, value):\n        if value and ':' in value:\n            try:\n                return clean_ipv6_address(value, self.unpack_ipv4)\n            except exceptions.ValidationError:\n                pass\n        return value\n", "code_after": "    def get_prep_value(self, value):\n        value = super(FilePathField, self).get_prep_value(value)\n        if value is None:\n            return None\n        return smart_unicode(value)\n", "commit_message": "[1.4.x] Fixed queries that may return unexpected results on MySQL due to typecasting.\n\nThis is a security fix. Disclosure will follow shortly.\n\nBackport of 75c0d4ea3ae48970f788c482ee0bd6b29a7f1307 from master", "commit": "https://github.com/django/django/commit/aa80f498de6d687e613860933ac58433ab71ea4b", "description": "The (1) FilePathField, (2) GenericIPAddressField, and (3) IPAddressField model field classes in Django before 1.4.11, 1.5.x before 1.5.6, 1.6.x before 1.6.3, and 1.7.x before 1.7 beta 2 do not properly perform type conversion, which allows remote attackers to have unspecified impact and vectors, related to \"MySQL typecasting.\"", "file_change_id": 62937775564035, "report_link": "https://github.com/advisories/GHSA-wqjj-hx84-v449", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `get_prep_value` has been changed in response to a security vulnerability related to improper type conversion in Django's model field classes, including `FilePathField`, `GenericIPAddressField`, and `IPAddressField`.\n\nThe `get_prep_value` function is part of Django's model field classes and is responsible for \"prepping\" a value for database insertion. In the \"before\" code, the function is checking if the value contains a colon (':'), and if so, it attempts to clean the IPv6 address. If the cleaning fails, it simply returns the original value. This could potentially allow for improper type conversion, especially if the value is not a valid IPv6 address.\n\nIn the \"after\" code, the function has been changed to call the superclass's `get_prep_value` method, which would handle the appropriate type conversion. If the value is `None`, it returns `None`. Otherwise, it converts the value to a Unicode string using the `smart_unicode` function. This change ensures that the value is always properly typecast before being inserted into the database, mitigating the reported vulnerability.\n\nTherefore, the function `get_prep_value` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "explain_query_prefix", "code_before": "    def explain_query_prefix(self, format=None, **options):\n        prefix = super().explain_query_prefix(format)\n        extra = {}\n        if format:\n            extra[\"FORMAT\"] = format\n        if options:\n            extra.update(\n                {\n                    name.upper(): \"true\" if value else \"false\"\n                    for name, value in options.items()\n                }\n            )\n        if extra:\n            prefix += \" (%s)\" % \", \".join(\"%s %s\" % i for i in extra.items())\n        return prefix\n", "code_after": "    def explain_query_prefix(self, format=None, **options):\n        extra = {}\n        # Normalize options.\n        if options:\n            options = {\n                name.upper(): \"true\" if value else \"false\"\n                for name, value in options.items()\n            }\n            for valid_option in self.explain_options:\n                value = options.pop(valid_option, None)\n                if value is not None:\n                    extra[valid_option.upper()] = value\n        prefix = super().explain_query_prefix(format, **options)\n        if format:\n            extra[\"FORMAT\"] = format\n        if extra:\n            prefix += \" (%s)\" % \", \".join(\"%s %s\" % i for i in extra.items())\n        return prefix\n", "commit_message": "Fixed CVE-2022-28347 -- Protected QuerySet.explain(**options) against SQL injection on PostgreSQL.", "commit": "https://github.com/django/django/commit/6723a26e59b0b5429a0c5873941e01a2e1bdbb81", "description": "A SQL injection issue was discovered in `QuerySet.explain()` in Django 2.2 before 2.2.28, 3.2 before 3.2.13, and 4.0 before 4.0.4. This occurs by passing a crafted dictionary (with dictionary expansion) as the `**options` argument, and placing the injection payload in an option name.", "file_change_id": 32476282380804, "report_link": "https://github.com/advisories/GHSA-w24h-v9qh-8gxj", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `explain_query_prefix` was changed to fix a SQL injection vulnerability. The vulnerability was discovered in `QuerySet.explain()`, where passing a crafted dictionary as the `**options` argument and placing the injection payload in an option name could lead to SQL injection.\n\nIn the `code_before` snippet, the function accepts any options and directly includes them in the SQL query prefix. This is where the SQL injection vulnerability arises.\n\nIn the `code_after` snippet, the function has been modified to only accept valid options from `self.explain_options`. This change prevents the inclusion of potentially harmful options in the SQL query prefix, thereby mitigating the SQL injection vulnerability.\n\nTherefore, the function `explain_query_prefix` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "explain", "code_before": "    def explain(self, using, format=None, **options):\n        q = self.clone()\n        q.explain_info = ExplainInfo(format, options)\n        compiler = q.get_compiler(using=using)\n        return \"\\n\".join(compiler.explain_query())\n", "code_after": "    def explain(self, using, format=None, **options):\n        q = self.clone()\n        for option_name in options:\n            if (\n                not EXPLAIN_OPTIONS_PATTERN.fullmatch(option_name)\n                or \"--\" in option_name\n            ):\n                raise ValueError(f\"Invalid option name: {option_name!r}.\")\n        q.explain_info = ExplainInfo(format, options)\n        compiler = q.get_compiler(using=using)\n        return \"\\n\".join(compiler.explain_query())\n", "commit_message": "Fixed CVE-2022-28347 -- Protected QuerySet.explain(**options) against SQL injection on PostgreSQL.", "commit": "https://github.com/django/django/commit/6723a26e59b0b5429a0c5873941e01a2e1bdbb81", "description": "A SQL injection issue was discovered in `QuerySet.explain()` in Django 2.2 before 2.2.28, 3.2 before 3.2.13, and 4.0 before 4.0.4. This occurs by passing a crafted dictionary (with dictionary expansion) as the `**options` argument, and placing the injection payload in an option name.", "file_change_id": 260997237107136, "report_link": "https://github.com/advisories/GHSA-w24h-v9qh-8gxj", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"explain\" was indeed vulnerable to SQL injection attacks. The vulnerability was due to the lack of validation on the `**options` argument, which allowed for a crafted dictionary to be passed, leading to SQL injection.\n\nIn the \"code_after\" section, we can see that a validation check has been added to the function to ensure that the option names match a certain pattern and do not contain \"--\". This change directly addresses the described vulnerability by adding a protection measure against ill-formed option names that could potentially be utilized for SQL injection.\n\nTherefore, the function \"explain\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "explain_query_prefix", "code_before": "    def explain_query_prefix(self, format=None, **options):\n        prefix = super().explain_query_prefix(format)\n        extra = {}\n        if format:\n            extra[\"FORMAT\"] = format\n        if options:\n            extra.update(\n                {\n                    name.upper(): \"true\" if value else \"false\"\n                    for name, value in options.items()\n                }\n            )\n        if extra:\n            prefix += \" (%s)\" % \", \".join(\"%s %s\" % i for i in extra.items())\n        return prefix\n", "code_after": "    def explain_query_prefix(self, format=None, **options):\n        extra = {}\n        # Normalize options.\n        if options:\n            options = {\n                name.upper(): \"true\" if value else \"false\"\n                for name, value in options.items()\n            }\n            for valid_option in self.explain_options:\n                value = options.pop(valid_option, None)\n                if value is not None:\n                    extra[valid_option.upper()] = value\n        prefix = super().explain_query_prefix(format, **options)\n        if format:\n            extra[\"FORMAT\"] = format\n        if extra:\n            prefix += \" (%s)\" % \", \".join(\"%s %s\" % i for i in extra.items())\n        return prefix\n", "commit_message": "[4.0.x] Fixed CVE-2022-28347 -- Protected QuerySet.explain(**options) against SQL injection on PostgreSQL.\n\nBackport of 6723a26e59b0b5429a0c5873941e01a2e1bdbb81 from main.", "commit": "https://github.com/django/django/commit/00b0fc50e1738c7174c495464a5ef069408a4402", "description": "A SQL injection issue was discovered in `QuerySet.explain()` in Django 2.2 before 2.2.28, 3.2 before 3.2.13, and 4.0 before 4.0.4. This occurs by passing a crafted dictionary (with dictionary expansion) as the `**options` argument, and placing the injection payload in an option name.", "file_change_id": 145057006003277, "report_link": "https://github.com/advisories/GHSA-w24h-v9qh-8gxj", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `explain_query_prefix` was changed to fix a SQL injection vulnerability. The vulnerability was discovered in `QuerySet.explain()`, where passing a crafted dictionary as the `**options` argument and placing the injection payload in an option name could lead to SQL injection.\n\nIn the updated code, the function now includes a normalization step for options, where it checks each option against a list of valid options (`self.explain_options`). Only valid options are added to the `extra` dictionary. This change prevents the injection of malicious SQL code via the `**options` argument, as only recognized options are now allowed.\n\nTherefore, the function `explain_query_prefix` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "explain", "code_before": "    def explain(self, using, format=None, **options):\n        q = self.clone()\n        q.explain_info = ExplainInfo(format, options)\n        compiler = q.get_compiler(using=using)\n        return \"\\n\".join(compiler.explain_query())\n", "code_after": "    def explain(self, using, format=None, **options):\n        q = self.clone()\n        for option_name in options:\n            if (\n                not EXPLAIN_OPTIONS_PATTERN.fullmatch(option_name)\n                or \"--\" in option_name\n            ):\n                raise ValueError(f\"Invalid option name: {option_name!r}.\")\n        q.explain_info = ExplainInfo(format, options)\n        compiler = q.get_compiler(using=using)\n        return \"\\n\".join(compiler.explain_query())\n", "commit_message": "[4.0.x] Fixed CVE-2022-28347 -- Protected QuerySet.explain(**options) against SQL injection on PostgreSQL.\n\nBackport of 6723a26e59b0b5429a0c5873941e01a2e1bdbb81 from main.", "commit": "https://github.com/django/django/commit/00b0fc50e1738c7174c495464a5ef069408a4402", "description": "A SQL injection issue was discovered in `QuerySet.explain()` in Django 2.2 before 2.2.28, 3.2 before 3.2.13, and 4.0 before 4.0.4. This occurs by passing a crafted dictionary (with dictionary expansion) as the `**options` argument, and placing the injection payload in an option name.", "file_change_id": 129818366594422, "report_link": "https://github.com/advisories/GHSA-w24h-v9qh-8gxj", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"explain\" was indeed vulnerable to SQL injection attacks. The vulnerability was due to the fact that a crafted dictionary could be passed as the `**options` argument, with the injection payload placed in an option name.\n\nIn the \"code_after\" section, we can see that a new block of code has been added to check the validity of the option names. If an option name does not match the pattern defined by `EXPLAIN_OPTIONS_PATTERN` or contains \"--\", a ValueError is raised. This change is directly addressing the described vulnerability by adding a validation step for option names, thus preventing the SQL injection attack.\n\nTherefore, the function \"explain\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "explain_query_prefix", "code_before": "    def explain_query_prefix(self, format=None, **options):\n        prefix = super().explain_query_prefix(format)\n        extra = {}\n        if format:\n            extra['FORMAT'] = format\n        if options:\n            extra.update({\n                name.upper(): 'true' if value else 'false'\n                for name, value in options.items()\n            })\n        if extra:\n            prefix += ' (%s)' % ', '.join('%s %s' % i for i in extra.items())\n        return prefix\n", "code_after": "    def explain_query_prefix(self, format=None, **options):\n        extra = {}\n        # Normalize options.\n        if options:\n            options = {\n                name.upper(): 'true' if value else 'false'\n                for name, value in options.items()\n            }\n            for valid_option in self.explain_options:\n                value = options.pop(valid_option, None)\n                if value is not None:\n                    extra[valid_option.upper()] = value\n        prefix = super().explain_query_prefix(format, **options)\n        if format:\n            extra['FORMAT'] = format\n        if extra:\n            prefix += ' (%s)' % ', '.join('%s %s' % i for i in extra.items())\n        return prefix\n", "commit_message": "[2.2.x] Fixed CVE-2022-28347 -- Protected QuerySet.explain(**options) against SQL injection on PostgreSQL.\n\nBackport of 6723a26e59b0b5429a0c5873941e01a2e1bdbb81 from main.", "commit": "https://github.com/django/django/commit/29a6c98b4c13af82064f993f0acc6e8fafa4d3f5", "description": "A SQL injection issue was discovered in `QuerySet.explain()` in Django 2.2 before 2.2.28, 3.2 before 3.2.13, and 4.0 before 4.0.4. This occurs by passing a crafted dictionary (with dictionary expansion) as the `**options` argument, and placing the injection payload in an option name.", "file_change_id": 219745544080092, "report_link": "https://github.com/advisories/GHSA-w24h-v9qh-8gxj", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `explain_query_prefix` was indeed vulnerable to a SQL injection attack. The vulnerability was due to the way the function handled the `**options` argument, which could be exploited by passing a crafted dictionary.\n\nIn the updated code, the function has been modified to normalize the options and only allow valid options from `self.explain_options`. This change prevents the possibility of SQL injection by ensuring that only valid options are processed.\n\nTherefore, the function `explain_query_prefix` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "explain", "code_before": "    def explain(self, using, format=None, **options):\n        q = self.clone()\n        q.explain_query = True\n        q.explain_format = format\n        q.explain_options = options\n        compiler = q.get_compiler(using=using)\n        return '\\n'.join(compiler.explain_query())\n", "code_after": "    def explain(self, using, format=None, **options):\n        q = self.clone()\n        for option_name in options:\n            if (\n                not EXPLAIN_OPTIONS_PATTERN.fullmatch(option_name) or\n                \"--\" in option_name\n            ):\n                raise ValueError(\"Invalid option name: '%s'.\" % option_name)\n        q.explain_query = True\n        q.explain_format = format\n        q.explain_options = options\n        compiler = q.get_compiler(using=using)\n        return '\\n'.join(compiler.explain_query())\n", "commit_message": "[2.2.x] Fixed CVE-2022-28347 -- Protected QuerySet.explain(**options) against SQL injection on PostgreSQL.\n\nBackport of 6723a26e59b0b5429a0c5873941e01a2e1bdbb81 from main.", "commit": "https://github.com/django/django/commit/29a6c98b4c13af82064f993f0acc6e8fafa4d3f5", "description": "A SQL injection issue was discovered in `QuerySet.explain()` in Django 2.2 before 2.2.28, 3.2 before 3.2.13, and 4.0 before 4.0.4. This occurs by passing a crafted dictionary (with dictionary expansion) as the `**options` argument, and placing the injection payload in an option name.", "file_change_id": 45664820667904, "report_link": "https://github.com/advisories/GHSA-w24h-v9qh-8gxj", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"explain\" was indeed vulnerable to a SQL injection attack. The vulnerability was due to the lack of validation on the option names passed to the function. \n\nIn the \"code_after\" section, we can see that a validation check has been added to ensure that the option names match a certain pattern and do not contain \"--\". This change directly addresses the described vulnerability, which was the ability to pass a crafted dictionary as the `**options` argument and place the injection payload in an option name.\n\nTherefore, the function \"explain\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "explain", "code_before": "    def explain(self, using, format=None, **options):\n        q = self.clone()\n        q.explain_query = True\n        q.explain_format = format\n        q.explain_options = options\n        compiler = q.get_compiler(using=using)\n        return '\\n'.join(compiler.explain_query())\n", "code_after": "    def explain(self, using, format=None, **options):\n        q = self.clone()\n        for option_name in options:\n            if (\n                not EXPLAIN_OPTIONS_PATTERN.fullmatch(option_name) or\n                \"--\" in option_name\n            ):\n                raise ValueError(f\"Invalid option name: {option_name!r}.\")\n        q.explain_query = True\n        q.explain_format = format\n        q.explain_options = options\n        compiler = q.get_compiler(using=using)\n        return '\\n'.join(compiler.explain_query())\n", "commit_message": "[3.2.x] Fixed CVE-2022-28347 -- Protected QuerySet.explain(**options) against SQL injection on PostgreSQL.\n\nBackport of 6723a26e59b0b5429a0c5873941e01a2e1bdbb81 from main.", "commit": "https://github.com/django/django/commit/9e19accb6e0a00ba77d5a95a91675bf18877c72d", "description": "A SQL injection issue was discovered in `QuerySet.explain()` in Django 2.2 before 2.2.28, 3.2 before 3.2.13, and 4.0 before 4.0.4. This occurs by passing a crafted dictionary (with dictionary expansion) as the `**options` argument, and placing the injection payload in an option name.", "file_change_id": 215467495125765, "report_link": "https://github.com/advisories/GHSA-w24h-v9qh-8gxj", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"explain\" was indeed vulnerable to SQL injection attacks. The vulnerability was due to the lack of validation on the `**options` argument, which allowed for a crafted dictionary to be passed, leading to SQL injection.\n\nIn the \"code_after\" section, we can see that a validation step has been added to check the option names against a pattern and to ensure they do not contain \"--\". This change directly addresses the described vulnerability by adding a protection measure against ill-formed option names that could potentially be utilized for SQL injection.\n\nTherefore, the function \"explain\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "add_ordering", "code_before": "    def add_ordering(self, *ordering):\n        \"\"\"\n        Add items from the 'ordering' sequence to the query's \"order by\"\n        clause. These items are either field names (not column names) --\n        possibly with a direction prefix ('-' or '?') -- or OrderBy\n        expressions.\n\n        If 'ordering' is empty, clear all ordering from the query.\n        \"\"\"\n        errors = []\n        for item in ordering:\n            if isinstance(item, str):\n                if '.' in item:\n                    warnings.warn(\n                        'Passing column raw column aliases to order_by() is '\n                        'deprecated. Wrap %r in a RawSQL expression before '\n                        'passing it to order_by().' % item,\n                        category=RemovedInDjango40Warning,\n                        stacklevel=3,\n                    )\n                    continue\n                if item == '?':\n                    continue\n                if item.startswith('-'):\n                    item = item[1:]\n                if item in self.annotations:\n                    continue\n                if self.extra and item in self.extra:\n                    continue\n                # names_to_path() validates the lookup. A descriptive\n                # FieldError will be raise if it's not.\n                self.names_to_path(item.split(LOOKUP_SEP), self.model._meta)\n            elif not hasattr(item, 'resolve_expression'):\n                errors.append(item)\n            if getattr(item, 'contains_aggregate', False):\n                raise FieldError(\n                    'Using an aggregate in order_by() without also including '\n                    'it in annotate() is not allowed: %s' % item\n                )\n        if errors:\n            raise FieldError('Invalid order_by arguments: %s' % errors)\n        if ordering:\n            self.order_by += ordering\n        else:\n            self.default_ordering = False\n", "code_after": "    def add_ordering(self, *ordering):\n        \"\"\"\n        Add items from the 'ordering' sequence to the query's \"order by\"\n        clause. These items are either field names (not column names) --\n        possibly with a direction prefix ('-' or '?') -- or OrderBy\n        expressions.\n\n        If 'ordering' is empty, clear all ordering from the query.\n        \"\"\"\n        errors = []\n        for item in ordering:\n            if isinstance(item, str):\n                if '.' in item and ORDER_PATTERN.match(item):\n                    warnings.warn(\n                        'Passing column raw column aliases to order_by() is '\n                        'deprecated. Wrap %r in a RawSQL expression before '\n                        'passing it to order_by().' % item,\n                        category=RemovedInDjango40Warning,\n                        stacklevel=3,\n                    )\n                    continue\n                if item == '?':\n                    continue\n                if item.startswith('-'):\n                    item = item[1:]\n                if item in self.annotations:\n                    continue\n                if self.extra and item in self.extra:\n                    continue\n                # names_to_path() validates the lookup. A descriptive\n                # FieldError will be raise if it's not.\n                self.names_to_path(item.split(LOOKUP_SEP), self.model._meta)\n            elif not hasattr(item, 'resolve_expression'):\n                errors.append(item)\n            if getattr(item, 'contains_aggregate', False):\n                raise FieldError(\n                    'Using an aggregate in order_by() without also including '\n                    'it in annotate() is not allowed: %s' % item\n                )\n        if errors:\n            raise FieldError('Invalid order_by arguments: %s' % errors)\n        if ordering:\n            self.order_by += ordering\n        else:\n            self.default_ordering = False\n", "commit_message": "[3.1.x] Fixed CVE-2021-35042 -- Prevented SQL injection in QuerySet.order_by().\n\nRegression introduced in 513948735b799239f3ef8c89397592445e1a0cd5\nby marking the raw SQL column reference feature for deprecation in\nDjango 4.0 while lifting the column format validation.\n\nIn retrospective the validation should have been kept around and the\nuser should have been pointed at using RawSQL expressions during the\ndeprecation period.\n\nThe main branch is not affected because the raw SQL column reference\nsupport has been removed in 06eec3197009b88e3a633128bbcbd76eea0b46ff\nper the 4.0 deprecation life cycle.\n\nThanks Joel Saunders for the report.", "commit": "https://github.com/django/django/commit/0bd57a879a0d54920bb9038a732645fb917040e9", "description": "Django 3.1.x before 3.1.13 and 3.2.x before 3.2.5 allows QuerySet.order_by SQL injection if order_by is untrusted input from a client of a web application.", "file_change_id": 121582880154984, "report_link": "https://github.com/advisories/GHSA-xpfp-f569-q3p2", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The function `add_ordering` is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability is described as a SQL injection vulnerability in `QuerySet.order_by` if `order_by` is untrusted input from a client of a web application.\n\nThe change in the function `add_ordering` is specifically in the condition that checks if a period ('.') is in the item. In the 'before' code, it simply checks if a period is in the item, while in the 'after' code, it checks if a period is in the item and if the item matches the `ORDER_PATTERN`. This change is likely to add an extra layer of validation to prevent SQL injection attacks.\n\nTherefore, the function `add_ordering` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "add_ordering", "code_before": "    def add_ordering(self, *ordering):\n        \"\"\"\n        Add items from the 'ordering' sequence to the query's \"order by\"\n        clause. These items are either field names (not column names) --\n        possibly with a direction prefix ('-' or '?') -- or OrderBy\n        expressions.\n\n        If 'ordering' is empty, clear all ordering from the query.\n        \"\"\"\n        errors = []\n        for item in ordering:\n            if isinstance(item, str):\n                if '.' in item:\n                    warnings.warn(\n                        'Passing column raw column aliases to order_by() is '\n                        'deprecated. Wrap %r in a RawSQL expression before '\n                        'passing it to order_by().' % item,\n                        category=RemovedInDjango40Warning,\n                        stacklevel=3,\n                    )\n                    continue\n                if item == '?':\n                    continue\n                if item.startswith('-'):\n                    item = item[1:]\n                if item in self.annotations:\n                    continue\n                if self.extra and item in self.extra:\n                    continue\n                # names_to_path() validates the lookup. A descriptive\n                # FieldError will be raise if it's not.\n                self.names_to_path(item.split(LOOKUP_SEP), self.model._meta)\n            elif not hasattr(item, 'resolve_expression'):\n                errors.append(item)\n            if getattr(item, 'contains_aggregate', False):\n                raise FieldError(\n                    'Using an aggregate in order_by() without also including '\n                    'it in annotate() is not allowed: %s' % item\n                )\n        if errors:\n            raise FieldError('Invalid order_by arguments: %s' % errors)\n        if ordering:\n            self.order_by += ordering\n        else:\n            self.default_ordering = False\n", "code_after": "    def add_ordering(self, *ordering):\n        \"\"\"\n        Add items from the 'ordering' sequence to the query's \"order by\"\n        clause. These items are either field names (not column names) --\n        possibly with a direction prefix ('-' or '?') -- or OrderBy\n        expressions.\n\n        If 'ordering' is empty, clear all ordering from the query.\n        \"\"\"\n        errors = []\n        for item in ordering:\n            if isinstance(item, str):\n                if '.' in item and ORDER_PATTERN.match(item):\n                    warnings.warn(\n                        'Passing column raw column aliases to order_by() is '\n                        'deprecated. Wrap %r in a RawSQL expression before '\n                        'passing it to order_by().' % item,\n                        category=RemovedInDjango40Warning,\n                        stacklevel=3,\n                    )\n                    continue\n                if item == '?':\n                    continue\n                if item.startswith('-'):\n                    item = item[1:]\n                if item in self.annotations:\n                    continue\n                if self.extra and item in self.extra:\n                    continue\n                # names_to_path() validates the lookup. A descriptive\n                # FieldError will be raise if it's not.\n                self.names_to_path(item.split(LOOKUP_SEP), self.model._meta)\n            elif not hasattr(item, 'resolve_expression'):\n                errors.append(item)\n            if getattr(item, 'contains_aggregate', False):\n                raise FieldError(\n                    'Using an aggregate in order_by() without also including '\n                    'it in annotate() is not allowed: %s' % item\n                )\n        if errors:\n            raise FieldError('Invalid order_by arguments: %s' % errors)\n        if ordering:\n            self.order_by += ordering\n        else:\n            self.default_ordering = False\n", "commit_message": "[3.2.x] Fixed CVE-2021-35042 -- Prevented SQL injection in QuerySet.order_by().\n\nRegression introduced in 513948735b799239f3ef8c89397592445e1a0cd5\nby marking the raw SQL column reference feature for deprecation in\nDjango 4.0 while lifting the column format validation.\n\nIn retrospective the validation should have been kept around and the\nuser should have been pointed at using RawSQL expressions during the\ndeprecation period.\n\nThe main branch is not affected because the raw SQL column reference\nsupport has been removed in 06eec3197009b88e3a633128bbcbd76eea0b46ff\nper the 4.0 deprecation life cycle.\n\nThanks Joel Saunders for the report.", "commit": "https://github.com/django/django/commit/a34a5f724c5d5adb2109374ba3989ebb7b11f81f", "description": "Django 3.1.x before 3.1.13 and 3.2.x before 3.2.5 allows QuerySet.order_by SQL injection if order_by is untrusted input from a client of a web application.", "file_change_id": 48903713809800, "report_link": "https://github.com/advisories/GHSA-xpfp-f569-q3p2", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `add_ordering` is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability description mentions that Django versions before 3.1.13 and 3.2.5 allow SQL injection in `QuerySet.order_by` if `order_by` is untrusted input from a client of a web application.\n\nLooking at the changes in the `add_ordering` function, we can see that the condition for issuing a warning about passing raw column aliases to `order_by()` has been modified. In the 'before' code, the warning is issued if there is a '.' in the item. In the 'after' code, the warning is issued if there is a '.' in the item and the item matches the `ORDER_PATTERN`.\n\nThis change is directly related to the SQL injection vulnerability described, as it adds an additional layer of validation to the input, thus preventing maliciously crafted input from causing an SQL injection.\n\nTherefore, the function `add_ordering` is vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "__init__", "code_before": "    def __init__(self, expression, delimiter, **extra):\n        super().__init__(expression, delimiter=delimiter, **extra)\n", "code_after": "    def __init__(self, expression, delimiter, **extra):\n        delimiter_expr = Value(str(delimiter))\n        super().__init__(expression, delimiter_expr, **extra)\n", "commit_message": "Fixed CVE-2020-7471 -- Properly escaped StringAgg(delimiter) parameter.", "commit": "https://github.com/django/django/commit/eb31d845323618d688ad429479c6dda973056136", "description": "Django 1.11 before 1.11.28, 2.2 before 2.2.10, and 3.0 before 3.0.3 allows SQL Injection if untrusted data is used as a StringAgg delimiter (e.g., in Django applications that offer downloads of data as a series of rows with a user-specified column delimiter). By passing a suitably crafted delimiter to a contrib.postgres.aggregates.StringAgg instance, it was possible to break escaping and inject malicious SQL.", "file_change_id": 10145975401224, "report_link": "https://github.com/advisories/GHSA-hmr4-m2h5-33qx", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the \"__init__\" function is being modified to address a security vulnerability. The vulnerability, as described, allows SQL Injection if untrusted data is used as a StringAgg delimiter. \n\nIn the \"code_before\" snippet, the delimiter is passed directly to the super constructor. In the \"code_after\" snippet, the delimiter is first converted to a Value object before being passed to the super constructor. This change is likely intended to ensure that the delimiter is properly escaped, preventing the SQL Injection vulnerability.\n\nGiven this, it can be concluded that the \"__init__\" function was vulnerable and has been changed to fix the vulnerability. Therefore, the answer is 1.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "__init__", "code_before": "    def __init__(self, expression, delimiter, distinct=False, **extra):\n        distinct = 'DISTINCT ' if distinct else ''\n        super(StringAgg, self).__init__(expression, delimiter=delimiter, distinct=distinct, **extra)\n", "code_after": "    def __init__(self, expression, delimiter, distinct=False, **extra):\n        distinct = 'DISTINCT ' if distinct else ''\n        delimiter_expr = Value(str(delimiter))\n        super(StringAgg, self).__init__(expression, delimiter_expr, distinct=distinct, **extra)\n", "commit_message": "[1.11.x] Fixed CVE-2020-7471 -- Properly escaped StringAgg(delimiter) parameter.", "commit": "https://github.com/django/django/commit/001b0634cd309e372edb6d7d95d083d02b8e37bd", "description": "Django 1.11 before 1.11.28, 2.2 before 2.2.10, and 3.0 before 3.0.3 allows SQL Injection if untrusted data is used as a StringAgg delimiter (e.g., in Django applications that offer downloads of data as a series of rows with a user-specified column delimiter). By passing a suitably crafted delimiter to a contrib.postgres.aggregates.StringAgg instance, it was possible to break escaping and inject malicious SQL.", "file_change_id": 146461326243878, "report_link": "https://github.com/advisories/GHSA-hmr4-m2h5-33qx", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the vulnerability allowed SQL Injection if untrusted data was used as a StringAgg delimiter. The change in the \"__init__\" function is directly related to this issue. In the \"code_after\" section, the delimiter is explicitly cast to a string using `Value(str(delimiter))` before being passed to the super constructor. This change ensures that the delimiter is properly escaped, preventing the SQL Injection vulnerability.\n\nTherefore, the \"__init__\" function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "parse_header", "code_before": "    def parse_header(self, header_plus):\n        \"\"\"\n        Parses the header_plus block of text (the headers plus the\n        first line of the request).\n        \"\"\"\n        index = header_plus.find(b\"\\n\")\n        if index >= 0:\n            first_line = header_plus[:index].rstrip()\n            header = header_plus[index + 1 :]\n        else:\n            first_line = header_plus.rstrip()\n            header = b\"\"\n\n        self.first_line = first_line  # for testing\n\n        lines = get_header_lines(header)\n\n        headers = self.headers\n        for line in lines:\n            index = line.find(b\":\")\n            if index > 0:\n                key = line[:index]\n                if b\"_\" in key:\n                    continue\n                value = line[index + 1 :].strip()\n                key1 = tostr(key.upper().replace(b\"-\", b\"_\"))\n                # If a header already exists, we append subsequent values\n                # seperated by a comma. Applications already need to handle\n                # the comma seperated values, as HTTP front ends might do\n                # the concatenation for you (behavior specified in RFC2616).\n                try:\n                    headers[key1] += tostr(b\", \" + value)\n                except KeyError:\n                    headers[key1] = tostr(value)\n            # else there's garbage in the headers?\n\n        # command, uri, version will be bytes\n        command, uri, version = crack_first_line(first_line)\n        version = tostr(version)\n        command = tostr(command)\n        self.command = command\n        self.version = version\n        (\n            self.proxy_scheme,\n            self.proxy_netloc,\n            self.path,\n            self.query,\n            self.fragment,\n        ) = split_uri(uri)\n        self.url_scheme = self.adj.url_scheme\n        connection = headers.get(\"CONNECTION\", \"\")\n\n        if version == \"1.0\":\n            if connection.lower() != \"keep-alive\":\n                self.connection_close = True\n\n        if version == \"1.1\":\n            # since the server buffers data from chunked transfers and clients\n            # never need to deal with chunked requests, downstream clients\n            # should not see the HTTP_TRANSFER_ENCODING header; we pop it\n            # here\n            te = headers.pop(\"TRANSFER_ENCODING\", \"\")\n            if te.lower() == \"chunked\":\n                self.chunked = True\n                buf = OverflowableBuffer(self.adj.inbuf_overflow)\n                self.body_rcv = ChunkedReceiver(buf)\n            expect = headers.get(\"EXPECT\", \"\").lower()\n            self.expect_continue = expect == \"100-continue\"\n            if connection.lower() == \"close\":\n                self.connection_close = True\n\n        if not self.chunked:\n            try:\n                cl = int(headers.get(\"CONTENT_LENGTH\", 0))\n            except ValueError:\n                cl = 0\n            self.content_length = cl\n            if cl > 0:\n                buf = OverflowableBuffer(self.adj.inbuf_overflow)\n                self.body_rcv = FixedStreamReceiver(cl, buf)\n", "code_after": "    def parse_header(self, header_plus):\n        \"\"\"\n        Parses the header_plus block of text (the headers plus the\n        first line of the request).\n        \"\"\"\n        index = header_plus.find(b\"\\r\\n\")\n        if index >= 0:\n            first_line = header_plus[:index].rstrip()\n            header = header_plus[index + 2 :]\n        else:\n            raise ParsingError(\"HTTP message header invalid\")\n\n        if b\"\\r\" in first_line or b\"\\n\" in first_line:\n            raise ParsingError(\"Bare CR or LF found in HTTP message\")\n\n        self.first_line = first_line  # for testing\n\n        lines = get_header_lines(header)\n\n        headers = self.headers\n        for line in lines:\n            index = line.find(b\":\")\n            if index > 0:\n                key = line[:index]\n                if b\"_\" in key:\n                    continue\n                value = line[index + 1 :].strip()\n                key1 = tostr(key.upper().replace(b\"-\", b\"_\"))\n                # If a header already exists, we append subsequent values\n                # seperated by a comma. Applications already need to handle\n                # the comma seperated values, as HTTP front ends might do\n                # the concatenation for you (behavior specified in RFC2616).\n                try:\n                    headers[key1] += tostr(b\", \" + value)\n                except KeyError:\n                    headers[key1] = tostr(value)\n            # else there's garbage in the headers?\n\n        # command, uri, version will be bytes\n        command, uri, version = crack_first_line(first_line)\n        version = tostr(version)\n        command = tostr(command)\n        self.command = command\n        self.version = version\n        (\n            self.proxy_scheme,\n            self.proxy_netloc,\n            self.path,\n            self.query,\n            self.fragment,\n        ) = split_uri(uri)\n        self.url_scheme = self.adj.url_scheme\n        connection = headers.get(\"CONNECTION\", \"\")\n\n        if version == \"1.0\":\n            if connection.lower() != \"keep-alive\":\n                self.connection_close = True\n\n        if version == \"1.1\":\n            # since the server buffers data from chunked transfers and clients\n            # never need to deal with chunked requests, downstream clients\n            # should not see the HTTP_TRANSFER_ENCODING header; we pop it\n            # here\n            te = headers.pop(\"TRANSFER_ENCODING\", \"\")\n            if te.lower() == \"chunked\":\n                self.chunked = True\n                buf = OverflowableBuffer(self.adj.inbuf_overflow)\n                self.body_rcv = ChunkedReceiver(buf)\n            expect = headers.get(\"EXPECT\", \"\").lower()\n            self.expect_continue = expect == \"100-continue\"\n            if connection.lower() == \"close\":\n                self.connection_close = True\n\n        if not self.chunked:\n            try:\n                cl = int(headers.get(\"CONTENT_LENGTH\", 0))\n            except ValueError:\n                cl = 0\n            self.content_length = cl\n            if cl > 0:\n                buf = OverflowableBuffer(self.adj.inbuf_overflow)\n                self.body_rcv = FixedStreamReceiver(cl, buf)\n", "commit_message": "Remove support for non CRLF line endings\n\nhttps://tools.ietf.org/html/rfc7230#section-3.5 says that servers MAY\nimplement their parsers to use only the LF as a delimeter between lines,\nhowever if the frontend server does NOT do the same you can potentially\nallow a single HTTP request to be treated differently by the two\nservers.\n\nThis issue can be used to cause HTTP request smuggling or HTTP desync\nwhich may lead to vulnerabilities.\n\nTo increase robustness Waitress will no longer allow bare LF for HTTP\nmessages/headers and chunked encoding and instead now enforces that the\nline endings at CRLF.", "commit": "https://github.com/Pylons/waitress/commit/8eba394ad75deaf9e5cd15b78a3d16b12e6b0eba", "description": "### Impact\n\nWaitress implemented a &amp;quot;MAY&amp;quot; part of the RFC7230 (https://tools.ietf.org/html/rfc7230#section-3.5) which states:\n\n      Although the line terminator for the start-line and header fields is\n      the sequence CRLF, a recipient MAY recognize a single LF as a line\n      terminator and ignore any preceding CR.\n\nUnfortunately if a front-end server does not parse header fields with an LF the same way as it does those with a CRLF it can lead to the front-end and the back-end server parsing the same HTTP message in two different ways. This can lead to a potential for HTTP request smuggling/splitting whereby Waitress may see two requests while the front-end server only sees a single HTTP message.\n\nExample:\n\n```\nContent-Length: 100[CRLF]\nX-Header: x[LF]Content-Length: 0[CRLF]\n```\n\nWould get treated by Waitress as if it were:\n\n```\nContent-Length: 100\nX-Header: x\nContent-Length: 0\n```\n\nThis could potentially get used by attackers to split the HTTP request and smuggle a second request in the body of the first.\n\n\n### Patches\n\nThis issue is fixed in Waitress 1.4.0. This brings a range of changes to harden Waitress against potential HTTP request confusions, and may change the behaviour of Waitress behind non-conformist proxies. \n\nWaitress no longer implements the MAY part of the specification and instead requires that all lines are terminated correctly with CRLF. If any lines are found with a bare CR or LF a 400 Bad Request is sent back to the requesting entity.\n\nThe Pylons Project recommends upgrading as soon as possible, while validating that the changes in Waitress don&amp;#39;t cause any changes in behavior.\n\n### Workarounds\n\nVarious reverse proxies may have protections against sending potentially bad HTTP requests to the backend, and or hardening against potential issues like this. If the reverse proxy doesn&amp;#39;t use HTTP/1.1 for connecting to the backend issues are also somewhat mitigated, as HTTP pipelining does not exist in HTTP/1.0 and Waitress will close the connection after every single request (unless the Keep Alive header is explicitly sent... so this is not a fool proof security method)\n\n### Issues/more security issues:\n\n* open an issue at https://github.com/Pylons/waitress/issues (if not sensitive or security related)\n* email the Pylons Security mailing list: pylons-project-security@googlegroups.com (if security related)", "file_change_id": 128480306068850, "report_link": "https://github.com/advisories/GHSA-pg36-wpm5-g57p", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "get_header_lines", "code_before": "def get_header_lines(header):\n    \"\"\"\n    Splits the header into lines, putting multi-line headers together.\n    \"\"\"\n    r = []\n    lines = header.split(b\"\\n\")\n    for line in lines:\n        if line.startswith((b\" \", b\"\\t\")):\n            if not r:\n                # https://corte.si/posts/code/pathod/pythonservers/index.html\n                raise ParsingError('Malformed header line \"%s\"' % tostr(line))\n            r[-1] += line\n        else:\n            r.append(line)\n    return r\n", "code_after": "def get_header_lines(header):\n    \"\"\"\n    Splits the header into lines, putting multi-line headers together.\n    \"\"\"\n    r = []\n    lines = header.split(b\"\\r\\n\")\n    for line in lines:\n        if b\"\\r\" in line or b\"\\n\" in line:\n            raise ParsingError('Bare CR or LF found in header line \"%s\"' % tostr(line))\n\n        if line.startswith((b\" \", b\"\\t\")):\n            if not r:\n                # https://corte.si/posts/code/pathod/pythonservers/index.html\n                raise ParsingError('Malformed header line \"%s\"' % tostr(line))\n            r[-1] += line\n        else:\n            r.append(line)\n    return r\n"}, {"function_name": "received", "code_before": "    def received(self, data):\n        \"\"\"\n        Receives the HTTP stream for one request.  Returns the number of\n        bytes consumed.  Sets the completed flag once both the header and the\n        body have been received.\n        \"\"\"\n        if self.completed:\n            return 0  # Can't consume any more.\n        datalen = len(data)\n        br = self.body_rcv\n        if br is None:\n            # In header.\n            s = self.header_plus + data\n            index = find_double_newline(s)\n            if index >= 0:\n                # Header finished.\n                header_plus = s[:index]\n                consumed = len(data) - (len(s) - index)\n                # Remove preceeding blank lines.\n                header_plus = header_plus.lstrip()\n                if not header_plus:\n                    self.empty = True\n                    self.completed = True\n                else:\n                    try:\n                        self.parse_header(header_plus)\n                    except ParsingError as e:\n                        self.error = BadRequest(e.args[0])\n                        self.completed = True\n                    else:\n                        if self.body_rcv is None:\n                            # no content-length header and not a t-e: chunked\n                            # request\n                            self.completed = True\n                        if self.content_length > 0:\n                            max_body = self.adj.max_request_body_size\n                            # we won't accept this request if the content-length\n                            # is too large\n                            if self.content_length >= max_body:\n                                self.error = RequestEntityTooLarge(\n                                    \"exceeds max_body of %s\" % max_body\n                                )\n                                self.completed = True\n                self.headers_finished = True\n                return consumed\n            else:\n                # Header not finished yet.\n                self.header_bytes_received += datalen\n                max_header = self.adj.max_request_header_size\n                if self.header_bytes_received >= max_header:\n                    # malformed header, we need to construct some request\n                    # on our own. we disregard the incoming(?) requests HTTP\n                    # version and just use 1.0. IOW someone just sent garbage\n                    # over the wire\n                    self.parse_header(b\"GET / HTTP/1.0\\n\")\n                    self.error = RequestHeaderFieldsTooLarge(\n                        \"exceeds max_header of %s\" % max_header\n                    )\n                    self.completed = True\n                self.header_plus = s\n                return datalen\n        else:\n            # In body.\n            consumed = br.received(data)\n            self.body_bytes_received += consumed\n            max_body = self.adj.max_request_body_size\n            if self.body_bytes_received >= max_body:\n                # this will only be raised during t-e: chunked requests\n                self.error = RequestEntityTooLarge(\"exceeds max_body of %s\" % max_body)\n                self.completed = True\n            elif br.error:\n                # garbage in chunked encoding input probably\n                self.error = br.error\n                self.completed = True\n            elif br.completed:\n                # The request (with the body) is ready to use.\n                self.completed = True\n                if self.chunked:\n                    # We've converted the chunked transfer encoding request\n                    # body into a normal request body, so we know its content\n                    # length; set the header here.  We already popped the\n                    # TRANSFER_ENCODING header in parse_header, so this will\n                    # appear to the client to be an entirely non-chunked HTTP\n                    # request with a valid content-length.\n                    self.headers[\"CONTENT_LENGTH\"] = str(br.__len__())\n            return consumed\n", "code_after": "    def received(self, data):\n        \"\"\"\n        Receives the HTTP stream for one request.  Returns the number of\n        bytes consumed.  Sets the completed flag once both the header and the\n        body have been received.\n        \"\"\"\n        if self.completed:\n            return 0  # Can't consume any more.\n        datalen = len(data)\n        br = self.body_rcv\n        if br is None:\n            # In header.\n            s = self.header_plus + data\n            index = find_double_newline(s)\n            if index >= 0:\n                # Header finished.\n                header_plus = s[:index]\n                consumed = len(data) - (len(s) - index)\n\n                # Remove preceeding blank lines. This is suggested by\n                # https://tools.ietf.org/html/rfc7230#section-3.5 to support\n                # clients sending an extra CR LF after another request when\n                # using HTTP pipelining\n                header_plus = header_plus.lstrip()\n\n                if not header_plus:\n                    self.empty = True\n                    self.completed = True\n                else:\n                    try:\n                        self.parse_header(header_plus)\n                    except ParsingError as e:\n                        self.error = BadRequest(e.args[0])\n                        self.completed = True\n                    else:\n                        if self.body_rcv is None:\n                            # no content-length header and not a t-e: chunked\n                            # request\n                            self.completed = True\n                        if self.content_length > 0:\n                            max_body = self.adj.max_request_body_size\n                            # we won't accept this request if the content-length\n                            # is too large\n                            if self.content_length >= max_body:\n                                self.error = RequestEntityTooLarge(\n                                    \"exceeds max_body of %s\" % max_body\n                                )\n                                self.completed = True\n                self.headers_finished = True\n                return consumed\n            else:\n                # Header not finished yet.\n                self.header_bytes_received += datalen\n                max_header = self.adj.max_request_header_size\n                if self.header_bytes_received >= max_header:\n                    # malformed header, we need to construct some request\n                    # on our own. we disregard the incoming(?) requests HTTP\n                    # version and just use 1.0. IOW someone just sent garbage\n                    # over the wire\n                    self.parse_header(b\"GET / HTTP/1.0\\n\")\n                    self.error = RequestHeaderFieldsTooLarge(\n                        \"exceeds max_header of %s\" % max_header\n                    )\n                    self.completed = True\n                self.header_plus = s\n                return datalen\n        else:\n            # In body.\n            consumed = br.received(data)\n            self.body_bytes_received += consumed\n            max_body = self.adj.max_request_body_size\n            if self.body_bytes_received >= max_body:\n                # this will only be raised during t-e: chunked requests\n                self.error = RequestEntityTooLarge(\"exceeds max_body of %s\" % max_body)\n                self.completed = True\n            elif br.error:\n                # garbage in chunked encoding input probably\n                self.error = br.error\n                self.completed = True\n            elif br.completed:\n                # The request (with the body) is ready to use.\n                self.completed = True\n                if self.chunked:\n                    # We've converted the chunked transfer encoding request\n                    # body into a normal request body, so we know its content\n                    # length; set the header here.  We already popped the\n                    # TRANSFER_ENCODING header in parse_header, so this will\n                    # appear to the client to be an entirely non-chunked HTTP\n                    # request with a valid content-length.\n                    self.headers[\"CONTENT_LENGTH\"] = str(br.__len__())\n            return consumed\n"}], "gpt_answer": "The vulnerability described in the advisory is related to the handling of HTTP requests, specifically the potential for HTTP request smuggling/splitting due to the server's handling of line terminators in HTTP headers. The advisory mentions that Waitress implemented a \"MAY\" part of the RFC7230 which allows a single LF as a line terminator, but if a front-end server does not parse header fields with an LF the same way as it does those with a CRLF, it can lead to the front-end and the back-end server parsing the same HTTP message in two different ways.\n\nLooking at the changes in the \"parse_header\" function, it's clear that the function has been modified to enforce the use of CRLF as line terminators, and to raise a ParsingError if a bare CR or LF is found in the HTTP message. This change directly addresses the vulnerability described in the advisory, by enforcing stricter parsing rules and eliminating the potential for HTTP request smuggling/splitting due to differences in how line terminators are handled.\n\nTherefore, the \"parse_header\" function is relevant to the vulnerability that the commit is trying to fix, and it was vulnerable before the changes were made.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "get_header_lines", "code_before": "def get_header_lines(header):\n    \"\"\"\n    Splits the header into lines, putting multi-line headers together.\n    \"\"\"\n    r = []\n    lines = header.split(b\"\\n\")\n    for line in lines:\n        if line.startswith((b\" \", b\"\\t\")):\n            if not r:\n                # https://corte.si/posts/code/pathod/pythonservers/index.html\n                raise ParsingError('Malformed header line \"%s\"' % tostr(line))\n            r[-1] += line\n        else:\n            r.append(line)\n    return r\n", "code_after": "def get_header_lines(header):\n    \"\"\"\n    Splits the header into lines, putting multi-line headers together.\n    \"\"\"\n    r = []\n    lines = header.split(b\"\\r\\n\")\n    for line in lines:\n        if b\"\\r\" in line or b\"\\n\" in line:\n            raise ParsingError('Bare CR or LF found in header line \"%s\"' % tostr(line))\n\n        if line.startswith((b\" \", b\"\\t\")):\n            if not r:\n                # https://corte.si/posts/code/pathod/pythonservers/index.html\n                raise ParsingError('Malformed header line \"%s\"' % tostr(line))\n            r[-1] += line\n        else:\n            r.append(line)\n    return r\n", "commit_message": "Remove support for non CRLF line endings\n\nhttps://tools.ietf.org/html/rfc7230#section-3.5 says that servers MAY\nimplement their parsers to use only the LF as a delimeter between lines,\nhowever if the frontend server does NOT do the same you can potentially\nallow a single HTTP request to be treated differently by the two\nservers.\n\nThis issue can be used to cause HTTP request smuggling or HTTP desync\nwhich may lead to vulnerabilities.\n\nTo increase robustness Waitress will no longer allow bare LF for HTTP\nmessages/headers and chunked encoding and instead now enforces that the\nline endings at CRLF.", "commit": "https://github.com/Pylons/waitress/commit/8eba394ad75deaf9e5cd15b78a3d16b12e6b0eba", "description": "### Impact\n\nWaitress implemented a &amp;quot;MAY&amp;quot; part of the RFC7230 (https://tools.ietf.org/html/rfc7230#section-3.5) which states:\n\n      Although the line terminator for the start-line and header fields is\n      the sequence CRLF, a recipient MAY recognize a single LF as a line\n      terminator and ignore any preceding CR.\n\nUnfortunately if a front-end server does not parse header fields with an LF the same way as it does those with a CRLF it can lead to the front-end and the back-end server parsing the same HTTP message in two different ways. This can lead to a potential for HTTP request smuggling/splitting whereby Waitress may see two requests while the front-end server only sees a single HTTP message.\n\nExample:\n\n```\nContent-Length: 100[CRLF]\nX-Header: x[LF]Content-Length: 0[CRLF]\n```\n\nWould get treated by Waitress as if it were:\n\n```\nContent-Length: 100\nX-Header: x\nContent-Length: 0\n```\n\nThis could potentially get used by attackers to split the HTTP request and smuggle a second request in the body of the first.\n\n\n### Patches\n\nThis issue is fixed in Waitress 1.4.0. This brings a range of changes to harden Waitress against potential HTTP request confusions, and may change the behaviour of Waitress behind non-conformist proxies. \n\nWaitress no longer implements the MAY part of the specification and instead requires that all lines are terminated correctly with CRLF. If any lines are found with a bare CR or LF a 400 Bad Request is sent back to the requesting entity.\n\nThe Pylons Project recommends upgrading as soon as possible, while validating that the changes in Waitress don&amp;#39;t cause any changes in behavior.\n\n### Workarounds\n\nVarious reverse proxies may have protections against sending potentially bad HTTP requests to the backend, and or hardening against potential issues like this. If the reverse proxy doesn&amp;#39;t use HTTP/1.1 for connecting to the backend issues are also somewhat mitigated, as HTTP pipelining does not exist in HTTP/1.0 and Waitress will close the connection after every single request (unless the Keep Alive header is explicitly sent... so this is not a fool proof security method)\n\n### Issues/more security issues:\n\n* open an issue at https://github.com/Pylons/waitress/issues (if not sensitive or security related)\n* email the Pylons Security mailing list: pylons-project-security@googlegroups.com (if security related)", "file_change_id": 128480306068850, "report_link": "https://github.com/advisories/GHSA-pg36-wpm5-g57p", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "parse_header", "code_before": "    def parse_header(self, header_plus):\n        \"\"\"\n        Parses the header_plus block of text (the headers plus the\n        first line of the request).\n        \"\"\"\n        index = header_plus.find(b\"\\n\")\n        if index >= 0:\n            first_line = header_plus[:index].rstrip()\n            header = header_plus[index + 1 :]\n        else:\n            first_line = header_plus.rstrip()\n            header = b\"\"\n\n        self.first_line = first_line  # for testing\n\n        lines = get_header_lines(header)\n\n        headers = self.headers\n        for line in lines:\n            index = line.find(b\":\")\n            if index > 0:\n                key = line[:index]\n                if b\"_\" in key:\n                    continue\n                value = line[index + 1 :].strip()\n                key1 = tostr(key.upper().replace(b\"-\", b\"_\"))\n                # If a header already exists, we append subsequent values\n                # seperated by a comma. Applications already need to handle\n                # the comma seperated values, as HTTP front ends might do\n                # the concatenation for you (behavior specified in RFC2616).\n                try:\n                    headers[key1] += tostr(b\", \" + value)\n                except KeyError:\n                    headers[key1] = tostr(value)\n            # else there's garbage in the headers?\n\n        # command, uri, version will be bytes\n        command, uri, version = crack_first_line(first_line)\n        version = tostr(version)\n        command = tostr(command)\n        self.command = command\n        self.version = version\n        (\n            self.proxy_scheme,\n            self.proxy_netloc,\n            self.path,\n            self.query,\n            self.fragment,\n        ) = split_uri(uri)\n        self.url_scheme = self.adj.url_scheme\n        connection = headers.get(\"CONNECTION\", \"\")\n\n        if version == \"1.0\":\n            if connection.lower() != \"keep-alive\":\n                self.connection_close = True\n\n        if version == \"1.1\":\n            # since the server buffers data from chunked transfers and clients\n            # never need to deal with chunked requests, downstream clients\n            # should not see the HTTP_TRANSFER_ENCODING header; we pop it\n            # here\n            te = headers.pop(\"TRANSFER_ENCODING\", \"\")\n            if te.lower() == \"chunked\":\n                self.chunked = True\n                buf = OverflowableBuffer(self.adj.inbuf_overflow)\n                self.body_rcv = ChunkedReceiver(buf)\n            expect = headers.get(\"EXPECT\", \"\").lower()\n            self.expect_continue = expect == \"100-continue\"\n            if connection.lower() == \"close\":\n                self.connection_close = True\n\n        if not self.chunked:\n            try:\n                cl = int(headers.get(\"CONTENT_LENGTH\", 0))\n            except ValueError:\n                cl = 0\n            self.content_length = cl\n            if cl > 0:\n                buf = OverflowableBuffer(self.adj.inbuf_overflow)\n                self.body_rcv = FixedStreamReceiver(cl, buf)\n", "code_after": "    def parse_header(self, header_plus):\n        \"\"\"\n        Parses the header_plus block of text (the headers plus the\n        first line of the request).\n        \"\"\"\n        index = header_plus.find(b\"\\r\\n\")\n        if index >= 0:\n            first_line = header_plus[:index].rstrip()\n            header = header_plus[index + 2 :]\n        else:\n            raise ParsingError(\"HTTP message header invalid\")\n\n        if b\"\\r\" in first_line or b\"\\n\" in first_line:\n            raise ParsingError(\"Bare CR or LF found in HTTP message\")\n\n        self.first_line = first_line  # for testing\n\n        lines = get_header_lines(header)\n\n        headers = self.headers\n        for line in lines:\n            index = line.find(b\":\")\n            if index > 0:\n                key = line[:index]\n                if b\"_\" in key:\n                    continue\n                value = line[index + 1 :].strip()\n                key1 = tostr(key.upper().replace(b\"-\", b\"_\"))\n                # If a header already exists, we append subsequent values\n                # seperated by a comma. Applications already need to handle\n                # the comma seperated values, as HTTP front ends might do\n                # the concatenation for you (behavior specified in RFC2616).\n                try:\n                    headers[key1] += tostr(b\", \" + value)\n                except KeyError:\n                    headers[key1] = tostr(value)\n            # else there's garbage in the headers?\n\n        # command, uri, version will be bytes\n        command, uri, version = crack_first_line(first_line)\n        version = tostr(version)\n        command = tostr(command)\n        self.command = command\n        self.version = version\n        (\n            self.proxy_scheme,\n            self.proxy_netloc,\n            self.path,\n            self.query,\n            self.fragment,\n        ) = split_uri(uri)\n        self.url_scheme = self.adj.url_scheme\n        connection = headers.get(\"CONNECTION\", \"\")\n\n        if version == \"1.0\":\n            if connection.lower() != \"keep-alive\":\n                self.connection_close = True\n\n        if version == \"1.1\":\n            # since the server buffers data from chunked transfers and clients\n            # never need to deal with chunked requests, downstream clients\n            # should not see the HTTP_TRANSFER_ENCODING header; we pop it\n            # here\n            te = headers.pop(\"TRANSFER_ENCODING\", \"\")\n            if te.lower() == \"chunked\":\n                self.chunked = True\n                buf = OverflowableBuffer(self.adj.inbuf_overflow)\n                self.body_rcv = ChunkedReceiver(buf)\n            expect = headers.get(\"EXPECT\", \"\").lower()\n            self.expect_continue = expect == \"100-continue\"\n            if connection.lower() == \"close\":\n                self.connection_close = True\n\n        if not self.chunked:\n            try:\n                cl = int(headers.get(\"CONTENT_LENGTH\", 0))\n            except ValueError:\n                cl = 0\n            self.content_length = cl\n            if cl > 0:\n                buf = OverflowableBuffer(self.adj.inbuf_overflow)\n                self.body_rcv = FixedStreamReceiver(cl, buf)\n"}, {"function_name": "received", "code_before": "    def received(self, data):\n        \"\"\"\n        Receives the HTTP stream for one request.  Returns the number of\n        bytes consumed.  Sets the completed flag once both the header and the\n        body have been received.\n        \"\"\"\n        if self.completed:\n            return 0  # Can't consume any more.\n        datalen = len(data)\n        br = self.body_rcv\n        if br is None:\n            # In header.\n            s = self.header_plus + data\n            index = find_double_newline(s)\n            if index >= 0:\n                # Header finished.\n                header_plus = s[:index]\n                consumed = len(data) - (len(s) - index)\n                # Remove preceeding blank lines.\n                header_plus = header_plus.lstrip()\n                if not header_plus:\n                    self.empty = True\n                    self.completed = True\n                else:\n                    try:\n                        self.parse_header(header_plus)\n                    except ParsingError as e:\n                        self.error = BadRequest(e.args[0])\n                        self.completed = True\n                    else:\n                        if self.body_rcv is None:\n                            # no content-length header and not a t-e: chunked\n                            # request\n                            self.completed = True\n                        if self.content_length > 0:\n                            max_body = self.adj.max_request_body_size\n                            # we won't accept this request if the content-length\n                            # is too large\n                            if self.content_length >= max_body:\n                                self.error = RequestEntityTooLarge(\n                                    \"exceeds max_body of %s\" % max_body\n                                )\n                                self.completed = True\n                self.headers_finished = True\n                return consumed\n            else:\n                # Header not finished yet.\n                self.header_bytes_received += datalen\n                max_header = self.adj.max_request_header_size\n                if self.header_bytes_received >= max_header:\n                    # malformed header, we need to construct some request\n                    # on our own. we disregard the incoming(?) requests HTTP\n                    # version and just use 1.0. IOW someone just sent garbage\n                    # over the wire\n                    self.parse_header(b\"GET / HTTP/1.0\\n\")\n                    self.error = RequestHeaderFieldsTooLarge(\n                        \"exceeds max_header of %s\" % max_header\n                    )\n                    self.completed = True\n                self.header_plus = s\n                return datalen\n        else:\n            # In body.\n            consumed = br.received(data)\n            self.body_bytes_received += consumed\n            max_body = self.adj.max_request_body_size\n            if self.body_bytes_received >= max_body:\n                # this will only be raised during t-e: chunked requests\n                self.error = RequestEntityTooLarge(\"exceeds max_body of %s\" % max_body)\n                self.completed = True\n            elif br.error:\n                # garbage in chunked encoding input probably\n                self.error = br.error\n                self.completed = True\n            elif br.completed:\n                # The request (with the body) is ready to use.\n                self.completed = True\n                if self.chunked:\n                    # We've converted the chunked transfer encoding request\n                    # body into a normal request body, so we know its content\n                    # length; set the header here.  We already popped the\n                    # TRANSFER_ENCODING header in parse_header, so this will\n                    # appear to the client to be an entirely non-chunked HTTP\n                    # request with a valid content-length.\n                    self.headers[\"CONTENT_LENGTH\"] = str(br.__len__())\n            return consumed\n", "code_after": "    def received(self, data):\n        \"\"\"\n        Receives the HTTP stream for one request.  Returns the number of\n        bytes consumed.  Sets the completed flag once both the header and the\n        body have been received.\n        \"\"\"\n        if self.completed:\n            return 0  # Can't consume any more.\n        datalen = len(data)\n        br = self.body_rcv\n        if br is None:\n            # In header.\n            s = self.header_plus + data\n            index = find_double_newline(s)\n            if index >= 0:\n                # Header finished.\n                header_plus = s[:index]\n                consumed = len(data) - (len(s) - index)\n\n                # Remove preceeding blank lines. This is suggested by\n                # https://tools.ietf.org/html/rfc7230#section-3.5 to support\n                # clients sending an extra CR LF after another request when\n                # using HTTP pipelining\n                header_plus = header_plus.lstrip()\n\n                if not header_plus:\n                    self.empty = True\n                    self.completed = True\n                else:\n                    try:\n                        self.parse_header(header_plus)\n                    except ParsingError as e:\n                        self.error = BadRequest(e.args[0])\n                        self.completed = True\n                    else:\n                        if self.body_rcv is None:\n                            # no content-length header and not a t-e: chunked\n                            # request\n                            self.completed = True\n                        if self.content_length > 0:\n                            max_body = self.adj.max_request_body_size\n                            # we won't accept this request if the content-length\n                            # is too large\n                            if self.content_length >= max_body:\n                                self.error = RequestEntityTooLarge(\n                                    \"exceeds max_body of %s\" % max_body\n                                )\n                                self.completed = True\n                self.headers_finished = True\n                return consumed\n            else:\n                # Header not finished yet.\n                self.header_bytes_received += datalen\n                max_header = self.adj.max_request_header_size\n                if self.header_bytes_received >= max_header:\n                    # malformed header, we need to construct some request\n                    # on our own. we disregard the incoming(?) requests HTTP\n                    # version and just use 1.0. IOW someone just sent garbage\n                    # over the wire\n                    self.parse_header(b\"GET / HTTP/1.0\\n\")\n                    self.error = RequestHeaderFieldsTooLarge(\n                        \"exceeds max_header of %s\" % max_header\n                    )\n                    self.completed = True\n                self.header_plus = s\n                return datalen\n        else:\n            # In body.\n            consumed = br.received(data)\n            self.body_bytes_received += consumed\n            max_body = self.adj.max_request_body_size\n            if self.body_bytes_received >= max_body:\n                # this will only be raised during t-e: chunked requests\n                self.error = RequestEntityTooLarge(\"exceeds max_body of %s\" % max_body)\n                self.completed = True\n            elif br.error:\n                # garbage in chunked encoding input probably\n                self.error = br.error\n                self.completed = True\n            elif br.completed:\n                # The request (with the body) is ready to use.\n                self.completed = True\n                if self.chunked:\n                    # We've converted the chunked transfer encoding request\n                    # body into a normal request body, so we know its content\n                    # length; set the header here.  We already popped the\n                    # TRANSFER_ENCODING header in parse_header, so this will\n                    # appear to the client to be an entirely non-chunked HTTP\n                    # request with a valid content-length.\n                    self.headers[\"CONTENT_LENGTH\"] = str(br.__len__())\n            return consumed\n"}], "gpt_answer": "The function \"get_header_lines\" is changed to enforce stricter line ending rules. The original function splits the header into lines using \"\\n\" as the delimiter, and the updated function uses \"\\r\\n\" as the delimiter. This change is in line with the commit message, which states that the update removes support for non-CRLF line endings to increase robustness and prevent potential vulnerabilities related to HTTP request smuggling or HTTP desync.\n\nThe vulnerability description also aligns with this change, as it mentions that the issue arises from the server treating LF and CRLF differently, leading to potential HTTP request smuggling/splitting.\n\nTherefore, the function \"get_header_lines\" appears to be directly related to the vulnerability and has been changed to fix it.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "received", "code_before": "    def received(self, data):\n        \"\"\"\n        Receives the HTTP stream for one request.  Returns the number of\n        bytes consumed.  Sets the completed flag once both the header and the\n        body have been received.\n        \"\"\"\n        if self.completed:\n            return 0  # Can't consume any more.\n        datalen = len(data)\n        br = self.body_rcv\n        if br is None:\n            # In header.\n            s = self.header_plus + data\n            index = find_double_newline(s)\n            if index >= 0:\n                # Header finished.\n                header_plus = s[:index]\n                consumed = len(data) - (len(s) - index)\n                # Remove preceeding blank lines.\n                header_plus = header_plus.lstrip()\n                if not header_plus:\n                    self.empty = True\n                    self.completed = True\n                else:\n                    try:\n                        self.parse_header(header_plus)\n                    except ParsingError as e:\n                        self.error = BadRequest(e.args[0])\n                        self.completed = True\n                    else:\n                        if self.body_rcv is None:\n                            # no content-length header and not a t-e: chunked\n                            # request\n                            self.completed = True\n                        if self.content_length > 0:\n                            max_body = self.adj.max_request_body_size\n                            # we won't accept this request if the content-length\n                            # is too large\n                            if self.content_length >= max_body:\n                                self.error = RequestEntityTooLarge(\n                                    \"exceeds max_body of %s\" % max_body\n                                )\n                                self.completed = True\n                self.headers_finished = True\n                return consumed\n            else:\n                # Header not finished yet.\n                self.header_bytes_received += datalen\n                max_header = self.adj.max_request_header_size\n                if self.header_bytes_received >= max_header:\n                    # malformed header, we need to construct some request\n                    # on our own. we disregard the incoming(?) requests HTTP\n                    # version and just use 1.0. IOW someone just sent garbage\n                    # over the wire\n                    self.parse_header(b\"GET / HTTP/1.0\\n\")\n                    self.error = RequestHeaderFieldsTooLarge(\n                        \"exceeds max_header of %s\" % max_header\n                    )\n                    self.completed = True\n                self.header_plus = s\n                return datalen\n        else:\n            # In body.\n            consumed = br.received(data)\n            self.body_bytes_received += consumed\n            max_body = self.adj.max_request_body_size\n            if self.body_bytes_received >= max_body:\n                # this will only be raised during t-e: chunked requests\n                self.error = RequestEntityTooLarge(\"exceeds max_body of %s\" % max_body)\n                self.completed = True\n            elif br.error:\n                # garbage in chunked encoding input probably\n                self.error = br.error\n                self.completed = True\n            elif br.completed:\n                # The request (with the body) is ready to use.\n                self.completed = True\n                if self.chunked:\n                    # We've converted the chunked transfer encoding request\n                    # body into a normal request body, so we know its content\n                    # length; set the header here.  We already popped the\n                    # TRANSFER_ENCODING header in parse_header, so this will\n                    # appear to the client to be an entirely non-chunked HTTP\n                    # request with a valid content-length.\n                    self.headers[\"CONTENT_LENGTH\"] = str(br.__len__())\n            return consumed\n", "code_after": "    def received(self, data):\n        \"\"\"\n        Receives the HTTP stream for one request.  Returns the number of\n        bytes consumed.  Sets the completed flag once both the header and the\n        body have been received.\n        \"\"\"\n        if self.completed:\n            return 0  # Can't consume any more.\n        datalen = len(data)\n        br = self.body_rcv\n        if br is None:\n            # In header.\n            s = self.header_plus + data\n            index = find_double_newline(s)\n            if index >= 0:\n                # Header finished.\n                header_plus = s[:index]\n                consumed = len(data) - (len(s) - index)\n\n                # Remove preceeding blank lines. This is suggested by\n                # https://tools.ietf.org/html/rfc7230#section-3.5 to support\n                # clients sending an extra CR LF after another request when\n                # using HTTP pipelining\n                header_plus = header_plus.lstrip()\n\n                if not header_plus:\n                    self.empty = True\n                    self.completed = True\n                else:\n                    try:\n                        self.parse_header(header_plus)\n                    except ParsingError as e:\n                        self.error = BadRequest(e.args[0])\n                        self.completed = True\n                    else:\n                        if self.body_rcv is None:\n                            # no content-length header and not a t-e: chunked\n                            # request\n                            self.completed = True\n                        if self.content_length > 0:\n                            max_body = self.adj.max_request_body_size\n                            # we won't accept this request if the content-length\n                            # is too large\n                            if self.content_length >= max_body:\n                                self.error = RequestEntityTooLarge(\n                                    \"exceeds max_body of %s\" % max_body\n                                )\n                                self.completed = True\n                self.headers_finished = True\n                return consumed\n            else:\n                # Header not finished yet.\n                self.header_bytes_received += datalen\n                max_header = self.adj.max_request_header_size\n                if self.header_bytes_received >= max_header:\n                    # malformed header, we need to construct some request\n                    # on our own. we disregard the incoming(?) requests HTTP\n                    # version and just use 1.0. IOW someone just sent garbage\n                    # over the wire\n                    self.parse_header(b\"GET / HTTP/1.0\\n\")\n                    self.error = RequestHeaderFieldsTooLarge(\n                        \"exceeds max_header of %s\" % max_header\n                    )\n                    self.completed = True\n                self.header_plus = s\n                return datalen\n        else:\n            # In body.\n            consumed = br.received(data)\n            self.body_bytes_received += consumed\n            max_body = self.adj.max_request_body_size\n            if self.body_bytes_received >= max_body:\n                # this will only be raised during t-e: chunked requests\n                self.error = RequestEntityTooLarge(\"exceeds max_body of %s\" % max_body)\n                self.completed = True\n            elif br.error:\n                # garbage in chunked encoding input probably\n                self.error = br.error\n                self.completed = True\n            elif br.completed:\n                # The request (with the body) is ready to use.\n                self.completed = True\n                if self.chunked:\n                    # We've converted the chunked transfer encoding request\n                    # body into a normal request body, so we know its content\n                    # length; set the header here.  We already popped the\n                    # TRANSFER_ENCODING header in parse_header, so this will\n                    # appear to the client to be an entirely non-chunked HTTP\n                    # request with a valid content-length.\n                    self.headers[\"CONTENT_LENGTH\"] = str(br.__len__())\n            return consumed\n", "commit_message": "Remove support for non CRLF line endings\n\nhttps://tools.ietf.org/html/rfc7230#section-3.5 says that servers MAY\nimplement their parsers to use only the LF as a delimeter between lines,\nhowever if the frontend server does NOT do the same you can potentially\nallow a single HTTP request to be treated differently by the two\nservers.\n\nThis issue can be used to cause HTTP request smuggling or HTTP desync\nwhich may lead to vulnerabilities.\n\nTo increase robustness Waitress will no longer allow bare LF for HTTP\nmessages/headers and chunked encoding and instead now enforces that the\nline endings at CRLF.", "commit": "https://github.com/Pylons/waitress/commit/8eba394ad75deaf9e5cd15b78a3d16b12e6b0eba", "description": "### Impact\n\nWaitress implemented a &amp;quot;MAY&amp;quot; part of the RFC7230 (https://tools.ietf.org/html/rfc7230#section-3.5) which states:\n\n      Although the line terminator for the start-line and header fields is\n      the sequence CRLF, a recipient MAY recognize a single LF as a line\n      terminator and ignore any preceding CR.\n\nUnfortunately if a front-end server does not parse header fields with an LF the same way as it does those with a CRLF it can lead to the front-end and the back-end server parsing the same HTTP message in two different ways. This can lead to a potential for HTTP request smuggling/splitting whereby Waitress may see two requests while the front-end server only sees a single HTTP message.\n\nExample:\n\n```\nContent-Length: 100[CRLF]\nX-Header: x[LF]Content-Length: 0[CRLF]\n```\n\nWould get treated by Waitress as if it were:\n\n```\nContent-Length: 100\nX-Header: x\nContent-Length: 0\n```\n\nThis could potentially get used by attackers to split the HTTP request and smuggle a second request in the body of the first.\n\n\n### Patches\n\nThis issue is fixed in Waitress 1.4.0. This brings a range of changes to harden Waitress against potential HTTP request confusions, and may change the behaviour of Waitress behind non-conformist proxies. \n\nWaitress no longer implements the MAY part of the specification and instead requires that all lines are terminated correctly with CRLF. If any lines are found with a bare CR or LF a 400 Bad Request is sent back to the requesting entity.\n\nThe Pylons Project recommends upgrading as soon as possible, while validating that the changes in Waitress don&amp;#39;t cause any changes in behavior.\n\n### Workarounds\n\nVarious reverse proxies may have protections against sending potentially bad HTTP requests to the backend, and or hardening against potential issues like this. If the reverse proxy doesn&amp;#39;t use HTTP/1.1 for connecting to the backend issues are also somewhat mitigated, as HTTP pipelining does not exist in HTTP/1.0 and Waitress will close the connection after every single request (unless the Keep Alive header is explicitly sent... so this is not a fool proof security method)\n\n### Issues/more security issues:\n\n* open an issue at https://github.com/Pylons/waitress/issues (if not sensitive or security related)\n* email the Pylons Security mailing list: pylons-project-security@googlegroups.com (if security related)", "file_change_id": 128480306068850, "report_link": "https://github.com/advisories/GHSA-pg36-wpm5-g57p", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "parse_header", "code_before": "    def parse_header(self, header_plus):\n        \"\"\"\n        Parses the header_plus block of text (the headers plus the\n        first line of the request).\n        \"\"\"\n        index = header_plus.find(b\"\\n\")\n        if index >= 0:\n            first_line = header_plus[:index].rstrip()\n            header = header_plus[index + 1 :]\n        else:\n            first_line = header_plus.rstrip()\n            header = b\"\"\n\n        self.first_line = first_line  # for testing\n\n        lines = get_header_lines(header)\n\n        headers = self.headers\n        for line in lines:\n            index = line.find(b\":\")\n            if index > 0:\n                key = line[:index]\n                if b\"_\" in key:\n                    continue\n                value = line[index + 1 :].strip()\n                key1 = tostr(key.upper().replace(b\"-\", b\"_\"))\n                # If a header already exists, we append subsequent values\n                # seperated by a comma. Applications already need to handle\n                # the comma seperated values, as HTTP front ends might do\n                # the concatenation for you (behavior specified in RFC2616).\n                try:\n                    headers[key1] += tostr(b\", \" + value)\n                except KeyError:\n                    headers[key1] = tostr(value)\n            # else there's garbage in the headers?\n\n        # command, uri, version will be bytes\n        command, uri, version = crack_first_line(first_line)\n        version = tostr(version)\n        command = tostr(command)\n        self.command = command\n        self.version = version\n        (\n            self.proxy_scheme,\n            self.proxy_netloc,\n            self.path,\n            self.query,\n            self.fragment,\n        ) = split_uri(uri)\n        self.url_scheme = self.adj.url_scheme\n        connection = headers.get(\"CONNECTION\", \"\")\n\n        if version == \"1.0\":\n            if connection.lower() != \"keep-alive\":\n                self.connection_close = True\n\n        if version == \"1.1\":\n            # since the server buffers data from chunked transfers and clients\n            # never need to deal with chunked requests, downstream clients\n            # should not see the HTTP_TRANSFER_ENCODING header; we pop it\n            # here\n            te = headers.pop(\"TRANSFER_ENCODING\", \"\")\n            if te.lower() == \"chunked\":\n                self.chunked = True\n                buf = OverflowableBuffer(self.adj.inbuf_overflow)\n                self.body_rcv = ChunkedReceiver(buf)\n            expect = headers.get(\"EXPECT\", \"\").lower()\n            self.expect_continue = expect == \"100-continue\"\n            if connection.lower() == \"close\":\n                self.connection_close = True\n\n        if not self.chunked:\n            try:\n                cl = int(headers.get(\"CONTENT_LENGTH\", 0))\n            except ValueError:\n                cl = 0\n            self.content_length = cl\n            if cl > 0:\n                buf = OverflowableBuffer(self.adj.inbuf_overflow)\n                self.body_rcv = FixedStreamReceiver(cl, buf)\n", "code_after": "    def parse_header(self, header_plus):\n        \"\"\"\n        Parses the header_plus block of text (the headers plus the\n        first line of the request).\n        \"\"\"\n        index = header_plus.find(b\"\\r\\n\")\n        if index >= 0:\n            first_line = header_plus[:index].rstrip()\n            header = header_plus[index + 2 :]\n        else:\n            raise ParsingError(\"HTTP message header invalid\")\n\n        if b\"\\r\" in first_line or b\"\\n\" in first_line:\n            raise ParsingError(\"Bare CR or LF found in HTTP message\")\n\n        self.first_line = first_line  # for testing\n\n        lines = get_header_lines(header)\n\n        headers = self.headers\n        for line in lines:\n            index = line.find(b\":\")\n            if index > 0:\n                key = line[:index]\n                if b\"_\" in key:\n                    continue\n                value = line[index + 1 :].strip()\n                key1 = tostr(key.upper().replace(b\"-\", b\"_\"))\n                # If a header already exists, we append subsequent values\n                # seperated by a comma. Applications already need to handle\n                # the comma seperated values, as HTTP front ends might do\n                # the concatenation for you (behavior specified in RFC2616).\n                try:\n                    headers[key1] += tostr(b\", \" + value)\n                except KeyError:\n                    headers[key1] = tostr(value)\n            # else there's garbage in the headers?\n\n        # command, uri, version will be bytes\n        command, uri, version = crack_first_line(first_line)\n        version = tostr(version)\n        command = tostr(command)\n        self.command = command\n        self.version = version\n        (\n            self.proxy_scheme,\n            self.proxy_netloc,\n            self.path,\n            self.query,\n            self.fragment,\n        ) = split_uri(uri)\n        self.url_scheme = self.adj.url_scheme\n        connection = headers.get(\"CONNECTION\", \"\")\n\n        if version == \"1.0\":\n            if connection.lower() != \"keep-alive\":\n                self.connection_close = True\n\n        if version == \"1.1\":\n            # since the server buffers data from chunked transfers and clients\n            # never need to deal with chunked requests, downstream clients\n            # should not see the HTTP_TRANSFER_ENCODING header; we pop it\n            # here\n            te = headers.pop(\"TRANSFER_ENCODING\", \"\")\n            if te.lower() == \"chunked\":\n                self.chunked = True\n                buf = OverflowableBuffer(self.adj.inbuf_overflow)\n                self.body_rcv = ChunkedReceiver(buf)\n            expect = headers.get(\"EXPECT\", \"\").lower()\n            self.expect_continue = expect == \"100-continue\"\n            if connection.lower() == \"close\":\n                self.connection_close = True\n\n        if not self.chunked:\n            try:\n                cl = int(headers.get(\"CONTENT_LENGTH\", 0))\n            except ValueError:\n                cl = 0\n            self.content_length = cl\n            if cl > 0:\n                buf = OverflowableBuffer(self.adj.inbuf_overflow)\n                self.body_rcv = FixedStreamReceiver(cl, buf)\n"}, {"function_name": "get_header_lines", "code_before": "def get_header_lines(header):\n    \"\"\"\n    Splits the header into lines, putting multi-line headers together.\n    \"\"\"\n    r = []\n    lines = header.split(b\"\\n\")\n    for line in lines:\n        if line.startswith((b\" \", b\"\\t\")):\n            if not r:\n                # https://corte.si/posts/code/pathod/pythonservers/index.html\n                raise ParsingError('Malformed header line \"%s\"' % tostr(line))\n            r[-1] += line\n        else:\n            r.append(line)\n    return r\n", "code_after": "def get_header_lines(header):\n    \"\"\"\n    Splits the header into lines, putting multi-line headers together.\n    \"\"\"\n    r = []\n    lines = header.split(b\"\\r\\n\")\n    for line in lines:\n        if b\"\\r\" in line or b\"\\n\" in line:\n            raise ParsingError('Bare CR or LF found in header line \"%s\"' % tostr(line))\n\n        if line.startswith((b\" \", b\"\\t\")):\n            if not r:\n                # https://corte.si/posts/code/pathod/pythonservers/index.html\n                raise ParsingError('Malformed header line \"%s\"' % tostr(line))\n            r[-1] += line\n        else:\n            r.append(line)\n    return r\n"}], "gpt_answer": "The provided information indicates that the vulnerability was related to the handling of HTTP requests, specifically the handling of line endings in HTTP messages. The vulnerability could potentially allow HTTP request smuggling or HTTP desync, which could lead to other vulnerabilities.\n\nLooking at the changes in the \"received\" function, it can be seen that the function is responsible for receiving the HTTP stream for a request. The changes in the function are related to how the HTTP headers are parsed. Specifically, the function now requires that all lines are terminated correctly with CRLF (Carriage Return and Line Feed), and if any lines are found with a bare CR or LF, a 400 Bad Request is sent back to the requesting entity.\n\nThis change directly addresses the vulnerability described in the commit message and the vulnerability description. Therefore, it can be concluded that the \"received\" function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "received", "code_before": "    def received(self, s):\n        # Returns the number of bytes consumed.\n        if self.completed:\n            return 0\n        orig_size = len(s)\n        while s:\n            rm = self.chunk_remainder\n            if rm > 0:\n                # Receive the remainder of a chunk.\n                to_write = s[:rm]\n                self.buf.append(to_write)\n                written = len(to_write)\n                s = s[written:]\n                self.chunk_remainder -= written\n            elif not self.all_chunks_received:\n                # Receive a control line.\n                s = self.control_line + s\n                pos = s.find(b\"\\n\")\n                if pos < 0:\n                    # Control line not finished.\n                    self.control_line = s\n                    s = \"\"\n                else:\n                    # Control line finished.\n                    line = s[:pos]\n                    s = s[pos + 1 :]\n                    self.control_line = b\"\"\n                    line = line.strip()\n                    if line:\n                        # Begin a new chunk.\n                        semi = line.find(b\";\")\n                        if semi >= 0:\n                            # discard extension info.\n                            line = line[:semi]\n                        try:\n                            sz = int(line.strip(), 16)  # hexadecimal\n                        except ValueError:  # garbage in input\n                            self.error = BadRequest(\"garbage in chunked encoding input\")\n                            sz = 0\n                        if sz > 0:\n                            # Start a new chunk.\n                            self.chunk_remainder = sz\n                        else:\n                            # Finished chunks.\n                            self.all_chunks_received = True\n                    # else expect a control line.\n            else:\n                # Receive the trailer.\n                trailer = self.trailer + s\n                if trailer.startswith(b\"\\r\\n\"):\n                    # No trailer.\n                    self.completed = True\n                    return orig_size - (len(trailer) - 2)\n                elif trailer.startswith(b\"\\n\"):\n                    # No trailer.\n                    self.completed = True\n                    return orig_size - (len(trailer) - 1)\n                pos = find_double_newline(trailer)\n                if pos < 0:\n                    # Trailer not finished.\n                    self.trailer = trailer\n                    s = b\"\"\n                else:\n                    # Finished the trailer.\n                    self.completed = True\n                    self.trailer = trailer[:pos]\n                    return orig_size - (len(trailer) - pos)\n        return orig_size\n", "code_after": "    def received(self, s):\n        # Returns the number of bytes consumed.\n\n        if self.completed:\n            return 0\n        orig_size = len(s)\n\n        while s:\n            rm = self.chunk_remainder\n\n            if rm > 0:\n                # Receive the remainder of a chunk.\n                to_write = s[:rm]\n                self.buf.append(to_write)\n                written = len(to_write)\n                s = s[written:]\n\n                self.chunk_remainder -= written\n\n                if self.chunk_remainder == 0:\n                    self.validate_chunk_end = True\n            elif self.validate_chunk_end:\n                pos = s.find(b\"\\r\\n\")\n\n                if pos == 0:\n                    # Chop off the terminating CR LF from the chunk\n                    s = s[2:]\n                else:\n                    self.error = BadRequest(\"Chunk not properly terminated\")\n                    self.all_chunks_received = True\n\n                # Always exit this loop\n                self.validate_chunk_end = False\n            elif not self.all_chunks_received:\n                # Receive a control line.\n                s = self.control_line + s\n                pos = s.find(b\"\\r\\n\")\n\n                if pos < 0:\n                    # Control line not finished.\n                    self.control_line = s\n                    s = \"\"\n                else:\n                    # Control line finished.\n                    line = s[:pos]\n                    s = s[pos + 2 :]\n                    self.control_line = b\"\"\n                    line = line.strip()\n\n                    if line:\n                        # Begin a new chunk.\n                        semi = line.find(b\";\")\n\n                        if semi >= 0:\n                            # discard extension info.\n                            line = line[:semi]\n                        try:\n                            sz = int(line.strip(), 16)  # hexadecimal\n                        except ValueError:  # garbage in input\n                            self.error = BadRequest(\"garbage in chunked encoding input\")\n                            sz = 0\n\n                        if sz > 0:\n                            # Start a new chunk.\n                            self.chunk_remainder = sz\n                        else:\n                            # Finished chunks.\n                            self.all_chunks_received = True\n                    # else expect a control line.\n            else:\n                # Receive the trailer.\n                trailer = self.trailer + s\n\n                if trailer.startswith(b\"\\r\\n\"):\n                    # No trailer.\n                    self.completed = True\n\n                    return orig_size - (len(trailer) - 2)\n                pos = find_double_newline(trailer)\n\n                if pos < 0:\n                    # Trailer not finished.\n                    self.trailer = trailer\n                    s = b\"\"\n                else:\n                    # Finished the trailer.\n                    self.completed = True\n                    self.trailer = trailer[:pos]\n\n                    return orig_size - (len(trailer) - pos)\n\n        return orig_size\n", "commit_message": "Remove support for non CRLF line endings\n\nhttps://tools.ietf.org/html/rfc7230#section-3.5 says that servers MAY\nimplement their parsers to use only the LF as a delimeter between lines,\nhowever if the frontend server does NOT do the same you can potentially\nallow a single HTTP request to be treated differently by the two\nservers.\n\nThis issue can be used to cause HTTP request smuggling or HTTP desync\nwhich may lead to vulnerabilities.\n\nTo increase robustness Waitress will no longer allow bare LF for HTTP\nmessages/headers and chunked encoding and instead now enforces that the\nline endings at CRLF.", "commit": "https://github.com/Pylons/waitress/commit/8eba394ad75deaf9e5cd15b78a3d16b12e6b0eba", "description": "### Impact\n\nWaitress implemented a &amp;quot;MAY&amp;quot; part of the RFC7230 (https://tools.ietf.org/html/rfc7230#section-3.5) which states:\n\n      Although the line terminator for the start-line and header fields is\n      the sequence CRLF, a recipient MAY recognize a single LF as a line\n      terminator and ignore any preceding CR.\n\nUnfortunately if a front-end server does not parse header fields with an LF the same way as it does those with a CRLF it can lead to the front-end and the back-end server parsing the same HTTP message in two different ways. This can lead to a potential for HTTP request smuggling/splitting whereby Waitress may see two requests while the front-end server only sees a single HTTP message.\n\nExample:\n\n```\nContent-Length: 100[CRLF]\nX-Header: x[LF]Content-Length: 0[CRLF]\n```\n\nWould get treated by Waitress as if it were:\n\n```\nContent-Length: 100\nX-Header: x\nContent-Length: 0\n```\n\nThis could potentially get used by attackers to split the HTTP request and smuggle a second request in the body of the first.\n\n\n### Patches\n\nThis issue is fixed in Waitress 1.4.0. This brings a range of changes to harden Waitress against potential HTTP request confusions, and may change the behaviour of Waitress behind non-conformist proxies. \n\nWaitress no longer implements the MAY part of the specification and instead requires that all lines are terminated correctly with CRLF. If any lines are found with a bare CR or LF a 400 Bad Request is sent back to the requesting entity.\n\nThe Pylons Project recommends upgrading as soon as possible, while validating that the changes in Waitress don&amp;#39;t cause any changes in behavior.\n\n### Workarounds\n\nVarious reverse proxies may have protections against sending potentially bad HTTP requests to the backend, and or hardening against potential issues like this. If the reverse proxy doesn&amp;#39;t use HTTP/1.1 for connecting to the backend issues are also somewhat mitigated, as HTTP pipelining does not exist in HTTP/1.0 and Waitress will close the connection after every single request (unless the Keep Alive header is explicitly sent... so this is not a fool proof security method)\n\n### Issues/more security issues:\n\n* open an issue at https://github.com/Pylons/waitress/issues (if not sensitive or security related)\n* email the Pylons Security mailing list: pylons-project-security@googlegroups.com (if security related)", "file_change_id": 208099899870229, "report_link": "https://github.com/advisories/GHSA-pg36-wpm5-g57p", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function \"received\" was changed to address a security vulnerability. The vulnerability was related to the handling of line terminators in HTTP messages. The original implementation allowed for a single LF as a line terminator, which could lead to HTTP request smuggling/splitting if the front-end server parsed header fields differently.\n\nThe changes in the \"received\" function include the addition of a new condition to validate the end of a chunk and the enforcement of CRLF as the line terminator. This change directly addresses the described vulnerability by ensuring that all lines are terminated correctly with CRLF. If any lines are found with a bare CR or LF, a 400 Bad Request is sent back to the requesting entity.\n\nTherefore, the function \"received\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "find_double_newline", "code_before": "def find_double_newline(s):\n    \"\"\"Returns the position just after a double newline in the given string.\"\"\"\n    pos1 = s.find(b\"\\n\\r\\n\")  # One kind of double newline\n    if pos1 >= 0:\n        pos1 += 3\n    pos2 = s.find(b\"\\n\\n\")  # Another kind of double newline\n    if pos2 >= 0:\n        pos2 += 2\n\n    if pos1 >= 0:\n        if pos2 >= 0:\n            return min(pos1, pos2)\n        else:\n            return pos1\n    else:\n        return pos2\n", "code_after": "def find_double_newline(s):\n    \"\"\"Returns the position just after a double newline in the given string.\"\"\"\n    pos = s.find(b\"\\r\\n\\r\\n\")\n\n    if pos >= 0:\n        pos += 4\n\n    return pos\n", "commit_message": "Remove support for non CRLF line endings\n\nhttps://tools.ietf.org/html/rfc7230#section-3.5 says that servers MAY\nimplement their parsers to use only the LF as a delimeter between lines,\nhowever if the frontend server does NOT do the same you can potentially\nallow a single HTTP request to be treated differently by the two\nservers.\n\nThis issue can be used to cause HTTP request smuggling or HTTP desync\nwhich may lead to vulnerabilities.\n\nTo increase robustness Waitress will no longer allow bare LF for HTTP\nmessages/headers and chunked encoding and instead now enforces that the\nline endings at CRLF.", "commit": "https://github.com/Pylons/waitress/commit/8eba394ad75deaf9e5cd15b78a3d16b12e6b0eba", "description": "### Impact\n\nWaitress implemented a &amp;quot;MAY&amp;quot; part of the RFC7230 (https://tools.ietf.org/html/rfc7230#section-3.5) which states:\n\n      Although the line terminator for the start-line and header fields is\n      the sequence CRLF, a recipient MAY recognize a single LF as a line\n      terminator and ignore any preceding CR.\n\nUnfortunately if a front-end server does not parse header fields with an LF the same way as it does those with a CRLF it can lead to the front-end and the back-end server parsing the same HTTP message in two different ways. This can lead to a potential for HTTP request smuggling/splitting whereby Waitress may see two requests while the front-end server only sees a single HTTP message.\n\nExample:\n\n```\nContent-Length: 100[CRLF]\nX-Header: x[LF]Content-Length: 0[CRLF]\n```\n\nWould get treated by Waitress as if it were:\n\n```\nContent-Length: 100\nX-Header: x\nContent-Length: 0\n```\n\nThis could potentially get used by attackers to split the HTTP request and smuggle a second request in the body of the first.\n\n\n### Patches\n\nThis issue is fixed in Waitress 1.4.0. This brings a range of changes to harden Waitress against potential HTTP request confusions, and may change the behaviour of Waitress behind non-conformist proxies. \n\nWaitress no longer implements the MAY part of the specification and instead requires that all lines are terminated correctly with CRLF. If any lines are found with a bare CR or LF a 400 Bad Request is sent back to the requesting entity.\n\nThe Pylons Project recommends upgrading as soon as possible, while validating that the changes in Waitress don&amp;#39;t cause any changes in behavior.\n\n### Workarounds\n\nVarious reverse proxies may have protections against sending potentially bad HTTP requests to the backend, and or hardening against potential issues like this. If the reverse proxy doesn&amp;#39;t use HTTP/1.1 for connecting to the backend issues are also somewhat mitigated, as HTTP pipelining does not exist in HTTP/1.0 and Waitress will close the connection after every single request (unless the Keep Alive header is explicitly sent... so this is not a fool proof security method)\n\n### Issues/more security issues:\n\n* open an issue at https://github.com/Pylons/waitress/issues (if not sensitive or security related)\n* email the Pylons Security mailing list: pylons-project-security@googlegroups.com (if security related)", "file_change_id": 88162740912305, "report_link": "https://github.com/advisories/GHSA-pg36-wpm5-g57p", "programming_language": "Python", "other_changed_function_in_the_commit": [], "gpt_answer": "The function \"find_double_newline\" is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability is related to the handling of line terminators in HTTP messages. The RFC7230 specification allows for a single LF to be recognized as a line terminator, but if a front-end server does not parse header fields with an LF the same way as it does those with a CRLF, it can lead to the front-end and the back-end server parsing the same HTTP message in two different ways. This can lead to a potential for HTTP request smuggling/splitting.\n\nThe change in the function \"find_double_newline\" is directly related to this issue. In the \"before\" code, the function was looking for two types of double newlines: \"\\n\\r\\n\" and \"\\n\\n\". In the \"after\" code, the function only looks for \"\\r\\n\\r\\n\". This change removes support for non CRLF line endings, which is exactly what the commit message says it is doing. Therefore, the function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "_get_cert_url", "code_before": "    def _get_cert_url(self):\n        \"\"\"\n        Get the signing certificate URL.\n        Only accept urls that match the domains set in the\n        AWS_SNS_EVENT_CERT_TRUSTED_DOMAINS setting. Sub-domains\n        are allowed. i.e. if amazonaws.com is in the trusted domains\n        then sns.us-east-1.amazonaws.com will match.\n        \"\"\"\n        cert_url = self._data.get(\"SigningCertURL\")\n        if not cert_url:\n            logger.warning('No signing certificate URL: \"%s\"', cert_url)\n            return None\n\n        if not cert_url.startswith(\"https://\"):\n            logger.warning('Untrusted certificate URL: \"%s\"', cert_url)\n            return None\n\n        url_obj = urlparse(cert_url)\n        for trusted_domain in settings.EVENT_CERT_DOMAINS:\n            parts = trusted_domain.split(\".\")\n            if url_obj.netloc.split(\".\")[-len(parts) :] == parts:\n                return cert_url\n\n        return None\n", "code_after": "    def _get_cert_url(self):\n        \"\"\"\n        Get the signing certificate URL.\n        Only accept urls that match the domains set in the\n        AWS_SNS_EVENT_CERT_TRUSTED_DOMAINS setting. Sub-domains\n        are allowed. i.e. if amazonaws.com is in the trusted domains\n        then sns.us-east-1.amazonaws.com will match.\n        \"\"\"\n        cert_url = self._data.get(\"SigningCertURL\")\n        if not cert_url:\n            logger.warning('No signing certificate URL: \"%s\"', cert_url)\n            return None\n\n        if not cert_url.startswith(\"https://\"):\n            logger.warning('Untrusted certificate URL: \"%s\"', cert_url)\n            return None\n\n        url_obj = urlparse(cert_url)\n        for trusted_domain in settings.EVENT_CERT_DOMAINS:\n            parts = trusted_domain.split(\".\")\n            if \"amazonaws.com\" in trusted_domain:\n                if not SES_REGEX_CERT_URL.match(cert_url):\n                    if len(parts) < 4:\n                        return None\n                    else:\n                        logger.warning('Possible security risk for: \"%s\"', cert_url)\n                        logger.warning(\n                            \"It is strongly recommended to configure the full domain in EVENT_CERT_DOMAINS. \"\n                            \"See v3.5.0 release notes for more details.\"\n                        )\n\n            if url_obj.netloc.split(\".\")[-len(parts) :] == parts:\n                return cert_url\n\n        return None\n", "commit_message": "Restrict amazonaws allowed certificate URLs.", "commit": "https://github.com/django-ses/django-ses/commit/b71b5f413293a13997b6e6314086cb9c22629795", "description": "The django_ses library implements a mail backend for Django using AWS Simple Email Service. The library exports the `SESEventWebhookView class` intended to receive signed requests from AWS to handle email bounces, subscriptions, etc. These requests are signed by AWS and are verified by django_ses, however the verification of this signature was found to be flawed as it allowed users to specify arbitrary public certificates.", "file_change_id": 140231584695511, "report_link": "https://github.com/advisories/GHSA-qg36-9jxh-fj25", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "_get_bytes_to_sign", "code_before": "    def _get_bytes_to_sign(self):\n        \"\"\"\n        Creates the message used for signing SNS notifications.\n        This is used to verify the bounce message when it is received.\n        \"\"\"\n\n        # Depending on the message type the fields to add to the message\n        # differ so we handle that here.\n        msg_type = self._data.get('Type')\n        if msg_type == 'Notification':\n            fields_to_sign = [\n                'Message',\n                'MessageId',\n                'Subject',\n                'Timestamp',\n                'TopicArn',\n                'Type',\n            ]\n        elif (msg_type == 'SubscriptionConfirmation' or\n              msg_type == 'UnsubscribeConfirmation'):\n            fields_to_sign = [\n                'Message',\n                'MessageId',\n                'SubscribeURL',\n                'Timestamp',\n                'Token',\n                'TopicArn',\n                'Type',\n            ]\n        else:\n            # Unrecognized type\n            logger.warning('Unrecognized SNS message Type: \"%s\"', msg_type)\n            return None\n\n        bytes_to_sign = []\n        for field in fields_to_sign:\n            field_value = self._data.get(field)\n            if not field_value:\n                continue\n\n            # Some notification types do not have all fields. Only add fields\n            # with values.\n            bytes_to_sign.append(f\"{field}\\n{field_value}\\n\")\n\n        return \"\".join(bytes_to_sign).encode()\n", "code_after": "    def _get_bytes_to_sign(self):\n        \"\"\"\n        Creates the message used for signing SNS notifications.\n        This is used to verify the bounce message when it is received.\n        \"\"\"\n\n        # Depending on the message type the fields to add to the message\n        # differ so we handle that here.\n        msg_type = self._data.get(\"Type\")\n        if msg_type == \"Notification\":\n            fields_to_sign = [\n                \"Message\",\n                \"MessageId\",\n                \"Subject\",\n                \"Timestamp\",\n                \"TopicArn\",\n                \"Type\",\n            ]\n        elif (\n            msg_type == \"SubscriptionConfirmation\"\n            or msg_type == \"UnsubscribeConfirmation\"\n        ):\n            fields_to_sign = [\n                \"Message\",\n                \"MessageId\",\n                \"SubscribeURL\",\n                \"Timestamp\",\n                \"Token\",\n                \"TopicArn\",\n                \"Type\",\n            ]\n        else:\n            # Unrecognized type\n            logger.warning('Unrecognized SNS message Type: \"%s\"', msg_type)\n            return None\n\n        bytes_to_sign = []\n        for field in fields_to_sign:\n            field_value = self._data.get(field)\n            if not field_value:\n                continue\n\n            # Some notification types do not have all fields. Only add fields\n            # with values.\n            bytes_to_sign.append(f\"{field}\\n{field_value}\\n\")\n\n        return \"\".join(bytes_to_sign).encode()\n"}, {"function_name": "verify_bounce_message", "code_before": "def verify_bounce_message(msg):\n    \"\"\"\n    Verify an SES/SNS bounce(event) notification message.\n    \"\"\"\n    warnings.warn(\n        'utils.verify_bounce_message is deprecated. It is renamed to verify_event_message.',\n        RemovedInDjangoSES20Warning,\n    )\n    return verify_event_message(msg)\n", "code_after": "def verify_bounce_message(msg):\n    \"\"\"\n    Verify an SES/SNS bounce(event) notification message.\n    \"\"\"\n    warnings.warn(\n        \"utils.verify_bounce_message is deprecated. It is renamed to verify_event_message.\",\n        RemovedInDjangoSES20Warning,\n    )\n    return verify_event_message(msg)\n"}, {"function_name": "confirm_sns_subscription", "code_before": "def confirm_sns_subscription(notification):\n    logger.info(\n        'Received subscription confirmation: TopicArn: %s',\n        notification.get('TopicArn'),\n        extra={\n            'notification': notification,\n        },\n    )\n\n    # Get the subscribe url and hit the url to confirm the subscription.\n    subscribe_url = notification.get('SubscribeURL')\n    try:\n        urlopen(subscribe_url).read()\n    except URLError as e:\n        # Some kind of error occurred when confirming the request.\n        logger.error(\n            'Could not confirm subscription: \"%s\"', e,\n            extra={\n                'notification': notification,\n            },\n            exc_info=True,\n        )\n", "code_after": "def confirm_sns_subscription(notification):\n    logger.info(\n        \"Received subscription confirmation: TopicArn: %s\",\n        notification.get(\"TopicArn\"),\n        extra={\n            \"notification\": notification,\n        },\n    )\n\n    # Get the subscribe url and hit the url to confirm the subscription.\n    subscribe_url = notification.get(\"SubscribeURL\")\n    try:\n        urlopen(subscribe_url).read()\n    except URLError as e:\n        # Some kind of error occurred when confirming the request.\n        logger.error(\n            'Could not confirm subscription: \"%s\"',\n            e,\n            extra={\n                \"notification\": notification,\n            },\n            exc_info=True,\n        )\n"}, {"function_name": "BounceMessageVerifier", "code_before": "def BounceMessageVerifier(*args, **kwargs):\n    warnings.warn(\n        'utils.BounceMessageVerifier is deprecated. It is renamed to EventMessageVerifier.',\n        RemovedInDjangoSES20Warning,\n    )\n\n    # parameter name is renamed from bounce_dict to notification.\n    if 'bounce_dict' in kwargs:\n        kwargs['notification'] = kwargs['bounce_dict']\n        del kwargs['bounce_dict']\n\n    return EventMessageVerifier(*args, **kwargs)\n", "code_after": "def BounceMessageVerifier(*args, **kwargs):\n    warnings.warn(\n        \"utils.BounceMessageVerifier is deprecated. It is renamed to EventMessageVerifier.\",\n        RemovedInDjangoSES20Warning,\n    )\n\n    # parameter name is renamed from bounce_dict to notification.\n    if \"bounce_dict\" in kwargs:\n        kwargs[\"notification\"] = kwargs[\"bounce_dict\"]\n        del kwargs[\"bounce_dict\"]\n\n    return EventMessageVerifier(*args, **kwargs)\n"}], "gpt_answer": "The provided information indicates that the function \"_get_cert_url\" was changed to address a security vulnerability. The vulnerability allowed users to specify arbitrary public certificates, which could lead to unauthorized access or other security issues.\n\nThe changes in the function \"_get_cert_url\" include additional checks for the certificate URL. Specifically, it adds a regular expression match for the certificate URL and a warning for potential security risks if the domain parts are less than 4. This change is directly related to the vulnerability as it adds more restrictions and checks to the certificate URL, which was the source of the vulnerability.\n\nTherefore, the function \"_get_cert_url\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "_check_sigs_on_pdus", "code_before": "def _check_sigs_on_pdus(keyring, room_version, pdus):\n    \"\"\"Check that the given events are correctly signed\n\n    Args:\n        keyring (synapse.crypto.Keyring): keyring object to do the checks\n        room_version (str): the room version of the PDUs\n        pdus (Collection[EventBase]): the events to be checked\n\n    Returns:\n        List[Deferred]: a Deferred for each event in pdus, which will either succeed if\n           the signatures are valid, or fail (with a SynapseError) if not.\n    \"\"\"\n\n    # we want to check that the event is signed by:\n    #\n    # (a) the sender's server\n    #\n    #     - except in the case of invites created from a 3pid invite, which are exempt\n    #     from this check, because the sender has to match that of the original 3pid\n    #     invite, but the event may come from a different HS, for reasons that I don't\n    #     entirely grok (why do the senders have to match? and if they do, why doesn't the\n    #     joining server ask the inviting server to do the switcheroo with\n    #     exchange_third_party_invite?).\n    #\n    #     That's pretty awful, since redacting such an invite will render it invalid\n    #     (because it will then look like a regular invite without a valid signature),\n    #     and signatures are *supposed* to be valid whether or not an event has been\n    #     redacted. But this isn't the worst of the ways that 3pid invites are broken.\n    #\n    # (b) for V1 and V2 rooms, the server which created the event_id\n    #\n    # let's start by getting the domain for each pdu, and flattening the event back\n    # to JSON.\n\n    pdus_to_check = [\n        PduToCheckSig(\n            pdu=p,\n            redacted_pdu_json=prune_event(p).get_pdu_json(),\n            sender_domain=get_domain_from_id(p.sender),\n            deferreds=[],\n        )\n        for p in pdus\n    ]\n\n    v = KNOWN_ROOM_VERSIONS.get(room_version)\n    if not v:\n        raise RuntimeError(\"Unrecognized room version %s\" % (room_version,))\n\n    # First we check that the sender event is signed by the sender's domain\n    # (except if its a 3pid invite, in which case it may be sent by any server)\n    pdus_to_check_sender = [p for p in pdus_to_check if not _is_invite_via_3pid(p.pdu)]\n\n    more_deferreds = keyring.verify_json_objects_for_server(\n        [\n            (\n                p.sender_domain,\n                p.redacted_pdu_json,\n                p.pdu.origin_server_ts if v.enforce_key_validity else 0,\n                p.pdu.event_id,\n            )\n            for p in pdus_to_check_sender\n        ]\n    )\n\n    def sender_err(e, pdu_to_check):\n        errmsg = \"event id %s: unable to verify signature for sender %s: %s\" % (\n            pdu_to_check.pdu.event_id,\n            pdu_to_check.sender_domain,\n            e.getErrorMessage(),\n        )\n        # XX not really sure if these are the right codes, but they are what\n        # we've done for ages\n        raise SynapseError(400, errmsg, Codes.UNAUTHORIZED)\n\n    for p, d in zip(pdus_to_check_sender, more_deferreds):\n        d.addErrback(sender_err, p)\n        p.deferreds.append(d)\n\n    # now let's look for events where the sender's domain is different to the\n    # event id's domain (normally only the case for joins/leaves), and add additional\n    # checks. Only do this if the room version has a concept of event ID domain\n    # (ie, the room version uses old-style non-hash event IDs).\n    if v.event_format == EventFormatVersions.V1:\n        pdus_to_check_event_id = [\n            p\n            for p in pdus_to_check\n            if p.sender_domain != get_domain_from_id(p.pdu.event_id)\n        ]\n\n        more_deferreds = keyring.verify_json_objects_for_server(\n            [\n                (\n                    get_domain_from_id(p.pdu.event_id),\n                    p.redacted_pdu_json,\n                    p.pdu.origin_server_ts if v.enforce_key_validity else 0,\n                    p.pdu.event_id,\n                )\n                for p in pdus_to_check_event_id\n            ]\n        )\n\n        def event_err(e, pdu_to_check):\n            errmsg = (\n                \"event id %s: unable to verify signature for event id domain: %s\"\n                % (pdu_to_check.pdu.event_id, e.getErrorMessage())\n            )\n            # XX as above: not really sure if these are the right codes\n            raise SynapseError(400, errmsg, Codes.UNAUTHORIZED)\n\n        for p, d in zip(pdus_to_check_event_id, more_deferreds):\n            d.addErrback(event_err, p)\n            p.deferreds.append(d)\n\n    # replace lists of deferreds with single Deferreds\n    return [_flatten_deferred_list(p.deferreds) for p in pdus_to_check]\n", "code_after": "def _check_sigs_on_pdus(keyring, room_version, pdus):\n    \"\"\"Check that the given events are correctly signed\n\n    Args:\n        keyring (synapse.crypto.Keyring): keyring object to do the checks\n        room_version (str): the room version of the PDUs\n        pdus (Collection[EventBase]): the events to be checked\n\n    Returns:\n        List[Deferred]: a Deferred for each event in pdus, which will either succeed if\n           the signatures are valid, or fail (with a SynapseError) if not.\n    \"\"\"\n\n    # we want to check that the event is signed by:\n    #\n    # (a) the sender's server\n    #\n    #     - except in the case of invites created from a 3pid invite, which are exempt\n    #     from this check, because the sender has to match that of the original 3pid\n    #     invite, but the event may come from a different HS, for reasons that I don't\n    #     entirely grok (why do the senders have to match? and if they do, why doesn't the\n    #     joining server ask the inviting server to do the switcheroo with\n    #     exchange_third_party_invite?).\n    #\n    #     That's pretty awful, since redacting such an invite will render it invalid\n    #     (because it will then look like a regular invite without a valid signature),\n    #     and signatures are *supposed* to be valid whether or not an event has been\n    #     redacted. But this isn't the worst of the ways that 3pid invites are broken.\n    #\n    # (b) for V1 and V2 rooms, the server which created the event_id\n    #\n    # let's start by getting the domain for each pdu, and flattening the event back\n    # to JSON.\n\n    pdus_to_check = [\n        PduToCheckSig(\n            pdu=p,\n            redacted_pdu_json=prune_event(p).get_pdu_json(),\n            sender_domain=get_domain_from_id(p.sender),\n            deferreds=[],\n        )\n        for p in pdus\n    ]\n\n    v = KNOWN_ROOM_VERSIONS.get(room_version)\n    if not v:\n        raise RuntimeError(\"Unrecognized room version %s\" % (room_version,))\n\n    # First we check that the sender event is signed by the sender's domain\n    # (except if its a 3pid invite, in which case it may be sent by any server)\n    pdus_to_check_sender = [p for p in pdus_to_check if not _is_invite_via_3pid(p.pdu)]\n\n    more_deferreds = keyring.verify_json_objects_for_server(\n        [\n            (\n                p.sender_domain,\n                p.redacted_pdu_json,\n                p.pdu.origin_server_ts if v.enforce_key_validity else 0,\n                p.pdu.event_id,\n            )\n            for p in pdus_to_check_sender\n        ]\n    )\n\n    def sender_err(e, pdu_to_check):\n        errmsg = \"event id %s: unable to verify signature for sender %s: %s\" % (\n            pdu_to_check.pdu.event_id,\n            pdu_to_check.sender_domain,\n            e.getErrorMessage(),\n        )\n        raise SynapseError(403, errmsg, Codes.FORBIDDEN)\n\n    for p, d in zip(pdus_to_check_sender, more_deferreds):\n        d.addErrback(sender_err, p)\n        p.deferreds.append(d)\n\n    # now let's look for events where the sender's domain is different to the\n    # event id's domain (normally only the case for joins/leaves), and add additional\n    # checks. Only do this if the room version has a concept of event ID domain\n    # (ie, the room version uses old-style non-hash event IDs).\n    if v.event_format == EventFormatVersions.V1:\n        pdus_to_check_event_id = [\n            p\n            for p in pdus_to_check\n            if p.sender_domain != get_domain_from_id(p.pdu.event_id)\n        ]\n\n        more_deferreds = keyring.verify_json_objects_for_server(\n            [\n                (\n                    get_domain_from_id(p.pdu.event_id),\n                    p.redacted_pdu_json,\n                    p.pdu.origin_server_ts if v.enforce_key_validity else 0,\n                    p.pdu.event_id,\n                )\n                for p in pdus_to_check_event_id\n            ]\n        )\n\n        def event_err(e, pdu_to_check):\n            errmsg = (\n                \"event id %s: unable to verify signature for event id domain: %s\"\n                % (pdu_to_check.pdu.event_id, e.getErrorMessage())\n            )\n            raise SynapseError(403, errmsg, Codes.FORBIDDEN)\n\n        for p, d in zip(pdus_to_check_event_id, more_deferreds):\n            d.addErrback(event_err, p)\n            p.deferreds.append(d)\n\n    # replace lists of deferreds with single Deferreds\n    return [_flatten_deferred_list(p.deferreds) for p in pdus_to_check]\n", "commit_message": "Improve signature checking on some federation APIs (#6262)\n\nMake sure that we check that events sent over /send_join, /send_leave, and\r\n/invite, are correctly signed and come from the expected servers.", "commit": "https://github.com/matrix-org/synapse/commit/172f264ed38e8bef857552f93114b4ee113a880b", "description": "Matrix Synapse before 1.5.0 mishandles signature checking on some federation APIs. Events sent over `/send_join`, `/send_leave`, and `/invite` may not be correctly signed, or may not come from the expected servers.", "file_change_id": 150571072067112, "report_link": "https://github.com/advisories/GHSA-cppw-2mf8-qpm5", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "_check_sigs_on_pdus.sender_err", "code_before": "    def sender_err(e, pdu_to_check):\n        errmsg = \"event id %s: unable to verify signature for sender %s: %s\" % (\n            pdu_to_check.pdu.event_id,\n            pdu_to_check.sender_domain,\n            e.getErrorMessage(),\n        )\n        # XX not really sure if these are the right codes, but they are what\n        # we've done for ages\n        raise SynapseError(400, errmsg, Codes.UNAUTHORIZED)\n", "code_after": "    def sender_err(e, pdu_to_check):\n        errmsg = \"event id %s: unable to verify signature for sender %s: %s\" % (\n            pdu_to_check.pdu.event_id,\n            pdu_to_check.sender_domain,\n            e.getErrorMessage(),\n        )\n        raise SynapseError(403, errmsg, Codes.FORBIDDEN)\n"}, {"function_name": "_check_sigs_on_pdus.event_err", "code_before": "        def event_err(e, pdu_to_check):\n            errmsg = (\n                \"event id %s: unable to verify signature for event id domain: %s\"\n                % (pdu_to_check.pdu.event_id, e.getErrorMessage())\n            )\n            # XX as above: not really sure if these are the right codes\n            raise SynapseError(400, errmsg, Codes.UNAUTHORIZED)\n", "code_after": "        def event_err(e, pdu_to_check):\n            errmsg = (\n                \"event id %s: unable to verify signature for event id domain: %s\"\n                % (pdu_to_check.pdu.event_id, e.getErrorMessage())\n            )\n            raise SynapseError(403, errmsg, Codes.FORBIDDEN)\n"}], "gpt_answer": "The function \"_check_sigs_on_pdus\" is responsible for checking the signatures of events. The changes made to this function are related to the error handling part of the function. The error code returned when a signature check fails has been changed from 400 to 403, and the error code has been changed from \"UNAUTHORIZED\" to \"FORBIDDEN\". \n\nThe vulnerability description states that \"Matrix Synapse before 1.5.0 mishandles signature checking on some federation APIs. Events sent over `/send_join`, `/send_leave`, and `/invite` may not be correctly signed, or may not come from the expected servers.\" This suggests that the function \"_check_sigs_on_pdus\" is indeed relevant to the vulnerability, as it is responsible for checking the signatures of events.\n\nTherefore, the function \"_check_sigs_on_pdus\" is vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "_check_sigs_on_pdus.event_err", "code_before": "        def event_err(e, pdu_to_check):\n            errmsg = (\n                \"event id %s: unable to verify signature for event id domain: %s\"\n                % (pdu_to_check.pdu.event_id, e.getErrorMessage())\n            )\n            # XX as above: not really sure if these are the right codes\n            raise SynapseError(400, errmsg, Codes.UNAUTHORIZED)\n", "code_after": "        def event_err(e, pdu_to_check):\n            errmsg = (\n                \"event id %s: unable to verify signature for event id domain: %s\"\n                % (pdu_to_check.pdu.event_id, e.getErrorMessage())\n            )\n            raise SynapseError(403, errmsg, Codes.FORBIDDEN)\n", "commit_message": "Improve signature checking on some federation APIs (#6262)\n\nMake sure that we check that events sent over /send_join, /send_leave, and\r\n/invite, are correctly signed and come from the expected servers.", "commit": "https://github.com/matrix-org/synapse/commit/172f264ed38e8bef857552f93114b4ee113a880b", "description": "Matrix Synapse before 1.5.0 mishandles signature checking on some federation APIs. Events sent over `/send_join`, `/send_leave`, and `/invite` may not be correctly signed, or may not come from the expected servers.", "file_change_id": 150571072067112, "report_link": "https://github.com/advisories/GHSA-cppw-2mf8-qpm5", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "_check_sigs_on_pdus", "code_before": "def _check_sigs_on_pdus(keyring, room_version, pdus):\n    \"\"\"Check that the given events are correctly signed\n\n    Args:\n        keyring (synapse.crypto.Keyring): keyring object to do the checks\n        room_version (str): the room version of the PDUs\n        pdus (Collection[EventBase]): the events to be checked\n\n    Returns:\n        List[Deferred]: a Deferred for each event in pdus, which will either succeed if\n           the signatures are valid, or fail (with a SynapseError) if not.\n    \"\"\"\n\n    # we want to check that the event is signed by:\n    #\n    # (a) the sender's server\n    #\n    #     - except in the case of invites created from a 3pid invite, which are exempt\n    #     from this check, because the sender has to match that of the original 3pid\n    #     invite, but the event may come from a different HS, for reasons that I don't\n    #     entirely grok (why do the senders have to match? and if they do, why doesn't the\n    #     joining server ask the inviting server to do the switcheroo with\n    #     exchange_third_party_invite?).\n    #\n    #     That's pretty awful, since redacting such an invite will render it invalid\n    #     (because it will then look like a regular invite without a valid signature),\n    #     and signatures are *supposed* to be valid whether or not an event has been\n    #     redacted. But this isn't the worst of the ways that 3pid invites are broken.\n    #\n    # (b) for V1 and V2 rooms, the server which created the event_id\n    #\n    # let's start by getting the domain for each pdu, and flattening the event back\n    # to JSON.\n\n    pdus_to_check = [\n        PduToCheckSig(\n            pdu=p,\n            redacted_pdu_json=prune_event(p).get_pdu_json(),\n            sender_domain=get_domain_from_id(p.sender),\n            deferreds=[],\n        )\n        for p in pdus\n    ]\n\n    v = KNOWN_ROOM_VERSIONS.get(room_version)\n    if not v:\n        raise RuntimeError(\"Unrecognized room version %s\" % (room_version,))\n\n    # First we check that the sender event is signed by the sender's domain\n    # (except if its a 3pid invite, in which case it may be sent by any server)\n    pdus_to_check_sender = [p for p in pdus_to_check if not _is_invite_via_3pid(p.pdu)]\n\n    more_deferreds = keyring.verify_json_objects_for_server(\n        [\n            (\n                p.sender_domain,\n                p.redacted_pdu_json,\n                p.pdu.origin_server_ts if v.enforce_key_validity else 0,\n                p.pdu.event_id,\n            )\n            for p in pdus_to_check_sender\n        ]\n    )\n\n    def sender_err(e, pdu_to_check):\n        errmsg = \"event id %s: unable to verify signature for sender %s: %s\" % (\n            pdu_to_check.pdu.event_id,\n            pdu_to_check.sender_domain,\n            e.getErrorMessage(),\n        )\n        # XX not really sure if these are the right codes, but they are what\n        # we've done for ages\n        raise SynapseError(400, errmsg, Codes.UNAUTHORIZED)\n\n    for p, d in zip(pdus_to_check_sender, more_deferreds):\n        d.addErrback(sender_err, p)\n        p.deferreds.append(d)\n\n    # now let's look for events where the sender's domain is different to the\n    # event id's domain (normally only the case for joins/leaves), and add additional\n    # checks. Only do this if the room version has a concept of event ID domain\n    # (ie, the room version uses old-style non-hash event IDs).\n    if v.event_format == EventFormatVersions.V1:\n        pdus_to_check_event_id = [\n            p\n            for p in pdus_to_check\n            if p.sender_domain != get_domain_from_id(p.pdu.event_id)\n        ]\n\n        more_deferreds = keyring.verify_json_objects_for_server(\n            [\n                (\n                    get_domain_from_id(p.pdu.event_id),\n                    p.redacted_pdu_json,\n                    p.pdu.origin_server_ts if v.enforce_key_validity else 0,\n                    p.pdu.event_id,\n                )\n                for p in pdus_to_check_event_id\n            ]\n        )\n\n        def event_err(e, pdu_to_check):\n            errmsg = (\n                \"event id %s: unable to verify signature for event id domain: %s\"\n                % (pdu_to_check.pdu.event_id, e.getErrorMessage())\n            )\n            # XX as above: not really sure if these are the right codes\n            raise SynapseError(400, errmsg, Codes.UNAUTHORIZED)\n\n        for p, d in zip(pdus_to_check_event_id, more_deferreds):\n            d.addErrback(event_err, p)\n            p.deferreds.append(d)\n\n    # replace lists of deferreds with single Deferreds\n    return [_flatten_deferred_list(p.deferreds) for p in pdus_to_check]\n", "code_after": "def _check_sigs_on_pdus(keyring, room_version, pdus):\n    \"\"\"Check that the given events are correctly signed\n\n    Args:\n        keyring (synapse.crypto.Keyring): keyring object to do the checks\n        room_version (str): the room version of the PDUs\n        pdus (Collection[EventBase]): the events to be checked\n\n    Returns:\n        List[Deferred]: a Deferred for each event in pdus, which will either succeed if\n           the signatures are valid, or fail (with a SynapseError) if not.\n    \"\"\"\n\n    # we want to check that the event is signed by:\n    #\n    # (a) the sender's server\n    #\n    #     - except in the case of invites created from a 3pid invite, which are exempt\n    #     from this check, because the sender has to match that of the original 3pid\n    #     invite, but the event may come from a different HS, for reasons that I don't\n    #     entirely grok (why do the senders have to match? and if they do, why doesn't the\n    #     joining server ask the inviting server to do the switcheroo with\n    #     exchange_third_party_invite?).\n    #\n    #     That's pretty awful, since redacting such an invite will render it invalid\n    #     (because it will then look like a regular invite without a valid signature),\n    #     and signatures are *supposed* to be valid whether or not an event has been\n    #     redacted. But this isn't the worst of the ways that 3pid invites are broken.\n    #\n    # (b) for V1 and V2 rooms, the server which created the event_id\n    #\n    # let's start by getting the domain for each pdu, and flattening the event back\n    # to JSON.\n\n    pdus_to_check = [\n        PduToCheckSig(\n            pdu=p,\n            redacted_pdu_json=prune_event(p).get_pdu_json(),\n            sender_domain=get_domain_from_id(p.sender),\n            deferreds=[],\n        )\n        for p in pdus\n    ]\n\n    v = KNOWN_ROOM_VERSIONS.get(room_version)\n    if not v:\n        raise RuntimeError(\"Unrecognized room version %s\" % (room_version,))\n\n    # First we check that the sender event is signed by the sender's domain\n    # (except if its a 3pid invite, in which case it may be sent by any server)\n    pdus_to_check_sender = [p for p in pdus_to_check if not _is_invite_via_3pid(p.pdu)]\n\n    more_deferreds = keyring.verify_json_objects_for_server(\n        [\n            (\n                p.sender_domain,\n                p.redacted_pdu_json,\n                p.pdu.origin_server_ts if v.enforce_key_validity else 0,\n                p.pdu.event_id,\n            )\n            for p in pdus_to_check_sender\n        ]\n    )\n\n    def sender_err(e, pdu_to_check):\n        errmsg = \"event id %s: unable to verify signature for sender %s: %s\" % (\n            pdu_to_check.pdu.event_id,\n            pdu_to_check.sender_domain,\n            e.getErrorMessage(),\n        )\n        raise SynapseError(403, errmsg, Codes.FORBIDDEN)\n\n    for p, d in zip(pdus_to_check_sender, more_deferreds):\n        d.addErrback(sender_err, p)\n        p.deferreds.append(d)\n\n    # now let's look for events where the sender's domain is different to the\n    # event id's domain (normally only the case for joins/leaves), and add additional\n    # checks. Only do this if the room version has a concept of event ID domain\n    # (ie, the room version uses old-style non-hash event IDs).\n    if v.event_format == EventFormatVersions.V1:\n        pdus_to_check_event_id = [\n            p\n            for p in pdus_to_check\n            if p.sender_domain != get_domain_from_id(p.pdu.event_id)\n        ]\n\n        more_deferreds = keyring.verify_json_objects_for_server(\n            [\n                (\n                    get_domain_from_id(p.pdu.event_id),\n                    p.redacted_pdu_json,\n                    p.pdu.origin_server_ts if v.enforce_key_validity else 0,\n                    p.pdu.event_id,\n                )\n                for p in pdus_to_check_event_id\n            ]\n        )\n\n        def event_err(e, pdu_to_check):\n            errmsg = (\n                \"event id %s: unable to verify signature for event id domain: %s\"\n                % (pdu_to_check.pdu.event_id, e.getErrorMessage())\n            )\n            raise SynapseError(403, errmsg, Codes.FORBIDDEN)\n\n        for p, d in zip(pdus_to_check_event_id, more_deferreds):\n            d.addErrback(event_err, p)\n            p.deferreds.append(d)\n\n    # replace lists of deferreds with single Deferreds\n    return [_flatten_deferred_list(p.deferreds) for p in pdus_to_check]\n"}, {"function_name": "_check_sigs_on_pdus.sender_err", "code_before": "    def sender_err(e, pdu_to_check):\n        errmsg = \"event id %s: unable to verify signature for sender %s: %s\" % (\n            pdu_to_check.pdu.event_id,\n            pdu_to_check.sender_domain,\n            e.getErrorMessage(),\n        )\n        # XX not really sure if these are the right codes, but they are what\n        # we've done for ages\n        raise SynapseError(400, errmsg, Codes.UNAUTHORIZED)\n", "code_after": "    def sender_err(e, pdu_to_check):\n        errmsg = \"event id %s: unable to verify signature for sender %s: %s\" % (\n            pdu_to_check.pdu.event_id,\n            pdu_to_check.sender_domain,\n            e.getErrorMessage(),\n        )\n        raise SynapseError(403, errmsg, Codes.FORBIDDEN)\n"}], "gpt_answer": "The provided information indicates that the function \"_check_sigs_on_pdus.event_err\" has been modified in response to a vulnerability in the Matrix Synapse before 1.5.0, which mishandles signature checking on some federation APIs. The vulnerability allows events sent over `/send_join`, `/send_leave`, and `/invite` to possibly not be correctly signed or not come from the expected servers.\n\nThe change in the function \"_check_sigs_on_pdus.event_err\" is a modification of the HTTP status code in the raised SynapseError from 400 to 403. This change is consistent with the commit message, which mentions improving signature checking on some federation APIs.\n\nGiven that the function is part of the signature checking process and the vulnerability is related to mishandling signature checking, it can be inferred that the function was vulnerable and has been changed to address the vulnerability.\n\nTherefore, the answer is 1, indicating that the function was vulnerable.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "on_send_leave_request", "code_before": "    def on_send_leave_request(self, origin, content, room_id):\n        logger.debug(\"on_send_leave_request: content: %s\", content)\n\n        room_version = yield self.store.get_room_version(room_id)\n        format_ver = room_version_to_event_format(room_version)\n        pdu = event_from_pdu_json(content, format_ver)\n\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n\n        logger.debug(\"on_send_leave_request: pdu sigs: %s\", pdu.signatures)\n        yield self.handler.on_send_leave_request(origin, pdu)\n        return 200, {}\n", "code_after": "    def on_send_leave_request(self, origin, content, room_id):\n        logger.debug(\"on_send_leave_request: content: %s\", content)\n\n        room_version = yield self.store.get_room_version(room_id)\n        format_ver = room_version_to_event_format(room_version)\n        pdu = event_from_pdu_json(content, format_ver)\n\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n\n        logger.debug(\"on_send_leave_request: pdu sigs: %s\", pdu.signatures)\n\n        pdu = yield self._check_sigs_and_hash(room_version, pdu)\n\n        yield self.handler.on_send_leave_request(origin, pdu)\n        return 200, {}\n", "commit_message": "Improve signature checking on some federation APIs (#6262)\n\nMake sure that we check that events sent over /send_join, /send_leave, and\r\n/invite, are correctly signed and come from the expected servers.", "commit": "https://github.com/matrix-org/synapse/commit/172f264ed38e8bef857552f93114b4ee113a880b", "description": "Matrix Synapse before 1.5.0 mishandles signature checking on some federation APIs. Events sent over `/send_join`, `/send_leave`, and `/invite` may not be correctly signed, or may not come from the expected servers.", "file_change_id": 181386078187440, "report_link": "https://github.com/advisories/GHSA-cppw-2mf8-qpm5", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "on_send_join_request", "code_before": "    def on_send_join_request(self, origin, content, room_id):\n        logger.debug(\"on_send_join_request: content: %s\", content)\n\n        room_version = yield self.store.get_room_version(room_id)\n        format_ver = room_version_to_event_format(room_version)\n        pdu = event_from_pdu_json(content, format_ver)\n\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n\n        logger.debug(\"on_send_join_request: pdu sigs: %s\", pdu.signatures)\n        res_pdus = yield self.handler.on_send_join_request(origin, pdu)\n        time_now = self._clock.time_msec()\n        return (\n            200,\n            {\n                \"state\": [p.get_pdu_json(time_now) for p in res_pdus[\"state\"]],\n                \"auth_chain\": [\n                    p.get_pdu_json(time_now) for p in res_pdus[\"auth_chain\"]\n                ],\n            },\n        )\n", "code_after": "    def on_send_join_request(self, origin, content, room_id):\n        logger.debug(\"on_send_join_request: content: %s\", content)\n\n        room_version = yield self.store.get_room_version(room_id)\n        format_ver = room_version_to_event_format(room_version)\n        pdu = event_from_pdu_json(content, format_ver)\n\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n\n        logger.debug(\"on_send_join_request: pdu sigs: %s\", pdu.signatures)\n\n        pdu = yield self._check_sigs_and_hash(room_version, pdu)\n\n        res_pdus = yield self.handler.on_send_join_request(origin, pdu)\n        time_now = self._clock.time_msec()\n        return (\n            200,\n            {\n                \"state\": [p.get_pdu_json(time_now) for p in res_pdus[\"state\"]],\n                \"auth_chain\": [\n                    p.get_pdu_json(time_now) for p in res_pdus[\"auth_chain\"]\n                ],\n            },\n        )\n"}, {"function_name": "on_invite_request", "code_before": "    def on_invite_request(self, origin, content, room_version):\n        if room_version not in KNOWN_ROOM_VERSIONS:\n            raise SynapseError(\n                400,\n                \"Homeserver does not support this room version\",\n                Codes.UNSUPPORTED_ROOM_VERSION,\n            )\n\n        format_ver = room_version_to_event_format(room_version)\n\n        pdu = event_from_pdu_json(content, format_ver)\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n        ret_pdu = yield self.handler.on_invite_request(origin, pdu)\n        time_now = self._clock.time_msec()\n        return {\"event\": ret_pdu.get_pdu_json(time_now)}\n", "code_after": "    def on_invite_request(self, origin, content, room_version):\n        if room_version not in KNOWN_ROOM_VERSIONS:\n            raise SynapseError(\n                400,\n                \"Homeserver does not support this room version\",\n                Codes.UNSUPPORTED_ROOM_VERSION,\n            )\n\n        format_ver = room_version_to_event_format(room_version)\n\n        pdu = event_from_pdu_json(content, format_ver)\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n        pdu = yield self._check_sigs_and_hash(room_version, pdu)\n        ret_pdu = yield self.handler.on_invite_request(origin, pdu)\n        time_now = self._clock.time_msec()\n        return {\"event\": ret_pdu.get_pdu_json(time_now)}\n"}], "gpt_answer": "The function \"on_send_leave_request\" is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability description states that Matrix Synapse before 1.5.0 mishandles signature checking on some federation APIs, including `/send_leave`. The commit message also confirms that the commit is intended to improve signature checking on some federation APIs, including `/send_leave`.\n\nIn the \"code_after\" section, we can see that a new line has been added: `pdu = yield self._check_sigs_and_hash(room_version, pdu)`. This line is responsible for checking the signatures and hash of the Protocol Data Unit (PDU), which is directly related to the vulnerability described.\n\nTherefore, the function \"on_send_leave_request\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "on_send_join_request", "code_before": "    def on_send_join_request(self, origin, content, room_id):\n        logger.debug(\"on_send_join_request: content: %s\", content)\n\n        room_version = yield self.store.get_room_version(room_id)\n        format_ver = room_version_to_event_format(room_version)\n        pdu = event_from_pdu_json(content, format_ver)\n\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n\n        logger.debug(\"on_send_join_request: pdu sigs: %s\", pdu.signatures)\n        res_pdus = yield self.handler.on_send_join_request(origin, pdu)\n        time_now = self._clock.time_msec()\n        return (\n            200,\n            {\n                \"state\": [p.get_pdu_json(time_now) for p in res_pdus[\"state\"]],\n                \"auth_chain\": [\n                    p.get_pdu_json(time_now) for p in res_pdus[\"auth_chain\"]\n                ],\n            },\n        )\n", "code_after": "    def on_send_join_request(self, origin, content, room_id):\n        logger.debug(\"on_send_join_request: content: %s\", content)\n\n        room_version = yield self.store.get_room_version(room_id)\n        format_ver = room_version_to_event_format(room_version)\n        pdu = event_from_pdu_json(content, format_ver)\n\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n\n        logger.debug(\"on_send_join_request: pdu sigs: %s\", pdu.signatures)\n\n        pdu = yield self._check_sigs_and_hash(room_version, pdu)\n\n        res_pdus = yield self.handler.on_send_join_request(origin, pdu)\n        time_now = self._clock.time_msec()\n        return (\n            200,\n            {\n                \"state\": [p.get_pdu_json(time_now) for p in res_pdus[\"state\"]],\n                \"auth_chain\": [\n                    p.get_pdu_json(time_now) for p in res_pdus[\"auth_chain\"]\n                ],\n            },\n        )\n", "commit_message": "Improve signature checking on some federation APIs (#6262)\n\nMake sure that we check that events sent over /send_join, /send_leave, and\r\n/invite, are correctly signed and come from the expected servers.", "commit": "https://github.com/matrix-org/synapse/commit/172f264ed38e8bef857552f93114b4ee113a880b", "description": "Matrix Synapse before 1.5.0 mishandles signature checking on some federation APIs. Events sent over `/send_join`, `/send_leave`, and `/invite` may not be correctly signed, or may not come from the expected servers.", "file_change_id": 181386078187440, "report_link": "https://github.com/advisories/GHSA-cppw-2mf8-qpm5", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "on_send_leave_request", "code_before": "    def on_send_leave_request(self, origin, content, room_id):\n        logger.debug(\"on_send_leave_request: content: %s\", content)\n\n        room_version = yield self.store.get_room_version(room_id)\n        format_ver = room_version_to_event_format(room_version)\n        pdu = event_from_pdu_json(content, format_ver)\n\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n\n        logger.debug(\"on_send_leave_request: pdu sigs: %s\", pdu.signatures)\n        yield self.handler.on_send_leave_request(origin, pdu)\n        return 200, {}\n", "code_after": "    def on_send_leave_request(self, origin, content, room_id):\n        logger.debug(\"on_send_leave_request: content: %s\", content)\n\n        room_version = yield self.store.get_room_version(room_id)\n        format_ver = room_version_to_event_format(room_version)\n        pdu = event_from_pdu_json(content, format_ver)\n\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n\n        logger.debug(\"on_send_leave_request: pdu sigs: %s\", pdu.signatures)\n\n        pdu = yield self._check_sigs_and_hash(room_version, pdu)\n\n        yield self.handler.on_send_leave_request(origin, pdu)\n        return 200, {}\n"}, {"function_name": "on_invite_request", "code_before": "    def on_invite_request(self, origin, content, room_version):\n        if room_version not in KNOWN_ROOM_VERSIONS:\n            raise SynapseError(\n                400,\n                \"Homeserver does not support this room version\",\n                Codes.UNSUPPORTED_ROOM_VERSION,\n            )\n\n        format_ver = room_version_to_event_format(room_version)\n\n        pdu = event_from_pdu_json(content, format_ver)\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n        ret_pdu = yield self.handler.on_invite_request(origin, pdu)\n        time_now = self._clock.time_msec()\n        return {\"event\": ret_pdu.get_pdu_json(time_now)}\n", "code_after": "    def on_invite_request(self, origin, content, room_version):\n        if room_version not in KNOWN_ROOM_VERSIONS:\n            raise SynapseError(\n                400,\n                \"Homeserver does not support this room version\",\n                Codes.UNSUPPORTED_ROOM_VERSION,\n            )\n\n        format_ver = room_version_to_event_format(room_version)\n\n        pdu = event_from_pdu_json(content, format_ver)\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n        pdu = yield self._check_sigs_and_hash(room_version, pdu)\n        ret_pdu = yield self.handler.on_invite_request(origin, pdu)\n        time_now = self._clock.time_msec()\n        return {\"event\": ret_pdu.get_pdu_json(time_now)}\n"}], "gpt_answer": "The function \"on_send_join_request\" is indeed relevant to the vulnerability that the commit is trying to fix. The vulnerability description states that Matrix Synapse before 1.5.0 mishandles signature checking on some federation APIs, and events sent over `/send_join`, `/send_leave`, and `/invite` may not be correctly signed, or may not come from the expected servers.\n\nIn the \"on_send_join_request\" function, the change is the addition of the line `pdu = yield self._check_sigs_and_hash(room_version, pdu)`. This line is checking the signatures and hashes of the Protocol Data Unit (PDU), which is directly related to the vulnerability described. \n\nTherefore, the function \"on_send_join_request\" was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "on_invite_request", "code_before": "    def on_invite_request(self, origin, content, room_version):\n        if room_version not in KNOWN_ROOM_VERSIONS:\n            raise SynapseError(\n                400,\n                \"Homeserver does not support this room version\",\n                Codes.UNSUPPORTED_ROOM_VERSION,\n            )\n\n        format_ver = room_version_to_event_format(room_version)\n\n        pdu = event_from_pdu_json(content, format_ver)\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n        ret_pdu = yield self.handler.on_invite_request(origin, pdu)\n        time_now = self._clock.time_msec()\n        return {\"event\": ret_pdu.get_pdu_json(time_now)}\n", "code_after": "    def on_invite_request(self, origin, content, room_version):\n        if room_version not in KNOWN_ROOM_VERSIONS:\n            raise SynapseError(\n                400,\n                \"Homeserver does not support this room version\",\n                Codes.UNSUPPORTED_ROOM_VERSION,\n            )\n\n        format_ver = room_version_to_event_format(room_version)\n\n        pdu = event_from_pdu_json(content, format_ver)\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n        pdu = yield self._check_sigs_and_hash(room_version, pdu)\n        ret_pdu = yield self.handler.on_invite_request(origin, pdu)\n        time_now = self._clock.time_msec()\n        return {\"event\": ret_pdu.get_pdu_json(time_now)}\n", "commit_message": "Improve signature checking on some federation APIs (#6262)\n\nMake sure that we check that events sent over /send_join, /send_leave, and\r\n/invite, are correctly signed and come from the expected servers.", "commit": "https://github.com/matrix-org/synapse/commit/172f264ed38e8bef857552f93114b4ee113a880b", "description": "Matrix Synapse before 1.5.0 mishandles signature checking on some federation APIs. Events sent over `/send_join`, `/send_leave`, and `/invite` may not be correctly signed, or may not come from the expected servers.", "file_change_id": 181386078187440, "report_link": "https://github.com/advisories/GHSA-cppw-2mf8-qpm5", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "on_send_leave_request", "code_before": "    def on_send_leave_request(self, origin, content, room_id):\n        logger.debug(\"on_send_leave_request: content: %s\", content)\n\n        room_version = yield self.store.get_room_version(room_id)\n        format_ver = room_version_to_event_format(room_version)\n        pdu = event_from_pdu_json(content, format_ver)\n\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n\n        logger.debug(\"on_send_leave_request: pdu sigs: %s\", pdu.signatures)\n        yield self.handler.on_send_leave_request(origin, pdu)\n        return 200, {}\n", "code_after": "    def on_send_leave_request(self, origin, content, room_id):\n        logger.debug(\"on_send_leave_request: content: %s\", content)\n\n        room_version = yield self.store.get_room_version(room_id)\n        format_ver = room_version_to_event_format(room_version)\n        pdu = event_from_pdu_json(content, format_ver)\n\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n\n        logger.debug(\"on_send_leave_request: pdu sigs: %s\", pdu.signatures)\n\n        pdu = yield self._check_sigs_and_hash(room_version, pdu)\n\n        yield self.handler.on_send_leave_request(origin, pdu)\n        return 200, {}\n"}, {"function_name": "on_send_join_request", "code_before": "    def on_send_join_request(self, origin, content, room_id):\n        logger.debug(\"on_send_join_request: content: %s\", content)\n\n        room_version = yield self.store.get_room_version(room_id)\n        format_ver = room_version_to_event_format(room_version)\n        pdu = event_from_pdu_json(content, format_ver)\n\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n\n        logger.debug(\"on_send_join_request: pdu sigs: %s\", pdu.signatures)\n        res_pdus = yield self.handler.on_send_join_request(origin, pdu)\n        time_now = self._clock.time_msec()\n        return (\n            200,\n            {\n                \"state\": [p.get_pdu_json(time_now) for p in res_pdus[\"state\"]],\n                \"auth_chain\": [\n                    p.get_pdu_json(time_now) for p in res_pdus[\"auth_chain\"]\n                ],\n            },\n        )\n", "code_after": "    def on_send_join_request(self, origin, content, room_id):\n        logger.debug(\"on_send_join_request: content: %s\", content)\n\n        room_version = yield self.store.get_room_version(room_id)\n        format_ver = room_version_to_event_format(room_version)\n        pdu = event_from_pdu_json(content, format_ver)\n\n        origin_host, _ = parse_server_name(origin)\n        yield self.check_server_matches_acl(origin_host, pdu.room_id)\n\n        logger.debug(\"on_send_join_request: pdu sigs: %s\", pdu.signatures)\n\n        pdu = yield self._check_sigs_and_hash(room_version, pdu)\n\n        res_pdus = yield self.handler.on_send_join_request(origin, pdu)\n        time_now = self._clock.time_msec()\n        return (\n            200,\n            {\n                \"state\": [p.get_pdu_json(time_now) for p in res_pdus[\"state\"]],\n                \"auth_chain\": [\n                    p.get_pdu_json(time_now) for p in res_pdus[\"auth_chain\"]\n                ],\n            },\n        )\n"}], "gpt_answer": "The provided information indicates that the vulnerability in Matrix Synapse before 1.5.0 is related to mishandling signature checking on some federation APIs. Events sent over `/send_join`, `/send_leave`, and `/invite` may not be correctly signed, or may not come from the expected servers.\n\nThe function `on_invite_request` is changed to include a call to `_check_sigs_and_hash(room_version, pdu)`. This function is likely to check the signatures and hash of the event, which aligns with the vulnerability description and the commit message. Therefore, it can be inferred that the function `on_invite_request` was vulnerable and has been changed to fix the vulnerability.\n\nThe other functions changed in the commit (`on_send_leave_request` and `on_send_join_request`) also include the same change, which further supports this conclusion.\n\nTherefore, the answer is 1 (the function is vulnerable).\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "on_send_leave_request", "code_before": "    def on_send_leave_request(self, origin, pdu):\n        \"\"\" We have received a leave event for a room. Fully process it.\"\"\"\n        event = pdu\n\n        logger.debug(\n            \"on_send_leave_request: Got event: %s, signatures: %s\",\n            event.event_id,\n            event.signatures,\n        )\n\n        event.internal_metadata.outlier = False\n\n        context = yield self._handle_new_event(origin, event)\n\n        event_allowed = yield self.third_party_event_rules.check_event_allowed(\n            event, context\n        )\n        if not event_allowed:\n            logger.info(\"Sending of leave %s forbidden by third-party rules\", event)\n            raise SynapseError(\n                403, \"This event is not allowed in this context\", Codes.FORBIDDEN\n            )\n\n        logger.debug(\n            \"on_send_leave_request: After _handle_new_event: %s, sigs: %s\",\n            event.event_id,\n            event.signatures,\n        )\n\n        return None\n", "code_after": "    def on_send_leave_request(self, origin, pdu):\n        \"\"\" We have received a leave event for a room. Fully process it.\"\"\"\n        event = pdu\n\n        logger.debug(\n            \"on_send_leave_request: Got event: %s, signatures: %s\",\n            event.event_id,\n            event.signatures,\n        )\n\n        if get_domain_from_id(event.sender) != origin:\n            logger.info(\n                \"Got /send_leave request for user %r from different origin %s\",\n                event.sender,\n                origin,\n            )\n            raise SynapseError(403, \"User not from origin\", Codes.FORBIDDEN)\n\n        event.internal_metadata.outlier = False\n\n        context = yield self._handle_new_event(origin, event)\n\n        event_allowed = yield self.third_party_event_rules.check_event_allowed(\n            event, context\n        )\n        if not event_allowed:\n            logger.info(\"Sending of leave %s forbidden by third-party rules\", event)\n            raise SynapseError(\n                403, \"This event is not allowed in this context\", Codes.FORBIDDEN\n            )\n\n        logger.debug(\n            \"on_send_leave_request: After _handle_new_event: %s, sigs: %s\",\n            event.event_id,\n            event.signatures,\n        )\n\n        return None\n", "commit_message": "Improve signature checking on some federation APIs (#6262)\n\nMake sure that we check that events sent over /send_join, /send_leave, and\r\n/invite, are correctly signed and come from the expected servers.", "commit": "https://github.com/matrix-org/synapse/commit/172f264ed38e8bef857552f93114b4ee113a880b", "description": "Matrix Synapse before 1.5.0 mishandles signature checking on some federation APIs. Events sent over `/send_join`, `/send_leave`, and `/invite` may not be correctly signed, or may not come from the expected servers.", "file_change_id": 237566638815830, "report_link": "https://github.com/advisories/GHSA-cppw-2mf8-qpm5", "programming_language": "Python", "other_changed_function_in_the_commit": [{"function_name": "on_send_join_request", "code_before": "    def on_send_join_request(self, origin, pdu):\n        \"\"\" We have received a join event for a room. Fully process it and\n        respond with the current state and auth chains.\n        \"\"\"\n        event = pdu\n\n        logger.debug(\n            \"on_send_join_request: Got event: %s, signatures: %s\",\n            event.event_id,\n            event.signatures,\n        )\n\n        event.internal_metadata.outlier = False\n        # Send this event on behalf of the origin server.\n        #\n        # The reasons we have the destination server rather than the origin\n        # server send it are slightly mysterious: the origin server should have\n        # all the neccessary state once it gets the response to the send_join,\n        # so it could send the event itself if it wanted to. It may be that\n        # doing it this way reduces failure modes, or avoids certain attacks\n        # where a new server selectively tells a subset of the federation that\n        # it has joined.\n        #\n        # The fact is that, as of the current writing, Synapse doesn't send out\n        # the join event over federation after joining, and changing it now\n        # would introduce the danger of backwards-compatibility problems.\n        event.internal_metadata.send_on_behalf_of = origin\n\n        context = yield self._handle_new_event(origin, event)\n\n        event_allowed = yield self.third_party_event_rules.check_event_allowed(\n            event, context\n        )\n        if not event_allowed:\n            logger.info(\"Sending of join %s forbidden by third-party rules\", event)\n            raise SynapseError(\n                403, \"This event is not allowed in this context\", Codes.FORBIDDEN\n            )\n\n        logger.debug(\n            \"on_send_join_request: After _handle_new_event: %s, sigs: %s\",\n            event.event_id,\n            event.signatures,\n        )\n\n        if event.type == EventTypes.Member:\n            if event.content[\"membership\"] == Membership.JOIN:\n                user = UserID.from_string(event.state_key)\n                yield self.user_joined_room(user, event.room_id)\n\n        prev_state_ids = yield context.get_prev_state_ids(self.store)\n\n        state_ids = list(prev_state_ids.values())\n        auth_chain = yield self.store.get_auth_chain(state_ids)\n\n        state = yield self.store.get_events(list(prev_state_ids.values()))\n\n        return {\"state\": list(state.values()), \"auth_chain\": auth_chain}\n", "code_after": "    def on_send_join_request(self, origin, pdu):\n        \"\"\" We have received a join event for a room. Fully process it and\n        respond with the current state and auth chains.\n        \"\"\"\n        event = pdu\n\n        logger.debug(\n            \"on_send_join_request from %s: Got event: %s, signatures: %s\",\n            origin,\n            event.event_id,\n            event.signatures,\n        )\n\n        if get_domain_from_id(event.sender) != origin:\n            logger.info(\n                \"Got /send_join request for user %r from different origin %s\",\n                event.sender,\n                origin,\n            )\n            raise SynapseError(403, \"User not from origin\", Codes.FORBIDDEN)\n\n        event.internal_metadata.outlier = False\n        # Send this event on behalf of the origin server.\n        #\n        # The reasons we have the destination server rather than the origin\n        # server send it are slightly mysterious: the origin server should have\n        # all the neccessary state once it gets the response to the send_join,\n        # so it could send the event itself if it wanted to. It may be that\n        # doing it this way reduces failure modes, or avoids certain attacks\n        # where a new server selectively tells a subset of the federation that\n        # it has joined.\n        #\n        # The fact is that, as of the current writing, Synapse doesn't send out\n        # the join event over federation after joining, and changing it now\n        # would introduce the danger of backwards-compatibility problems.\n        event.internal_metadata.send_on_behalf_of = origin\n\n        context = yield self._handle_new_event(origin, event)\n\n        event_allowed = yield self.third_party_event_rules.check_event_allowed(\n            event, context\n        )\n        if not event_allowed:\n            logger.info(\"Sending of join %s forbidden by third-party rules\", event)\n            raise SynapseError(\n                403, \"This event is not allowed in this context\", Codes.FORBIDDEN\n            )\n\n        logger.debug(\n            \"on_send_join_request: After _handle_new_event: %s, sigs: %s\",\n            event.event_id,\n            event.signatures,\n        )\n\n        if event.type == EventTypes.Member:\n            if event.content[\"membership\"] == Membership.JOIN:\n                user = UserID.from_string(event.state_key)\n                yield self.user_joined_room(user, event.room_id)\n\n        prev_state_ids = yield context.get_prev_state_ids(self.store)\n\n        state_ids = list(prev_state_ids.values())\n        auth_chain = yield self.store.get_auth_chain(state_ids)\n\n        state = yield self.store.get_events(list(prev_state_ids.values()))\n\n        return {\"state\": list(state.values()), \"auth_chain\": auth_chain}\n"}, {"function_name": "on_make_join_request", "code_before": "    def on_make_join_request(self, origin, room_id, user_id):\n        \"\"\" We've received a /make_join/ request, so we create a partial\n        join event for the room and return that. We do *not* persist or\n        process it until the other server has signed it and sent it back.\n\n        Args:\n            origin (str): The (verified) server name of the requesting server.\n            room_id (str): Room to create join event in\n            user_id (str): The user to create the join for\n\n        Returns:\n            Deferred[FrozenEvent]\n        \"\"\"\n\n        if get_domain_from_id(user_id) != origin:\n            logger.info(\n                \"Got /make_join request for user %r from different origin %s, ignoring\",\n                user_id,\n                origin,\n            )\n            raise SynapseError(403, \"User not from origin\", Codes.FORBIDDEN)\n\n        event_content = {\"membership\": Membership.JOIN}\n\n        room_version = yield self.store.get_room_version(room_id)\n\n        builder = self.event_builder_factory.new(\n            room_version,\n            {\n                \"type\": EventTypes.Member,\n                \"content\": event_content,\n                \"room_id\": room_id,\n                \"sender\": user_id,\n                \"state_key\": user_id,\n            },\n        )\n\n        try:\n            event, context = yield self.event_creation_handler.create_new_client_event(\n                builder=builder\n            )\n        except AuthError as e:\n            logger.warn(\"Failed to create join %r because %s\", event, e)\n            raise e\n\n        event_allowed = yield self.third_party_event_rules.check_event_allowed(\n            event, context\n        )\n        if not event_allowed:\n            logger.info(\"Creation of join %s forbidden by third-party rules\", event)\n            raise SynapseError(\n                403, \"This event is not allowed in this context\", Codes.FORBIDDEN\n            )\n\n        # The remote hasn't signed it yet, obviously. We'll do the full checks\n        # when we get the event back in `on_send_join_request`\n        yield self.auth.check_from_context(\n            room_version, event, context, do_sig_check=False\n        )\n\n        return event\n", "code_after": "    def on_make_join_request(self, origin, room_id, user_id):\n        \"\"\" We've received a /make_join/ request, so we create a partial\n        join event for the room and return that. We do *not* persist or\n        process it until the other server has signed it and sent it back.\n\n        Args:\n            origin (str): The (verified) server name of the requesting server.\n            room_id (str): Room to create join event in\n            user_id (str): The user to create the join for\n\n        Returns:\n            Deferred[FrozenEvent]\n        \"\"\"\n        if get_domain_from_id(user_id) != origin:\n            logger.info(\n                \"Got /make_join request for user %r from different origin %s, ignoring\",\n                user_id,\n                origin,\n            )\n            raise SynapseError(403, \"User not from origin\", Codes.FORBIDDEN)\n\n        event_content = {\"membership\": Membership.JOIN}\n\n        room_version = yield self.store.get_room_version(room_id)\n\n        builder = self.event_builder_factory.new(\n            room_version,\n            {\n                \"type\": EventTypes.Member,\n                \"content\": event_content,\n                \"room_id\": room_id,\n                \"sender\": user_id,\n                \"state_key\": user_id,\n            },\n        )\n\n        try:\n            event, context = yield self.event_creation_handler.create_new_client_event(\n                builder=builder\n            )\n        except AuthError as e:\n            logger.warn(\"Failed to create join %r because %s\", event, e)\n            raise e\n\n        event_allowed = yield self.third_party_event_rules.check_event_allowed(\n            event, context\n        )\n        if not event_allowed:\n            logger.info(\"Creation of join %s forbidden by third-party rules\", event)\n            raise SynapseError(\n                403, \"This event is not allowed in this context\", Codes.FORBIDDEN\n            )\n\n        # The remote hasn't signed it yet, obviously. We'll do the full checks\n        # when we get the event back in `on_send_join_request`\n        yield self.auth.check_from_context(\n            room_version, event, context, do_sig_check=False\n        )\n\n        return event\n"}], "gpt_answer": "The provided information indicates that the vulnerability in Matrix Synapse before 1.5.0 mishandles signature checking on some federation APIs. Events sent over `/send_join`, `/send_leave`, and `/invite` may not be correctly signed, or may not come from the expected servers.\n\nThe function `on_send_leave_request` has been changed to include a check that verifies if the domain from the event sender is the same as the origin. If not, it raises a `SynapseError`. This change is directly related to the vulnerability described, as it adds a check to ensure that the event is coming from the expected server.\n\nTherefore, the function `on_send_leave_request` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "on_send_join_request", "code_before": "    def on_send_join_request(self, origin, pdu):\n        \"\"\" We have received a join event for a room. Fully process it and\n        respond with the current state and auth chains.\n        \"\"\"\n        event = pdu\n\n        logger.debug(\n            \"on_send_join_request: Got event: %s, signatures: %s\",\n            event.event_id,\n            event.signatures,\n        )\n\n        event.internal_metadata.outlier = False\n        # Send this event on behalf of the origin server.\n        #\n        # The reasons we have the destination server rather than the origin\n        # server send it are slightly mysterious: the origin server should have\n        # all the neccessary state once it gets the response to the send_join,\n        # so it could send the event itself if it wanted to. It may be that\n        # doing it this way reduces failure modes, or avoids certain attacks\n        # where a new server selectively tells a subset of the federation that\n        # it has joined.\n        #\n        # The fact is that, as of the current writing, Synapse doesn't send out\n        # the join event over federation after joining, and changing it now\n        # would introduce the danger of backwards-compatibility problems.\n        event.internal_metadata.send_on_behalf_of = origin\n\n        context = yield self._handle_new_event(origin, event)\n\n        event_allowed = yield self.third_party_event_rules.check_event_allowed(\n            event, context\n        )\n        if not event_allowed:\n            logger.info(\"Sending of join %s forbidden by third-party rules\", event)\n            raise SynapseError(\n                403, \"This event is not allowed in this context\", Codes.FORBIDDEN\n            )\n\n        logger.debug(\n            \"on_send_join_request: After _handle_new_event: %s, sigs: %s\",\n            event.event_id,\n            event.signatures,\n        )\n\n        if even