 destroy: () => void; update: (t: () => TooltipContent) => void } {\n  let getter = text;"}, {"function_name": "update", "code_before": "): { destroy: () => void; update: (t: () => string) => void } {\n  let getter = text;", "code_after": "): { destroy: () => void; update: (t: () => TooltipContent) => void } {\n  let getter = text;"}, {"function_name": "node.getScreenCTM", "code_before": "    const matrix = node.getScreenCTM();\n    if (res && matrix) {\n      const [x, y, content] = res;\n      const t = tooltip();\n      t.style.opacity = \"1\";\n      t.innerHTML = content;\n      t.style.left = `${window.scrollX + x + matrix.e}px`;\n      t.style.top = `${window.scrollY + y + matrix.f - 15}px`;\n    } else {\n      hide();\n    }\n  }\n  node.addEventListener(\"mousemove\", mousemove);\n  node.addEventListener(\"mouseleave\", hide);\n\n  return {\n    destroy: hide,\n  };\n}\n", "code_after": "    const matrix = node.getScreenCTM();\n    if (res && matrix) {\n      const [x, y, content] = res;\n      const t = tooltip();\n      t.style.opacity = \"1\";\n      t.replaceChildren(...content);\n      t.style.left = `${window.scrollX + x + matrix.e}px`;\n      t.style.top = `${window.scrollY + y + matrix.f - 15}px`;\n    } else {\n      hide();\n    }\n  }\n  node.addEventListener(\"mousemove\", mousemove);\n  node.addEventListener(\"mouseleave\", hide);\n\n  return {\n    destroy: hide,\n  };\n}\n"}, {"function_name": "followingTooltip", "code_before": "  text: () => string\n): { destroy: () => void; update: (t: () => string) => void } {\n  let getter = text;", "code_after": "  text: () => TooltipContent\n): { destroy: () => void; update: (t: () => TooltipContent) => void } {\n  let getter = text;"}], "gpt_answer": "The provided information indicates that the function `node.addEventListener` is being modified to address a Cross-Site Scripting (XSS) vulnerability. The vulnerability allowed an attacker to execute malicious JavaScript code due to improper validation on filter conversion.\n\nIn the `code_before` snippet, the `innerHTML` property is used to set the content of the tooltip, which is a common source of XSS vulnerabilities because it interprets the input as HTML, including any scripts it might contain.\n\nIn the `code_after` snippet, the `replaceChildren` method is used instead of `innerHTML`. This method does not interpret the input as HTML, but instead treats it as text, which prevents the execution of any scripts and thus mitigates the XSS vulnerability.\n\nTherefore, the function `node.addEventListener` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "node.getScreenCTM", "code_before": "    const matrix = node.getScreenCTM();\n    if (res && matrix) {\n      const [x, y, content] = res;\n      const t = tooltip();\n      t.style.opacity = \"1\";\n      t.innerHTML = content;\n      t.style.left = `${window.scrollX + x + matrix.e}px`;\n      t.style.top = `${window.scrollY + y + matrix.f - 15}px`;\n    } else {\n      hide();\n    }\n  }\n  node.addEventListener(\"mousemove\", mousemove);\n  node.addEventListener(\"mouseleave\", hide);\n\n  return {\n    destroy: hide,\n  };\n}\n", "code_after": "    const matrix = node.getScreenCTM();\n    if (res && matrix) {\n      const [x, y, content] = res;\n      const t = tooltip();\n      t.style.opacity = \"1\";\n      t.replaceChildren(...content);\n      t.style.left = `${window.scrollX + x + matrix.e}px`;\n      t.style.top = `${window.scrollY + y + matrix.f - 15}px`;\n    } else {\n      hide();\n    }\n  }\n  node.addEventListener(\"mousemove\", mousemove);\n  node.addEventListener(\"mouseleave\", hide);\n\n  return {\n    destroy: hide,\n  };\n}\n", "commit_message": "create tooltip contents in a xss-safe way", "commit": "https://github.com/beancount/fava/commit/68bbb6e39319deb35ab9f18d0b6aa9fa70472539", "description": "Description\nFava v1.22 have a conversion filter function on income statement dashboard which allow user to perform XSS due to improper validation on filter conversion.\nProof of Concept\nNavigate to Fava demo instance https://fava.pythonanywhere.com/example-beancount-file/income_statement/.\nFilter on conversion type and add payload on the result.\nHover mouse cursor to bar chart (visualization) and XSS alert will pop up.\nEndpoints\nhttps://fava.pythonanywhere.com/huge-example-file/income_statement/?conversion=at_value\nhttps://fava.pythonanywhere.com/example-with-budgets/income_statement/?conversion=units\nhttps://fava.pythonanywhere.com/example-beancount-file/income_statement/?conversion=at_value\nPayload\n\"><img src=a onerror=alert(document.domain)>\nScreenshot POC\nxss domain\nxss\nImpact\nThis vulnerability is capable of executing a malicious javascript code in web page", "file_change_id": 82256946508618, "report_link": "https://huntr.com/bounties/8705800d-cf2f-433d-9c3e-dbef6a3f7e08/", "programming_language": "TypeScript", "other_changed_function_in_the_commit": [{"function_name": "TooltipFindNode", "code_before": ") => [number, number, string] | undefined;\n", "code_after": ") => [number, number, TooltipContent] | undefined;\n"}, {"function_name": "node.addEventListener", "code_before": "  node.addEventListener(\"mouseenter\", () => {\n    const t = tooltip();\n    t.innerHTML = getter();\n  });\n  node.addEventListener(\"mousemove\", followMouse);", "code_after": "  node.addEventListener(\"mouseenter\", () => {\n    const t = tooltip();\n    t.replaceChildren(...getter());\n  });\n  node.addEventListener(\"mousemove\", followMouse);"}, {"function_name": "destroy", "code_before": "): { destroy: () => void; update: (t: () => string) => void } {\n  let getter = text;", "code_after": "): { destroy: () => void; update: (t: () => TooltipContent) => void } {\n  let getter = text;"}, {"function_name": "update", "code_before": "): { destroy: () => void; update: (t: () => string) => void } {\n  let getter = text;", "code_after": "): { destroy: () => void; update: (t: () => TooltipContent) => void } {\n  let getter = text;"}, {"function_name": "followingTooltip", "code_before": "  text: () => string\n): { destroy: () => void; update: (t: () => string) => void } {\n  let getter = text;", "code_after": "  text: () => TooltipContent\n): { destroy: () => void; update: (t: () => TooltipContent) => void } {\n  let getter = text;"}], "gpt_answer": "The provided information indicates that the vulnerability was related to Cross-Site Scripting (XSS) due to improper validation on filter conversion. The change in the function `node.getScreenCTM` is from using `innerHTML` to `replaceChildren`, which is a safer way to modify the content of an element and helps prevent XSS attacks.\n\nThe `innerHTML` property can potentially open your code up to injection attacks, as it interprets the argument as HTML. On the other hand, `replaceChildren` does not interpret the inserted content as HTML, but instead adds it as text, which is safer.\n\nGiven this, it can be inferred that the function `node.getScreenCTM` was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "showTooltip", "code_before": "function showTooltip(target: HTMLElement): () => void {\n  const tooltip = document.createElement(\"div\");\n  const isHidden = target.classList.contains(\"hidden\");\n  if (isHidden) {\n    target.classList.remove(\"hidden\");\n  }\n  tooltip.className = \"keyboard-tooltip\";\n  tooltip.innerHTML = target.getAttribute(\"data-key\") || \"\";\n  document.body.appendChild(tooltip);\n  const parentCoords = target.getBoundingClientRect();\n  // Padded 10px to the left if there is space or centered otherwise\n  const left =\n    parentCoords.left +\n    Math.min((target.offsetWidth - tooltip.offsetWidth) / 2, 10);\n  const top =\n    parentCoords.top + (target.offsetHeight - tooltip.offsetHeight) / 2;\n  tooltip.style.left = `${left}px`;\n  tooltip.style.top = `${top + window.pageYOffset}px`;\n  return (): void => {\n    tooltip.remove();\n    if (isHidden) {\n      target.classList.add(\"hidden\");\n    }\n  };\n}\n", "code_after": "function showTooltip(target: HTMLElement): () => void {\n  const tooltip = document.createElement(\"div\");\n  const isHidden = target.classList.contains(\"hidden\");\n  if (isHidden) {\n    target.classList.remove(\"hidden\");\n  }\n  tooltip.className = \"keyboard-tooltip\";\n  tooltip.textContent = target.getAttribute(\"data-key\") ?? \"\";\n  document.body.appendChild(tooltip);\n  const parentCoords = target.getBoundingClientRect();\n  // Padded 10px to the left if there is space or centered otherwise\n  const left =\n    parentCoords.left +\n    Math.min((target.offsetWidth - tooltip.offsetWidth) / 2, 10);\n  const top =\n    parentCoords.top + (target.offsetHeight - tooltip.offsetHeight) / 2;\n  tooltip.style.left = `${left}px`;\n  tooltip.style.top = `${top + window.pageYOffset}px`;\n  return (): void => {\n    tooltip.remove();\n    if (isHidden) {\n      target.classList.add(\"hidden\");\n    }\n  };\n}\n", "commit_message": "create tooltip contents in a xss-safe way", "commit": "https://github.com/beancount/fava/commit/68bbb6e39319deb35ab9f18d0b6aa9fa70472539", "description": "Description\nFava v1.22 have a conversion filter function on income statement dashboard which allow user to perform XSS due to improper validation on filter conversion.\nProof of Concept\nNavigate to Fava demo instance https://fava.pythonanywhere.com/example-beancount-file/income_statement/.\nFilter on conversion type and add payload on the result.\nHover mouse cursor to bar chart (visualization) and XSS alert will pop up.\nEndpoints\nhttps://fava.pythonanywhere.com/huge-example-file/income_statement/?conversion=at_value\nhttps://fava.pythonanywhere.com/example-with-budgets/income_statement/?conversion=units\nhttps://fava.pythonanywhere.com/example-beancount-file/income_statement/?conversion=at_value\nPayload\n\"><img src=a onerror=alert(document.domain)>\nScreenshot POC\nxss domain\nxss\nImpact\nThis vulnerability is capable of executing a malicious javascript code in web page", "file_change_id": 98890093478648, "report_link": "https://huntr.com/bounties/8705800d-cf2f-433d-9c3e-dbef6a3f7e08/", "programming_language": "JavaScript", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the function `showTooltip` was changed to mitigate a Cross-Site Scripting (XSS) vulnerability. The XSS vulnerability was due to improper validation on filter conversion, which allowed the execution of malicious JavaScript code.\n\nIn the `showTooltip` function, the change is from using `innerHTML` to `textContent` for setting the tooltip content. The `innerHTML` property can potentially lead to XSS attacks if the content is user-supplied, as it interprets the content as HTML including any scripts within. On the other hand, `textContent` does not parse the content as HTML, but instead treats it as raw text, which mitigates the risk of XSS.\n\nGiven this, it can be inferred that the `showTooltip` function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "initSidebar", "code_before": "export function initSidebar(): void {\n  const errorCountEl = document.getElementById(\"error-count\");\n  if (errorCountEl instanceof HTMLLIElement) {\n    errorCount.subscribe((errorCount_val) => {\n      errorCountEl.classList.toggle(\"hidden\", errorCount_val === 0);\n      const span = errorCountEl.querySelector(\"span\");\n      if (span) {\n        span.innerHTML = `${errorCount_val}`;\n      }\n    });\n  }\n\n  const asideButton = document.getElementById(\"aside-button\");\n  if (asideButton instanceof HTMLButtonElement) {\n    asideButton.addEventListener(\"click\", () => {\n      document.querySelector(\"aside\")?.classList.toggle(\"active\");\n      asideButton.classList.toggle(\"active\");\n    });\n  }\n}\n", "code_after": "export function initSidebar(): void {\n  const errorCountEl = document.getElementById(\"error-count\");\n  if (errorCountEl instanceof HTMLLIElement) {\n    errorCount.subscribe((errorCount_val) => {\n      errorCountEl.classList.toggle(\"hidden\", errorCount_val === 0);\n      const span = errorCountEl.querySelector(\"span\");\n      if (span) {\n        span.textContent = `${errorCount_val}`;\n      }\n    });\n  }\n\n  const asideButton = document.getElementById(\"aside-button\");\n  if (asideButton instanceof HTMLButtonElement) {\n    asideButton.addEventListener(\"click\", () => {\n      document.querySelector(\"aside\")?.classList.toggle(\"active\");\n      asideButton.classList.toggle(\"active\");\n    });\n  }\n}\n", "commit_message": "create tooltip contents in a xss-safe way", "commit": "https://github.com/beancount/fava/commit/68bbb6e39319deb35ab9f18d0b6aa9fa70472539", "description": "Description\nFava v1.22 have a conversion filter function on income statement dashboard which allow user to perform XSS due to improper validation on filter conversion.\nProof of Concept\nNavigate to Fava demo instance https://fava.pythonanywhere.com/example-beancount-file/income_statement/.\nFilter on conversion type and add payload on the result.\nHover mouse cursor to bar chart (visualization) and XSS alert will pop up.\nEndpoints\nhttps://fava.pythonanywhere.com/huge-example-file/income_statement/?conversion=at_value\nhttps://fava.pythonanywhere.com/example-with-budgets/income_statement/?conversion=units\nhttps://fava.pythonanywhere.com/example-beancount-file/income_statement/?conversion=at_value\nPayload\n\"><img src=a onerror=alert(document.domain)>\nScreenshot POC\nxss domain\nxss\nImpact\nThis vulnerability is capable of executing a malicious javascript code in web page", "file_change_id": 27150774200287, "report_link": "https://huntr.com/bounties/8705800d-cf2f-433d-9c3e-dbef6a3f7e08/", "programming_language": "TypeScript", "other_changed_function_in_the_commit": [], "gpt_answer": "The provided information indicates that the vulnerability was due to improper validation on filter conversion, which allowed for Cross-Site Scripting (XSS) attacks. The commit message also mentions creating tooltip contents in an XSS-safe way.\n\nLooking at the changes in the \"initSidebar\" function, the only change is the replacement of `span.innerHTML` with `span.textContent`. This change is significant because `innerHTML` can potentially lead to XSS attacks if the input is not properly sanitized, as it interprets the input as HTML (including any scripts it might contain). On the other hand, `textContent` treats the input as a plain text string, which prevents the execution of any scripts and thus mitigates the risk of XSS attacks.\n\nGiven this, it can be concluded that the \"initSidebar\" function was vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "policy", "code_before": "        var policy = function (tagName, attribs) {\n            if (!(html4.ELEMENTS[tagName] & html4.eflags.UNSAFE)) {\n                return {\n                    'attribs': sanitizeAttribs(tagName, attribs,\n                        noop, noop, record_messages)\n                    };\n            } else {\n                record_messages(tagName + \" removed\", {\n                  change: \"removed\",\n                  tagName: tagName\n                });\n            }\n        };\n        \n        var sanitized = caja.sanitizeWithPolicy(html, policy);\n        \n        if (allow_css) {\n            // sanitize style tags as stylesheets\n            sanitized = sanitize_stylesheets(sanitized, policy);\n        }\n        \n        return sanitized;\n    };\n", "code_after": "", "commit_message": "Merge pull request from GHSA-hwvq-6gjx-j797\n\n* sanitizer fix\n\n* Pass sanitizer options explicitly", "commit": "https://github.com/jupyter/notebook/commit/79fc76e890a8ec42f73a3d009e44ef84c14ef0d5", "description": "### Impact\n\nUntrusted notebook can execute code on load. This is a remote code execution, but requires user action to open a notebook.\n\n### Patches\n\n5.7.11, 6.4.1\n\n### References\n\n[OWASP Page on Injection Prevention](https://cheatsheetseries.owasp.org/cheatsheets/Injection_Prevention_Cheat_Sheet.html#injection-prevention-rules)\n\n### For more information\n\nIf you have any questions or comments about this advisory, or vulnerabilities to report, please email our security list security@ipython.org.\n\nCredit: Guillaume Jeanne from Google\n\n\n### Example:\n\nA notebook with the following content in a cell and it would display an alert when opened for the first time in Notebook (in an untrusted state):\n\n```\n{ \"cell_type\": \"code\", \"execution_count\": 0, \"metadata\": {}, \"outputs\": [ { \"data\": { \"text/html\": [ \"<select><iframe></select><img src=x: onerror=alert('xss')>\\n\"], \"text/plain\": [] }, \"metadata\": {}, \"output_type\": \"display_data\" } ], \"source\": [ \"\" ] }\n````", "file_change_id": 147146198041855, "report_link": "https://github.com/advisories/GHSA-hwvq-6gjx-j797", "programming_language": "JavaScript", "other_changed_function_in_the_commit": [{"function_name": "sanitizeAttribs", "code_before": "    var sanitizeAttribs = function (tagName, attribs, opt_naiveUriRewriter, opt_nmTokenPolicy, opt_logger) {\n        /**\n         * add trusting data-attributes to the default sanitizeAttribs from caja\n         * this function is mostly copied from the caja source\n         */\n        var ATTRIBS = caja.html4.ATTRIBS;\n        for (var i = 0; i < attribs.length; i += 2) {\n            var attribName = attribs[i];\n            if (attribName.substr(0,5) == 'data-') {\n                var attribKey = '*::' + attribName;\n                if (!ATTRIBS.hasOwnProperty(attribKey)) {\n                    ATTRIBS[attribKey] = 0;\n                }\n            }\n        }\n        // Caja doesn't allow data uri for img::src, see\n        // https://github.com/google/caja/issues/1558\n        // This is not a security issue for browser post ie6 though, so we\n        // disable the check\n        // https://www.owasp.org/index.php/Script_in_IMG_tags\n        ATTRIBS['img::src'] = 0;\n        return caja.sanitizeAttribs(tagName, attribs, opt_naiveUriRewriter, opt_nmTokenPolicy, opt_logger);\n    };\n    ", "code_after": ""}, {"function_name": "record_messages", "code_before": "        var record_messages = function (msg, opts) {\n            console.log(\"HTML Sanitizer\", msg, opts);\n        };\n        ", "code_after": ""}, {"function_name": "sanitize_html", "code_before": "    var sanitize_html = function (html, allow_css) {\n        /**\n         * sanitize HTML\n         * if allow_css is true (default: false), CSS is sanitized as well.\n         * otherwise, CSS elements and attributes are simply removed.\n         */\n        var html4 = caja.html4;\n\n        if (allow_css) {\n            // allow sanitization of style tags,\n            // not just scrubbing\n            html4.ELEMENTS.style &= ~html4.eflags.UNSAFE;\n            html4.ATTRIBS.style = html4.atype.STYLE;\n        } else {\n            // scrub all CSS\n            html4.ELEMENTS.style |= html4.eflags.UNSAFE;\n            html4.ATTRIBS.style = html4.atype.SCRIPT;\n        }\n        \n        var record_messages = function (msg, opts) {\n            console.log(\"HTML Sanitizer\", msg, opts);\n        };\n        \n        var policy = function (tagName, attribs) {\n            if (!(html4.ELEMENTS[tagName] & html4.eflags.UNSAFE)) {\n                return {\n                    'attribs': sanitizeAttribs(tagName, attribs,\n                        noop, noop, record_messages)\n                    };\n            } else {\n                record_messages(tagName + \" removed\", {\n                  change: \"removed\",\n                  tagName: tagName\n                });\n            }\n        };\n        \n        var sanitized = caja.sanitizeWithPolicy(html, policy);\n        \n        if (allow_css) {\n            // sanitize style tags as stylesheets\n            sanitized = sanitize_stylesheets(sanitized, policy);\n        }\n        \n        return sanitized;\n    };\n\n    var sanitize_html_and_parse = function (html, allow_css) {\n        /**\n         * Sanitize HTML and parse it safely using jQuery.\n         *\n         * This disable's jQuery's html 'prefilter', which can make invalid\n         * HTML valid after the sanitizer has checked it.\n         *\n         * Returns an array of DOM nodes.\n         */\n        var sanitized_html = sanitize_html(html, allow_css);\n        var prev_htmlPrefilter = $.htmlPrefilter;\n        $.htmlPrefilter = function(html) {return html;};  // Don't modify HTML\n        try {\n            return $.parseHTML(sanitized_html);\n        } finally {\n            $.htmlPrefilter = prev_htmlPrefilter;  // Set it back again\n        }\n    };\n    \n    var security = {\n        caja: caja,\n        sanitize_html_and_parse: sanitize_html_and_parse,\n        sanitize_html: sanitize_html\n    };\n\n    return security;\n});\n", "code_after": "    var sanitize_html = function (html, allow_css) {\n        /**\n         * sanitize HTML\n         * if allow_css is true (default: false), CSS is sanitized as well.\n         * otherwise, CSS elements and attributes are simply removed.\n         */\n         const options = {};\n         if (!allow_css) {\n             options.allowedStyles = {};\n         }\n        return defaultSanitizer.sanitize(html, options);\n    };\n"}, {"function_name": "sanitize_stylesheets", "code_before": "    var sanitize_stylesheets = function (html, tagPolicy) {\n        /**\n         * sanitize just the css in style tags in a block of html\n         * called by sanitize_html, if allow_css is true\n         */\n        var h = $(\"<div/>\").append(html);\n        var style_tags = h.find(\"style\");\n        if (!style_tags.length) {\n            // no style tags to sanitize\n            return html;\n        }\n        style_tags.each(function(i, style) {\n            style.innerHTML = sanitize_css(style.innerHTML, tagPolicy);\n        });\n        return h.html();\n    };\n    ", "code_after": ""}, {"function_name": "sanitizeAttribs", "code_before": "                    'attribs': sanitizeAttribs(tagName, attribs,\n                        noop, noop, record_messages)\n                    };\n            } else {\n                record_messages(tagName + \" removed\", {\n                  change: \"removed\",\n                  tagName: tagName\n                });\n            }\n        };\n        ", "code_after": ""}, {"function_name": "sanitize_css", "code_before": "    var sanitize_css = function (css, tagPolicy) {\n        /**\n         * sanitize CSS\n         * like sanitize_html, but for CSS\n         * called by sanitize_stylesheets\n         */\n        return caja.sanitizeStylesheet(\n            window.location.pathname,\n            css,\n            {\n                containerClass: null,\n                idSuffix: '',\n                tagPolicy: tagPolicy,\n                virtualizeAttrName: noop\n            },\n            noop\n        );\n    };\n    ", "code_after": ""}], "gpt_answer": "The provided information indicates that the function \"policy\" was removed in the commit that was made to fix a vulnerability. The vulnerability allowed untrusted notebooks to execute code on load, which is a remote code execution vulnerability but requires user action to open a notebook.\n\nThe \"policy\" function was part of the sanitization process for HTML content. It checked if the HTML elements were unsafe and if so, it removed them and recorded a message. However, this function was removed in the commit, and no replacement function was provided in the \"code_after\" field.\n\nGiven the nature of the vulnerability and the changes made in the commit, it can be inferred that the \"policy\" function was vulnerable and was removed as part of the fix.\n\nTherefore, the answer is 1 (the function is vulnerable).\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "sanitize_html", "code_before": "    var sanitize_html = function (html, allow_css) {\n        /**\n         * sanitize HTML\n         * if allow_css is true (default: false), CSS is sanitized as well.\n         * otherwise, CSS elements and attributes are simply removed.\n         */\n        var html4 = caja.html4;\n\n        if (allow_css) {\n            // allow sanitization of style tags,\n            // not just scrubbing\n            html4.ELEMENTS.style &= ~html4.eflags.UNSAFE;\n            html4.ATTRIBS.style = html4.atype.STYLE;\n        } else {\n            // scrub all CSS\n            html4.ELEMENTS.style |= html4.eflags.UNSAFE;\n            html4.ATTRIBS.style = html4.atype.SCRIPT;\n        }\n        \n        var record_messages = function (msg, opts) {\n            console.log(\"HTML Sanitizer\", msg, opts);\n        };\n        \n        var policy = function (tagName, attribs) {\n            if (!(html4.ELEMENTS[tagName] & html4.eflags.UNSAFE)) {\n                return {\n                    'attribs': sanitizeAttribs(tagName, attribs,\n                        noop, noop, record_messages)\n                    };\n            } else {\n                record_messages(tagName + \" removed\", {\n                  change: \"removed\",\n                  tagName: tagName\n                });\n            }\n        };\n        \n        var sanitized = caja.sanitizeWithPolicy(html, policy);\n        \n        if (allow_css) {\n            // sanitize style tags as stylesheets\n            sanitized = sanitize_stylesheets(sanitized, policy);\n        }\n        \n        return sanitized;\n    };\n\n    var sanitize_html_and_parse = function (html, allow_css) {\n        /**\n         * Sanitize HTML and parse it safely using jQuery.\n         *\n         * This disable's jQuery's html 'prefilter', which can make invalid\n         * HTML valid after the sanitizer has checked it.\n         *\n         * Returns an array of DOM nodes.\n         */\n        var sanitized_html = sanitize_html(html, allow_css);\n        var prev_htmlPrefilter = $.htmlPrefilter;\n        $.htmlPrefilter = function(html) {return html;};  // Don't modify HTML\n        try {\n            return $.parseHTML(sanitized_html);\n        } finally {\n            $.htmlPrefilter = prev_htmlPrefilter;  // Set it back again\n        }\n    };\n    \n    var security = {\n        caja: caja,\n        sanitize_html_and_parse: sanitize_html_and_parse,\n        sanitize_html: sanitize_html\n    };\n\n    return security;\n});\n", "code_after": "    var sanitize_html = function (html, allow_css) {\n        /**\n         * sanitize HTML\n         * if allow_css is true (default: false), CSS is sanitized as well.\n         * otherwise, CSS elements and attributes are simply removed.\n         */\n         const options = {};\n         if (!allow_css) {\n             options.allowedStyles = {};\n         }\n        return defaultSanitizer.sanitize(html, options);\n    };\n", "commit_message": "Merge pull request from GHSA-hwvq-6gjx-j797\n\n* sanitizer fix\n\n* Pass sanitizer options explicitly", "commit": "https://github.com/jupyter/notebook/commit/79fc76e890a8ec42f73a3d009e44ef84c14ef0d5", "description": "### Impact\n\nUntrusted notebook can execute code on load. This is a remote code execution, but requires user action to open a notebook.\n\n### Patches\n\n5.7.11, 6.4.1\n\n### References\n\n[OWASP Page on Injection Prevention](https://cheatsheetseries.owasp.org/cheatsheets/Injection_Prevention_Cheat_Sheet.html#injection-prevention-rules)\n\n### For more information\n\nIf you have any questions or comments about this advisory, or vulnerabilities to report, please email our security list security@ipython.org.\n\nCredit: Guillaume Jeanne from Google\n\n\n### Example:\n\nA notebook with the following content in a cell and it would display an alert when opened for the first time in Notebook (in an untrusted state):\n\n```\n{ \"cell_type\": \"code\", \"execution_count\": 0, \"metadata\": {}, \"outputs\": [ { \"data\": { \"text/html\": [ \"<select><iframe></select><img src=x: onerror=alert('xss')>\\n\"], \"text/plain\": [] }, \"metadata\": {}, \"output_type\": \"display_data\" } ], \"source\": [ \"\" ] }\n````", "file_change_id": 147146198041855, "report_link": "https://github.com/advisories/GHSA-hwvq-6gjx-j797", "programming_language": "JavaScript", "other_changed_function_in_the_commit": [{"function_name": "sanitizeAttribs", "code_before": "    var sanitizeAttribs = function (tagName, attribs, opt_naiveUriRewriter, opt_nmTokenPolicy, opt_logger) {\n        /**\n         * add trusting data-attributes to the default sanitizeAttribs from caja\n         * this function is mostly copied from the caja source\n         */\n        var ATTRIBS = caja.html4.ATTRIBS;\n        for (var i = 0; i < attribs.length; i += 2) {\n            var attribName = attribs[i];\n            if (attribName.substr(0,5) == 'data-') {\n                var attribKey = '*::' + attribName;\n                if (!ATTRIBS.hasOwnProperty(attribKey)) {\n                    ATTRIBS[attribKey] = 0;\n                }\n            }\n        }\n        // Caja doesn't allow data uri for img::src, see\n        // https://github.com/google/caja/issues/1558\n        // This is not a security issue for browser post ie6 though, so we\n        // disable the check\n        // https://www.owasp.org/index.php/Script_in_IMG_tags\n        ATTRIBS['img::src'] = 0;\n        return caja.sanitizeAttribs(tagName, attribs, opt_naiveUriRewriter, opt_nmTokenPolicy, opt_logger);\n    };\n    ", "code_after": ""}, {"function_name": "record_messages", "code_before": "        var record_messages = function (msg, opts) {\n            console.log(\"HTML Sanitizer\", msg, opts);\n        };\n        ", "code_after": ""}, {"function_name": "policy", "code_before": "        var policy = function (tagName, attribs) {\n            if (!(html4.ELEMENTS[tagName] & html4.eflags.UNSAFE)) {\n                return {\n                    'attribs': sanitizeAttribs(tagName, attribs,\n                        noop, noop, record_messages)\n                    };\n            } else {\n                record_messages(tagName + \" removed\", {\n                  change: \"removed\",\n                  tagName: tagName\n                });\n            }\n        };\n        \n        var sanitized = caja.sanitizeWithPolicy(html, policy);\n        \n        if (allow_css) {\n            // sanitize style tags as stylesheets\n            sanitized = sanitize_stylesheets(sanitized, policy);\n        }\n        \n        return sanitized;\n    };\n", "code_after": ""}, {"function_name": "sanitize_stylesheets", "code_before": "    var sanitize_stylesheets = function (html, tagPolicy) {\n        /**\n         * sanitize just the css in style tags in a block of html\n         * called by sanitize_html, if allow_css is true\n         */\n        var h = $(\"<div/>\").append(html);\n        var style_tags = h.find(\"style\");\n        if (!style_tags.length) {\n            // no style tags to sanitize\n            return html;\n        }\n        style_tags.each(function(i, style) {\n            style.innerHTML = sanitize_css(style.innerHTML, tagPolicy);\n        });\n        return h.html();\n    };\n    ", "code_after": ""}, {"function_name": "sanitizeAttribs", "code_before": "                    'attribs': sanitizeAttribs(tagName, attribs,\n                        noop, noop, record_messages)\n                    };\n            } else {\n                record_messages(tagName + \" removed\", {\n                  change: \"removed\",\n                  tagName: tagName\n                });\n            }\n        };\n        ", "code_after": ""}, {"function_name": "sanitize_css", "code_before": "    var sanitize_css = function (css, tagPolicy) {\n        /**\n         * sanitize CSS\n         * like sanitize_html, but for CSS\n         * called by sanitize_stylesheets\n         */\n        return caja.sanitizeStylesheet(\n            window.location.pathname,\n            css,\n            {\n                containerClass: null,\n                idSuffix: '',\n                tagPolicy: tagPolicy,\n                virtualizeAttrName: noop\n            },\n            noop\n        );\n    };\n    ", "code_after": ""}], "gpt_answer": "The function \"sanitize_html\" is being changed to address a vulnerability. The vulnerability allows untrusted notebooks to execute code on load, which is a remote code execution vulnerability. \n\nIn the \"sanitize_html\" function, the code is being changed to use a new sanitizer, \"defaultSanitizer\", instead of the previous \"caja\" sanitizer. The new sanitizer is being used with options that are set based on the \"allow_css\" parameter. If \"allow_css\" is false, then no styles are allowed in the sanitized HTML.\n\nThis change is directly related to the vulnerability, as it changes how the HTML is sanitized to prevent the execution of unauthorized code. Therefore, the function \"sanitize_html\" is vulnerable and has been changed to fix the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
{"function_name": "sanitize_stylesheets", "code_before": "    var sanitize_stylesheets = function (html, tagPolicy) {\n        /**\n         * sanitize just the css in style tags in a block of html\n         * called by sanitize_html, if allow_css is true\n         */\n        var h = $(\"<div/>\").append(html);\n        var style_tags = h.find(\"style\");\n        if (!style_tags.length) {\n            // no style tags to sanitize\n            return html;\n        }\n        style_tags.each(function(i, style) {\n            style.innerHTML = sanitize_css(style.innerHTML, tagPolicy);\n        });\n        return h.html();\n    };\n    ", "code_after": "", "commit_message": "Merge pull request from GHSA-hwvq-6gjx-j797\n\n* sanitizer fix\n\n* Pass sanitizer options explicitly", "commit": "https://github.com/jupyter/notebook/commit/79fc76e890a8ec42f73a3d009e44ef84c14ef0d5", "description": "### Impact\n\nUntrusted notebook can execute code on load. This is a remote code execution, but requires user action to open a notebook.\n\n### Patches\n\n5.7.11, 6.4.1\n\n### References\n\n[OWASP Page on Injection Prevention](https://cheatsheetseries.owasp.org/cheatsheets/Injection_Prevention_Cheat_Sheet.html#injection-prevention-rules)\n\n### For more information\n\nIf you have any questions or comments about this advisory, or vulnerabilities to report, please email our security list security@ipython.org.\n\nCredit: Guillaume Jeanne from Google\n\n\n### Example:\n\nA notebook with the following content in a cell and it would display an alert when opened for the first time in Notebook (in an untrusted state):\n\n```\n{ \"cell_type\": \"code\", \"execution_count\": 0, \"metadata\": {}, \"outputs\": [ { \"data\": { \"text/html\": [ \"<select><iframe></select><img src=x: onerror=alert('xss')>\\n\"], \"text/plain\": [] }, \"metadata\": {}, \"output_type\": \"display_data\" } ], \"source\": [ \"\" ] }\n````", "file_change_id": 147146198041855, "report_link": "https://github.com/advisories/GHSA-hwvq-6gjx-j797", "programming_language": "JavaScript", "other_changed_function_in_the_commit": [{"function_name": "sanitizeAttribs", "code_before": "    var sanitizeAttribs = function (tagName, attribs, opt_naiveUriRewriter, opt_nmTokenPolicy, opt_logger) {\n        /**\n         * add trusting data-attributes to the default sanitizeAttribs from caja\n         * this function is mostly copied from the caja source\n         */\n        var ATTRIBS = caja.html4.ATTRIBS;\n        for (var i = 0; i < attribs.length; i += 2) {\n            var attribName = attribs[i];\n            if (attribName.substr(0,5) == 'data-') {\n                var attribKey = '*::' + attribName;\n                if (!ATTRIBS.hasOwnProperty(attribKey)) {\n                    ATTRIBS[attribKey] = 0;\n                }\n            }\n        }\n        // Caja doesn't allow data uri for img::src, see\n        // https://github.com/google/caja/issues/1558\n        // This is not a security issue for browser post ie6 though, so we\n        // disable the check\n        // https://www.owasp.org/index.php/Script_in_IMG_tags\n        ATTRIBS['img::src'] = 0;\n        return caja.sanitizeAttribs(tagName, attribs, opt_naiveUriRewriter, opt_nmTokenPolicy, opt_logger);\n    };\n    ", "code_after": ""}, {"function_name": "record_messages", "code_before": "        var record_messages = function (msg, opts) {\n            console.log(\"HTML Sanitizer\", msg, opts);\n        };\n        ", "code_after": ""}, {"function_name": "policy", "code_before": "        var policy = function (tagName, attribs) {\n            if (!(html4.ELEMENTS[tagName] & html4.eflags.UNSAFE)) {\n                return {\n                    'attribs': sanitizeAttribs(tagName, attribs,\n                        noop, noop, record_messages)\n                    };\n            } else {\n                record_messages(tagName + \" removed\", {\n                  change: \"removed\",\n                  tagName: tagName\n                });\n            }\n        };\n        \n        var sanitized = caja.sanitizeWithPolicy(html, policy);\n        \n        if (allow_css) {\n            // sanitize style tags as stylesheets\n            sanitized = sanitize_stylesheets(sanitized, policy);\n        }\n        \n        return sanitized;\n    };\n", "code_after": ""}, {"function_name": "sanitize_html", "code_before": "    var sanitize_html = function (html, allow_css) {\n        /**\n         * sanitize HTML\n         * if allow_css is true (default: false), CSS is sanitized as well.\n         * otherwise, CSS elements and attributes are simply removed.\n         */\n        var html4 = caja.html4;\n\n        if (allow_css) {\n            // allow sanitization of style tags,\n            // not just scrubbing\n            html4.ELEMENTS.style &= ~html4.eflags.UNSAFE;\n            html4.ATTRIBS.style = html4.atype.STYLE;\n        } else {\n            // scrub all CSS\n            html4.ELEMENTS.style |= html4.eflags.UNSAFE;\n            html4.ATTRIBS.style = html4.atype.SCRIPT;\n        }\n        \n        var record_messages = function (msg, opts) {\n            console.log(\"HTML Sanitizer\", msg, opts);\n        };\n        \n        var policy = function (tagName, attribs) {\n            if (!(html4.ELEMENTS[tagName] & html4.eflags.UNSAFE)) {\n                return {\n                    'attribs': sanitizeAttribs(tagName, attribs,\n                        noop, noop, record_messages)\n                    };\n            } else {\n                record_messages(tagName + \" removed\", {\n                  change: \"removed\",\n                  tagName: tagName\n                });\n            }\n        };\n        \n        var sanitized = caja.sanitizeWithPolicy(html, policy);\n        \n        if (allow_css) {\n            // sanitize style tags as stylesheets\n            sanitized = sanitize_stylesheets(sanitized, policy);\n        }\n        \n        return sanitized;\n    };\n\n    var sanitize_html_and_parse = function (html, allow_css) {\n        /**\n         * Sanitize HTML and parse it safely using jQuery.\n         *\n         * This disable's jQuery's html 'prefilter', which can make invalid\n         * HTML valid after the sanitizer has checked it.\n         *\n         * Returns an array of DOM nodes.\n         */\n        var sanitized_html = sanitize_html(html, allow_css);\n        var prev_htmlPrefilter = $.htmlPrefilter;\n        $.htmlPrefilter = function(html) {return html;};  // Don't modify HTML\n        try {\n            return $.parseHTML(sanitized_html);\n        } finally {\n            $.htmlPrefilter = prev_htmlPrefilter;  // Set it back again\n        }\n    };\n    \n    var security = {\n        caja: caja,\n        sanitize_html_and_parse: sanitize_html_and_parse,\n        sanitize_html: sanitize_html\n    };\n\n    return security;\n});\n", "code_after": "    var sanitize_html = function (html, allow_css) {\n        /**\n         * sanitize HTML\n         * if allow_css is true (default: false), CSS is sanitized as well.\n         * otherwise, CSS elements and attributes are simply removed.\n         */\n         const options = {};\n         if (!allow_css) {\n             options.allowedStyles = {};\n         }\n        return defaultSanitizer.sanitize(html, options);\n    };\n"}, {"function_name": "sanitizeAttribs", "code_before": "                    'attribs': sanitizeAttribs(tagName, attribs,\n                        noop, noop, record_messages)\n                    };\n            } else {\n                record_messages(tagName + \" removed\", {\n                  change: \"removed\",\n                  tagName: tagName\n                });\n            }\n        };\n        ", "code_after": ""}, {"function_name": "sanitize_css", "code_before": "    var sanitize_css = function (css, tagPolicy) {\n        /**\n         * sanitize CSS\n         * like sanitize_html, but for CSS\n         * called by sanitize_stylesheets\n         */\n        return caja.sanitizeStylesheet(\n            window.location.pathname,\n            css,\n            {\n                containerClass: null,\n                idSuffix: '',\n                tagPolicy: tagPolicy,\n                virtualizeAttrName: noop\n            },\n            noop\n        );\n    };\n    ", "code_after": ""}], "gpt_answer": "The function \"sanitize_stylesheets\" is removed in the commit. The function was responsible for sanitizing the CSS in style tags in a block of HTML. The removal of this function is likely related to the vulnerability that the commit is trying to fix, which is about untrusted notebooks being able to execute code on load. \n\nHowever, it's important to note that the removal of this function alone might not be sufficient to fix the vulnerability. The commit message indicates that there are other changes in the commit, such as adding sanitizer options explicitly. \n\nFrom the \"other_changed_function_in_the_commit\" field, we can see that several other functions related to sanitization are also removed or modified, including \"sanitize_html\", \"sanitizeAttribs\", and \"sanitize_css\". \n\nGiven this information, it's reasonable to conclude that the \"sanitize_stylesheets\" function is vulnerable and has been removed as part of the fix for the vulnerability.\n\n```json\n{\n\"answer\": 1\n}\n```"}
